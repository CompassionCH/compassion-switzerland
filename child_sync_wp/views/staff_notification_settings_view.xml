<odoo>
    <record id="view_notification_settings_website_form" model="ir.ui.view">
        <field name="name">staff.notification.website.form</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="message_center_compassion.compassion_settings"
        />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='notification_configuration']" position="inside">

                <setting id="website_sponsorship_notifications"
                         string="Sponsorships made from the website"
                         help="Select the users to notify when a sponsorship is created on the website for each language.">

                    <div class="content-group">
                        <div class="row mt16">
                            <label for="sponsorship_fr_id" class="col-lg-3 o_light_label" string="French"/>
                            <field name="sponsorship_fr_id" class="col-lg-9"/>
                        </div>
                        <div class="row">
                            <label for="sponsorship_de_id" class="col-lg-3 o_light_label" string="German"/>
                            <field name="sponsorship_de_id" class="col-lg-9"/>
                        </div>
                        <div class="row">
                            <label for="sponsorship_it_id" class="col-lg-3 o_light_label" string="Italian"/>
                            <field name="sponsorship_it_id" class="col-lg-9"/>
                        </div>
                    </div>

                </setting>

            </xpath>
        </field>
    </record>
</odoo>