        <!--
        SUB Sponsorship proposal e-mails
        -->
        <record id="email_sponsorship_sub_dossier_new" model="mail.template">
            <field name="name">Sponsorship - SUB Dossier</field>
            <field
        name="model_id"
        ref="partner_communication.model_partner_communication_job"
      />
            <field name="email_from">"{{object.user_id.company_id.with_context(lang=object.partner_id.lang).commercial_name}}" &lt;compassion@compassion.ch&gt;</field>
            <field name="reply_to">info@compassion.ch</field>
            <field name="partner_to">{{object.partner_id and object.partner_id.email and object.partner_id.id or False }}</field>
            <field name="subject">Your new sponsorship</field>
            <field name="body_html" type="html">
                <t t-set="sponsorships" t-value="object.get_objects()"/>
                <t t-set="child" t-value="sponsorships.mapped('child_id')"/>
                <t t-set="one_child" t-value="len(child) == 1"/>
                <t t-set="previous" t-value="sponsorships.mapped('parent_id.child_id')"/>
                <t t-set="previous_name" t-value="previous.get_list('preferred_name', 3, '', translate=False)"/>
                <t t-set="name" t-value="child.get_list('preferred_name', 3, child.get_number(), False)"/>
                <t t-set="he" t-value="child.get('he')"/>
                <t t-set="He" t-value="he[:1].upper() + he[1:]"/>
                <t t-set="his" t-value="child.get('his')"/>
                <t t-set="him" t-value="child.get('him')"/>
                <t t-set="payment_term" t-value="(sponsorships.mapped('payment_mode_id.name') or [''])[0]"/>
                <t t-set="lsv_dd" t-value="'LSV' in payment_term or 'Postfinance' in payment_term"/>
                <p>
                    <t t-out="object.partner_id.salutation"/>,
                </p>
                <p>
                    <t t-if="previous_name">Thank you so much for investing in the life of <t t-out="previous_name"/>. </t>After a sponsorship ends, one of the most wonderful parts of our work is connecting a child living in extreme poverty with a sponsor.
                </p>
                <p>
                    <b>We are delighted to introduce <t t-out="name"/><t t-if="one_child">, <t t-out="child[:1].age"/> years old</t>, from <t t-out="child.get_list('project_id.country_id.name')"/>.</b> <t t-out="He"/> <t t-out="'is' if one_child else 'are'"/> waiting for a sponsor like you.
                </p>
                <p>
                    Every child is unique and deserves a future full of hope and opportunity. The enclosed information will help you get to know <t t-out="name"/> a little better. See <t t-out="his"/> challenges and dreams, and how you can support <t t-out="him"/>.
                </p>
                <p>
                    Most sponsors decide to support a new child. That is why we have made it as easy as possible to take over the sponsorship of <t t-out="name"/>. <b>Would you be ready to sponsor <t t-out="him"/>?</b>
                </p>
                <p>
                    <t t-if="lsv_dd">
                        If you have not yet cancelled your direct debit, you do not need to do anything. We will take care of everything so that this sponsorship can start. The sponsorship donation will continue to be debited as usual.
                    </t>
                    <t t-else="">
                        If you have not yet cancelled your standing order, you do not need to do anything. We will take care of everything so that this sponsorship can start.
                    </t>
                </p>
                <p>
                    <b>
                        If we should look for another sponsor for <t t-out="name"/>, or if you wish to support another child, please contact us by e-mail or by phone within the next two weeks. If we do not hear from you, we will assume that you wish to support <t t-out="'this child' if one_child else 'these children'"/>, so that you can continue your commitment in the fight against extreme poverty.
                    </b>
                </p>
                <p>
                    We look forward to announcing the good news of this sponsorship to <t t-out="name"/>. Thank you for investing in the lives of children living in extreme poverty.
                </p>
                <p>
                    Best regards,
                </p>
                <t t-if="object.send_mode == &quot;digital&quot;">
                    <p t-out="object.user_id.signature"/>
                </t>
            </field>
        </record>
        <record id="email_sponsorship_no_sub" model="mail.template">
