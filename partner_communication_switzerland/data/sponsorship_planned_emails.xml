        <!--
        Birthday Reminder
        -->
        <record id="email_sponsorship_birthday_reminder" model="mail.template">
            <field name="name">Sponsorship - Birthday Reminder</field>
            <field
        name="model_id"
        ref="partner_communication.model_partner_communication_job"
      />
            <field name="email_from">"{{object.user_id.company_id.with_context(lang=object.partner_id.lang).commercial_name}}" &lt;compassion@compassion.ch&gt;</field>
            <field name="reply_to">info@compassion.ch</field>
            <field name="partner_to">{{object.partner_id and object.partner_id.email and object.partner_id.id or False }}</field>
            <field name="subject">Your sponsor child's birthday is approaching</field>
            <field name="body_html" type="html">
                    <t t-set="sponsorships" t-value="object.get_objects()"/>
                    <t t-set="child" t-value="sponsorships.mapped('child_id')"/>
                    <t t-set="firstname" t-value="child.get_list('preferred_name', 3, child.get_number(), False)"/>
                    <t t-set="he" t-value="child.get('he')"/>
                    <t t-set="him" t-value="child.get('him')"/>
                    <t t-set="month" t-value="child.get_date('birthdate', 'MMMM d')"/>
                    <t t-set="hold_gifts" t-value="child.get_hold_gifts()"/>
                    <t t-set="partner" t-value="object.partner_id"/>
                    <t t-set="already_paid" t-value="sponsorships.mapped('birthday_paid')"/>
                    <t t-set="send_gifts_to" t-value="sponsorships[:1] and sponsorships.mapped(sponsorships[0].send_gifts_to)[:1]"/>
                    <t t-set="does_write" t-value="partner == sponsorships[:1].correspondent_id and 23 not in partner.category_id.ids"/>
                    <t t-set="can_gift" t-value="not hold_gifts and not already_paid and send_gifts_to == partner"/>
                    <t t-set="mycompassion_url" t-value="'https://www.mycompassion.ch'"/>
                    <t t-set="gift_form_url" t-value="'https://compassion.ch/de/geschenkformular'"/>
                <p>
                    <t t-out="partner.salutation"/>,
                </p>
                <p>
                    It's <t t-out="firstname"/>'s birthday on <t t-out="month"/>.
                </p>
                <t t-if="len(child) == 1">
                    <p>
                        <t t-out="child.get('He')"/> will be <t t-out="child[:1].age + 1"/> years old this year.
                    </p>
                </t>
                <t t-if="does_write">
                    <p>
                        We invite you to write a few words of encouragement to <t t-out="him"/> online via <a t-att-href="mycompassion_url">MyCompassion</a>.
                    </p>
                    <p>
                        Imagine the joy when <t t-out="he"/> receives a letter from you!*
                    </p>
                </t>
                <t t-if="can_gift">
                    <p>
                        If you would also like to give <t t-out="firstname"/> a present, you can do so <t t-if="object.send_mode == 'physical'">using the attached payment slip or </t><a t-att-href="gift_form_url">online</a>.*
                    </p>
                </t>
                <p>
                    Thank you for making a difference in <t t-out="firstname"/>'s life.
                </p>
                <t t-if="does_write or can_gift">
                    <blockquote>
                        <small>*It is possible that this message crossed with your letter or donation.</small>
                    </blockquote>
                </t>
                <p>
                    Kind regards,
                </p>
                <t t-if="object.send_mode == 'digital'">
                    <p t-out="object.user_id.signature"/>
                </t>
            </field>
        </record>

