<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Compassion Communities - Welcome and payment information -->
    <record id="cc_welcome_template" model="mail.template">
        <field name="name">Compassion Communities - Welcome and payment information</field>
        <field name="model_id" ref="partner_communication.model_partner_communication_job" />
        <field name="email_from">"{{ object.user_id.company_id.name }}" &lt;compassion@compassion.ch&gt;</field>
        <field name="reply_to">info@compassion.ch</field>
        <field name="use_default_to" eval="True" />
        <field name="subject">Welcome to the Compassion family!</field>
        <field name="body_html" type="html">
            <p>
                {{ object.partner_id.salutation }},
                <br />
                <br />
                TODO: text of "Compassion Communities - Welcome and payment information".
            </p>
            <t t-if="object.send_mode == 'digital'">
                <p t-out="object.user_id.signature" />
            </t>
        </field>
    </record>
    <record id="cc_welcome_rule" model="partner.communication.config">
        <field name="name">Compassion Communities - Welcome and payment information</field>
        <field name="model_id" ref="model_recurring_contract" />
        <field name="email_template_id" ref="cc_welcome_template" />
        <field name="report_id" ref="report_compassion.report_partner_communication" />
        <field name="send_mode">digital</field>
        <field name="print_if_not_email">True</field>
        <field name="attachments_function">get_sponsorship_payment_slip_attachments</field>
    </record>

