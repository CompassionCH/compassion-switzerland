        name="name"
      >Many2Many Onboarding - Stop recurrent donation</field>
            <field name="model_id" ref="model_recurring_contract" />
            <field name="email_template_id" ref="m2m_stop_template" />
            <field name="send_mode">partner_preference</field>
        </record>
