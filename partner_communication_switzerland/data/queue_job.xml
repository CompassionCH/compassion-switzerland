    <record id="sponsorship_confirm_upgrade" model="queue.job.function">
        <field name="model_id" ref="model_recurring_contract" />
        <field name="method">confirm_upgrade</field>
        <field
      name="channel_id"
      ref="recurring_contract.channel_recurring_contract"
    />
    </record>
</odoo>
