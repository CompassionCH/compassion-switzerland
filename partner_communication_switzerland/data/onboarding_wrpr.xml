    <t t-set="survey" t-value="object.env.ref('partner_communication_switzerland.wrpr_onboarding_survey').public_url"/>
    <t t-set="my_url" t-value="'https://stage.compassion.ch/my/home' if partner.user_ids.login_date else partner.signup_url"/>
