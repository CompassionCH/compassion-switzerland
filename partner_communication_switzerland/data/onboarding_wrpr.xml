<odoo noupdate="1">
        <!-- Mail templates -->
    <record id="mail_wrpr_welcome" model="mail.template">
        <field name="name">Write&amp;Pray Onboarding - Welcome</field>
        <field name="subject">Write&amp;Pray Onboarding - Welcome</field>
        <field
        name="model_id"
        ref="partner_communication.model_partner_communication_job"
      />
        <field
        name="email_from"
      >"{{ object.user_id.company_id.with_context(lang=object.partner_id.lang).address_name }}" &lt;compassion@compassion.ch&gt;</field>
        <field name="reply_to">info@compassion.ch</field>
        <field name="use_default_to" eval="True" />
        <field name="body_html" type="html">
<div>
    <t t-set="partner" t-value="object.partner_id"/>
    <t t-set="sponsorships" t-value="object.get_objects()"/>
    <t t-set="plural" t-value="partner.title.plural or partner.title.id == 29"/>
    <t t-set="du" t-value="'ihr' if plural else 'du'"/>
    <t t-set="deine" t-value="'eure' if plural else 'deine'"/>
    <t t-set="firstname" t-value="sponsorships.mapped('child_id').get_list('preferred_name', 3, deine + 'n Patenkindern', False)"/>
    <t t-set="dir" t-value="'euch' if plural else 'dir'"/>
    <t t-set="dich" t-value="'euch' if plural else 'dich'"/>
 <t t-set="my_url" t-value="'https://stage.compassion.ch/im_livechat/support/2'"/>
</div>
<p>
    {{ partner.salutation }}
</p>
<p
        >So schön, {{ "ihr gehört" if plural else "du gehörst" }} nun zur weltweiten Compassion-Familie! Herzlich wilkommen!
</p>
<p>{{ "Erfahrt" if plural else "Erfahre" }} hier mehr dazu: <a
            href="https://vimeo.com/710323229/b9f3f472c5"
          >https://vimeo.com/710323229/b9f3f472c5</a>
</p><div>
<t t-if="sum(sponsorships.mapped('total_amount')) and partner in sponsorships.mapped('partner_id')">
    <p
          >Damit {{ "ihr eure" if plural else "du deine" }} Spende für die {{ sponsorships.get('Patenschaft') }} einrichten {{ "könnt, findet ihr" if plural else "kannst, findest du" }} hier den Einzahlungsschein: <a
              t-attf-href="https://stage.compassion.ch/report/pdf/report_compassion.single_bvr_sponsorship/{{ str(sponsorships[:1].id) }}"
            >Einzahlungsschein</a>
        <t t-if="partner.parent_consent == 'not_submitted'">
<br
            />und die Einverständniserklärung, die wir von {{ deine }}n Eltern unterschrieben benötigen:
<a
              href="https://stage.compassion.ch/partner_compassion/static/src/img/parental_consent_de_DE.pdf"
            >https://stage.compassion.ch/partner_compassion/static/src/img/parental_consent_de_DE.pdf</a>
         </t>
    </p>
</t>
</div><p
        >In den kommenden Tagen werden wir {{ dir }} weitere wichtige Informationen zum Start der {{ sponsorships.get('Patenschaft') }} per SMS zukommen lassen. Heute sind wir bei Schritt 1/8.
</p>
<p>Liebe Grüsse
<br />Sarah
<br />Tel: +41 (0)31 552 21 21
<br />Fragen? {{ "Meldet ihr" if plural else "Melde dich" }} per Chat bei uns: <a
            t-attf-href="{{ my_url }}"
          >{{ my_url }}</a>
</p>
        </field>
    </record>
