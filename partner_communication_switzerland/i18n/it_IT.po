#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.sms_confirmation_email_1
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    % set sponsorship = object.get_objects()\n"
"                    % set child = sponsorship.child_id\n"
"% set image_url = child.image_url.replace('media.ci.org/', 'media.ci.org/g_face,c_thumb,w_150,h_150,r_max/') if child.image_url else None\n"
"% set confirmation_url = \"/child/\" + str(child.id) + \"/sponsor/confirmation?face_reveal=1\"\n"
"                </div>\n"
"% if image_url:\n"
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;text-align:center;>\n"
"<img src=\">\n"
"</div>\n"
"% endif\n"
"                <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                  Hello!\n"
"                  </p>\n"
"                  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                   It's so wonderful that you wish to invest in the life of ${child.preferred_name}. ou will change ${child.get(\"his\")} life in a sustainable way.\n"
"                    <br><br>\n"
"                    <a href=\"${confirmation_url}\" style=\"background-color:transparent;color:#0055A6;text-decoration: underline;\">Click here</a> to complete your details.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    Best regards,\n"
"<br><br>\n"
" ${object.user_id.preferred_name} ${object.user_id.lastname}\n"
"   <br>\n"
"   ${object.user_id.employee_ids.department_id.name}\n"
"   <br>\n"
"   ${object.user_id.company_id.address_name}\n"
"                </p>\n"
"            "
msgstr ""
"<div>\n"
"   % set sponsorship = object.get_objects()\n"
"% set child = sponsorship.child_id\n"
"                    \n"
"% set image_url = child.image_url.replace('media.ci.org/', 'media.ci.org/g_face,c_thumb,w_150,h_150,r_max/') if child.image_url else None\n"
"  % set confirmation_url = \"/child/\" + str(child.id) + \"/sponsor/confirmation?face_reveal=1\"\n"
"  </div>\n"
"% if image_url:  \n"
"<div style=\"text-align: center;\">\n"
"   <img src=\"${image_url}\">\n"
"  </div>\n"
"% endif\n"
"  <h1 style=\"text-align: center; line-height: 1.2;\">\n"
"   Grazie per il tuo sostegno!\n"
"  </h1>\n"
"  <p>\n"
"   Ciao!\n"
"  </p>\n"
"  <p>\n"
"   È così bello che hai deciso di investire nella vita di ${child.preferred_name}. Farai una differenza duratura nella sua vita. \n"
"  </p>\n"
"  <p>\n"
"   <a href=\"${confirmation_url}\" style=\"color: #0055A6; text-decoration: underline;\">Clicca qui</a> per inserire i tuoi dati.\n"
"  </p>\n"
"  <p>\n"
"   Insieme, stiamo cambiando il mondo. Un bambino alla volta.\n"
"  </p>\n"
"  <p>\n"
"   A presto!\n"
"  </p>\n"
"  <p>\n"
"    ${object.user_id.short_signature | safe}\n"
"  </p>\n"
" "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_wrpr_child_info
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set firstname = sponsorships.mapped('child_id').get_list('preferred_name', 3, deine + 'n Patenkindern', False)\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set deine_patenkinder = 'deine Patenkinder' if not plural else 'eure Patenkinder'\n"
"    % set chat_url = \"https://mycompassion.ch/im_livechat/support/2\"\n"
"        % if partner.user_ids.login_date:\n"
"        % set my_url = \"https://mycompassion.ch/my/children\"\n"
"        % set chat_url = my_url\n"
"    % else:\n"
"        % if partner.email and not partner.signup_url:\n"
"            % if not partner.env[\"res.users\"].search_count([(\"login\", \"=\", partner.email)]):\n"
"                % set void = partner.env[\"res.partner.create.portal.wizard\"].with_context(active_ids=partner.ids).create({\"create_communication\": False}).button_create_portal_user()\n"
"            % endif\n"
"            % set void = partner.action_signup_prepare()\n"
"            % set void = partner.env.clear()\n"
"        % endif\n"
"        % set my_url = partner.signup_url or \"https://mycompassion.ch/web/signup\"\n"
"    % endif\n"
"</div>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"2/8:\n"
"<br>${partner.salutation}\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">Heute stellen wir ${dir} ${child.get_child_preposition_country(child_limit=3, country_limit=3, child_substitution=deine_patenkinder, country_substitution=deine_patenkinder)} besser vor.\n"
"</p><p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    % if not sponsorships.filtered(\"is_first_sponsorship\") and partner.user_ids:\n"
"Wie bisher ${\"werdet ihr\" if plural else \"wirst du\"} alle Informationen zu ${deine}r ${child.get('Patenschaft')} in MyCompassion finden: <a href=\"${my_url}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">${my_url}</a>\n"
"    % else:\n"
"${\"Registriert euch\" if plural else \"Registriere dich\"} dazu auf MyCompassion: <a href=\"${my_url}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">${my_url}</a>\n"
"    % endif\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">${\"Stellt euch\" if plural else \"Stell dir\"} einmal ${child.get('seine')} Herausforderungen und Träume vor und wie ${du} ${child.get('ihn')} darin ermutigen und unterstützen ${\"könnt\" if plural else \"kannst\"}.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">Danke, dass ${du} einen Unterschied im Leben von ${firstname} ${\"macht\" if plural else \"machst\"}.</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"Liebe Grüsse<br>\n"
"Sarah<br>\n"
"Tel: +41 (0)31 552 21 21<br>\n"
"Fragen? <a href=\"${chat_url}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">${chat_url}</a>\n"
"</p>\n"
"        "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set firstname = sponsorships.mapped('child_id').get_list('preferred_name', 0, False)\n"
"    % set chat_url = 'https://mycompassion.ch/fr_CH/im_livechat/support/3'\n"
"    % set delimiter = ' '\n"
"    % set country = child.get_child_preposition_country('from_preposition')\n"
"    % set idx = country.find('da')    \n"
"    % set country = country[idx:]\n"
"\n"
"    % if country[2:] in ('Ecuador', 'Etiopia', 'Indonesia'):\n"
"        % set country = country.replace(\"da\", \"dall'\")\n"
"    % elif country[2:] in ('Bangladesh', 'Brasile', 'Burkina Faso', 'Ghana', 'Guatemala'):\n"
"        % set country = country.replace(\"da\", \"dal \")\n"
"    % elif country[2:] in ('Bolivia', 'Colombia', 'Repubblica Dominicana'):\n"
"        % set country = country.replace(\"da\", \"dalla \")\n"
"    % elif country[2:] in ('Filippine'):\n"
"        % set country = country.replace(\"da\", \"dalle \")\n"
"    % else:\n"
"        % set country = country.replace(\"da\", \"da \")\n"
"    % endif \n"
"    % set country = (firstname + ' ' + country).strip()\n"
"\n"
"    % if child.gender == 'M':\n"
"        % set incoraggiarlo = 'incoraggiarlo'\n"
"        % set sostenerlo = 'sostenerlo'\n"
"    % else:\n"
"        % set incoraggiarlo = 'incoraggiarla'\n"
"        % set sostenerlo = 'sostenerla'\n"
"    % endif\n"
"\n"
"     % if partner.user_ids.login_date:\n"
"        % set my_url = \"https://mycompassion.ch/my/children\"\n"
"        % set chat_url = my_url\n"
"    % else:\n"
"        % if partner.email and not partner.signup_url:\n"
"            % if not partner.env[\"res.users\"].search_count([(\"login\", \"=\", partner.email)]):\n"
"                % set void = partner.env[\"res.partner.create.portal.wizard\"].with_context(active_ids=partner.ids).create({\"create_communication\": False}).button_create_portal_user()\n"
"            % endif\n"
"            % set void = partner.action_signup_prepare()\n"
"            % set void = partner.env.clear()\n"
"        % endif\n"
"        % set my_url = partner.signup_url or \"https://mycompassion.ch/web/signup\"\n"
"    % endif\n"
"\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Oggi ti presentiamo ${country}.\n"
"</p>\n"
"<p>\n"
"    Per farlo, registrati su MyCompassion: <a href=\"${my_url}\">${my_url}</a>\n"
"</p>\n"
"<p>\n"
"    Scopri le sue sfide e i suoi sogni e come puoi ${incoraggiarlo} e ${sostenerlo}.\n"
"</p>\n"
"<p>\n"
"    Grazie per aver fatto la differenza nella vita di ${firstname}.\n"
"<p>\n"
"<p>\n"
"    Buona giornata e a presto!<br>\n"
"    Il team di Compassion<br>\n"
"Tel: +41 (0)24 434 21 24<br>\n"
"Hai domande? WhatsApp: +41 (0)79 622 31 97\n"
"</p>\n"
"        "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_yearly_payment_slips
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set fully_managed = sponsorships.filtered('fully_managed')\n"
"    % set ns = namespace(correspondents = object.env['recurring.contract'])\n"
"   % set is_payer = partner in sponsorships.mapped(\"partner_id\")\n"
"\n"
"    % for s in sponsorships:\n"
"        % set gp = s.mapped(s.send_gifts_to)\n"
"\n"
"        % if gp == partner:\n"
"            % set ns.correspondents = ns.correspondents + s\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % set payers = partner.mapped('contracts_paid').intersect(sponsorships)\n"
"    % set payment_modes = sponsorships.mapped('payment_mode_id')\n"
"    % set bvr = payment_modes.intersect(object.env.ref('sponsorship_switzerland.payment_mode_bvr'))\n"
"    % set op = payment_modes.intersect(object.env.ref('sponsorship_switzerland.payment_mode_permanent_order'))\n"
"    % set months_paid = max(sponsorships.mapped('months_paid'))\n"
"    % set children = fully_managed.union(ns.correspondents).mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, 'many children', False)\n"
" % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | safe\n"
"\n"
"    % if payers and (bvr or op):\n"
"        % set children = fully_managed.union(ns.correspondents, payers).mapped('child_id')\n"
"    % endif\n"
"</div>\n"
"    % if object.send_mode == \"digital\":\n"
"        <img src=\"https://compassion.ch/medias/banners/CC-EC0534-MyLastDay-01-2506.jpg\" alt=\"merci pour votre soutien\" style=\"border-style:none;vertical-align:middle;display:block;margin: auto; margin-bottom: 60px; width: 100%; max-width: 600px; height: auto;\" width=\"600\" height=\"0\">\n"
"    % endif\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\"><b style=\"font-weight:bolder;\">We wish you and your loved ones a happy new year full of hope! </b></p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    <b style=\"font-weight:bolder;\">Thank you for choosing to invest in ${firstname}’s life.</b> Your commitment and support will have a lasting impact on ${children.get('his')} life and ${children.get('his')} loved ones, just as it did for Jennifer and so many other children in need.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Jennifer still remembers the very first time she walked into the Compassion child development center. “I was seven. I felt scared and shy. They served us a warm meal – rice, chicken, and lentils – and I can still remember its smell. From that moment on, I felt at home.”\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    But what changed her life wasn’t just hot meals and school supplies. It was  a caring community, the presence of the Church, and faith slowly taking root in her heart. Every day, the staff gently spoke truth over her life: “You are loved. You are precious. God has a purpose for you.”\n"
"% if object.send_mode == \"digital\":\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"% endif\n"
"    Today, Jennifer is studying family social work and has returned as a teacher to the very Compassion center that once welcomed her.\n"
"</p>\n"
"\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\"></p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"  <b style=\"font-weight:bolder;\">Attached you will find:</b>\n"
"</p>\n"
"<ul style=\"margin:0px 0 1rem 0;\">\n"
"    % if bvr and is_payer:\n"
"        <li>\n"
"            payment slips for your sponsorship for the year ${str(datetime.date.today().year+1)}\n"
"        </li>\n"
"    % endif\n"
"    <li>\n"
"        three additional slips per sponsored child, should you wish to bless them with a birthday gift, support ${firstname}’s family, or contribute to the child development center during the year ${str(datetime.date.today().year+1)}\n"
"    </li>\n"
"</ul>\n"
"   % if bvr and is_payer:\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    You also have the option to set up a standing order for your sponsorship contributions if you wish.\n"
"</p>\n"
"% endif\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Please note that any “gift” donations are entirely optional - there is absolutely no obligation. Your sponsorship alone is already a beautiful and generous gift! If you happen to misplace your payment slips or would like additional ones, please don’t hesitate to contact us at 031 552 21 25 or at info@compassion.ch.\n"
"% if object.send_mode == \"digital\":\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"% endif\n"
"    We remain at your disposal for any further questions regarding your sponsorship.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    <b style=\"font-weight:bolder;\">Thank you for being part of the Compassion family.</b> Your generosity, together with other sponsors and the work of more than ${number_fcps} child development centers in ${number_countries} countries, is bringing hope and encouragement to ${number_children} million children today.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   Wishing you a peaceful Advent season.\n"
"</p>\n"
"\n"
"% if object.send_mode == \"digital\":\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"        ${object.user_id.sudo().signature | safe}\n"
"    </p>\n"
"% endif"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29 or not partner.title\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tuoi = \"vostri\" if plural else \"tuoi\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"    % set sponsorships = object.get_objects()\n"
"    % set fully_managed = sponsorships.filtered('fully_managed')\n"
"    % set ns = namespace(correspondents = object.env['recurring.contract'])\n"
"   % set is_payer = partner in sponsorships.mapped(\"partner_id\")\n"
"\n"
"    % for s in sponsorships:\n"
"        % set gp = s.mapped(s.send_gifts_to)\n"
"        % if gp == partner:\n"
"            % set ns.correspondents = ns.correspondents + s\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % set payers = partner.mapped('contracts_paid').intersect(sponsorships)\n"
"    % set payment_modes = sponsorships.mapped('payment_mode_id')\n"
"    % set bvr = payment_modes.intersect(object.env.ref('sponsorship_switzerland.payment_mode_bvr'))\n"
"    % set op = payment_modes.intersect(object.env.ref('sponsorship_switzerland.payment_mode_permanent_order'))\n"
"    % set months_paid = max(sponsorships.mapped('months_paid'))\n"
"    % set children = fully_managed.union(ns.correspondents).mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, 'vostri figlioli', False)\n"
"\n"
"    % if payers and (bvr or op):\n"
"        % set children = fully_managed.union(ns.correspondents, payers).mapped('child_id')\n"
"    % endif\n"
"\n"
"    % set firstname = children.get_list('preferred_name', 3, 'vostri figlioli', False)\n"
"    % set number_years = object.env[\"partner.communication.job\"].get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.env[\"partner.communication.job\"].get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.env[\"partner.communication.job\"].get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.env[\"partner.communication.job\"].get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.env[\"partner.communication.job\"].get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.env[\"partner.communication.job\"].get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = object.env[\"partner.communication.job\"].get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"\n"
"    % if object.send_mode == \"digital\":\n"
"        <img src=\"https://compassion.ch/medias/banners/CC-EC0534-MyLastDay-01-2506.jpg\" alt=\"merci pour votre soutien\" style=\"display: block; margin: auto; margin-bottom: 60px; width: 100%; max-width: 600px; height: auto;\">\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>Auguriamo a ${te} e ai ${tuoi} cari un felice anno nuovo pieno di speranza!</p>\n"
"<p>\n"
"    <b>Grazie per aver scelto di investire nel migliorare la vita di ${firstname}.</b> Il tuo impegno e il tuo sostegno cambieranno per sempre la vita di ${firstname} e dei suoi cari, come è avvenuto per Jennifer e a tanti altri bambini bisognosi.\n"
"</p>\n"
"<p>\n"
"    Jennifer ricorda il suo primo giorno al centro di sviluppo infantile di Compassion: «Avevo sette anni. Ero spaventata e timida. Ci hanno servito un pasto caldo: riso, pollo e lenticchie - ne ricordo ancora il profumo. Fin dall'inizio mi sono sentita a casa\".\n"
"</p>\n"
"<p>\n"
"    Ciò che ha cambiato la sua vita non sono stati solo i pasti caldi e il materiale scolastico. È stata la comunità, la Chiesa e la fede che cresceva nel suo cuore. I collaboratori del centro glielo ricordavano ogni giorno: «Sei amata. Sei preziosa. Dio ha un piano per te».\n"
"% if object.send_mode == \"digital\":\n"
"</p>\n"
"<p>\n"
"% endif\n"
"    Oggi Jennifer studia assistenza sociale familiare e lavora come insegnante nel centro Compassion che lei stessa ha frequentato.\n"
"</p>\n"
"<p>\n"
"    <b>In allegato ${'troverete' if plural else 'troverai'}:</b>\n"
"</p>\n"
"<ul>\n"
"    % if bvr and is_payer:\n"
"        <li>\n"
"            i bollettini di versamento del ${tuo} sostegno a distanza per l’anno ${str(datetime.date.today().year)}.\n"
"        </li>\n"
"    % endif\n"
"    <li>\n"
"        tre bollettini di versamento per ogni bambino sostenuto, da utilizzare per eventuali regali di compleanno a ${firstname}, donazioni alla sua famiglia o al centro di sviluppo infantile per l'anno ${str(datetime.date.today().year)}.\n"
"    </li>\n"
"</ul>\n"
"    % if bvr and is_payer:\n"
"<p>\n"
"    Se lo desider${'ate, avete' if plural else 'i, hai'} anche la possibilità di impostare un ordine permanente per il contributo del sostegno.\n"
"</p>\n"
"% endif\n"
"<p>\n"
"    Il versamento delle donazioni «regalo» è facoltativo e non costituisce un obbligo. Il ${tuo} sostegno è già un dono meraviglioso! Se doves${'te' if plural else 'si'} smarrire i ${tuoi} bollettini di versamento o desideras${'te' if plural else 'si'} riceverne altri, non esita${'t' if plural else 'r'}e a contattarci al numero 031 552 21 24 o all’indirizzo e-mail info@compassion.ch.\n"
"% if object.send_mode == \"digital\":\n"
"</p>\n"
"<p>\n"
"% endif\n"
"    Rimaniamo a ${tua} disposizione per qualsiasi ulteriore domanda relativa al ${tuo} sostegno!\n"
"</p>\n"
"<p>\n"
"    Siamo grati che ${'facciate' if plural else 'tu faccia'} parte della famiglia di Compassion. Grazie a ${te}, agli altri sostenitori e agli oltre ${number_fcps} centri di sviluppo infantile presenti in ${number_countries} Paesi, attualmente ${number_children} milioni di bambini ricevono sostegno e incoraggiamento.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <div style=\"margin-top: 20px;\">\n"
"        ${object.user_id.sudo().signature | safe}\n"
"    </div>\n"
"% endif\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.csp_mail_template
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set contracts = object.get_objects()\n"
"                    \n"
"% set partner = object.partner_id\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you to support a child survival program from Compassion.\n"
"   <br>\n"
"   <br>\n"
"   From pregnancy through infanthood, Child Survival offers help that moms and babies desperately need to survive and thrive. More than 64,598 moms and babies have been helped to date! Through our Child Survival Centers, we ensure mothers and babies receive any of the following:\n"
"   <br>\n"
"  </p>\n"
"  <ul style=\"margin:0px 0 1rem 0;\">\n"
"   <li>\n"
"    Basic Nutrition in the form of clean water, healthy food and vitamins.\n"
"   </li>\n"
"   <li>\n"
"    Pre-natal and post-natal medical exams to monitor mom and baby’s health.\n"
"   </li>\n"
"   <li>\n"
"    Critical medical resources such as child birth assistance.\n"
"   </li>\n"
"   <li>\n"
"    Monthly growth monitoring to protect the children from malnutrition.\n"
"   </li>\n"
"   <li>\n"
"    Immunizations and other medical care for newborns and babies.\n"
"   </li>\n"
"   <li>\n"
"    Mentoring from a survival specialist that gives one-on-one coaching and support.\n"
"   </li>\n"
"   <li>\n"
"    Opportunities for infants to learn cognitive skills.\n"
"   </li>\n"
"   <li>\n"
"    Workshops that teach mothers parenting and survival skills.\n"
"   </li>\n"
"   <li>\n"
"    Home visits to check in on mother and baby.\n"
"   </li>\n"
"   <li>\n"
"    Emotional support from a community of moms facing the same fears.\n"
"   </li>\n"
"  </ul>\n"
"  Each Child Survival Center is staffed with warm, caring, knowledgeable individuals that serve mothers and babies extremely well. Your donations give children under 1 year old a head start toward a healthy life!\n"
"  <br>\n"
"  <br>\n"
"  There is no correspondence with the mothers, nevertheless you will receive a newsletter with information about the program and testimonies from mothers.\n"
"  <br>\n"
"  <br>\n"
"  Please do not hesitate to contact us if you have any questions.\n"
"  <br>\n"
"  <br>\n"
"  Sincerely\n"
" "
msgstr ""
"<div>\n"
"    % set new_contracts = object.get_objects()\n"
"    % set partner = object.partner_id\n"
"    % set contracts = partner.other_contract_ids\n"
"    % set sponsorships = partner.sponsorship_ids.filtered('is_active')\n"
"    % set plural = partner.title.plural or partner.title.id == 29 or not partner.title\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Grazie di cuore per aver deciso di sostenere il nostro programma di aiuto per mamme e neonati (CSP).\n"
"</p>\n"
"<p>\n"
"    Questo programma è progettato specificamente per le madri e i loro bambini, nonché per le donne incinte che vivono in condizioni di estrema povertà. Il programma fornisce sostegno per i loro bisogni fisici, economici e sociali prima e dopo il parto. Numerosi studi dimostrano che il primo anno di vita è cruciale nella vita di un bambino. Grazie al ${'vostro' if plural else 'tuo'} sostegno, neonati e madri beneficiano di:\n"
"</p>\n"
"<ul>\n"
"    <li>cibo e vitamine</li>\n"
"    <li>controlli medici prima e dopo il parto</li>\n"
"    <li>controlli mensili per prevenire la malnutrizione</li>\n"
"    <li>vaccinazioni e assistenza medica per i neonati (fino a un anno di età)</li>\n"
"    <li>accompagnamento spirituale e coaching per madri e donne incinte</li>\n"
"    <li>sostegno allo sviluppo cognitivo dei bambini</li>\n"
"    <li>laboratori educativi per le madri</li>\n"
"    <li>incoraggiamento da parte di altre madri</li>\n"
"    <li>visite a domicilio</li>\n"
"</ul>\n"
"<p>\n"
"    ${'Vi' if plural else 'Ti'} ringraziamo per la ${'vostra' if plural else 'tua'} generosità. Grazie a ${'voi' if plural else 'te'}, possiamo fare tutto il possibile per garantire a questi bambini un buon inizio di vita: una fonte di speranza e conforto per tante madri in difficoltà.\n"
"</p>\n"
"<p>\n"
"    Siamo a disposizione per qualsiasi domanda su questo programma.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_anniversary_5
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"Congratulations! It’s been 5 years since you’ve been supporting ${firstname}! On behalf of the entire team at Compassion Switzerland, we would like to thank you for your commitment to a child in extreme poverty.\n"
"   <br>\n"
"   <br>\n"
"   Your sponsorship has a great impact on the development of this child. It enables ${child.get('him')} to live a life without extreme poverty but with dignity and real hope. ${firstname} is one of 2,3 million children currently supported by Compassion’s sponsorship program. Thank you for working together with us.\n"
"   <br>\n"
"   <br>\n"
"   Yours sincerely.\n"
"   <br>\n"
"  </p>\n"
" % if object.send_mode == 'digital':\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"    % set sponsorships = object.get_objects()       \n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"</p>\n"
"<p>\n"
"    Siamo arrivati a 5 anni! Super!\n"
"</p>\n"
"<p>\n"
"    Negli ultimi 5 anni, ${\"avete\" if plural else \"hai\"} sostenuto ${firstname} e ${\"avete\" if plural else \"hai\"} contribuito a far${child.get(\"lo\")} uscire dalla povertà estrema. Ogni giorno un pochino di più.\n"
"</p>\n"
"<p>\n"
"    Sostenendo ${firstname}, ${\"state\" if plural else \"stai\"} dandon${child.get(\"gli\")} anche il coraggio di avere dei sogni e perseguirli.\n"
"</p>\n"
"<p>\n"
"    Grazie per la ${tua} preziosa fedeltà. ${firstname} è uno degli oltre ${number_children} milioni di bambini attualmente supportati da un sostenitore di Compassion. Insieme stiamo cambiando il mondo! Un bambino alla volta.\n"
"</p>\n"
"<p>\n"
"    Infinitamente Grazie!\n"
"</p>\n"
" "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.compassion_reset_password_email
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"% set partner = object.get_objects()\n"
"% set link = str(partner.signup_url).replace('erp.compassion', 'mycompassion')\n"
"  </div>\n"
"<p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Dear ${partner.preferred_name},\n"
"<br>\n"
"<br>\n"
"    You have requested a new password for your Compassion Account. You may change your password by following this link which will remain valid during 24 hours:\n"
"   </p>\n"
"   <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: rgb(119, 119, 119); text-align: center; margin-top: 16px;\">\n"
"    <a href=\"${link}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);padding: 5px 10px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#875A7B; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius:3px\">\n"
"     Change password\n"
"    </a>\n"
"   </div>\n"
"<br>\n"
"<br>\n"
"   <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    If you do not expect this, you can safely ignore this email.\n"
"<br>\n"
"<br>\n"
"     Thank you for your committed effort in the fight against extreme poverty. Please feel free to contact us if you have any questions.\n"
"     <br>\n"
"<br>\n"
"    Best Regards,\n"
"   <br>\n"
"<br>\n"
"    Compassion Switzerland\n"
"   </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.get_objects()\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set link = str(partner.signup_url).replace('erp.compassion', 'mycompassion')\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Abbiamo ricevuto una richiesta di reimpostazione della ${'vostra' if plural else 'tua'} password.\n"
"</p>\n"
"<p>\n"
"    ${'Potete' if plural else 'Puoi'} cambiare la ${'vostra' if plural else 'tua'} password cliccando su questo link, che rimarrà valido per 24 ore:\n"
"</p>\n"
"<div style=\"text-align: center; margin-top: 16px; text-transform: uppercase\">\n"
"    <a href=\"${link}\" style=\"padding: 5px 10px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\">\n"
"        Cambia password\n"
"    </a>\n"
"</div>\n"
"<p>\n"
"    Grazie mille per la ${'vostra' if plural else 'tua'} partecipazione alla lotta contro la povertà estrema. Non esita${'t' if plural else 'r'}e contattarci se ${'avete' if plural else 'hai'} domande.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.auto_reminder_archive_partners_template
msgid ""
"<div>\n"
"                    <b>The following partners meet the criteria (see <a href=\"/web#action=521&amp;active_id=895&amp;cids=1&amp;id=600&amp;menu_id=2029&amp;model=project.task&amp;view_type=form\">T0024</a>) and are considered invalid : </b>\n"
"                    <span style=\"font-family: 'miller';\">\n"
"                    % for partner in ctx.get('partners_to_archive'):\n"
"                        <p><a href=\"/web#id=${partner.id}&amp;model=res.partner&amp;view_type=form\">Ref ${partner.ref} - ${partner.name}</a></p>\n"
"                    % endfor\n"
"                    </span>\n"
"                </div>\n"
"            "
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.old_letter
msgid ""
"<div>\n"
"    % set letter = object.get_objects()\n"
"    letter: ${letter}<br><br>\n"
"    % set cetteLettre = 'cette lettre' if len(letter) == 1 else 'ces lettres'\n"
"    cetteLettre: ${cetteLettre}\n"
"    % set uneLettre = 'une lettre' if len(letter) == 1 else 'des lettres'\n"
"    % set child = letter.mapped('child_id')\n"
"    % set partner = object.partner_id\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set urls = []\n"
"\n"
"    % for l in letter.filtered('read_url').mapped('read_url'):\n"
"        % if l not in urls:\n"
"            % set void = urls.append(l)\n"
"        % endif \n"
"    % endfor\n"
"\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/fr_CH/im_livechat/support/3\"\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"\n"
"% if object.send_mode == \"sms\":\n"
"    <p>\n"
"        ${partner.informal_salutation},\n"
"    </p>\n"
"    <p>\n"
"        Nous sommes heureux de t'envoyer la nouvelle lettre de ${child.get('preferred_name', translate=False)}!\n"
"    </p>\n"
"    <p>\n"
"        Clique ici pour télécharger la lettre: <a href=\"${urls[0]}\">Lettre</a>\n"
"    </p>\n"
"    <p>\n"
"        Bonne lecture!\n"
"    </p>\n"
"    <p>\n"
"        Si tu as cinq minutes, pourrais-tu directement répondre à cette lettre? Clique simplement ici: <a href=\"https://mycompassion.ch/fr_CH/my/letter\">MyCompassion</a>\n"
"    </p>\n"
"    <p>\n"
"        Merci et à bientôt!\n"
"    </p>\n"
"    <p>\n"
"        L'équipe de Compassion\n"
"        <br/>Tel: +41 (0)24 434 21 24\n"
"        <br/>Des questions? Écris-nous sur WhatsApp: +41 (0)79 622 31 97\n"
"    </p>\n"
"% else:  \n"
"    <p>\n"
"        ${object.partner_id.salutation},\n"
"    </p>\n"
"    <p>\n"
"        C'est avec joie que nous vous adressons ${uneLettre} de ${child.get_list('preferred_name', 3, child.get_number(), False)} ! Comme vous le constaterez, ${\"cette lettre n'est\" if len(letter) == 1 else \"ces lettres ne sont\"} pas toute récente${child.get('accord_s')}, la faute à un problème technique survenu lors de la transmission. Toutes nos excuses pour ce désagrément.\n"
"    </p>\n"
"    <p>\n"
"        % if object.send_mode == 'digital':\n"
"            Cliquez sur le lien pour télécharger ${cetteLettre}*. Nous vous souhaitons beaucoup de plaisir à la lecture des nouvelles de ${child.get_list('preferred_name', 3, child.get_number(), False)}\n"
"            </p>\n"
"            <ul>\n"
"                % for l in urls:\n"
"                    <li>\n"
"                        <a href=\"${l}\">\n"
"                            ${l}\n"
"                        </a>\n"
"                    </li>\n"
"                % endfor\n"
"                </ul>\n"
"            <p>\n"
"        % endif\n"
"    \n"
"        ${years_uc} ${number_years} ans d'expérience montrent que ces lettres peuvent contribuer de façon déterminante au développement de l'enfant.\n"
"    </p>\n"
"    <p>\n"
"        D'avance, merci de prendre quelques minutes pour répondre ${'au courrier ci-joint' if len(child) == 1 else 'aux courriers ci-joints'}, avec quelques paroles d'encouragement à ${child.get_list('preferred_name', 3, child.get_number(), False)}. Vous pouvez lui écrire\n"
"        <a href=\"https://mycompassion.ch\">en ligne</a>.\n"
"    </p>\n"
"    <p>\n"
"        N'hésitez pas à prendre contact avec nous pour toute question relative aux échanges de courriers !\n"
"    </p>\n"
"    <p>\n"
"        Merci de transformer la vie ${'d'un enfant' if len(child) == 1 else 'de plusieurs enfants et de les'} et de le libérer de l'extrême pauvreté pour une vie digne et qui ait du sens.\n"
"    </p>\n"
"    <p>\n"
"        Avec nos chaleureuses salutations.\n"
"    </p>\n"
"    <p>\n"
"        % if object.send_mode == 'digital':\n"
"            </p>\n"
"            <p>\n"
"                ${object.sudo().user_id.signature | safe}\n"
"        % endif\n"
"    </p>\n"
"    <p>\n"
"        *En cas de problème pour ouvrir une ou plusieurs lettres, vous pouvez aussi les télécharger depuis votre compte MyCompassion.\n"
"    </p>\n"
"% endif"
msgstr ""
"<div>\n"
"    % set letter = object.get_objects()\n"
"    % set one_letter = len(letter) == 1\n"
"    % set child = letter.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set firstname = child.get_list('preferred_name', 3, 'vostri figlioli', False)\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set urls = []\n"
"\n"
"    % for l in letter.filtered('read_url').mapped('read_url'):\n"
"        % if l not in urls:\n"
"            % set void = urls.append(l)\n"
"        % endif \n"
"    % endfor \n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"\n"
"% if object.send_mode == \"sms\":\n"
"    <p>\n"
"        ${object.partner_id.informal_salutation},\n"
"    </p>\n"
"    <p>\n"
"        Siamo felici di inviarti la nuova lettera di ${firstname}!\n"
"    </p>\n"
"    <p>\n"
"        Clicca qui per scaricarla. <a href=\"${urls[0]}\">link</a>\n"
"    </p>\n"
"    <p>\n"
"        Buona lettura!\n"
"    </p>\n"
"    <p>\n"
"       Se ${'avete' if plural else 'hai'} qualche minuto di tempo, ${'potreste' if plural else 'potresti'} rispondere direttamente a questa lettera? ${'Cliccate' if plural else 'Clicca'} qui: <a href=\"https://mycompassion.ch/it_IT/my/letter\">MyCompassion</a>\n"
"    </p>\n"
"    <p>\n"
"        Grazie e a presto!\n"
"    </p>\n"
"    <p>\n"
"        ${whatsapp_signature}\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        ${object.partner_id.salutation},\n"
"    </p>\n"
"    <p>\n"
"        Siamo felici di inviar${'vi' if plural else 'ti'} ${'una lettera' if one_letter else 'alcune lettere'} di ${firstname}! Come ${'noterete' if plural else 'noterai'}, ${'questa lettera non è molto recente' if one_letter else 'queste lettere non sono molto recenti'}; purtroppo, a causa di un problema tecnico, non è stato possibile consegnarl${'a' if one_letter else 'e'} prima. Ci dispiace per l'inconveniente.\n"
"    </p>\n"
"\n"
"    % if object.send_mode == 'digital':\n"
"        <p>\n"
"            ${'Cliccate' if plural else 'Clicca'} sul link per ${'scaricarla' if one_letter else 'scaricarle'}*. ${'Vi' if plural else 'Ti'} auguriamo di leggerl${'a' if one_letter else 'e'} con piacere.\n"
"        </p>\n"
"        <ul>\n"
"            % for l in urls:\n"
"                <li>\n"
"                    <a href=\"${l}\">${l}</a>\n"
"                </li>\n"
"            % endfor\n"
"        </ul>\n"
"    % endif\n"
"\n"
"    <p>\n"
"        Oltre ${number_years} anni di esperienza dimostrano che lo scambio di lettere può contribuire in modo decisivo allo sviluppo dei bambini.\n"
"    </p>\n"
"    <p>\n"
"        ${'Vi' if plural else 'Ti'} invitiamo a dedicare qualche minuto per rispondere a ${'questa lettera' if one_letter else 'queste lettere'}, con parole di incoraggiamento per ${firstname}. ${'Potete' if plural else 'Puoi'} scriver${'gli' if partner.gender == 'M' else 'le'} online\n"
"        <a href=\"https://compassion.ch/it/scrivere/\">compassion.ch/it/scrivere/</a>\n"
"    </p>\n"
"    <p>\n"
"        Non ${'esitate' if plural else 'esitare'} a contattarci per qualsiasi domanda sulla corrispondenza!\n"
"    </p>\n"
"    <p>\n"
"        Grazie per il ${'vostro' if plural else 'tuo'} contributo nel trasformare la vita di un bambino e liberarlo dalla povertà estrema, così che possa vivere una vita dignitosa e piena di senso.\n"
"    </p>\n"
"    <p>\n"
"        Cari saluti,\n"
"    </p>\n"
"\n"
"    % if object.send_mode == 'digital':\n"
"        <p>\n"
"            ${object.sudo().user_id.signature | safe}\n"
"        </p>\n"
"        <p>\n"
"            *Se ${'avete' if plural else 'hai'} difficoltà ad aprire ${'la lettera' if one_letter else 'le lettere'}, ${'potete' if plural else 'puoi'} anche scaricarl${'a' if one_letter else 'e'} dal ${'vostro' if plural else 'tuo'} account MyCompassion.\n"
"        </p>\n"
"    % endif\n"
"% endif\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_new_labels
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set child = object.get_objects().mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, 'your sponsored children', False)\n"
"    % if len(child) == 1:\n"
"        % set anewsheet = 'a new sheet'\n"
"        % set child = 'child'\n"
"    % else:\n"
"        % set anewsheet = 'the new sheets'\n"
"        % set child = 'children'\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you for investing into the life of ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Please find enclosed ${anewsheet} of labels for the letters you wish to send by post.\n"
"</p>\n"
"<p>\n"
"    Do you know that you can write your letters easily in your <a href='https://www.mycompassion.ch'>MyCompassion profile</a>? With it, you always have the pictures, letters and information of your ${child} at hand.\n"
"</p>\n"
"<p>\n"
"    Enjoy writing!\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set male = partner.gender == 'M'\n"
"    % set child = object.get_objects().mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set boy = child.gender == 'M'\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Grazie per aver investito nel migliorare la vita di ${firstname}.\n"
"</p>\n"
"<p>\n"
"    In allegato ${'troverete' if plural else 'troverai'} un nuovo set di etichette per la corrispondenza con ${'lui' if boy else 'lei'}. ${'Ricordate' if plural else 'Ricorda'} di attaccare un'etichetta su ogni elemento della spedizione (lettera, cartolina, adesivi, disegni, ecc.) destinato a ${firstname}.\n"
"</p>\n"
"<p>\n"
"    ${'Potete' if plural else 'Puoi'} anche scriver${'gli' if boy else 'le'} da www.mycompassion.ch.\n"
"</p>\n"
"<p>\n"
"    Siamo a disposizione per qualsiasi domanda.\n"
"</p>\n"
"<p>\n"
"    Buona scrittura!\n"
"</p>\n"
"<p>\n"
"    Cari saluti e a presto,\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_sponsorship_confirmation_not_read
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set child = object.get_objects().mapped('child_id')\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    We recently sent you an email to ${partner.email}, which doesn't seem to have reached you. Could you please let us know if you have a different email address. If our email went to the spam folder, could you please add compassion@compassion.ch to your address book? This way you will receive all the important information about ${child.get('your sponsored child')} in the future.\n"
"</p>\n"
"<p>\n"
"    Below is the communication we sent you:\n"
"</p>\n"
"<span>\n"
"    ${object.env.ref('partner_communication_switzerland.mail_onboarding_sponsorship_confirmation').generate_email(object.id, ['body_html'])['body_html'].replace(partner.salutation, '').strip().replace('&lt;p&gt;&lt;/p&gt;', '') | safe}\n"
"</span>\n"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"\n"
"    % if plural:\n"
"        % set benvenuto =  \"Benvenuti \" + partner.firstname or partner.name + \"!\"\n"
"    % else:\n"
"        % set benvenuto = (\"Benvenuta \" if partner.gender == \"F\" else \"Benvenuto \") + partner.firstname + \"!\"\n"
"    % endif\n"
"\n"
"    % if len(child) == 1:\n"
"        % set sul_bambino = (\"sulla bambina\" if partner.gender == \"F\" else \"sul bambino \")\n"
"    % else:\n"
"        % set sul_bambino = 'sui bambini'\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Di recente ${ti} abbiamo inviato un'e-mail all'indirizzo ${partner.email}, che sembra ${tu} non ${'abbiate' if plural else 'abbia'} ricevuto. ${'Potreste' if plural else 'Potresti'} verificare se è arrivata nella ${tua} cartella spam, ed eventualmente aggiungere compassion@compassion.ch alla ${tua} rubrica oppure inviarci un altro indirizzo?\n"
"</p>\n"
"<p>\n"
"    In questo modo, in futuro ${'potrete' if plural else 'potrai'} ricevere tutte le informazioni importanti ${sul_bambino} che ${'sostenete' if plural else 'sostieni'}.\n"
"</p>\n"
"<p>\n"
"    Ecco cosa ${ti} abbiamo scritto:\n"
"</p>\n"
"<span>\n"
"    ${object.env.ref('partner_communication_switzerland.mail_onboarding_sponsorship_confirmation').generate_email(object.id, ['body_html'])['body_html'].replace(benvenuto, '').strip().replace('&lt;p&gt;&lt;/p&gt;', '') | safe}\n"
"</span>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_wrpr_reminder
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set children = object.get_objects().mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29 or not partner.title.id\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    A few months ago, you decided to support ${firstname} through our “Write & Pray” sponsorship.\n"
"</p>\n"
"<p>\n"
"    The special feature of a “Write & Pray” sponsorship is teamwork.\n"
"</p>\n"
"<p>\n"
"    You are known to ${firstname} as ${children.get('his')} ${'sponsors' if plural else 'sponsor'}. Another donor regularly provides the financial support for this type of sponsorship.\n"
"</p>\n"
"<p>\n"
"    We are counting on you to pray for ${children.get('him')} and write to ${children.get('him')} at least twice a year.\n"
"</p>\n"
"<p>\n"
"    So far, our records indicate that ${firstname} ${'has' if len(children) == 1 else 'have'} not received a letter from you.\n"
"</p>\n"
"<p>\n"
"    Thank you for taking a few minutes of your time to write a letter to ${children.get('him')}, online via <a href=\"https://mycompassion.ch/my/letter\">MyCompassion</a>.\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.signature | safe}\n"
"</p>"
msgstr ""
"<div>\n"
"   % set partner = object.partner_id\n"
"\n"
"    % set sponsorships = object.get_objects()\n"
"\n"
"    % set child = sponsorships.mapped('child_id')\n"
"\n"
"    % set young = True\n"
"\n"
"    % if partner.title.plural:\n"
"\n"
"        % set le_parrain = 'die Paten'\n"
"        % set young = False\n"
"\n"
"    % endif\n"
"\n"
"    % set te = 'te' if young else 'voi'\n"
"  </div>\n"
"  <p>\n"
"   ${(partner.get('salutation').title() + ' ' + partner.preferred_name) if young else partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Qualche mese fa, ${\"ti sei impegnat\" + partner.get('accord_o_a') if young else \"vi siete impegnati\"} a sostenere ${child.get_list('preferred_name', translate=False)} grazie al nostro programma di sostegno «Write & Pray».\n"
"   <br>\n"
"   <br>\n"
"   La particolarità del sostegno «Write & Pray» è il lavoro di squadra. ${\"Tu sei il sostenitore\" if young else \"Voi siete i sostenitori\"} in contatto con ${child.get_list('preferred_name', translate=False)}.  Contiamo su di ${te} per pregare per ${child.get('lui')} e scrivere${child.get('gli')} almeno due volte l'anno. Un altro donatore fornisce supporto finanziario per questo sostegno.\n"
"   <br>\n"
"   <br>\n"
"   Fino ad oggi ${child.get_list('preferred_name', translate=False)} non ha ricevuto nessuna letterina. Contiamo su di ${te}! Grazie di prendere 5 minuti per scrivere oggi, ${\"puoi\" if young else \"potete\"} farlo direttamente online: https://compassion.ch/it/scrivere/\n"
"   <br>\n"
"   <br>\n"
"   Una lettera può fare la differenza. Ronnie, ad esempio, è cresciuto in una baraccopoli in Uganda. Quando in una delle sue lettere la sua sostenitrice inglese gli ha chiesto quale lavoro avesse voluto fare da grande, Ronnie non sapeva neanche cosa significasse la parola «lavoro». Grazie alle spiegazioni dello staff del centro compassion,  all'incoraggiamento e alla fiducia mostrate dalla sua sostenitrice nelle sue lettere, grazie al suo lavoro a scuola, Ronnie ha brillantemente completato la sua istruzione. In grado di entrare nella scuola di ingegneria, si è diplomato pochi anni dopo.\n"
"   <br>\n"
"   <br>\n"
"   Scrivere e pregare: grazie per aver preso seriamente questa missione, così come il donatore che fornisce fedelmente supporto per ${child.get_list('preferred_name', translate=False)}.\n"
"   <br>\n"
"   <br>\n"
"   Ancora una volta, grazie di investire nella vita di questo bambino che vive in estrema povertà.\n"
"   <br>\n"
"   <br>\n"
"   Con i nostri migliori saluti.\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"       ${object.user_id.short_signature | safe}\n"
"% endif\n"
"  </p>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.wrpr_transformation_fail
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set children = object.get_objects().mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', translate=False)\n"
"    % set reminder = object.search([(\"config_id\", \"=\", object.config_id.id), (\"partner_id\", \"=\", partner.id), (\"state\", \"=\", \"done\")])\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>Unfortunately, we have not received any feedback from you and will have to cancel the sponsorship for ${firstname}.\n"
"</p>\n"
"<p>We will now look for another sponsor for ${firstname}.\n"
"</p>\n"
"<p>\n"
"</p>\n"
"<p>Have you changed your mind? Then let us know as soon as possible and increase your sponsorship contribution to CHF 42:\n"
"<a href=\"https://mycompassion.ch/my/donations\">link</a>\n"
"</p>\n"
"<p>The joy of ${firstname} will be enormous!</p>\n"
"        "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set children = object.get_objects().mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', translate=False)\n"
"    % set reminder = object.search([(\"config_id\", \"=\", object.config_id.id), (\"partner_id\", \"=\", partner.id), (\"state\", \"=\", \"done\")])\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Purtroppo non abbiamo ricevuto risposta e siamo costretti ad annullare il sostegno di ${firstname}.\n"
"</p>\n"
"<p>Cercheremo un altro sostenitore per ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Hai cambiato idea? Faccelo sapere e aumenta il tuo contributo a 42 CHF: <a href='https://mycompassion.ch/it_IT/my/donations'>link</a>\n"
"</p>\n"
"<p>\n"
"    La gioia di ${firstname} sarà immensa!\n"
"</p>\n"
"<p>\n"
"    Buona giornata e a presto!\n"
"</p>\n"
"<p>\n"
"    Il team di Compassion\n"
"</p>"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.tax_receipt_letter_template
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set tax_year = 2024\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Last year:\n"
"</p>\n"
"<ul>\n"
"    <li>more children living in extreme poverty were sponsored from Switzerland</li>\n"
"    <li>more mothers and babies received vital support</li>\n"
"    <li>more young people were able to start vocational training</li>\n"
"    <li>more children received a present at Christmas*</li>\n"
"    <li>many families received food supplies</li>\n"
"    <li>and many children now have access to safe toilets</li>\n"
"</ul>\n"
"<p>\n"
"    thanks in no small part to your generosity and loyalty!\n"
"</p>\n"
"<p>\n"
"    Thank you from the bottom of our hearts!\n"
"</p>\n"
"<h4>Tax Receipt ${tax_year}</h4>\n"
"<p>\n"
"    We are grateful to send you the enclosed tax certificate for the donations you have made to Compassion in\n"
"    ${tax_year}. You can deduct 100% of this amount from your tax return in any Swiss canton.\n"
"</p>\n"
"<h4>Your real impact</h4>\n"
"<p>\n"
"    Discover the impact of the friends of Compassion Switzerland in ${tax_year} in the fight against extreme poverty.\n"
"    .. which is partly yours too!\n"
"</p>\n"
"<p>\n"
"    (Available in French or German)\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <div style=\"display: flex; margin:40px;text-align: center;\">\n"
"        <div style=\"flex: 1;\">\n"
"            <a href=\"https://compassion.ch/activite2024\" style=\"padding: 12px 18px; font-size: 16px; line-height: 18px;\n"
"            color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">votre impact en ${tax_year}</a>\n"
"        </div>\n"
"        &nbsp;&nbsp;&nbsp;\n"
"        <div style=\"flex: 1;\">\n"
"            <a href=\"https://compassion.ch/de/aktivitat2024\" style=\"padding: 12px 18px; font-size: 16px; line-height:\n"
"             18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"                Deine Wirkung in ${tax_year}\n"
"            </a>\n"
"        </div>\n"
"    </div>\n"
"% else:\n"
"    <p>\n"
"        en français: impact.compassion.ch\n"
"        <br>\n"
"        auf Deutsch: impact.compassion.ch/de\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Thank you, once again, for your faithful commitment to fighting the injustice of extreme poverty. Together, you\n"
"    and other sponsors, donors and more than ${number_fcps} child development centres in ${number_countries} countries\n"
"    of the Global South are working to bring hope to an ever increasing number of children and families in need.\n"
"</p>\n"
"<p>\n"
"    Have a happy New Year, all the best and warm regards.\n"
"</p>\n"
"% if object.send_mode == 'digital':\n"
"    <p>${object.user_id.short_signature | safe}</p>\n"
"% endif\n"
"\n"
"<p style=\"font-size:10px\">\n"
"    * (The cost per gift has been revised downwards, from the CHF 15.- announced in our communications to CHF 12.60. 100% of your donation was invested in the gifts)\n"
"</p>\n"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"     % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set ti = 'vi' if plural else 'ti'\n"
"    % set Scopri = 'Scoprite' if plural else 'Scopri'\n"
"    % set tuo = 'vostro' if plural else 'tuo'\n"
"    % set tua = 'vostra' if plural else 'tua'\n"
"    % set inviarti = 'inviarvi' if plural else 'inviartiti'\n"
"    % set te = 'voi' if plural else 'te'\n"
"    % set hai = 'avete' if plural else 'hai'\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set major_donor = 18454 in partner.category_id.ids\n"
"    % set tax_year = 2025\n"
"</div>\n"
"<p>\n"
"        ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Nel corso del ${tax_year} abbiamo realizzato molte cose insieme:\n"
"</p>\n"
"<ul>\n"
"    <li>4066 bambini in più hanno beneficiato di un sostegno dalla Svizzera</li>\n"
"    <li>1.759 mamme e i loro bambini hanno ricevuto un sostegno vitale</li>\n"
"    <li>100 posti di formazione professionale sono stati finanziati dagli amici di Compassion Svizzera</li>\n"
"    <li>34.775 bambini hanno ricevuto un regalo a Natale</li>\n"
"    <li>4.886 famiglie hanno ricevuto scorte alimentari</li>\n"
"    <li>3.765 bambini hanno ora accesso a servizi igienici sicuri</li>\n"
"</ul>\n"
"<p style=\"${'margin-bottom: 40px' if object.send_mode == 'digital' else ''}\">\n"
"${ti.title()} ringraziamo di cuore per la ${tua} generosità e fedeltà!\n"
"</p>\n"
"<h4>La ${tua} ricevuta fiscale ${tax_year}</h4>\n"
"<p>\n"
"    È con grande gioia che ${ti} inviamo in allegato la ricevuta fiscale delle donazioni che ${hai} versato a Compassion nel ${tax_year}. ${\"Potete\" if plural else \"Puoi\"} dedurre il 100% di questo importo dalla ${tua} dichiarazione dei redditi in tutti i cantoni svizzeri.\n"
"</p>\n"
"<h4>Tutto inizia con un sì</h4>\n"
"<p>Il ${tuo} contributo a favore di Compassion nella lotta contro l'estrema povertà è probabilmente iniziato con un “sì” e per questo ${ti} siamo profondamente grati. Quel “sì” ha un impatto duraturo sui beneficiari di Compassion e sui nostri programmi. ${ti.title()} invitiamo a scoprire di più nel nostro rapporto annuale.\n"
"</p>\n"
"% if object.send_mode == 'digital':\n"
"    <div style=\"margin:40px auto; text-align: center;\">\n"
"        <a href=\"https://compassion.ch/it/attivita-${tax_year}\" style=\"padding: 12px 18px; font-size: 16px; line-height: 18px; color: #FFFFFF; border-color:#2A5EEC; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #2A5EEC; border: 1px solid #2A5EEC; border-radius:3px\" title=\"\">\n"
"            Il ${tuo} impatto nel ${tax_year}\n"
"        </a>\n"
"    </div>\n"
"% else:\n"
"    <p>\n"
"        Il ${tuo} impatto nel ${tax_year} : https://compassion.ch/it/attivita-${tax_year}\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Grazie ancora per il ${tuo} fedele impegno al nostro fianco nella lotta contro l'ingiustizia della povertà estrema. Insieme a ${te} e ad altri sostenitori, donatori e agli oltre ${number_fcps} centri di sviluppo infantile presenti nei Paesi del Sud, acciamo tutto il possibile per offrire prospettive di speranza a un numero sempre maggiore di bambini e famiglie in difficoltà.\n"
"</p>\n"
"<p>\n"
"    ${ti.title()} auguriamo un felice anno nuovo. Cari saluti e a presto,\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <p>${object.user_id.short_signature | safe}</p>\n"
"% endif"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step5
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorship = partner.sponsorship_ids\n"
"    % set child = sponsorship.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set one_child = len(child) == 1\n"
"    % set less_4 = firstname != child.get_number()\n"
"    % set translator = False\n"
"    % set event = False\n"
"    % set base_url = object.env['ir.config_parameter'].get_param('web.external.url')\n"
"\n"
"    % for engagement in partner.advocate_details_id.engagement_ids:\n"
"        % if engagement.id == 2:\n"
"            % set translator = True\n"
"        % endif\n"
"\n"
"        % if engagement.id in (1,3,9):\n"
"            % set event = True\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % set number_years = object.env[\"partner.communication.job\"].get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.env[\"partner.communication.job\"].get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.env[\"partner.communication.job\"].get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.env[\"partner.communication.job\"].get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.env[\"partner.communication.job\"].get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.env[\"partner.communication.job\"].get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = object.env[\"partner.communication.job\"].get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"<p>\n"
"    % if sponsorship.mapped('invoice_line_ids').filtered('last_payment') or 0 in sponsorship.mapped('total_amount'):\n"
"        Congratulations, your ${'sponsorship has' if one_child else 'sponsorships have'} started well! The good news has reached ${firstname if less_4 else 'your sponsored children'} and ${child.get('his')} ${'family' if one_child else 'families'}.\n"
"    % endif\n"
"    This is the final email you will receive from us concerning the start of your sponsorship.\n"
"</p>\n"
"<p>\n"
"    Your feedback regarding the start of your sponsorship${'s' if not one_child} is important to us. It should only take 60 seconds.\n"
"</p>\n"
"<div style=\"margin:30px auto;text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"${base_url + object.env.ref('partner_communication_switzerland.onboarding_survey').get_start_url()}\"\n"
"       style=\"padding:12px 18px;font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\">\n"
"        Take part in the questionnaire\n"
"    </a>\n"
"</div>\n"
"\n"
"% if not translator or not event:\n"
"    <p>\n"
"        Did you know that Compassion is a network of many actively engaged people? This network is made up of you and other sponsors, Compassion staff in different countries and over ${number_fcps} local church partners in ${number_countries} countries.\n"
"    </p>\n"
"    % if not translator:\n"
"        <p>\n"
"            In Switzerland, around 100 volunteers translate numerous letters from sponsors and sponsored children. Would you be interested in helping us?\n"
"        </p>\n"
"    % endif\n"
"    <p>\n"
"        Many volunteers help in the fight against extreme poverty by participating at Compassion events or church services or through prayer. Do you want to get involved?\n"
"    </p>\n"
"    <div style=\"margin:30px auto;text-align: center; text-transform: uppercase;\">\n"
"        <a href=\"https://compassion.ch/de/sich-mehr-engagieren/\"\n"
"           style=\"padding:12px 18px;font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\">\n"
"            Volunteer\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"\n"
"<p>\n"
"    We would also like to present you our interactive fundraising platform TOGETHER. Here you can start your own project!\n"
"</p>\n"
"<div style=\"margin:30px auto;text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://together.compassion.ch/homepage\"\n"
"       style=\"padding:12px 18px;font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\">\n"
"        TOGETHER\n"
"    </a>\n"
"</div>\n"
"<p>\n"
"    Our heartfelt thanks for investing in the ${'life of ' + firstname if one_child else ('lives of ' + firstname if less_4 else 'lives of many children')}! We wish you much joy throughout the journey.\n"
"</p>\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.signature | safe}\n"
"</p>"
msgstr ""
"<p>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"\n"
"    % set sponsorship = partner.sponsorship_ids\n"
"    % set child = sponsorship.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, 'i bambini', translate=False)\n"
"    % set di = 'di' if len(child) < 4 else 'dei' \n"
"\n"
"    % set translator = False\n"
"    % set event = False\n"
"\n"
"    % for engagement in partner.advocate_details_id.engagement_ids:\n"
"        % if engagement.id == 2:\n"
"            % set translator = True\n"
"        % endif\n"
"\n"
"        % if engagement.id in (1,3,9):\n"
"            % set event = True\n"
"        % endif \n"
"    % endfor \n"
"\n"
"    % set number_years = object.env[\"partner.communication.job\"].get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.env[\"partner.communication.job\"].get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.env[\"partner.communication.job\"].get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.env[\"partner.communication.job\"].get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.env[\"partner.communication.job\"].get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.env[\"partner.communication.job\"].get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = object.env[\"partner.communication.job\"].get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"</p>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    % if sponsorship.mapped('invoice_line_ids').filtered('last_payment') or 0 in sponsorship.mapped('total_amount'):\n"
"        Congratulazioni, questa nuova avventura del sostegno a distanza è iniziata bene! La buona notizia ha raggiunto ${firstname} e ${\"la sua famiglia\" if len(child) == 1 else \"le loro famiglie\"}. \n"
"    % endif \n"
"    Questa è l'ultima e-mail che inviamo per iniziare il sostegno a distanza.\n"
"</p>\n"
"<p>\n"
"    Il ${tuo} feedback sull'inizio del sostegno è importante per noi. Non dovrebbe richiedere più di 60 secondi.\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"${object.env.ref('partner_communication_switzerland.onboarding_survey').public_url}\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\">\n"
"        Partecipa al sondaggio\n"
"    </a>\n"
"</div>\n"
"\n"
"% if not translator or not event:\n"
"    <p>\n"
"        Sapevi che Compassion è una rete di molte persone impegnate? È composta da ${te} e da altri sostenitori, dal personale di Compassion in diversi paesi e dal personale di più di ${number_fcps} chiese partner locali in ${number_countries} paesi.\n"
"    </p>\n"
"    <p>\n"
"        % if not translator:\n"
"            In Svizzera, circa 100 volontari traducono numerose lettere di corrispondenza tra sostenitori e bambini. ${\"Volete\" if plural else \"Vuoi\"} aiutare?\n"
"        % endif \n"
"\n"
"        % if not event:\n"
"            Molti volontari sostengono la lotta contro la povertà estrema donando il proprio tempo negli eventi e come volontari nella loro chiesa, e attraverso la preghiera. \n"
"        % endif \n"
"\n"
"        ${\"Volete unirvi\" if plural else \"Vuoi unirti\"} a noi?\n"
"    </p>\n"
"    <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"        <a href=\"https://compassion.ch/it/participare/\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            Volontario per aiutare\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"\n"
"<p>\n"
"    Per ultima la nostra nuova piattaforma interattiva di raccolta fondi TOGETHER. Da qui insieme a ${te} possiamo iniziare il ${tuo} progetto!\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://together.compassion.ch/it_IT/homepage\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        TOGETHER\n"
"    </a>\n"
"</div>\n"
"<p>\n"
"    Grazie di cuore per aver scelto di investire nella vita ${di} ${firstname}!\n"
"</p>\n"
"<p>\n"
"    Auguriamo ad entrambi tanta gioia!  \n"
"</p>\n"
"<p> \n"
"    Calorosamente\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.short_signature | safe}\n"
"</p>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step4
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorship = partner.sponsorship_ids\n"
"    % set child = sponsorship.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set less_4 = firstname != child.get_number()\n"
"    % set christmas_time = (datetime.date.today().month)\n"
"    % set field_office_ids = letter.mapped('child_id.field_office_id').ids\n"
"    % set special = 1 in field_office_ids or 19 in field_office_ids\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"<p>\n"
"    Your letters and prayers make a difference in the ${'life of your sponsored child' if one_child else 'lives of your sponsored children'}!\n"
"</p>\n"
"<p>\n"
"    In a letter from her sponsors, Michelle from the Philippines read for the first time in her life the words \"You are beautiful, you are precious, we love you\". Today, over 25 years later, the impact of letter exchanges with her sponsors is still evident: Michelle has started an aid organisation to help victims of prostitution and human trafficking.\n"
"</p>\n"
"<p>\n"
"    Why not write a letter and send a photo to ${firstname if less_4 else 'your sponsored children'} for ${child.get('him')} to get to know you better. You can write via <a href=\"https://mycompassion.ch/en_US/my/letter\">MyCompassion</a>.\n"
"    % if christmas_time > 8:\n"
"        Why not send your sponsored child${'ren' if not one_child} a Christmas card now?\n"
"    % endif\n"
"</p>\n"
"<p>Do you need inspiration?</p>\n"
"<div style=\"margin:20px auto; text-align: center;\">\n"
"    <a href=\"https://compassion.ch/de/was-soll-ich-meinem-patenkind-schreiben/\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        5 ideas for letter writing\n"
"    </a>\n"
"</div>\n"
"% if special:\n"
"    <p>Extra information on writing letters to your sponsored ${'child' if len(child) == 1 else 'children'}.</p>\n"
"    <div style=\"margin:20px auto; text-align: center;\">\n"
"        <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_EN.pdf\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            Information about letter writing:\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"<p>\n"
"    Another important letter writing information: To ensure the protection of the children, but also for your own safety, the communication between you and your sponsored child${'ren' if not one_child} must run solely through us.\n"
"</p>\n"
"<p>Please never mention:<br></p>\n"
"<ul>\n"
"    <li>Your postal address</li>\n"
"    <li>Your email address</li>\n"
"    <li>Your phone number</li>\n"
"    <li>Compassion Switzerland's address</li>\n"
"    <li>Your Facebook or other social media contact details</li>\n"
"    <li>Making promises (e.g. a gift or visit)</li>\n"
"</ul>\n"
"<p>\n"
"    It's so wonderful that you're investing in the ${'life of ' + firstname if one_child else 'lives of your sponsored children'}!\n"
"</p>\n"
"<p>Warm regards,</p>\n"
"<p>${object.user_id.signature | safe}</p>"
msgstr ""
"<p>\n"
"   % set partner = object.partner_id\n"
"% set plural = partner.title.plural\n"
" % set te = \"voi\" if plural else \"te\"\n"
"% set tu = \"voi\" if plural else \"tu\"\n"
"% set tua = \"vostra\" if plural else \"tua\"\n"
"% set tuo = \"vostro\" if plural else \"tuo\"\n"
"% set tue = \"vostre\" if plural else \"tue\"\n"
"% set tuoi = \"vostri\" if plural else \"tuoi\"\n"
"% set ti = \"vi\" if plural else \"ti\"\n"
"\n"
"% set sponsorship = partner.sponsorship_ids\n"
"% set child = sponsorship.mapped('child_id')\n"
"% set firstname = child.get_list('preferred_name', 3, 'vostri bambini' if plural else 'tuoi bambini', translate=False)\n"
"% set field_office_ids = letter.mapped('child_id.field_office_id').ids\n"
"   % set special = 1 in field_office_ids or 19 in field_office_ids\n"
"\n"
"     ${partner.salutation}\n"
"  </p>\n"
"  <p>\n"
"   Le ${tue} lettere e le ${tue} preghiere fanno la differenza nella vita ${'di' if len(child) < 4 else 'di'} ${firstname}.\n"
"  </p>\n"
"  <p>\n"
"   In una lettera dei suoi sostenitori, Michelle delle Filippine ha \"sentito\" per la prima volta nella sua vita le parole \"Sei bella, sei preziosa, ti amiamo\". Oggi, a più di 25 anni di distanza, è ancora evidente come la corrispondenza con i suoi sostenitori abbia influenzato la sua vita: Michelle infatti ha creato e gestisce una sua ONG per le vittime della prostituzione e della tratta di esseri umani.\n"
"  </p>\n"
"  <p>\n"
"   Per aiutare ${\"i \" if len(child) > 3 else \"\"}${firstname} a ${\"conoscervi\" if plural else \"conoscerti\"} meglio, perchè non inviare una foto e una lettera di presentazione? ${\"Potete\" if plural else \"Puoi\"} scrivere tramite la nostra <a href=\"https://compassion.ch/it/app\">Compassion App</a> o tramite <a href=\"https://mycompassion.ch/it_IT/my/home\">MyCompassion</a>.\n"
"  </p>\n"
"<p>\n"
" Il Natale si avvicina, ${'approfittatene' if plural else 'approfittane'} per inviare una lettera di auguri!\n"
"</p>\n"
"  <p>\n"
"   ${'Avete' if plural else 'Hai'} bisogno di ispirazione per questo?\n"
"  </p>\n"
"  <div style=\"margin:20px auto; text-align: center;\">\n"
"   <a href=\"https://compassion.ch/it/cosa-dovrei-scrivere-al-mio-bambino/\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"    5 idee per scrivere le lettere\n"
"   </a>\n"
"  </div>\n"
"  % if special:\n"
"  <p>\n"
"   Raccomandazioni speciali per la corrispondenza con ${child.get('il vostro bambino') if plural else child.get('il tuo bambino')}.\n"
"  </p>\n"
"  <div style=\"margin:20px auto; text-align: center;\">\n"
"   <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_it.pdf\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"    Informazioni sulla scrittura di lettere\n"
"   </a>\n"
"  </div>\n"
"  % endif\n"
"  <p>\n"
"   Per la protezione del bambino e la ${tua}, tutta la corrispondenza viene inviata attraverso Compassion. Si prega di non menzionare mai:\n"
"   <br>\n"
"  </p>\n"
"  <ul>\n"
"   <li>\n"
"    il ${tuo} indirizzo postale\n"
"   </li>\n"
"   <li>\n"
"    il ${tuo} indirizzo e-mail\n"
"   </li>\n"
"   <li>\n"
"    il ${tuo} numero di telefono\n"
"   </li>\n"
"   <li>\n"
"    l'indirizzo di Compassion Svizzera\n"
"   </li>\n"
"   <li>\n"
"    i ${tuoi} dati di contatto Facebook o di altri social media\n"
"   </li>\n"
"   <li>\n"
"    la promessa di un regalo o di una visita\n"
"   </li>\n"
"  </ul>\n"
"  <p>\n"
"   Grazie per cambiare la vita ${'di' if len(child) < 4 else 'di'} ${firstname}. È fantastico!\n"
"  </p>\n"
"  <p>\n"
"   Calorosamente\n"
"  </p>\n"
"  <p>\n"
"   ${object.user_id.short_signature | safe}\n"
"  </p>\n"
"<br>\n"
"  <p>\n"
"   *Ps: ${\"Avete\" if plural else \"Hai\"} già scaricato la APP? ${\"Potrete\" if plural else \"Potrai\"} avere sempre a portata di mano, le lettere, le foto e tutte le informazioni ${'di' if len(child) < 4 else 'di'} ${firstname}. L'App ${\"vi\" if plural else \"ti\"} da anche suggerimenti di preghiera, Grazie di pregare regolarmente per ${firstname}.\n"
"  </p>"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_zoom_reminder
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set zoom = object.get_objects()\n"
"    % set child = partner.sponsorship_ids.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set less_4 = firstname != child.get_number()\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"<p>\n"
"    The next video conference for new sponsors is getting closer.\n"
"</p>\n"
"<p>\n"
"    You will experience what the message of a sponsorship means for a local family and you will be given more information on your sponsorship.\n"
"</p>\n"
"<p>\n"
"    Have you already signed up? Don't worry, it's really straightforward!\n"
"</p>\n"
"<p>\n"
"    Sign up here: ${zoom.get_date('date_start', 'dd. MMMM')} um ${zoom.get_date('date_start', 'HH:mm')}.\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://mycompassion.ch/de_DE/zoom/register\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Registration Video Conference\n"
"    </a>\n"
"</div>\n"
"<p>\n"
"    We look forward to welcoming/seeing you!\n"
"</p>\n"
"<p>\n"
"    Thank you for investing in the life of ${firstname} and ${child.get('his')} ${'family' if one_child else 'families'}. Together we are changing the world. One child at a time.\n"
"</p>\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.signature | safe}\n"
"<br>\n"
"</p>\n"
msgstr ""
"<p>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set plural = partner.title.plural\n"
"    % set firstname = children.get_list('preferred_name', 3, 'i vostri bambini' if plural else 'i tuoi bambini', translate=False)\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"    % set vive = \"vive\"\n"
"\n"
"    % if \",\" in firstname or firstname == \"i tuoi bambini\" or firstname == \"i vostri bambini\":\n"
"        % set vive = \"vivono\"\n"
"    % endif \n"
"</p>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    % if sponsorships.filtered(\"is_first_sponsorship\"):\n"
"\t    Questa è la prima delle cinque e-mail che abbiamo annunciato.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Oggi ${ti} presentiamo meglio: ${firstname} che ${vive} in ${children.get_list('field_office_id.country_id.name', 3, 'diversi paesi')}. (in allegato il PDF)\n"
"</p>\n"
"<p>\n"
"    % if False:   \n"
"        ${'Sapevate' if plural else 'Sapevi'} che è possibile fare visita ${children.get('al bambino')} che ${'sostenete' if plural else 'sostieni'}?\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://compassion.ch/de/reisen/\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        INFORMAZIONI SULLE VISITE\n"
"    </a>\n"
"</div>\n"
"    % endif\n"
"    % if not sponsorships.filtered(\"is_first_sponsorship\"):\n"
"        <p>\n"
"            Grazie di cuore per aver deciso di investire nella vita di un altro bambino! Cambiamo il mondo, un bambino alla volta.\n"
"        </p>\n"
"    % endif\n"
"    <p>\n"
"        Cordiali Saluti\n"
"    </p>\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
" "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step3
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorship = partner.sponsorship_ids\n"
"    % set child = sponsorship.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation},\n"
"</p>\n"
"<p>\n"
"    This is the third of five emails that you will receive from us.\n"
"</p>\n"
"<p>\n"
"    What does poverty mean in the life of your sponsored child${'ren' if not one_child}?\n"
"</p>\n"
"<p>\n"
"    The causes and effects of poverty can differ depending on the context.\n"
"</p>\n"
"<p>\n"
"    Compassion is active in areas where life is extremely difficult. Be it in Central America, where families live with the danger of gang violence on a daily basis; Africa, where diseases, alcohol, drugs dominate every day life; or Asia, where children are threatened with prostitution or child labour.\n"
"</p>\n"
"<p>\n"
"    Every child deserves to be able to go to school, be protected and experience a childhood filled with hope for the future.\n"
"</p>\n"
"<p>\n"
"    This is an important part of Compassion's work. <b>A sponsorship protects a child from child labour and other forms of slavery, particularly from gang violence and forced marriage.</b>\n"
"</p>\n"
"<p>\n"
"    Together we can protect children!\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://compassion.ch/de/kinderschutz\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        More information on child protection\n"
"    </a>\n"
"</div>\n"
"<p>\n"
"    Warm regards,\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.signature | safe}\n"
"</p>\n"
msgstr ""
"<p>\n"
"   % set partner = object.partner_id\n"
"% set sponsorship = partner.sponsorship_ids\n"
"\n"
"% set child = sponsorship.mapped('child_id')\n"
"% set firstname = child.get_list('preferred_name', 3, 'bambini che sotenete' if plural else 'bambini che sostieni', translate=False)\n"
"\n"
"% set plural = partner.title.plural\n"
"% set te = \"voi\" if plural else \"te\"\n"
"% set tu = \"voi\" if plural else \"tu\"\n"
"% set tua = \"vostra\" if plural else \"tua\"\n"
"% set tuo = \"vostro\" if plural else \"tuo\"\n"
"% set tue = \"vostre\" if plural else \"tue\"\n"
"% set ti = \"vi\" if plural else \"ti\"\n"
"\n"
"${partner.salutation}\n"
"  </p>\n"
"  <p>\n"
"   Questa è la terza delle cinque e-mail annunciate.\n"
"  </p>\n"
"  <p>\n"
"   Che cosa è la povertà nella vita ${'di' if len(child) < 4 else 'dei'} ${firstname}?\n"
"  </p>\n"
"  <p>\n"
"   Le cause e gli effetti della povertà variano a seconda del contesto.\n"
"   <br>\n"
"  </p>\n"
"  <p>\n"
"   Compassion è attiva nei luoghi dove la vita è estremamente difficile, che sia in America Centrale, dove le famiglie vivono il pericolo quotidiano di violenza da parte delle bande. In Asia, dove i bambini sono minacciati dalla prostituzione o dal lavoro minorile o n Africa, dove a farla da padroni, sono le malattie, l'alcol e le droghe.\n"
"  </p>\n"
"  <p>\n"
"   Ogni bambino merita di andare a scuola, di essere protetto e di vivere un'infanzia con speranza e futuro.\n"
"  </p>\n"
"  <p>\n"
"  Questa è una parte importante del lavoro di Compassion. Il sostegno a distanza protegge dal lavoro minorile e da altre forme di schiavitù, in particolare dalla violenza delle bande e dai matrimoni forzati e precoci.\n"
"   <br>\n"
"  </p>\n"
"  <p>\n"
"   Insieme possiamo proteggere i bambini!\n"
"  </p>\n"
"  <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"   <a href=\"https://compassion.ch/it/protezione-dellinfanzia/\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
