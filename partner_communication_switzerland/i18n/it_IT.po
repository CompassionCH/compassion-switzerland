#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.m2m_stop_template
#: model:mail.template,body_html:partner_communication_switzerland.m2m_welcome_template
msgid ""
"<html>\n"
"  <body>\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"      <br/>\n"
"    </p>\n"
"  </body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"one_child\" t-value=\"len(sponsorships) == 1\"/>\n"
"    <t t-if=\"one_child\">\n"
"        <t t-set=\"contracts\" t-value=\"object.get_objects()\"/>\n"
"        <t t-set=\"start_date\" t-value=\"contracts.get_date(&#x27;start_date&#x27;, &#x27;d MMMM YYYY&#x27;)\"/>\n"
"        <t t-set=\"period\" t-value=\"contracts.group_id.advance_billing_months\"/>\n"
"        <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"        <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"        <t t-set=\"hai\" t-value=\"&quot;avete&quot; if plural else &quot;hai&quot;\"/>\n"
"        <t t-set=\"te\" t-value=\"&quot;voi&quot; if plural else &quot;te&quot;\"/>\n"
"        <t t-set=\"ti\" t-value=\"&quot;vi&quot; if plural else &quot;ti&quot;\"/>\n"
"        <t t-set=\"Ti\" t-value=\"&quot;Vi&quot; if plural else &quot;Ti&quot;\"/>\n"
"        <t t-set=\"tu\" t-value=\"&quot;voi&quot; if plural else &quot;tu&quot;\"/>\n"
"        <t t-set=\"tua\" t-value=\"&quot;vostra&quot; if plural else &quot;tua&quot;\"/>\n"
"        <t t-set=\"tuo\" t-value=\"&quot;vostro&quot; if plural else &quot;tuo&quot;\"/>\n"
"        <t t-set=\"tuoi\" t-value=\"&quot;vostri&quot; if plural else &quot;tuoi&quot;\"/>\n"
"        <t t-set=\"tue\" t-value=\"&quot;vostre&quot; if plural else &quot;tue&quot;\"/>\n"
"        <t t-set=\"trovi\" t-value=\"&quot;trovate&quot; if plural else &quot;trovi&quot;\"/>\n"
"        <t t-set=\"potrai\" t-value=\"&#x27;potrete&#x27; if plural else &#x27;potrai&#x27;\"/>\n"
"        <t t-set=\"Potrai\" t-value=\"&#x27;Potrete&#x27; if plural else &#x27;Potrai&#x27;\"/>\n"
"        <t t-set=\"four_children\" t-value=\"len(sponsorships) &gt; 3\"/>\n"
"        <t t-set=\"is_new\" t-value=\"sponsorships.filtered(&quot;is_first_sponsorship&quot;)\"/>\n"
"        <t t-set=\"others\" t-value=\"partner.sponsorship_ids - sponsorships\"/>\n"
"        <t t-set=\"wp\" t-value=\"&quot;SWP&quot; in sponsorships.mapped(&quot;type&quot;)\"/>\n"
"        <t t-set=\"payer\" t-value=\"object.partner_id in sponsorships.mapped(&#x27;partner_id&#x27;)\"/>\n"
"        <t t-set=\"children\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"        <t t-set=\"firstname\" t-value=\"children.get_list(&#x27;preferred_name&#x27;, 3, &#x27;ai bambini&#x27;, translate=False)\"/>\n"
"        <t t-set=\"less_3\" t-value=\"firstname != &#x27;i bambini&#x27;\"/>\n"
"        <t t-set=\"payment_modes\" t-value=\"contracts.with_context(lang=&quot;en_US&quot;).mapped(&quot;payment_mode_id.name&quot;)\"/>\n"
"        <t t-set=\"other_children\" t-value=\"(partner.sponsorship_ids - sponsorships).mapped(&#x27;child_id&#x27;)\"/>\n"
"        <t t-set=\"other_names\" t-value=\"other_children.get_list(&#x27;preferred_name&#x27;, 3, other_children.get(&#x27;your sponsored child&#x27;))\"/>\n"
"        <t t-if=\"plural\">\n"
"            <t t-if=\"partner.gender == &#x27;F&#x27; or partner.title.id == 29\">\n"
"                <t t-set=\"Benvenuto\" t-value=\"&#x27;Benvenute&#x27;\"/>\n"
"            </t>\n"
"<t t-else=\"\">\n"
"                <t t-set=\"Benvenuto\" t-value=\"&#x27;Benvenuti&#x27;\"/>\n"
"            </t>\n"
"        </t>\n"
"<t t-else=\"\">\n"
"            <t t-set=\"Benvenuto\" t-value=\"&quot;Benvenuta&quot; if partner.gender == &quot;F&quot; else &quot;Benvenuto&quot;\"/>\n"
"        </t>\n"
"        <t t-if=\"one_child\">\n"
"            <t t-if=\"children.gender == &#x27;F&#x27;\">\n"
"                <t t-set=\"al_bambino\" t-value=\"&#x27;alla bambina&#x27;\"/>\n"
"            </t>\n"
"<t t-else=\"\">\n"
"                <t t-set=\"al_bambino\" t-value=\"&#x27;al bambino&#x27;\"/>\n"
"            </t>\n"
"        </t>\n"
"<t t-else=\"\">\n"
"            <t t-set=\"al_bambino\" t-value=\"&#x27;ai bambini&#x27;\"/>\n"
"        </t>\n"
"        <t t-set=\"number_years\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_years&#x27;, strip_html=True)\"/>\n"
"        <t t-set=\"number_children\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_children&#x27;, strip_html=True)\"/>\n"
"        <t t-set=\"number_fcps\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_fcps&#x27;, strip_html=True)\"/>\n"
"        <t t-set=\"number_countries\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_countries&#x27;, strip_html=True)\"/>\n"
"        <t t-set=\"years_uc\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;years_uc&#x27;, strip_html=True)\"/>\n"
"        <t t-set=\"years_lc\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;years_lc&#x27;, strip_html=True)\"/>\n"
"        <t t-set=\"children_in_poverty\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;children_in_poverty&#x27;, strip_html=True)\"/>\n"
"        <t t-set=\"early_deaths\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;early_deaths&#x27;, strip_html=True)\"/>\n"
"        <t t-set=\"number_mothers\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_mothers&#x27;, strip_html=True)\"/>\n"
"        <t t-set=\"number_unacceptable_conditions\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_unacceptable_conditions&#x27;, strip_html=True)\"/>\n"
"        <t t-set=\"children_in_poverty\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;children_in_poverty&#x27;, strip_html=True)\"/>\n"
"        <t t-set=\"daily_income_dollar\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;daily_income_dollar&#x27;, strip_html=True)\"/>\n"
"        <t t-set=\"daily_income_chf\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;daily_income_chf&#x27;, strip_html=True)\"/>\n"
"\n"
"        <t t-if=\"start_date.startswith(&quot;11&quot;) or start_date.startswith(&quot;8&quot;) or start_date.startswith(&quot;1 &quot;)\">\n"
"            <t t-set=\"start_date\" t-value=\"&quot;dall&#x27;&quot; + start_date\"/>\n"
"        </t>\n"
"<t t-else=\"\">\n"
"            <t t-set=\"start_date\" t-value=\"&quot;dal &quot; + start_date\"/>\n"
"        </t>\n"
"    </div>\n"
"    <p>\n"
"        <t t-out=\"partner.salutation\"></t>,\n"
"    </p>\n"
"    <p>\n"
"        <t t-out=\"Ti\"></t> ringraziamo per aver sostenuto il programma di sviluppo infantile di Compassion sin <t t-out=\"start_date\"></t>. <t t-out=\"hai.title()\"></t> fornito supporto a una chiesa locale che si è impegnata ad aiutare i bambini bisognosi del proprio quartiere e villaggio aprendo un centro partner di Compassion.\n"
"    </p>\n"
"    <p>\n"
"        <b>\n"
"            Abbiamo preso nota della <t t-out=\"tua\"></t> decisione di interrompere questa donazione ricorrente.\n"
"        </b>\n"
"        Se <t t-out=\"hai\"></t> impostato un ordine permanente, <t t-out=\"ti\"></t> preghiamo di interromperlo.\n"
"    </p>\n"
"    <p>\n"
"        <b>\n"
"            Il <t t-out=\"tuo\"></t> sostegno finanziario ha contribuito a cambiare delle vite in modo duraturo.\n"
"        </b>\n"
"        Ogni anno, decine di migliaia di nuovi bambini iscritti al nostro programma scoprono che l'estrema povertà non è una fatalità. Il loro sguardo su se stessi e sul futuro cambia.\n"
"    </p>\n"
"    <p>\n"
"        Spesso, questo rappresenta l'inizio di una trasformazione radicale e duratura per loro e per le loro famiglie. A nome di tutti questi bambini, <t t-out=\"ti\"></t> ringraziamo di cuore per il <t t-out=\"tuo\"></t> impegno al nostro fianco.\n"
"    </p>\n"
"    <p>\n"
"        Qui <t t-out=\"&#x27;troverete&#x27; if plural else &#x27;troverai&#x27;\"></t> altri modi per <t t-out=\"&#x27;impegnarvi&#x27; if plural else &#x27;impegnarti&#x27;\"></t> nella lotta contro la povertà estrema:\n"
"        <a href=\"https://compassion.ch/it/donare/\">\n"
"            compassion.ch/it/donare\n"
"        </a>\n"
"    </p>\n"
"    <p>\n"
"        Cari saluti.\n"
"    </p>\n"
"    <t t-if=\"object.send_mode == &quot;digital&quot;\">\n"
"        <p>\n"
"            <t t-out=\"object.user_id.signature\"></t>\n"
"        </p>\n"
"    </t>\n"
"</t>\n"
"</body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sub_accept
msgid ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\">\n"
"    <p>TODO</p>\n"
"  <t t-if=\"object.send_mode != 'physical'\"><t t-out=\"object.user_id.signature\"/></t></div></body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\">\n"
"    <p>Il <t t-out=\"&quot;vostro&quot; if object.partner_id.title.plural or object.partner_id.title.id == 29 else &quot;tuo&quot;\"></t> nuovo sostegno per <t t-out=\"object.get_objects().mapped(&quot;child_id&quot;).get_list(&quot;preferred_name&quot;, translate=False)\"></t></p>\n"
"  <t t-if=\"object.send_mode != 'physical'\"><t t-out=\"object.user_id.signature\"/></t></div></body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step5
msgid ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"sponsorship\" t-value=\"partner.sponsorship_ids\"/>\n"
"    <t t-set=\"child\" t-value=\"sponsorship.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, child.get_number(), translate=False)\"/>\n"
"    <t t-set=\"one_child\" t-value=\"len(child) == 1\"/>\n"
"    <t t-set=\"less_4\" t-value=\"firstname != child.get_number()\"/>\n"
"    <t t-set=\"translator\" t-value=\"False\"/>\n"
"    <t t-set=\"event\" t-value=\"False\"/>\n"
"    <t t-set=\"base_url\" t-value=\"object.env[&#x27;ir.config_parameter&#x27;].get_param(&#x27;web.external.url&#x27;)\"/>\n"
"    <t t-foreach=\"partner.advocate_details_id.engagement_ids\" t-as=\"engagement\">\n"
"        <t t-if=\"engagement.id == 2\">\n"
"            <t t-set=\"translator\" t-value=\"True\"/>\n"
"        </t>\n"
"        <t t-if=\"engagement.id in (1,3,9)\">\n"
"            <t t-set=\"event\" t-value=\"True\"/>\n"
"        </t>\n"
"    </t>\n"
"    <t t-set=\"number_years\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_years&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_children\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_children&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_fcps\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_fcps&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_countries\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_countries&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_uc\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;years_uc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_lc\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;years_lc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"children_in_poverty\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;children_in_poverty&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"early_deaths\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;early_deaths&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_mothers\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_mothers&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_unacceptable_conditions\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_unacceptable_conditions&#x27;, strip_html=True)\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.informal_salutation\"></t>\n"
"</p>\n"
"<p>\n"
"    <t t-if=\"sponsorship.mapped(&#x27;invoice_line_ids&#x27;).filtered(&#x27;last_payment&#x27;) or 0 in sponsorship.mapped(&#x27;total_amount&#x27;)\">\n"
"        Congratulations, your <t t-out=\"&#x27;sponsorship has&#x27; if one_child else &#x27;sponsorships have&#x27;\"></t> started well! The good news has reached <t t-out=\"firstname if less_4 else &#x27;your sponsored children&#x27;\"></t> and <t t-out=\"child.get(&#x27;his&#x27;)\"></t> <t t-out=\"&#x27;family&#x27; if one_child else &#x27;families&#x27;\"></t>.\n"
"    </t>\n"
"    This is the final email you will receive from us concerning the start of your sponsorship.\n"
"</p>\n"
"<p>\n"
"    Your feedback regarding the start of your sponsorship<t t-out=\"&#x27;s&#x27; if not one_child else ''\"></t> is important to us. It should only take 60 seconds.\n"
"</p>\n"
"<div style=\"margin:30px auto;text-align: center; text-transform: uppercase;\">\n"
"    <a t-attf-href=\"{{base_url + object.env.ref('partner_communication_switzerland.onboarding_survey').get_start_url()}}\" style=\"padding:12px 18px;font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\">\n"
"        Take part in the questionnaire\n"
"    </a>\n"
"</div>\n"
"\n"
"<t t-if=\"not translator or not event\">\n"
"    <p>\n"
"        Did you know that Compassion is a network of many actively engaged people? This network is made up of you and other sponsors, Compassion staff in different countries and over <t t-out=\"number_fcps\"></t> local church partners in <t t-out=\"number_countries\"></t> countries.\n"
"    </p>\n"
"    <t t-if=\"not translator\">\n"
"        <p>\n"
"            In Switzerland, around 100 volunteers translate numerous letters from sponsors and sponsored children. Would you be interested in helping us?\n"
"        </p>\n"
"    </t>\n"
"    <p>\n"
"        Many volunteers help in the fight against extreme poverty by participating at Compassion events or church services or through prayer. Do you want to get involved?\n"
"    </p>\n"
"    <div style=\"margin:30px auto;text-align: center; text-transform: uppercase;\">\n"
"        <a href=\"https://compassion.ch/de/sich-mehr-engagieren/\" style=\"padding:12px 18px;font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\">\n"
"            Volunteer\n"
"        </a>\n"
"    </div>\n"
"</t>\n"
"<p>\n"
"    We would also like to present you our interactive fundraising platform TOGETHER. Here you can start your own project!\n"
"</p>\n"
"<div style=\"margin:30px auto;text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://together.compassion.ch/homepage\" style=\"padding:12px 18px;font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\">\n"
"        TOGETHER\n"
"    </a>\n"
"</div>\n"
"<p>\n"
"    Our heartfelt thanks for investing in the <t t-out=\"&#x27;life of &#x27; + firstname if one_child else (&#x27;lives of &#x27; + firstname if less_4 else &#x27;lives of many children&#x27;)\"></t>! We wish you much joy throughout the journey.\n"
"</p>\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"<p>\n"
"    <t t-out=\"object.user_id.signature\"></t>\n"
"</p></div></body>\n"
"</html>\n"
msgstr ""
"<div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><p>\n"
"  <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"  <t t-set=\"plural\" t-value=\"partner.title.plural\"/>\n"
"  <t t-set=\"te\" t-value=\"'voi' if plural else 'te'\"/>\n"
"  <t t-set=\"tuo\" t-value=\"'vostro' if plural else 'tuo'\"/>\n"
"  <t t-set=\"sponsorship\" t-value=\"partner.sponsorship_ids\"/>\n"
"  <t t-set=\"child\" t-value=\"sponsorship.mapped('child_id')\"/>\n"
"  <t t-set=\"firstname\" t-value=\"child.get_list('preferred_name', 3, 'i bambini', translate=False)\"/>\n"
"  <t t-set=\"di\" t-value=\"'di' if len(child) &lt; 4 else 'dei'\"/>\n"
"  <t t-set=\"translator\" t-value=\"False\"/>\n"
"  <t t-set=\"event\" t-value=\"False\"/>\n"
"  <t t-foreach=\"partner.advocate_details_id.engagement_ids\" t-as=\"engagement\">\n"
"    <t t-if=\"engagement.id == 2\">\n"
"      <t t-set=\"translator\" t-value=\"True\"/>\n"
"    </t>\n"
"    <t t-if=\"engagement.id in (1, 3, 9)\">\n"
"      <t t-set=\"event\" t-value=\"True\"/>\n"
"    </t>\n"
"  </t>\n"
"  <t t-set=\"number_fcps\" t-value=\"object.env['partner.communication.job'].get_snippet('number_fcps', strip_html=True)\"/>\n"
"  <t t-set=\"number_countries\" t-value=\"object.env['partner.communication.job'].get_snippet('number_countries', strip_html=True)\"/>\n"
"  <t t-set=\"base_url\" t-value=\"object.env['ir.config_parameter'].get_param('web.external.url') + '/it_IT'\"/>\n"
"</p>\n"
"<p>\n"
"  <t t-out=\"partner.salutation\"/>\n"
"</p>\n"
"<p>\n"
"  <t t-if=\"sponsorship.mapped('invoice_line_ids').filtered('last_payment') or 0 in sponsorship.mapped('total_amount')\">\n"
"    Congratulazioni, questa nuova avventura del sostegno a distanza è iniziata\n"
"    bene! La buona notizia ha raggiunto <t t-out=\"firstname\"/> e\n"
"    <t t-out=\"'la sua famiglia' if len(child) == 1 else 'le loro famiglie'\"/>.\n"
"  </t>\n"
"  Questa è l'ultima e-mail che inviamo per iniziare il sostegno a distanza.\n"
"</p>\n"
"<p>\n"
"  Il <t t-out=\"tuo\"/> feedback sull'inizio del sostegno è importante per noi.\n"
"  Non dovrebbe richiedere più di 60 secondi.\n"
"</p>\n"
"<div style=\"margin: 30px auto; text-align: center; text-transform: uppercase\">\n"
"  <a t-attf-href=\"{{base_url + object.env.ref('partner_communication_switzerland.onboarding_survey').get_start_url()}}\" style=\"&#10;      padding: 12px 18px;&#10;      font-size: 14px;&#10;      line-height: 18px;&#10;      color: #ffffff;&#10;      border-color: #0054a6;&#10;      text-decoration: none;&#10;      display: inline-block;&#10;      margin-bottom: 0px;&#10;      font-weight: 400;&#10;      text-align: center;&#10;      vertical-align: middle;&#10;      cursor: pointer;&#10;      white-space: nowrap;&#10;      background-image: none;&#10;      background-color: #0054a6;&#10;      border: 1px solid #0054a6;&#10;      border-radius: 3px;&#10;    \">\n"
"    Partecipa al sondaggio\n"
"  </a>\n"
"</div>\n"
"<t t-if=\"not translator or not event\">\n"
"  <p>\n"
"    Sapevi che Compassion è una rete di molte persone impegnate? È composta da\n"
"    <t t-out=\"te\"/> e da altri sostenitori, dal personale di Compassion in\n"
"    diversi paesi e dal personale di più di <t t-out=\"number_fcps\"/> chiese\n"
"    partner locali in <t t-out=\"number_countries\"/> paesi.\n"
"  </p>\n"
"  <p>\n"
"    <t t-if=\"not translator\">\n"
"      In Svizzera, circa 100 volontari traducono numerose lettere di\n"
"      corrispondenza tra sostenitori e bambini.\n"
"      <t t-out=\"'Volete' if plural else 'Vuoi'\"/> aiutare?\n"
"    </t>\n"
"    <t t-if=\"not event\">\n"
"      Molti volontari sostengono la lotta contro la povertà estrema donando il\n"
"      proprio tempo negli eventi e come volontari nella loro chiesa, e\n"
"      attraverso la preghiera.\n"
"    </t>\n"
"    <t t-out=\"'Volete unirvi' if plural else 'Vuoi unirti'\"/> a noi?\n"
"  </p>\n"
"  <div style=\"margin: 30px auto; text-align: center; text-transform: uppercase\">\n"
"    <a href=\"https://compassion.ch/it/participare/\" style=\"&#10;        padding: 12px 18px;&#10;        font-size: 14px;&#10;        line-height: 18px;&#10;        color: #ffffff;&#10;        border-color: #0054a6;&#10;        text-decoration: none;&#10;        display: inline-block;&#10;        margin-bottom: 0px;&#10;        font-weight: 400;&#10;        text-align: center;&#10;        vertical-align: middle;&#10;        cursor: pointer;&#10;        white-space: nowrap;&#10;        background-image: none;&#10;        background-color: #0054a6;&#10;        border: 1px solid #0054a6;&#10;        border-radius: 3px;&#10;      \" title=\"\">\n"
"      Volontario per aiutare\n"
"    </a>\n"
"  </div>\n"
"</t>\n"
"<p>\n"
"  Per ultima la nostra nuova piattaforma interattiva di raccolta fondi TOGETHER.\n"
"  Da qui insieme a <t t-out=\"te\"/> possiamo iniziare il\n"
"  <t t-out=\"tuo\"/> progetto!\n"
"</p>\n"
"<div style=\"margin: 30px auto; text-align: center; text-transform: uppercase\">\n"
"  <a href=\"https://together.compassion.ch/it_IT/homepage\" style=\"&#10;      padding: 12px 18px;&#10;      font-size: 14px;&#10;      line-height: 18px;&#10;      color: #ffffff;&#10;      border-color: #0054a6;&#10;      text-decoration: none;&#10;      display: inline-block;&#10;      margin-bottom: 0px;&#10;      font-weight: 400;&#10;      text-align: center;&#10;      vertical-align: middle;&#10;      cursor: pointer;&#10;      white-space: nowrap;&#10;      background-image: none;&#10;      background-color: #0054a6;&#10;      border: 1px solid #0054a6;&#10;      border-radius: 3px;&#10;    \" title=\"\">\n"
"    TOGETHER\n"
"  </a>\n"
"</div>\n"
"<p>\n"
"  Grazie di cuore per aver scelto di investire nella vita <t t-out=\"di\"/>\n"
"  <t t-out=\"firstname\"/>!\n"
"</p>\n"
"<p>Auguriamo ad entrambi tanta gioia!</p>\n"
"<p>Calorosamente</p>\n"
"<p>\n"
"  <t t-if=\"object.send_mode != 'physical'\"><t t-out=\"object.user_id.signature\"/></t><t t-else=\"\"><t t-out=\"object.user_id.short_signature\"/></t>\n"
"</p>\n"
"</div>"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step4
msgid ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"sponsorship\" t-value=\"partner.sponsorship_ids\"/>\n"
"    <t t-set=\"child\" t-value=\"sponsorship.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"one_child\" t-value=\"len(child) == 1\"/>\n"
"    <t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, child.get_number(), translate=False)\"/>\n"
"    <t t-set=\"less_4\" t-value=\"firstname != child.get_number()\"/>\n"
"    <t t-set=\"christmas_time\" t-value=\"(datetime.date.today().month)\"/>\n"
"    <t t-set=\"field_office_ids\" t-value=\"child.mapped(&#x27;field_office_id&#x27;).ids\"/>\n"
"    <t t-set=\"special\" t-value=\"1 in field_office_ids or 19 in field_office_ids\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.informal_salutation\"></t>\n"
"</p>\n"
"<p>\n"
"    Your letters and prayers make a difference in the <t t-out=\"&#x27;life of your sponsored child&#x27; if one_child else &#x27;lives of your sponsored children&#x27;\"></t>!\n"
"</p>\n"
"<p>\n"
"    In a letter from her sponsors, Michelle from the Philippines read for the first time in her life the words \"You are beautiful, you are precious, we love you\". Today, over 25 years later, the impact of letter exchanges with her sponsors is still evident: Michelle has started an aid organisation to help victims of prostitution and human trafficking.\n"
"</p>\n"
"<p>\n"
"    Why not write a letter and send a photo to <t t-out=\"firstname if less_4 else &#x27;your sponsored children&#x27;\"></t> for <t t-out=\"child.get(&#x27;him&#x27;)\"></t> to get to know you better. You can write via <a href=\"https://mycompassion.ch/en_US/my/letter\">MyCompassion</a>.\n"
"    <t t-if=\"christmas_time &gt; 8\">\n"
"        Why not send your sponsored child<t t-out=\"&#x27;ren&#x27; if not one_child else &#x27;&#x27;\"></t> a Christmas card now?\n"
"    </t>\n"
"</p>\n"
"<p>Do you need inspiration?</p>\n"
"<div style=\"margin:20px auto; text-align: center;\">\n"
"    <a href=\"https://compassion.ch/de/was-soll-ich-meinem-patenkind-schreiben/\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        5 ideas for letter writing\n"
"    </a>\n"
"</div>\n"
"<t t-if=\"special\">\n"
"    <p>Extra information on writing letters to your sponsored <t t-out=\"&#x27;child&#x27; if len(child) == 1 else &#x27;children&#x27;\"></t>.</p>\n"
"    <div style=\"margin:20px auto; text-align: center;\">\n"
"        <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_EN.pdf\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            Information about letter writing:\n"
"        </a>\n"
"    </div>\n"
"</t>\n"
"<p>\n"
"    Another important letter writing information: To ensure the protection of the children, but also for your own safety, the communication between you and your sponsored child<t t-out=\"&#x27;ren&#x27; if not one_child else &#x27;&#x27;\"></t> must run solely through us.\n"
"</p>\n"
"<p>Please never mention:<br/></p>\n"
"<ul>\n"
"    <li>Your postal address</li>\n"
"    <li>Your email address</li>\n"
"    <li>Your phone number</li>\n"
"    <li>Compassion Switzerland's address</li>\n"
"    <li>Your Facebook or other social media contact details</li>\n"
"    <li>Making promises (e.g. a gift or visit)</li>\n"
"</ul>\n"
"<p>\n"
"    It's so wonderful that you're investing in the <t t-out=\"&#x27;life of &#x27; + firstname if one_child else &#x27;lives of your sponsored children&#x27;\"></t>!\n"
"</p>\n"
"<p>Warm regards,</p>\n"
"<p><t t-out=\"object.user_id.signature\"></t></p></div></body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><p>\n"
"   <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"<t t-set=\"plural\" t-value=\"partner.title.plural\"/>\n"
" <t t-set=\"te\" t-value=\"&quot;voi&quot; if plural else &quot;te&quot;\"/>\n"
"<t t-set=\"tu\" t-value=\"&quot;voi&quot; if plural else &quot;tu&quot;\"/>\n"
"<t t-set=\"tua\" t-value=\"&quot;vostra&quot; if plural else &quot;tua&quot;\"/>\n"
"<t t-set=\"tuo\" t-value=\"&quot;vostro&quot; if plural else &quot;tuo&quot;\"/>\n"
"<t t-set=\"tue\" t-value=\"&quot;vostre&quot; if plural else &quot;tue&quot;\"/>\n"
"<t t-set=\"tuoi\" t-value=\"&quot;vostri&quot; if plural else &quot;tuoi&quot;\"/>\n"
"<t t-set=\"ti\" t-value=\"&quot;vi&quot; if plural else &quot;ti&quot;\"/>\n"
"<t t-set=\"sponsorship\" t-value=\"partner.sponsorship_ids\"/>\n"
"<t t-set=\"child\" t-value=\"sponsorship.mapped(&#x27;child_id&#x27;)\"/>\n"
"<t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, &#x27;vostri bambini&#x27; if plural else &#x27;tuoi bambini&#x27;, translate=False)\"/>\n"
"<t t-set=\"field_office_ids\" t-value=\"child.mapped(&#x27;field_office_id&#x27;).ids\"/>\n"
"   <t t-set=\"special\" t-value=\"1 in field_office_ids or 19 in field_office_ids\"/>\n"
"     <t t-out=\"partner.salutation\"></t>\n"
"  </p>\n"
"  <p>\n"
"   Le <t t-out=\"tue\"></t> lettere e le <t t-out=\"tue\"></t> preghiere fanno la differenza nella vita <t t-out=\"&#x27;di&#x27; if len(child) &lt; 4 else &#x27;di&#x27;\"></t> <t t-out=\"firstname\"></t>.\n"
"  </p>\n"
"  <p>\n"
"   In una lettera dei suoi sostenitori, Michelle delle Filippine ha \"sentito\" per la prima volta nella sua vita le parole \"Sei bella, sei preziosa, ti amiamo\". Oggi, a più di 25 anni di distanza, è ancora evidente come la corrispondenza con i suoi sostenitori abbia influenzato la sua vita: Michelle infatti ha creato e gestisce una sua ONG per le vittime della prostituzione e della tratta di esseri umani.\n"
"  </p>\n"
"  <p>\n"
"   Per aiutare <t t-out=\"&quot;i &quot; if len(child) &gt; 3 else &quot;&quot;\"></t><t t-out=\"firstname\"></t> a <t t-out=\"&quot;conoscervi&quot; if plural else &quot;conoscerti&quot;\"></t> meglio, perchè non inviare una foto e una lettera di presentazione? <t t-out=\"&quot;Potete&quot; if plural else &quot;Puoi&quot;\"></t> scrivere tramite la nostra <a href=\"https://compassion.ch/it/app\">Compassion App</a> o tramite <a href=\"https://mycompassion.ch/it_IT/my/home\">MyCompassion</a>.\n"
"  </p>\n"
"<p>\n"
" Il Natale si avvicina, <t t-out=\"&#x27;approfittatene&#x27; if plural else &#x27;approfittane&#x27;\"></t> per inviare una lettera di auguri!\n"
"</p>\n"
"  <p>\n"
"   <t t-out=\"&#x27;Avete&#x27; if plural else &#x27;Hai&#x27;\"></t> bisogno di ispirazione per questo?\n"
"  </p>\n"
"  <div style=\"margin:20px auto; text-align: center;\">\n"
"   <a href=\"https://compassion.ch/it/cosa-dovrei-scrivere-al-mio-bambino/\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"    5 idee per scrivere le lettere\n"
"   </a>\n"
"  </div>\n"
"  <t t-if=\"special\">\n"
"  <p>\n"
"   Raccomandazioni speciali per la corrispondenza con <t t-out=\"child.get(&#x27;il vostro bambino&#x27;) if plural else child.get(&#x27;il tuo bambino&#x27;)\"></t>.\n"
"  </p>\n"
"  <div style=\"margin:20px auto; text-align: center;\">\n"
"   <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_it.pdf\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"    Informazioni sulla scrittura di lettere\n"
"   </a>\n"
"  </div>\n"
"  </t>\n"
"  <p>\n"
"   Per la protezione del bambino e la <t t-out=\"tua\"></t>, tutta la corrispondenza viene inviata attraverso Compassion. Si prega di non menzionare mai:\n"
"   <br/>\n"
"  </p>\n"
"  <ul>\n"
"   <li>\n"
"    il <t t-out=\"tuo\"></t> indirizzo postale\n"
"   </li>\n"
"   <li>\n"
"    il <t t-out=\"tuo\"></t> indirizzo e-mail\n"
"   </li>\n"
"   <li>\n"
"    il <t t-out=\"tuo\"></t> numero di telefono\n"
"   </li>\n"
"   <li>\n"
"    l'indirizzo di Compassion Svizzera\n"
"   </li>\n"
"   <li>\n"
"    i <t t-out=\"tuoi\"></t> dati di contatto Facebook o di altri social media\n"
"   </li>\n"
"   <li>\n"
"    la promessa di un regalo o di una visita\n"
"   </li>\n"
"  </ul>\n"
"  <p>\n"
"   Grazie per cambiare la vita <t t-out=\"&#x27;di&#x27; if len(child) &lt; 4 else &#x27;di&#x27;\"></t> <t t-out=\"firstname\"></t>. È fantastico!\n"
"  </p>\n"
"  <p>\n"
"   Calorosamente\n"
"  </p>\n"
"  <p>\n"
"   <t t-if=\"object.send_mode != 'physical'\"><t t-out=\"object.user_id.signature\"/></t><t t-else=\"\"><t t-out=\"object.user_id.short_signature\"/></t>\n"
"  </p>\n"
"<br/>\n"
"  <p>\n"
"   *Ps: <t t-out=\"&quot;Avete&quot; if plural else &quot;Hai&quot;\"></t> già scaricato la APP? <t t-out=\"&quot;Potrete&quot; if plural else &quot;Potrai&quot;\"></t> avere sempre a portata di mano, le lettere, le foto e tutte le informazioni <t t-out=\"&#x27;di&#x27; if len(child) &lt; 4 else &#x27;di&#x27;\"></t> <t t-out=\"firstname\"></t>. L'App <t t-out=\"&quot;vi&quot; if plural else &quot;ti&quot;\"></t> da anche suggerimenti di preghiera, Grazie di pregare regolarmente per <t t-out=\"firstname\"></t>.\n"
"  </p></div></body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step3
msgid ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"sponsorship\" t-value=\"partner.sponsorship_ids\"/>\n"
"    <t t-set=\"child\" t-value=\"sponsorship.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"one_child\" t-value=\"len(child) == 1\"/>\n"
"    <t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, child.get_number(), translate=False)\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.informal_salutation\"></t>,\n"
"</p>\n"
"<p>\n"
"    This is the third of five emails that you will receive from us.\n"
"</p>\n"
"<p>\n"
"    What does poverty mean in the life of your sponsored child<t t-out=\"&#x27;ren&#x27; if not one_child else &#x27;&#x27;\"></t>?\n"
"</p>\n"
"<p>\n"
"    The causes and effects of poverty can differ depending on the context.\n"
"</p>\n"
"<p>\n"
"    Compassion is active in areas where life is extremely difficult. Be it in Central America, where families live with the danger of gang violence on a daily basis; Africa, where diseases, alcohol, drugs dominate every day life; or Asia, where children are threatened with prostitution or child labour.\n"
"</p>\n"
"<p>\n"
"    Every child deserves to be able to go to school, be protected and experience a childhood filled with hope for the future.\n"
"</p>\n"
"<p>\n"
"    This is an important part of Compassion's work. <b>A sponsorship protects a child from child labour and other forms of slavery, particularly from gang violence and forced marriage.</b>\n"
"</p>\n"
"<p>\n"
"    Together we can protect children!\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://compassion.ch/de/kinderschutz\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        More information on child protection\n"
"    </a>\n"
"</div>\n"
"<p>\n"
"    Warm regards,\n"
"</p>\n"
"<p>\n"
"    <t t-out=\"object.user_id.signature\"></t>\n"
"</p>\n"
"</div></body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><p>\n"
"   <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"<t t-set=\"sponsorship\" t-value=\"partner.sponsorship_ids\"/>\n"
"<t t-set=\"child\" t-value=\"sponsorship.mapped(&#x27;child_id&#x27;)\"/>\n"
"<t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, &#x27;bambini che sotenete&#x27; if plural else &#x27;bambini che sostieni&#x27;, translate=False)\"/>\n"
"<t t-set=\"plural\" t-value=\"partner.title.plural\"/>\n"
"<t t-set=\"te\" t-value=\"&quot;voi&quot; if plural else &quot;te&quot;\"/>\n"
"<t t-set=\"tu\" t-value=\"&quot;voi&quot; if plural else &quot;tu&quot;\"/>\n"
"<t t-set=\"tua\" t-value=\"&quot;vostra&quot; if plural else &quot;tua&quot;\"/>\n"
"<t t-set=\"tuo\" t-value=\"&quot;vostro&quot; if plural else &quot;tuo&quot;\"/>\n"
"<t t-set=\"tue\" t-value=\"&quot;vostre&quot; if plural else &quot;tue&quot;\"/>\n"
"<t t-set=\"ti\" t-value=\"&quot;vi&quot; if plural else &quot;ti&quot;\"/>\n"
"<t t-out=\"partner.salutation\"></t>\n"
"  </p>\n"
"  <p>\n"
"   Questa è la terza delle cinque e-mail annunciate.\n"
"  </p>\n"
"  <p>\n"
"   Che cosa è la povertà nella vita <t t-out=\"&#x27;di&#x27; if len(child) &lt; 4 else &#x27;dei&#x27;\"></t> <t t-out=\"firstname\"></t>?\n"
"  </p>\n"
"  <p>\n"
"   Le cause e gli effetti della povertà variano a seconda del contesto.\n"
"   <br/>\n"
"  </p>\n"
"  <p>\n"
"   Compassion è attiva nei luoghi dove la vita è estremamente difficile, che sia in America Centrale, dove le famiglie vivono il pericolo quotidiano di violenza da parte delle bande. In Asia, dove i bambini sono minacciati dalla prostituzione o dal lavoro minorile o n Africa, dove a farla da padroni, sono le malattie, l'alcol e le droghe.\n"
"  </p>\n"
"  <p>\n"
"   Ogni bambino merita di andare a scuola, di essere protetto e di vivere un'infanzia con speranza e futuro.\n"
"  </p>\n"
"  <p>\n"
"  Questa è una parte importante del lavoro di Compassion. Il sostegno a distanza protegge dal lavoro minorile e da altre forme di schiavitù, in particolare dalla violenza delle bande e dai matrimoni forzati e precoci.\n"
"   <br/>\n"
"  </p>\n"
"  <p>\n"
"   Insieme possiamo proteggere i bambini!\n"
"  </p>\n"
"  <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"   <a href=\"https://compassion.ch/it/protezione-dellinfanzia/\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"    MAGGIORI INFORMAZIONI SULLA PROTEZIONE DEI BAMBINI\n"
"   </a>\n"
"  </div>\n"
"  <p>\n"
"   Cordiali saluti\n"
"  </p>\n"
"  <p>\n"
"   <t t-if=\"object.send_mode != 'physical'\"><t t-out=\"object.user_id.signature\"/></t><t t-else=\"\"><t t-out=\"object.user_id.short_signature\"/></t>\n"
"  </p>\n"
" </div></body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_sub_dossier_new
msgid ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><div>\n"
"   <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"                    \n"
"<t t-set=\"child\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"                    \n"
"<t t-set=\"previous\" t-value=\"sponsorships.mapped(&#x27;parent_id.child_id&#x27;)\"/>\n"
"                    \n"
"<t t-set=\"previous_name\" t-value=\"previous.get_list(&#x27;preferred_name&#x27;, 3, &#x27;&#x27;, translate=False)\"/>\n"
"                    \n"
"<t t-set=\"name\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, child.get_number(), False)\"/>\n"
"  </div>\n"
"  <p>\n"
"   <t t-out=\"object.partner_id.salutation\"></t>,\n"
"   <br/>\n"
"   <br/>\n"
"   We recently informed you that <t t-out=\"previous.get(&#x27;your sponsored child&#x27;)\"></t>, <t t-out=\"previous_name\"></t> <t t-out=\"previous.get(&#x27;is&#x27;)\"></t> no longer participating in the sponsorship program. We suggested that you sponsor another child who really needs help.\n"
"   <br/>\n"
"   <br/>\n"
"   Enclosed you will find information about <t t-out=\"name\"></t> in <t t-out=\"child.get_list(&#x27;project_id.country_id.name&#x27;)\"></t>. Would you again be prepared to invest in a life to release <t t-out=\"child.get(&#x27;him&#x27;)\"></t> from extreme poverty?\n"
"   <br/>\n"
"   <br/>\n"
"   Jennifer, for example lost her mother when she was only 14 years old. Today she is a lawyer. “In my sponsors letters, I was always encouraged to persevere and to improve.“\n"
"   <br/>\n"
"   <br/>\n"
"   Sponsorship changes the life of a child. Your commitment makes a huge difference for a child, for the family and the entire environment.\n"
"   <br/>\n"
"   <br/>\n"
"   If you do not want to support this child, please let us know as soon as possible so that we can find another sponsor for <t t-out=\"child.get(&#x27;him&#x27;)\"></t>.\n"
"   <br/>\n"
"   <br/>\n"
"   Thank you for everything you have already done for a child in poverty.\n"
"   <br/>\n"
"   <br/>\n"
"   Thank you for responding to this request.\n"
"   <br/>\n"
"   <br/>\n"
"   Sincerely,\n"
"  </p>\n"
" <t t-if=\"object.send_mode != 'physical'\"><t t-out=\"object.user_id.signature\"/></t></div></body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"te\" t-value=\"&quot;voi&quot; if plural else &quot;te&quot;\"/>\n"
"    <t t-set=\"ti\" t-value=\"&quot;vi&quot; if plural else &quot;ti&quot;\"/>\n"
"    <t t-set=\"tu\" t-value=\"&quot;voi&quot; if plural else &quot;tu&quot;\"/>\n"
"    <t t-set=\"tua\" t-value=\"&quot;vostra&quot; if plural else &quot;tua&quot;\"/>\n"
"    <t t-set=\"tuo\" t-value=\"&quot;vostro&quot; if plural else &quot;tuo&quot;\"/>\n"
"    <t t-set=\"tue\" t-value=\"&quot;vostre&quot; if plural else &quot;tue&quot;\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()                 \"/>\n"
"    <t t-set=\"child\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)                   \"/>\n"
"    <t t-set=\"previous\" t-value=\"sponsorships.mapped(&#x27;parent_id.child_id&#x27;)\"/>\n"
"    <t t-set=\"previous_name\" t-value=\"previous.get_list(&#x27;preferred_name&#x27;, 3, &#x27;&#x27;, translate=False)\"/>\n"
"    <t t-set=\"name\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, child.get_number(), False)\"/>\n"
"    <t t-set=\"presentarti\" t-value=\"&quot;presentarvi&quot; if plural else &quot;presentarti&quot;\"/>\n"
"    <t t-set=\"Immagina\" t-value=\"&quot;Immaginate&quot; if plural else &quot;Immagina&quot;\"/>\n"
"    <t t-set=\"vuoi\" t-value=\"&quot;volete&quot; if plural else &quot;vuoi&quot;\"/>\n"
"    <t t-set=\"devi\" t-value=\"&quot;dovete&quot; if plural else &quot;devi&quot;\"/>\n"
"    <t t-set=\"desideri\" t-value=\"&quot;desiderate&quot; if plural else &quot;desideri&quot;\"/>\n"
"    <t t-set=\"payment_term\" t-value=\"sponsorships.mapped(&#x27;payment_mode_id.name&#x27;)[0]\"/>\n"
"    <t t-set=\"lsv_dd\" t-value=\"&#x27;LSV&#x27; in payment_term or &#x27;Postfinance&#x27; in payment_term\"/>\n"
"    <t t-if=\"plural\">\n"
"        <t t-set=\"hai\" t-value=\"&#x27;avete&#x27;\"/>\n"
"        <t t-set=\"voglia\" t-value=\"&#x27;vogliate&#x27;\"/>\n"
"        <t t-set=\"impegnarti\" t-value=\"&#x27;impegnarvi&#x27;\"/>\n"
"        <t t-set=\"scopri\" t-value=\"&#x27;scoprite&#x27;\"/>\n"
"        <t t-set=\"puoi\" t-value=\"&#x27;potete&#x27;\"/>\n"
"        <t t-set=\"saresti\" t-value=\"&#x27;sareste&#x27;\"/>\n"
"        <t t-set=\"o\" t-value=\"&#x27;i&#x27;\"/>\n"
"        <t t-set=\"un_sostenitore\" t-value=\"&#x27;sostenitori&#x27;\"/>\n"
"        <t t-set=\"il_sostenitore\" t-value=\"&#x27;i sostenitori&#x27;\"/>\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-set=\"hai\" t-value=\"&#x27;hai&#x27;\"/>\n"
"        <t t-set=\"voglia\" t-value=\"&#x27;voglia&#x27;\"/>\n"
"        <t t-set=\"impegnarti\" t-value=\"&#x27;impegnarti&#x27;\"/>\n"
"        <t t-set=\"scopri\" t-value=\"&#x27;scopri&#x27;\"/>\n"
"        <t t-set=\"puoi\" t-value=\"&#x27;puoi&#x27;\"/>\n"
"        <t t-set=\"saresti\" t-value=\"&#x27;saresti&#x27;\"/>\n"
"        <t t-if=\"partner.gender == &#x27;M&#x27;\">\n"
"            <t t-set=\"un_sostenitore\" t-value=\"&#x27;un sostenitore&#x27;\"/>\n"
"            <t t-set=\"il_sostenitore\" t-value=\"&#x27;il sostenitore&#x27;\"/>\n"
"            <t t-set=\"o\" t-value=\"&#x27;o&#x27;\"/>\n"
"        </t>\n"
"<t t-else=\"\">\n"
"            <t t-set=\"un_sostenitore\" t-value=\"&#x27;una sostenitrice&#x27;\"/>\n"
"            <t t-set=\"il_sostenitore\" t-value=\"&#x27;la sostenitrice&#x27;\"/>\n"
"            <t t-set=\"o\" t-value=\"&#x27;a&#x27;\"/>\n"
"        </t>\n"
"    </t>\n"
"    <t t-if=\"len(child) == 1\">\n"
"        <t t-if=\"child.gender == &#x27;M&#x27;\">\n"
"            <t t-set=\"questo\" t-value=\"&#x27;questo&#x27;\"/>\n"
"            <t t-set=\"bambino\" t-value=\"&#x27;bambino&#x27;\"/>\n"
"        </t>\n"
"<t t-else=\"\">\n"
"            <t t-set=\"questo\" t-value=\"&#x27;questa&#x27;\"/>\n"
"            <t t-set=\"bambino\" t-value=\"&#x27;bambina&#x27;\"/>\n"
"        </t>\n"
"    </t>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"object.partner_id.salutation\"></t>,\n"
"</p>\n"
"<p>\n"
"    Una delle cose più belle del nostro lavoro è poter mettere in contatto un bambino che vive in estrema povertà con un sostenitore.\n"
"</p>\n"
"<p>\n"
"    <b>Siamo felici di <t t-out=\"presentarti\"></t> <t t-out=\"name\"></t>, \n"
"    <t t-if=\"len(child) == 1\">\n"
"        <t t-out=\"child.age\"></t> <t t-out=\"&quot;anno,&quot; if child.age &lt; 2 else &quot;anni,&quot;\"></t> \n"
"    </t>\n"
"    <t t-if=\"child.get_list(&#x27;project_id.country_id.from_preposition&#x27;) == &quot;dall&#x27;&quot;\">\n"
"        <t t-out=\"child.get_list(&#x27;project_id.country_id.from_preposition&#x27;)\"></t><t t-out=\"child.get_list(&#x27;project_id.country_id.name&#x27;)\"></t>,\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-out=\"child.get_list(&#x27;project_id.country_id.from_preposition&#x27;)\"></t> <t t-out=\"child.get_list(&#x27;project_id.country_id.name&#x27;)\"></t>,\n"
"    </t>\n"
"    </b>\n"
"    in attesa di <t t-out=\"un_sostenitore\"></t> come <t t-out=\"te\"></t>.\n"
"</p>\n"
"<p>\n"
"    Ogni bambino è unico e merita un futuro pieno di speranza e opportunità. Le informazioni in allegato <t t-out=\"ti\"></t> permetteranno di conoscere un po' meglio <t t-out=\"name\"></t>. <t t-out=\"scopri.title()\"></t> quali sono le sue sfide e i suoi sogni e come <t t-out=\"puoi\"></t> contribuire a migliorare la sua vita.\n"
"</p>\n"
"<p>\n"
"    La maggior parte dei sostenitori sceglie di continuare con un nuovo sostegno. Ecco perché abbiamo reso la procedura il più semplice possibile. <b><t t-out=\"saresti.title()\"></t> dispost<t t-out=\"o\"></t> a diventare <t t-out=\"il_sostenitore\"></t> di <t t-out=\"name\"></t>?</b>\n"
"</p>\n"
"<p>\n"
"    <t t-if=\"lsv_dd\">\n"
"        Se non <t t-out=\"hai\"></t> ancora annullato il <t t-out=\"tuo\"></t> addebito diretto, non <t t-out=\"devi\"></t> fare nulla. Ci occuperemo noi di tutto affinché il nuovo sostegno possa iniziare. La <t t-out=\"tua\"></t> donazione continuerà ad essere addebitata normalmente.\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        Se non <t t-out=\"hai\"></t> ancora disdetto il <t t-out=\"tuo\"></t> ordine permanente, non <t t-out=\"devi\"></t> fare nulla. Ci occuperemo noi di tutto affinché il nuovo sostegno possa iniziare.\n"
"    </t>\n"
"</p>\n"
"<p>\n"
"    <b>\n"
"        Se non avremo <t t-out=\"tue\"></t> notizie, penseremo che <t t-out=\"tu\"></t> <t t-out=\"voglia\"></t> sostenere <t t-out=\"name\"></t>, per continuare a <t t-out=\"impegnarti\"></t> nella lotta contro la povertà estrema. Se invece <t t-out=\"&#x27;decidete&#x27; if plural else &#x27;decidi&#x27;\"></t> di non <t t-out=\"&#x27;sostenerla&#x27; if child.gender == &#x27;F&#x27; else &#x27;sostenerlo&#x27;\"></t> o se <t t-out=\"desideri\"></t> scegliere un altro bambino, <t t-out=\"ti\"></t> preghiamo di contattarci via e-mail o per telefono entro le prossime due settimane.\n"
"    </b>\n"
"</p>\n"
"<p>\n"
"    Non vediamo l'ora di condividere la buona notizia con <t t-out=\"name\"></t>. Grazie per aver investito nel migliorare la vita di bambini che vivono in condizioni di estrema povertà.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"<t t-if=\"object.send_mode == &quot;digital&quot;\">\n"
"    <p><t t-out=\"object.user_id.signature\"></t></p>\n"
"</t>\n"
"</div></body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step2
msgid ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><p>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"sponsorship\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"child\" t-value=\"sponsorship.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, &#x27;your sponsored children&#x27;, translate=False)\"/>\n"
"    <t t-set=\"country\" t-value=\"child.mapped(&#x27;field_office_id&#x27;)\"/>\n"
"    <t t-set=\"alumni_name\" t-value=\"country.get_list(&#x27;alumni_representative&#x27;)\"/>\n"
"    <t t-set=\"apos\" t-value=\"&quot;&#x27;&quot; if alumni_name[-1] == &#x27;s&#x27; else &quot;&#x27;s&quot;\"/>\n"
"    <t t-set=\"alumni_link\" t-value=\"country.get_list(&#x27;alumni_video_link&#x27;, 1, &#x27;https://vimeo.com/showcase/geschichten-ehemaliger-patenkinder-von-compassion&#x27;)\"/>\n"
"    <t t-set=\"multi_link\" t-value=\"alumni_link == &#x27;https://vimeo.com/showcase/geschichten-ehemaliger-patenkinder-von-compassion&#x27;\"/>\n"
"    <t t-out=\"partner.salutation\"></t>, your sponsorship is making a difference!\n"
"</p>\n"
"<p>\n"
"    <t t-if=\"not multi_link\">\n"
"        Today, we would like to introduce you to <t t-out=\"alumni_name\"></t>, a former sponsored child of Compassion. <t t-out=\"&#x27;She&#x27; if child[0].field_office_id.alumni_gender == &#x27;F&#x27; else &#x27;He&#x27;\"></t> lives on the same continent as <t t-out=\"firstname\"></t>.\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        Today, we would like to introduce you to <t t-out=\"alumni_name\"></t>, former sponsored children of Compassion. They on the same continent as <t t-out=\"firstname\"></t>.\n"
"    </t>\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a t-attf-href=\"{{alumni_link}}\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">Discover\n"
"    <t t-if=\"multi_link\">\n"
"        their stories\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-out=\"alumni_name + apos\"></t> story\n"
"    </t>\n"
"    </a>\n"
"</div>\n"
"<h3 style=\"color: #0054A6; text-transform: uppercase;\">\n"
"    <b>You enable <t t-out=\"firstname if len(child) &lt; 4 else &#x27;your sponsored children&#x27;\"></t>:</b>\n"
"</h3>\n"
"<ul>\n"
"    <li>Access to school (school fees, uniform, material, tutoring)</li>\n"
"    <li>Higher education (vocational training or university studies)</li>\n"
"    <li>Medical care</li>\n"
"    <li>Hygiene training and regular balanced meals</li>\n"
"    <li>Love and care from a local church, bible teaching*</li>\n"
"    <li>Encouragement to explore their personality as they learn and play</li>\n"
"    <li>Letter contact with you</li>\n"
"</ul>\n"
"<p style=\"font-size: smaller\">\n"
"    *In agreement with the child's parents\n"
"</p>\n"
"<p>The child will be supported until the end of school, including vocational training, but at most until the age of 22.</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://compassion.ch/de/compassion-weltweit\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Get to know more about the country where <t t-out=\"firstname\"></t> <t t-out=\"&#x27;lives&#x27; if len(child) == 1 else &#x27;live&#x27;\"></t>\n"
"    </a>\n"
"</div>\n"
"<p>Thanks to you, not only a child, but a whole family can find new hope for the future.</p>\n"
"<p>Warm regards,</p>\n"
"<p><t t-if=\"object.send_mode != 'physical'\"><t t-out=\"object.user_id.signature\"/></t><t t-else=\"\"><t t-out=\"object.user_id.short_signature\"/></t></p></div></body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><p>\n"
"   <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"<t t-set=\"plural\" t-value=\"partner.title.plural\"/>\n"
" <t t-set=\"te\" t-value=\"&quot;voi&quot; if plural else &quot;te&quot;\"/>\n"
"<t t-set=\"tu\" t-value=\"&quot;voi&quot; if plural else &quot;tu&quot;\"/>\n"
"<t t-set=\"tua\" t-value=\"&quot;vostra&quot; if plural else &quot;tua&quot;\"/>\n"
"<t t-set=\"tuo\" t-value=\"&quot;vostro&quot; if plural else &quot;tuo&quot;\"/>\n"
"<t t-set=\"tue\" t-value=\"&quot;vostre&quot; if plural else &quot;tue&quot;\"/>\n"
"<t t-set=\"ti\" t-value=\"&quot;vi&quot; if plural else &quot;ti&quot;\"/>\n"
"<t t-set=\"sponsorship\" t-value=\"object.get_objects()\"/>\n"
"<t t-set=\"child\" t-value=\"sponsorship.mapped(&#x27;child_id&#x27;)\"/>\n"
"<t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, &#x27;i vostri bambini&#x27; if plural else &#x27;i tuoi bambini&#x27;, translate=False)\"/>\n"
"<t t-set=\"country\" t-value=\"child.mapped(&#x27;field_office_id&#x27;)\"/>\n"
"<t t-set=\"alumni_name\" t-value=\"country.get_list(&#x27;alumni_representative&#x27;)\"/>\n"
"<t t-set=\"alumni_link\" t-value=\"country.get_list(&#x27;alumni_video_link&#x27;, 1, &#x27;https://vimeo.com/showcase/8314999&#x27;)\"/>\n"
"<t t-set=\"multi_link\" t-value=\"alumni_link == &#x27;https://vimeo.com/showcase/8314999&#x27;\"/>\n"
"   <t t-out=\"partner.salutation\"></t> il <t t-out=\"tuo\"></t> sostegno funziona!\n"
"  </p>\n"
"  <p>\n"
"   <t t-if=\"not multi_link\">\n"
"            <t t-if=\"firstname == &quot;i tuoi bambini&quot;\">\n"
"         \tOggi vorremmo <t t-out=\"&quot;presentarvi&quot; if plural else &quot;presentarti&quot;\"></t> <t t-out=\"alumni_name\"></t>, ex bambini Compassion. Vivono nello stesso continente dei bambini che sostieni.\n"
"            </t>\n"
"<t t-else=\"\">\n"
"              \tOggi vorremmo <t t-out=\"&quot;presentarvi&quot; if plural else &quot;presentarti&quot;\"></t> <t t-out=\"alumni_name\"></t>, ex bambini Compassion. Vivono nello stesso continente di <t t-out=\"firstname\"></t>, <t t-out=\"child.get(&#x27;il bimbo&#x27;)\"></t> che <t t-out=\"&quot;sostenete&quot; if plural else &quot;sostieni&quot;\"></t>.\n"
"           </t>\n"
"\t</t>\n"
"<t t-else=\"\">\n"
"           <t t-if=\"firstname == &quot;i tuoi bambini&quot;\">\n"
"         \tOggi vorremmo <t t-out=\"&quot;presentarvi&quot; if plural else &quot;presentarti&quot;\"></t> <t t-out=\"alumni_name\"></t>, ex bambini Compassion. Vivono nello stesso continente dei bambini che sostieni.\n"
"            </t>\n"
"<t t-else=\"\">\n"
"              \tOggi vorremmo <t t-out=\"&quot;presentarvi&quot; if plural else &quot;presentarti&quot;\"></t> <t t-out=\"alumni_name\"></t>, ex bambini Compassion. Vivono nello stesso continente di <t t-out=\"firstname\"></t>, <t t-out=\"child.get(&#x27;il bimbo&#x27;)\"></t> che <t t-out=\"&quot;sostenete&quot; if plural else &quot;sostieni&quot;\"></t>.\n"
"           </t>\n"
"</t>\n"
"  </p>\n"
"  <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"   <a t-attf-href=\"{{alumni_link}}\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"    Qui la <t t-out=\"child.mapped(&#x27;field_office_id&#x27;).get(&#x27;sua&#x27;)\"></t> storia.\n"
"   </a>\n"
"  </div>\n"
"  <h3 style=\"color: #0054A6; text-transform: uppercase;\">\n"
"   <b>\n"
"    Il <t t-out=\"tuo\"></t> sostegno permette a <t t-out=\"firstname\"></t> di ricevere:\n"
"   </b>\n"
"  </h3>\n"
"  <ul>\n"
"   <li>\n"
"    Accesso alla scuola (tasse scolastiche, uniforme, materiale, tutoraggio)\n"
"   </li>\n"
"   <li>\n"
"    Istruzione (formazione professionale o studi universitari)\n"
"   </li>\n"
"   <li>\n"
"    Assistenza medica\n"
"   </li>\n"
"   <li>\n"
"    Formazione all'igiene,pasti regolari ed equilibrati\n"
"   </li>\n"
"   <li>\n"
"    Amore e cura in una comunità cristiana locale, insegnamento biblico*.\n"
"   </li>\n"
"   <li>\n"
"    Attività per sviluppare i propri talenti\n"
"   </li>\n"
"   <li>\n"
"    Corrispondenza con il sostenitore\n"
"   </li>\n"
"  </ul>\n"
"  <p style=\"font-size: smaller\">\n"
"   *con il consenso dei genitori\n"
"  </p>\n"
"  <p>\n"
"   Ogni bambino è accompagnato fino alla fine della scuola, compresa la formazione professionale, ma non oltre i 22 anni.\n"
"  </p>\n"
"<t t-if=\"False\">\n"
"  <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"   <a href=\"https://compassion.ch/de/compassion-weltweit\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"    <t t-out=\"&#x27;Scoprite&#x27; if plural else &#x27;Scopri&#x27;\"></t> di più sul paese in cui <t t-out=\"&quot;vive&quot; if len(child) == 1 else &quot;vivono&quot;\"></t> <t t-out=\"firstname\"></t>.\n"
"   </a>\n"
"  </div>\n"
"</t>\n"
"  <p>\n"
"   Grazie a <t t-out=\"te\"></t>, non solo un bambino, ma un'intera famiglia troverà una nuova speranza per il futuro.\n"
"  </p>\n"
"  <p>\n"
"   A presto!\n"
"  </p>\n"
"  <p>\n"
"   <t t-if=\"object.send_mode != 'physical'\"><t t-out=\"object.user_id.signature\"/></t><t t-else=\"\"><t t-out=\"object.user_id.short_signature\"/></t>\n"
"  </p>\n"
" </div></body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_sponsorship_confirmation
msgid ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><p>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"    <t t-if=\"len(sponsorships) &gt; 1\">\n"
"        <t t-set=\"has\" t-value=\"&#x27;have&#x27;\"/>\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-set=\"has\" t-value=\"&#x27;has&#x27;\"/>\n"
"    </t>\n"
"    <t t-set=\"others\" t-value=\"partner.sponsorship_ids - sponsorships\"/>\n"
"    <t t-set=\"wp\" t-value=\"&quot;SWP&quot; in sponsorships.mapped(&quot;type&quot;)\"/>\n"
"    <t t-set=\"payer\" t-value=\"object.partner_id in sponsorships.mapped(&#x27;partner_id&#x27;) and len(sponsorships.filtered(&#x27;period_paid&#x27;)) != len(sponsorships)\"/>\n"
"    <t t-set=\"children\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"firstname\" t-value=\"children.get_list(&#x27;preferred_name&#x27;, 3, children.get_number(), translate=False)\"/>\n"
"    <t t-set=\"less_3\" t-value=\"firstname != children.get_number()\"/>\n"
"    <t t-set=\"apos\" t-value=\"&quot;&#x27;&quot; if firstname[-1] == &#x27;s&#x27; else &quot;&#x27;s&quot;\"/>\n"
"    <t t-set=\"payment_attachment\" t-value=\"sponsorships.get_payment_type_attachment_string()\"/>\n"
"    <t t-set=\"is_new\" t-value=\"sponsorships.filtered(&quot;is_first_sponsorship&quot;)\"/>\n"
"    <t t-set=\"number_years\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_years&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_children\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_children&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_fcps\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_fcps&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_countries\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_countries&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_uc\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;years_uc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_lc\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;years_lc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"children_in_poverty\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;children_in_poverty&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"early_deaths\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;early_deaths&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_mothers\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_mothers&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_unacceptable_conditions\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_unacceptable_conditions&#x27;, strip_html=True)\"/>\n"
"</p><p>\n"
"</p>\n"
"    <t t-out=\"partner.salutation\"></t>\n"
"\n"
"<p>\n"
"    <t t-if=\"is_new\">\n"
"        It's so nice to have you as part of the Compassion family!\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        Thank you so much for deciding to sponsor <t t-out=\"&#x27;more children&#x27; if plural else &#x27;another child&#x27;\"></t>.\n"
"    </t>\n"
"</p>\n"
"<p>\n"
"    With your help alongside around <t t-out=\"number_fcps\"></t> partner churches we are currently releasing over <t t-out=\"number_children\"></t> million children from poverty in <t t-out=\"number_countries\"></t> countries. Together we enable children to have a life with hope and a future.\n"
"</p>\n"
"<p>\n"
"    <t t-if=\"payer\">\n"
"        After receiving your first donation, <t t-out=\"&#x27;the children&#x27; if plural else firstname\"></t> will be informed that <t t-out=\"children.get(&#x27;he&#x27;)\"></t> now <t t-out=\"has\"></t> a sponsor.\n"
"        <b>\n"
"            <t t-out=\"payment_attachment\"></t>\n"
"        </b>\n"
"        <t t-if=\"len(partner.sponsorship_ids) == len(sponsorships)\">\n"
"            Please <a href=\"https://compassion.ch/de/zahlungsart-deiner-patenschaft\">click here</a> if you have any questions about your donation.\n"
"        </t>\n"
"    </t>\n"
"</p>\n"
"<p>\n"
"    In a series of short emails over the coming month, we will explain everything you need to know about <t t-out=\"firstname if less_3 else &#x27;the children&#x27;\"></t> and the sponsorship.\n"
"</p>\n"
"    <t t-if=\"is_new\">\n"
"        Register and discover MyCompassion to write to your sponsored <t t-out=\"&#x27;children&#x27; if plural else &#x27;child&#x27;\"></t>, download photos and letters, find out more and adapt information linked to your <t t-out=\"&#x27;sponsorships&#x27; if plural else &#x27;sponsorship&#x27;\"></t> and much more.\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        Just like for your other sponsorships, you will find all of <t t-out=\"firstname + apos if less_3 else &#x27;your sponsored children&#x27;\"></t> information and photos on MyCompassion and you can write to <t t-out=\"children.get(&#x27;him&#x27;)\"></t>.\n"
"    </t>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://mycompassion.ch/de_DE/my/home\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        MyCompassion\n"
"    </a>\n"
"</div>\n"
"<t t-if=\"is_new\">\n"
"    <p>\n"
"        Thank you so much for making the decision to invest in the life of <t t-out=\"firstname if less_3 else &#x27;many children&#x27;\"></t>.\n"
"    </p>\n"
"</t>\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"<t t-if=\"object.send_mode == &quot;digital&quot;\">\n"
"    <p>\n"
"        <t t-out=\"object.user_id.signature\"></t>\n"
"    </p>\n"
"</t>\n"
"</div></body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><p>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"te\" t-value=\"&quot;voi&quot; if plural else &quot;te&quot;\"/>\n"
"    <t t-set=\"tu\" t-value=\"&quot;voi&quot; if plural else &quot;tu&quot;\"/>\n"
"    <t t-set=\"tua\" t-value=\"&quot;vostra&quot; if plural else &quot;tua&quot;\"/>\n"
"    <t t-set=\"tuo\" t-value=\"&quot;vostro&quot; if plural else &quot;tuo&quot;\"/>\n"
"    <t t-set=\"tue\" t-value=\"&quot;vostre&quot; if plural else &quot;tue&quot;\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"is_new\" t-value=\"sponsorships.filtered(&quot;is_first_sponsorship&quot;)\"/>\n"
"    <t t-set=\"others\" t-value=\"partner.sponsorship_ids - sponsorships\"/>\n"
"    <t t-set=\"wp\" t-value=\"&quot;SWP&quot; in sponsorships.mapped(&quot;type&quot;)\"/>\n"
"    <t t-set=\"payer\" t-value=\"object.partner_id in sponsorships.mapped(&#x27;partner_id&#x27;) and len(sponsorships.filtered(&#x27;period_paid&#x27;)) != len(sponsorships)\"/>\n"
"    <t t-set=\"children\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"firstname\" t-value=\"children.get_list(&#x27;preferred_name&#x27;, 3, &#x27;i bambini&#x27;, translate=False)\"/>\n"
"    <t t-set=\"less_3\" t-value=\"firstname != &#x27;i bambini&#x27;\"/>\n"
"    <t t-set=\"payment_type_attachement\" t-value=\"sponsorships.get_payment_type_attachment_string()\"/>\n"
"    <t t-if=\"plural\">\n"
"        <t t-if=\"partner.title.id == 29\">\n"
"            Benvenuta Famiglia <t t-out=\"partner.lastname\"></t>!\n"
"        </t>\n"
"<t t-else=\"\">\n"
"            Benvenuti <t t-out=\"partner.firstname or partner.name\"></t>!\n"
"        </t>\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-out=\"&quot;Benvenuta&quot; if partner.gender == &quot;F&quot; else &quot;Benvenuto&quot;\"></t> <t t-out=\"partner.firstname\"></t>!\n"
"    </t>\n"
"    <t t-set=\"number_years\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_years&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_children\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_children&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_fcps\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_fcps&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_countries\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_countries&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_uc\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;years_uc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_lc\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;years_lc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"children_in_poverty\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;children_in_poverty&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"early_deaths\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;early_deaths&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_mothers\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_mothers&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_unacceptable_conditions\" t-value=\"object.env[&quot;partner.communication.job&quot;].get_snippet(&#x27;number_unacceptable_conditions&#x27;, strip_html=True)\"/>\n"
"</p>\n"
"<p>\n"
"    <t t-if=\"is_new\">\n"
"        Siamo felici che ora <t t-out=\"&quot;fate&quot; if plural else &quot;fai&quot;\"></t> parte della famiglia di Compassion!\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        Grazie mille per aver scelto di investire nella vita di <t t-out=\"&quot;un altro bambino&quot; if len(children) == 1 else &quot;altri bambini&quot;\"></t>.\n"
"    </t>\n"
"</p>\n"
"<p>\n"
"    Insieme a <t t-out=\"te\"></t>, alle <t t-out=\"number_fcps\"></t> chiese locali in <t t-out=\"number_countries\"></t> paesi, stiamo liberando <t t-out=\"number_children\"></t> milioni di bambini dalla povertà estrema. Per una vita piena di speranza, dignità e futuro. \n"
"</p>\n"
"<p>\n"
"    <t t-if=\"payer and not wp\">\n"
"        Dopo la prima donazione ricevuta <t t-out=\"firstname\"></t> <t t-out=\"children.get(&#x27;will be&#x27;)\"></t> informat<t t-out=\"children.get(&#x27;accord_o_a&#x27;)\"></t> di avere finalmente un sostenitore. In allegato la polizza di versamento.\n"
"\n"
"        Se <t t-out=\"&quot;avete&quot; if plural else &quot;hai&quot;\"></t> domande sui metodi di pagamento\n"
"\n"
"        <t t-if=\"object.send_mode == &quot;digital&quot;\">\n"
"            <a href=\"https://compassion.ch/it/metodi-di-pagamento-per-il-sostegno-a-distanza/\">\n"
"                qui <t t-out=\"&quot;trovate&quot; if plural else &quot;trovi&quot;\"></t> più info.\n"
"            </a>\n"
"        </t>\n"
"<t t-else=\"\">\n"
"            <t t-out=\"&quot;trovate&quot; if plural else &quot;trovi&quot;\"></t> più info qui: www.compassion.ch/it/metodi-di-pagamento-per-il-sostegno-a-distanza\n"
"        </t>\n"
"    </t>\n"
"<t t-elif=\"wp\">\n"
"        <t t-if=\"sponsorships.filtered(&quot;total_amount&quot;)\">\n"
"            La cosa speciale del sostegno \"Write &amp; Pray\" è il lavoro di squadra. <t t-out=\"tu.title()\"></t> <t t-out=\"&quot;siete&quot; if plural else &quot;sei&quot;\"></t> il sostenitore che scrive una lettera a <t t-out=\"firstname\"></t> almeno due volte l'anno e <t t-out=\"&quot;pregate&quot; if plural else &quot;prega&quot;\"></t> per <t t-out=\"children.get(&#x27;lui&#x27;)\"></t>. Un altro donatore fornirà il saldo del sostegno a distanza per <t t-out=\"firstname\"></t>.  Dopo che riceveremo la <t t-out=\"tua\"></t>  prima donazione per <t t-out=\"firstname\"></t>, <t t-out=\"children.get(&#x27;lui&#x27;)\"></t> <t t-out=\"children.get(&#x27;will be&#x27;)\"></t> informat<t t-out=\"children.get(&#x27;accord_o_a&#x27;)\"></t> di avere finalmente un sostenitore.  In allegato la polizza di versamento.\n"
"\n"
"            <t t-if=\"len(partner.sponsorship_ids) == len(sponsorships)\">\n"
"                Se <t t-out=\"&quot;avete&quot; if plural else &quot;hai&quot;\"></t> domande sulla donazione\n"
"\n"
"            <t t-if=\"object.send_mode == &quot;digital&quot;\">\n"
"                <a href=\"https://compassion.ch/it/metodi-di-pagamento-per-il-sostegno-a-distanza/\">\n"
"                    qui <t t-out=\"&quot;trovate&quot; if plural else &quot;trovi&quot;\"></t> più info.\n"
"                </a>\n"
"            </t>\n"
"<t t-else=\"\">\n"
"                <t t-out=\"&quot;trovate&quot; if plural else &quot;trovi&quot;\"></t> più info qui: www.compassion.ch/it/metodi-di-pagamento-per-il-sostegno-a-distanza\n"
"                </t>\n"
"            </t>\n"
"        </t>\n"
"<t t-else=\"\">\n"
"            Tra qualche giorno, <t t-out=\"firstname\"></t> <t t-out=\"children.get(&#x27;will be&#x27;)\"></t> informat<t t-out=\"children.get(&#x27;accord_o_a&#x27;)\"></t> di avere finalmente un sostenitore. Questo sarà un giorno di gioia per <t t-out=\"children.get(&#x27;lui&#x27;)\"></t> e la sua famiglia! Ciò che rende il sostegno \"Write &amp; Pray\" così speciale è il lavoro di squadra. <t t-out=\"tu.title()\"></t> <t t-out=\"&quot;siete&quot; if plural else &quot;sei&quot;\"></t> il sostenitore che scrive una lettera a <t t-out=\"firstname\"></t> almeno due volte l'anno e <t t-out=\"&quot;pregate&quot; if plural else &quot;prega&quot;\"></t> per <t t-out=\"children.get(&#x27;lui&#x27;)\"></t>. Un altro donatore fornisce il sostegno finanziario.\n"
"        </t>\n"
"    </t>\n"
"</p>\n"
"<p>\n"
"    <t t-out=\"&quot;Riceverete&quot; if plural else &quot;Riceverai&quot;\"></t> nel corso del mese, una serie di brevi e-mail che spiegheranno tutto quello che c'è da sapere su <t t-out=\"children.get_list(&#x27;preferred_name&#x27;, translate=False)\"></t> e sul sostegno. \n"
"</p>\n"
"<p>\n"
"    <t t-if=\"is_new\">\n"
"        <t t-out=\"&quot;Registratevi e scoprite&quot; if plural else &quot;Registrati e scopri&quot;\"></t> <t t-out=\"&quot;MyCompassion&quot; if object.send_mode==&quot;digital&quot; else &quot;www.mycompassion.ch&quot;\"></t> per scrivere <t t-out=\"children.get(&#x27;al bambino&#x27;)\"></t>, scaricare lettere e foto, visualizzare e personalizzare le informazioni sul <t t-out=\"tuo\"></t> sostegno e altro ancora.\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-out=\"&quot;Potrete&quot; if plural else &quot;Potrai&quot;\"></t> trovare tutte le informazioni e le foto di <t t-out=\"firstname\"></t> in <t t-out=\"&quot;MyCompassion&quot; if object.send_mode==&quot;digital&quot; else &quot;www.mycompassion.ch&quot;\"></t>, da cui <t t-out=\"&quot;potrete&quot; if plural else &quot;potrai&quot;\"></t> anche scrivere le <t t-out=\"tue\"></t> lettere.\n"
"    </t>\n"
"</p>\n"
"<t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"    <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"        <a href=\"https://mycompassion.ch/it_IT/my/home\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            MyCompassion\n"
"        </a>\n"
"    </div>\n"
"</t>\n"
"<t t-if=\"is_new\">\n"
"    <p>\n"
"        Grazie di cuore per aver deciso di investire nella vita di <t t-out=\"children.get_list(&#x27;preferred_name&#x27;, translate=False)\"></t>!\n"
"    </p>\n"
"</t>\n"
"<p>\n"
"    A presto,\n"
"</p>\n"
"<t t-if=\"object.send_mode == &quot;digital&quot;\">\n"
"    <p>\n"
"        <t t-if=\"object.send_mode != 'physical'\"><t t-out=\"object.user_id.signature\"/></t><t t-else=\"\"><t t-out=\"object.user_id.short_signature\"/></t>\n"
"    </p>\n"
"</t>\n"
"</div></body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step1
msgid ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><p>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"children\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"one_child\" t-value=\"len(children) == 1\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"deine_patenkinder\" t-value=\"&#x27;your sponsored children&#x27;\"/>\n"
"    <t t-set=\"firstname\" t-value=\"children.get_list(&#x27;preferred_name&#x27;, 3, deine_patenkinder, translate=False)\"/>\n"
"    <t t-set=\"less_4\" t-value=\"firstname != deine_patenkinder\"/>\n"
"    <t t-set=\"wp\" t-value=\"&quot;SWP&quot; in sponsorships.mapped(&quot;type&quot;)\"/>\n"
"</p>\n"
"<p>\n"
"    <t t-out=\"partner.informal_salutation\"></t>\n"
"</p>\n"
"<t t-if=\"sponsorships.filtered(&quot;is_first_sponsorship&quot;)\">\n"
"    <p>\n"
"        This is the first of five emails that you will receive from us.\n"
"    </p>\n"
"    <p>\n"
"        Today we will help you get to know <t t-out=\"children.get_child_preposition_country(&#x27;from_preposition&#x27;, child_limit=3, country_limit=3, child_substitution=deine_patenkinder, country_substitution=deine_patenkinder)\"></t> better (PDF attached).\n"
"    </p>\n"
"    <p>\n"
"        Did you know that you can visit your sponsored <t t-out=\"&#x27;children&#x27; if not one_child else &#x27;child&#x27;\"></t>?\n"
"    </p>\n"
"    <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"        <a href=\"https://compassion.ch/de/reisen/\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            More information on visits\n"
"        </a>\n"
"    </div>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    <p>\n"
"        Thank you for deciding to invest in the life of <t t-out=\"&#x27;more children&#x27; if not one_child else &#x27;another child&#x27;\"></t>!\n"
"    </p>\n"
"</t>\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"<p>\n"
"    <t t-out=\"object.user_id.signature\"></t>\n"
"</p>\n"
"</div></body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><p>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"children\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural\"/>\n"
"    <t t-set=\"firstname\" t-value=\"children.get_list(&#x27;preferred_name&#x27;, 3, &#x27;i vostri bambini&#x27; if plural else &#x27;i tuoi bambini&#x27;, translate=False)\"/>\n"
"    <t t-set=\"te\" t-value=\"&quot;voi&quot; if plural else &quot;te&quot;\"/>\n"
"    <t t-set=\"tu\" t-value=\"&quot;voi&quot; if plural else &quot;tu&quot;\"/>\n"
"    <t t-set=\"tua\" t-value=\"&quot;vostra&quot; if plural else &quot;tua&quot;\"/>\n"
"    <t t-set=\"tuo\" t-value=\"&quot;vostro&quot; if plural else &quot;tuo&quot;\"/>\n"
"    <t t-set=\"tue\" t-value=\"&quot;vostre&quot; if plural else &quot;tue&quot;\"/>\n"
"    <t t-set=\"ti\" t-value=\"&quot;vi&quot; if plural else &quot;ti&quot;\"/>\n"
"    <t t-set=\"vive\" t-value=\"&quot;vive&quot;\"/>\n"
"    <t t-if=\"&quot;,&quot; in firstname or firstname == &quot;i tuoi bambini&quot; or firstname == &quot;i vostri bambini&quot;\">\n"
"        <t t-set=\"vive\" t-value=\"&quot;vivono&quot;\"/>\n"
"    </t>\n"
"</p>\n"
"<p>\n"
"    <t t-out=\"partner.salutation\"></t>\n"
"</p>\n"
"<p>\n"
"    <t t-if=\"sponsorships.filtered(&quot;is_first_sponsorship&quot;)\">\n"
"\t    Questa è la prima delle cinque e-mail che abbiamo annunciato.\n"
"    </t>\n"
"</p>\n"
"<p>\n"
"    Oggi <t t-out=\"ti\"></t> presentiamo meglio: <t t-out=\"firstname\"></t> che <t t-out=\"vive\"></t> in <t t-out=\"children.get_list(&#x27;field_office_id.country_id.name&#x27;, 3, &#x27;diversi paesi&#x27;)\"></t>. (in allegato il PDF)\n"
"</p>\n"
"<p>\n"
"    <t t-if=\"False\">   \n"
"        <t t-out=\"&#x27;Sapevate&#x27; if plural else &#x27;Sapevi&#x27;\"></t> che è possibile fare visita <t t-out=\"children.get(&#x27;al bambino&#x27;)\"></t> che <t t-out=\"&#x27;sostenete&#x27; if plural else &#x27;sostieni&#x27;\"></t>?\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://compassion.ch/de/reisen/\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        INFORMAZIONI SULLE VISITE\n"
"    </a>\n"
"</div>\n"
"    </t>\n"
"    <t t-if=\"not sponsorships.filtered(&quot;is_first_sponsorship&quot;)\">\n"
"        <p>\n"
"            Grazie di cuore per aver deciso di investire nella vita di un altro bambino! Cambiamo il mondo, un bambino alla volta.\n"
"        </p>\n"
"    </t>\n"
"    <p>\n"
"        Cordiali Saluti\n"
"    </p>\n"
"    <p>\n"
"        <t t-if=\"object.send_mode != 'physical'\"><t t-out=\"object.user_id.signature\"/></t><t t-else=\"\"><t t-out=\"object.user_id.short_signature\"/></t>\n"
"    </p>\n"
" </div></body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_no_sub
msgid ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><p>\n"
"   <t t-out=\"object.partner_id.salutation\"></t>,\n"
"   <br/>\n"
"   <br/>\n"
"   We understand and acknowledge  you have decided not to take over a new sponsorship at this time.\n"
"   <br/>\n"
"   <br/>\n"
"   Thank you for your past investment in the life of a child living in poverty.  More than 70 years of experience assures us that this commitment produces sustainable results. <t t-out=\"object.success_sentence or &#x27;&#x27;\"></t>\n"
"   <br/>\n"
"   <br/>\n"
"   If you have set up an automatic payment order for your sponsorship, please cancel it.\n"
"   <br/>\n"
"   <br/>\n"
"   Did you know that you can also help children in poverty by giving them access to drinking water (water filters, toilet installations, hygiene awareness)? With a one-time gift or regular donations of CHF 10, 20 or 30 per month - you can make a big difference.\n"
"   <br/>\n"
"   <br/>\n"
"   If you are interested, please call us at 031 552 21 25 or you can also donate online on www.compassion.ch/spenden\n"
"   <br/>\n"
"   <br/>\n"
"   Thank you again for your generosity so far.\n"
"<t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"   <br/>\n"
"   <br/>\n"
"   Best regards,\n"
"   <br/>\n"
"   <br/>\n"
"     <t t-out=\"object.user_id.signature\"></t>\n"
"</t>\n"
"  </p>\n"
" </div></body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div class=\"communication-text\" t-att-style=\"&#x27;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;&#x27; if object.send_mode != &#x27;physical&#x27; else None\"><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"te\" t-value=\"&quot;voi&quot; if plural else &quot;te&quot;\"/>\n"
"    <t t-set=\"tu\" t-value=\"&quot;voi&quot; if plural else &quot;tu&quot;\"/>\n"
"    <t t-set=\"tua\" t-value=\"&quot;vostra&quot; if plural else &quot;tua&quot;\"/>\n"
"    <t t-set=\"tuo\" t-value=\"&quot;vostro&quot; if plural else &quot;tuo&quot;\"/>\n"
"    <t t-set=\"tue\" t-value=\"&quot;vostre&quot; if plural else &quot;tue&quot;\"/>\n"
"    <t t-set=\"ti\" t-value=\"&quot;vi&quot; if plural else &quot;ti&quot;\"/>\n"
"    <t t-set=\"Ti\" t-value=\"&quot;Vi&quot; if plural else &quot;Ti&quot;\"/>\n"
"    <t t-set=\"puoi\" t-value=\"&quot;potete&quot; if plural else &quot;puoi&quot;\"/>\n"
"    <t t-set=\"Sapevi\" t-value=\"&quot;Sapete&quot; if plural else &quot;Sapevi&quot;\"/>\n"
"    <t t-set=\"potessi\" t-value=\"&quot;poteste&quot; if plural else &quot;potessi&quot;\"/>\n"
"    <t t-set=\"name\" t-value=\"object.get_objects().mapped(&#x27;child_id&#x27;).get_list(&#x27;preferred_name&#x27;, translate=False)\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"object.partner_id.salutation\"></t>\n"
"</p>\n"
"<p>\n"
"    Con la presente confermiamo la <t t-out=\"tua\"></t> decisione di non sostenere <t t-out=\"name\"></t>, di cui <t t-out=\"ti\"></t> abbiamo recentemente fornito le informazioni.\n"
"</p>\n"
"<p>\n"
"    Grazie per il <t t-out=\"tuo\"></t> impegno verso i bambini in estrema povertà. Siamo sicuri che il <t t-out=\"tuo\"></t> sostegno finora ha fatto una significativa differenza.\n"
"</p>\n"
"<p>\n"
"    Il sostegno a distanza dei bambini è solo una parte del programma di Compassion.\n"
"    <br/><br/>\n"
"    <t t-out=\"Sapevi\"></t> che è possibile fornire supporto alle donne incinte e alle madri di neonati in difficoltà? Il programma \"Mamme e Neonati\" permette, con una donazione una tantum o regolare di fare una grande differenza: assistenza medica durante la gravidanza, parto in una struttura medica, consulenza per diventare genitori, assistenza psicologica, sociale e spirituale, sostegno materiale e formazione per la generazione di reddito.\n"
"    <br/><br/>\n"
"    Con CHF15.-  <t t-out=\"puoi\"></t> sostenere una donna e il suo bambino per una settimana intera. \n"
"    <br/><br/>\n"
"    <t t-out=\"Ti\"></t> saremmo grati se <t t-out=\"potessi\"></t> contattarci o fare una donazione per <a href=\"https://compassion.ch/it/aiuto-per-mamme-e-neonati/\">Il programma mamme e neonati</a>.\n"
"</p>\n"
"<p>\n"
"    Cordiali saluti\n"
"</p>\n"
"<p>\n"
"<t t-if=\"object.send_mode == &quot;digital&quot;\">\n"
"    <t t-out=\"object.user_id.signature\"></t>\n"
"</t>\n"
"</p></div></body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.sms_confirmation_email_1
msgid ""
"<html>\n"
"  <body><div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    <t t-set=\"sponsorship\" t-value=\"object.get_objects()\"/>\n"
"                    <t t-set=\"child\" t-value=\"sponsorship.child_id\"/>\n"
"<t t-set=\"image_url\" t-value=\"child.image_url.replace(&#x27;media.ci.org/&#x27;, &#x27;media.ci.org/g_face,c_thumb,w_150,h_150,r_max/&#x27;) if child.image_url else None\"/>\n"
"<t t-set=\"confirmation_url\" t-value=\"&quot;/child/&quot; + str(child.id) + &quot;/sponsor/confirmation?face_reveal=1&quot;\"/>\n"
"                </div>\n"
"<t t-if=\"image_url\">\n"
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;text-align:center;&gt;&#10;&lt;img src=\">\n"
"</div>\n"
"</t>\n"
"                <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                  Hello!\n"
"                  </p>\n"
"                  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                   It's so wonderful that you wish to invest in the life of <t t-out=\"child.preferred_name\"></t>. You will change <t t-out=\"child.get(&quot;his&quot;)\"></t> life in a sustainable way.\n"
"                    <br/><br/>\n"
"                    <a t-attf-href=\"{{confirmation_url}}\" style=\"background-color:transparent;color:#0055A6;text-decoration: underline;\">Click here</a> to complete your details.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    Best regards,\n"
"<br/><br/>\n"
" <t t-out=\"object.user_id.preferred_name\"></t> <t t-out=\"object.user_id.lastname\"></t>\n"
"   <br/>\n"
"   <t t-out=\"object.user_id.employee_ids.department_id.name\"></t>\n"
"   <br/>\n"
"   <t t-out=\"object.user_id.company_id.address_name\"></t>\n"
"                </p>\n"
"            </body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"   <t t-set=\"sponsorship\" t-value=\"object.get_objects()\"/>\n"
"<t t-set=\"child\" t-value=\"sponsorship.child_id\"/>\n"
"                    \n"
"<t t-set=\"image_url\" t-value=\"child.image_url.replace(&#x27;media.ci.org/&#x27;, &#x27;media.ci.org/g_face,c_thumb,w_150,h_150,r_max/&#x27;) if child.image_url else None\"/>\n"
"  <t t-set=\"confirmation_url\" t-value=\"&quot;/child/&quot; + str(child.id) + &quot;/sponsor/confirmation?face_reveal=1&quot;\"/>\n"
"  </div>\n"
"<t t-if=\"image_url\">  \n"
"<div style=\"text-align: center;\">\n"
"   <img t-attf-src=\"{{image_url}}\"/>\n"
"  </div>\n"
"</t>\n"
"  <h1 style=\"text-align: center; line-height: 1.2;\">\n"
"   Grazie per il tuo sostegno!\n"
"  </h1>\n"
"  <p>\n"
"   Ciao!\n"
"  </p>\n"
"  <p>\n"
"   È così bello che hai deciso di investire nella vita di <t t-out=\"child.preferred_name\"></t>. Farai una differenza duratura nella sua vita. \n"
"  </p>\n"
"  <p>\n"
"   <a t-attf-href=\"{{confirmation_url}}\" style=\"color: #0055A6; text-decoration: underline;\">Clicca qui</a> per inserire i tuoi dati.\n"
"  </p>\n"
"  <p>\n"
"   Insieme, stiamo cambiando il mondo. Un bambino alla volta.\n"
"  </p>\n"
"  <p>\n"
"   A presto!\n"
"  </p>\n"
"  <p>\n"
"    <t t-out=\"object.user_id.short_signature\"></t>\n"
"  </p>\n"
" </body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_wrpr_child_info
msgid ""
"<html>\n"
"  <body><div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"child\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"du\" t-value=\"&#x27;ihr&#x27; if plural else &#x27;du&#x27;\"/>\n"
"    <t t-set=\"deine\" t-value=\"&#x27;eure&#x27; if plural else &#x27;deine&#x27;\"/>\n"
"    <t t-set=\"firstname\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;).get_list(&#x27;preferred_name&#x27;, 3, deine + &#x27;n Patenkindern&#x27;, False)\"/>\n"
"    <t t-set=\"dir\" t-value=\"&#x27;euch&#x27; if plural else &#x27;dir&#x27;\"/>\n"
"    <t t-set=\"dich\" t-value=\"&#x27;euch&#x27; if plural else &#x27;dich&#x27;\"/>\n"
"    <t t-set=\"deine_patenkinder\" t-value=\"&#x27;deine Patenkinder&#x27; if not plural else &#x27;eure Patenkinder&#x27;\"/>\n"
"    <t t-set=\"chat_url\" t-value=\"&quot;https://mycompassion.ch/im_livechat/support/2&quot;\"/>\n"
"        <t t-if=\"partner.user_ids.login_date\">\n"
"        <t t-set=\"my_url\" t-value=\"&quot;https://mycompassion.ch/my/children&quot;\"/>\n"
"        <t t-set=\"chat_url\" t-value=\"my_url\"/>\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-if=\"partner.email and not partner.signup_url\">\n"
"            <t t-if=\"not partner.env[&quot;res.users&quot;].search_count([(&quot;login&quot;, &quot;=&quot;, partner.email)])\">\n"
"                <t t-set=\"void\" t-value=\"partner.env[&quot;res.partner.create.portal.wizard&quot;].with_context(active_ids=partner.ids).create({&quot;create_communication&quot;: False}).button_create_portal_user()\"/>\n"
"            </t>\n"
"            <t t-set=\"void\" t-value=\"partner.action_signup_prepare()\"/>\n"
"            <t t-set=\"void\" t-value=\"partner.env.clear()\"/>\n"
"        </t>\n"
"        <t t-set=\"my_url\" t-value=\"partner.signup_url or &quot;https://mycompassion.ch/web/signup&quot;\"/>\n"
"    </t>\n"
"</div>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"2/8:\n"
"<br/><t t-out=\"partner.salutation\"></t>\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">Heute stellen wir <t t-out=\"dir\"></t> <t t-out=\"child.get_child_preposition_country(child_limit=3, country_limit=3, child_substitution=deine_patenkinder, country_substitution=deine_patenkinder)\"></t> besser vor.\n"
"</p><p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    <t t-if=\"not sponsorships.filtered(&quot;is_first_sponsorship&quot;) and partner.user_ids\">\n"
"Wie bisher <t t-out=\"&quot;werdet ihr&quot; if plural else &quot;wirst du&quot;\"></t> alle Informationen zu <t t-out=\"deine\"></t>r <t t-out=\"child.get(&#x27;Patenschaft&#x27;)\"></t> in MyCompassion finden: <a t-attf-href=\"{{my_url}}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\"><t t-out=\"my_url\"></t></a>\n"
"    </t>\n"
"<t t-else=\"\">\n"
"<t t-out=\"&quot;Registriert euch&quot; if plural else &quot;Registriere dich&quot;\"></t> dazu auf MyCompassion: <a t-attf-href=\"{{my_url}}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\"><t t-out=\"my_url\"></t></a>\n"
"    </t>\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\"><t t-out=\"&quot;Stellt euch&quot; if plural else &quot;Stell dir&quot;\"></t> einmal <t t-out=\"child.get(&#x27;seine&#x27;)\"></t> Herausforderungen und Träume vor und wie <t t-out=\"du\"></t> <t t-out=\"child.get(&#x27;ihn&#x27;)\"></t> darin ermutigen und unterstützen <t t-out=\"&quot;könnt&quot; if plural else &quot;kannst&quot;\"></t>.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">Danke, dass <t t-out=\"du\"></t> einen Unterschied im Leben von <t t-out=\"firstname\"></t> <t t-out=\"&quot;macht&quot; if plural else &quot;machst&quot;\"></t>.</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"Liebe Grüsse<br/>\n"
"Sarah<br/>\n"
"Tel: +41 (0)31 552 21 21<br/>\n"
"Fragen? <a t-attf-href=\"{{chat_url}}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\"><t t-out=\"chat_url\"></t></a>\n"
"</p>\n"
"        </body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"child\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"firstname\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;).get_list(&#x27;preferred_name&#x27;, 0, False)\"/>\n"
"    <t t-set=\"chat_url\" t-value=\"&#x27;https://mycompassion.ch/fr_CH/im_livechat/support/3&#x27;\"/>\n"
"    <t t-set=\"delimiter\" t-value=\"&#x27; &#x27;\"/>\n"
"    <t t-set=\"country\" t-value=\"child.get_child_preposition_country(&#x27;from_preposition&#x27;)\"/>\n"
"    <t t-set=\"idx\" t-value=\"country.find(&#x27;da&#x27;)   \"/>\n"
"    <t t-set=\"country\" t-value=\"country[idx:]\"/>\n"
"    <t t-if=\"country[2:] in (&#x27;Ecuador&#x27;, &#x27;Etiopia&#x27;, &#x27;Indonesia&#x27;)\">\n"
"        <t t-set=\"country\" t-value=\"country.replace(&quot;da&quot;, &quot;dall&#x27;&quot;)\"/>\n"
"    </t>\n"
"<t t-elif=\"country[2:] in (&#x27;Bangladesh&#x27;, &#x27;Brasile&#x27;, &#x27;Burkina Faso&#x27;, &#x27;Ghana&#x27;, &#x27;Guatemala&#x27;)\">\n"
"        <t t-set=\"country\" t-value=\"country.replace(&quot;da&quot;, &quot;dal &quot;)\"/>\n"
"    </t>\n"
"<t t-elif=\"country[2:] in (&#x27;Bolivia&#x27;, &#x27;Colombia&#x27;, &#x27;Repubblica Dominicana&#x27;)\">\n"
"        <t t-set=\"country\" t-value=\"country.replace(&quot;da&quot;, &quot;dalla &quot;)\"/>\n"
"    </t>\n"
"<t t-elif=\"country[2:] in (&#x27;Filippine&#x27;)\">\n"
"        <t t-set=\"country\" t-value=\"country.replace(&quot;da&quot;, &quot;dalle &quot;)\"/>\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-set=\"country\" t-value=\"country.replace(&quot;da&quot;, &quot;da &quot;)\"/>\n"
"    </t>\n"
"    <t t-set=\"country\" t-value=\"(firstname + &#x27; &#x27; + country).strip()\"/>\n"
"    <t t-if=\"child.gender == &#x27;M&#x27;\">\n"
"        <t t-set=\"incoraggiarlo\" t-value=\"&#x27;incoraggiarlo&#x27;\"/>\n"
"        <t t-set=\"sostenerlo\" t-value=\"&#x27;sostenerlo&#x27;\"/>\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-set=\"incoraggiarlo\" t-value=\"&#x27;incoraggiarla&#x27;\"/>\n"
"        <t t-set=\"sostenerlo\" t-value=\"&#x27;sostenerla&#x27;\"/>\n"
"    </t>\n"
"     <t t-if=\"partner.user_ids.login_date\">\n"
"        <t t-set=\"my_url\" t-value=\"&quot;https://mycompassion.ch/my/children&quot;\"/>\n"
"        <t t-set=\"chat_url\" t-value=\"my_url\"/>\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-if=\"partner.email and not partner.signup_url\">\n"
"            <t t-if=\"not partner.env[&quot;res.users&quot;].search_count([(&quot;login&quot;, &quot;=&quot;, partner.email)])\">\n"
"                <t t-set=\"void\" t-value=\"partner.env[&quot;res.partner.create.portal.wizard&quot;].with_context(active_ids=partner.ids).create({&quot;create_communication&quot;: False}).button_create_portal_user()\"/>\n"
"            </t>\n"
"            <t t-set=\"void\" t-value=\"partner.action_signup_prepare()\"/>\n"
"            <t t-set=\"void\" t-value=\"partner.env.clear()\"/>\n"
"        </t>\n"
"        <t t-set=\"my_url\" t-value=\"partner.signup_url or &quot;https://mycompassion.ch/web/signup&quot;\"/>\n"
"    </t>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.salutation\"></t>\n"
"</p>\n"
"<p>\n"
"    Oggi ti presentiamo <t t-out=\"country\"></t>.\n"
"</p>\n"
"<p>\n"
"    Per farlo, registrati su MyCompassion: <a t-attf-href=\"{{my_url}}\"><t t-out=\"my_url\"></t></a>\n"
"</p>\n"
"<p>\n"
"    Scopri le sue sfide e i suoi sogni e come puoi <t t-out=\"incoraggiarlo\"></t> e <t t-out=\"sostenerlo\"></t>.\n"
"</p>\n"
"<p>\n"
"    Grazie per aver fatto la differenza nella vita di <t t-out=\"firstname\"></t>.\n"
"</p><p>\n"
"</p><p>\n"
"    Buona giornata e a presto!<br/>\n"
"    Il team di Compassion<br/>\n"
"Tel: +41 (0)24 434 21 24<br/>\n"
"Hai domande? WhatsApp: +41 (0)79 622 31 97\n"
"</p>\n"
"        </body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.csp_mail_template
msgid ""
"<html>\n"
"  <body><div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   <t t-set=\"contracts\" t-value=\"object.get_objects()\"/>\n"
"                    \n"
"<t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   <t t-out=\"partner.salutation\"></t>,\n"
"   <br/>\n"
"   <br/>\n"
"   Thank you to support a child survival program from Compassion.\n"
"   <br/>\n"
"   <br/>\n"
"   From pregnancy through infanthood, Child Survival offers help that moms and babies desperately need to survive and thrive. More than 64,598 moms and babies have been helped to date! Through our Child Survival Centers, we ensure mothers and babies receive any of the following:\n"
"   <br/>\n"
"  </p>\n"
"  <ul style=\"margin:0px 0 1rem 0;\">\n"
"   <li>\n"
"    Basic Nutrition in the form of clean water, healthy food and vitamins.\n"
"   </li>\n"
"   <li>\n"
"    Pre-natal and post-natal medical exams to monitor mom and baby’s health.\n"
"   </li>\n"
"   <li>\n"
"    Critical medical resources such as child birth assistance.\n"
"   </li>\n"
"   <li>\n"
"    Monthly growth monitoring to protect the children from malnutrition.\n"
"   </li>\n"
"   <li>\n"
"    Immunizations and other medical care for newborns and babies.\n"
"   </li>\n"
"   <li>\n"
"    Mentoring from a survival specialist that gives one-on-one coaching and support.\n"
"   </li>\n"
"   <li>\n"
"    Opportunities for infants to learn cognitive skills.\n"
"   </li>\n"
"   <li>\n"
"    Workshops that teach mothers parenting and survival skills.\n"
"   </li>\n"
"   <li>\n"
"    Home visits to check in on mother and baby.\n"
"   </li>\n"
"   <li>\n"
"    Emotional support from a community of moms facing the same fears.\n"
"   </li>\n"
"  </ul>\n"
"  Each Child Survival Center is staffed with warm, caring, knowledgeable individuals that serve mothers and babies extremely well. Your donations give children under 1 year old a head start toward a healthy life!\n"
"  <br/>\n"
"  <br/>\n"
"  There is no correspondence with the mothers, nevertheless you will receive a newsletter with information about the program and testimonies from mothers.\n"
"  <br/>\n"
"  <br/>\n"
"  Please do not hesitate to contact us if you have any questions.\n"
"  <br/>\n"
"  <br/>\n"
"  Sincerely\n"
" </body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"new_contracts\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"contracts\" t-value=\"partner.other_contract_ids\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"partner.sponsorship_ids.filtered(&#x27;is_active&#x27;)\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29 or not partner.title\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.salutation\"></t>,\n"
"</p>\n"
"<p>\n"
"    Grazie di cuore per aver deciso di sostenere il nostro programma di aiuto per mamme e neonati (CSP).\n"
"</p>\n"
"<p>\n"
"    Questo programma è progettato specificamente per le madri e i loro bambini, nonché per le donne incinte che vivono in condizioni di estrema povertà. Il programma fornisce sostegno per i loro bisogni fisici, economici e sociali prima e dopo il parto. Numerosi studi dimostrano che il primo anno di vita è cruciale nella vita di un bambino. Grazie al <t t-out=\"&#x27;vostro&#x27; if plural else &#x27;tuo&#x27;\"></t> sostegno, neonati e madri beneficiano di:\n"
"</p>\n"
"<ul>\n"
"    <li>cibo e vitamine</li>\n"
"    <li>controlli medici prima e dopo il parto</li>\n"
"    <li>controlli mensili per prevenire la malnutrizione</li>\n"
"    <li>vaccinazioni e assistenza medica per i neonati (fino a un anno di età)</li>\n"
"    <li>accompagnamento spirituale e coaching per madri e donne incinte</li>\n"
"    <li>sostegno allo sviluppo cognitivo dei bambini</li>\n"
"    <li>laboratori educativi per le madri</li>\n"
"    <li>incoraggiamento da parte di altre madri</li>\n"
"    <li>visite a domicilio</li>\n"
"</ul>\n"
"<p>\n"
"    <t t-out=\"&#x27;Vi&#x27; if plural else &#x27;Ti&#x27;\"></t> ringraziamo per la <t t-out=\"&#x27;vostra&#x27; if plural else &#x27;tua&#x27;\"></t> generosità. Grazie a <t t-out=\"&#x27;voi&#x27; if plural else &#x27;te&#x27;\"></t>, possiamo fare tutto il possibile per garantire a questi bambini un buon inizio di vita: una fonte di speranza e conforto per tante madri in difficoltà.\n"
"</p>\n"
"<p>\n"
"    Siamo a disposizione per qualsiasi domanda su questo programma.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"<t t-if=\"object.send_mode == &quot;digital&quot;\">\n"
"    <p>\n"
"        <t t-out=\"object.user_id.signature\"></t>\n"
"    </p>\n"
"% endif</body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_anniversary_5
msgid ""
"<html>\n"
"  <body><div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"                    \n"
"<t t-set=\"child\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"                    \n"
"<t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, child.get_number(), False)\"/>\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"Congratulations! It’s been 5 years since you’ve been supporting <t t-out=\"firstname\"></t>! On behalf of the entire team at Compassion Switzerland, we would like to thank you for your commitment to a child in extreme poverty.\n"
"   <br/>\n"
"   <br/>\n"
"   Your sponsorship has a great impact on the development of this child. It enables <t t-out=\"child.get(&#x27;him&#x27;)\"></t> to live a life without extreme poverty but with dignity and real hope. <t t-out=\"firstname\"></t> is one of 2,3 million children currently supported by Compassion’s sponsorship program. Thank you for working together with us.\n"
"   <br/>\n"
"   <br/>\n"
"   Yours sincerely.\n"
"   <br/>\n"
"  </p>\n"
" <t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"        <t t-out=\"object.user_id.signature\"></t>\n"
"    </p>\n"
"</t>\n"
"</body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"te\" t-value=\"&quot;voi&quot; if plural else &quot;te&quot;\"/>\n"
"    <t t-set=\"tu\" t-value=\"&quot;voi&quot; if plural else &quot;tu&quot;\"/>\n"
"    <t t-set=\"tua\" t-value=\"&quot;vostra&quot; if plural else &quot;tua&quot;\"/>\n"
"    <t t-set=\"tuo\" t-value=\"&quot;vostro&quot; if plural else &quot;tuo&quot;\"/>\n"
"    <t t-set=\"tue\" t-value=\"&quot;vostre&quot; if plural else &quot;tue&quot;\"/>\n"
"    <t t-set=\"ti\" t-value=\"&quot;vi&quot; if plural else &quot;ti&quot;\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()      \"/>\n"
"    <t t-set=\"child\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, child.get_number(), False)\"/>\n"
"    <t t-set=\"number_years\" t-value=\"object.get_snippet(&#x27;number_years&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_children\" t-value=\"object.get_snippet(&#x27;number_children&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_fcps\" t-value=\"object.get_snippet(&#x27;number_fcps&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_countries\" t-value=\"object.get_snippet(&#x27;number_countries&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_uc\" t-value=\"object.get_snippet(&#x27;years_uc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_lc\" t-value=\"object.get_snippet(&#x27;years_lc&#x27;, strip_html=True)\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"object.partner_id.salutation\"></t>,\n"
"</p>\n"
"<p>\n"
"    Siamo arrivati a 5 anni! Super!\n"
"</p>\n"
"<p>\n"
"    Negli ultimi 5 anni, <t t-out=\"&quot;avete&quot; if plural else &quot;hai&quot;\"></t> sostenuto <t t-out=\"firstname\"></t> e <t t-out=\"&quot;avete&quot; if plural else &quot;hai&quot;\"></t> contribuito a far<t t-out=\"child.get(&quot;lo&quot;)\"></t> uscire dalla povertà estrema. Ogni giorno un pochino di più.\n"
"</p>\n"
"<p>\n"
"    Sostenendo <t t-out=\"firstname\"></t>, <t t-out=\"&quot;state&quot; if plural else &quot;stai&quot;\"></t> dandon<t t-out=\"child.get(&quot;gli&quot;)\"></t> anche il coraggio di avere dei sogni e perseguirli.\n"
"</p>\n"
"<p>\n"
"    Grazie per la <t t-out=\"tua\"></t> preziosa fedeltà. <t t-out=\"firstname\"></t> è uno degli oltre <t t-out=\"number_children\"></t> milioni di bambini attualmente supportati da un sostenitore di Compassion. Insieme stiamo cambiando il mondo! Un bambino alla volta.\n"
"</p>\n"
"<p>\n"
"    Infinitamente Grazie!\n"
"</p>\n"
" </body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.compassion_reset_password_email
msgid ""
"<html>\n"
"  <body><div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"<t t-set=\"partner\" t-value=\"object.get_objects()\"/>\n"
"<t t-set=\"link\" t-value=\"str(partner.signup_url).replace(&#x27;erp.compassion&#x27;, &#x27;mycompassion&#x27;)\"/>\n"
"  </div>\n"
"<p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Dear <t t-out=\"partner.preferred_name\"></t>,\n"
"<br/>\n"
"<br/>\n"
"    You have requested a new password for your Compassion Account. You may change your password by following this link which will remain valid during 24 hours:\n"
"   </p>\n"
"   <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: rgb(119, 119, 119); text-align: center; margin-top: 16px;\">\n"
"    <a t-attf-href=\"{{link}}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);padding: 5px 10px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#875A7B; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius:3px\">\n"
"     Change password\n"
"    </a>\n"
"   </div>\n"
"<br/>\n"
"<br/>\n"
"   <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    If you do not expect this, you can safely ignore this email.\n"
"<br/>\n"
"<br/>\n"
"     Thank you for your committed effort in the fight against extreme poverty. Please feel free to contact us if you have any questions.\n"
"     <br/>\n"
"<br/>\n"
"    Best Regards,\n"
"   <br/>\n"
"<br/>\n"
"    Compassion Switzerland\n"
"   </p>\n"
" </body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"partner\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"link\" t-value=\"str(partner.signup_url).replace(&#x27;erp.compassion&#x27;, &#x27;mycompassion&#x27;)\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.salutation\"></t>\n"
"</p>\n"
"<p>\n"
"    Abbiamo ricevuto una richiesta di reimpostazione della <t t-out=\"&#x27;vostra&#x27; if plural else &#x27;tua&#x27;\"></t> password.\n"
"</p>\n"
"<p>\n"
"    <t t-out=\"&#x27;Potete&#x27; if plural else &#x27;Puoi&#x27;\"></t> cambiare la <t t-out=\"&#x27;vostra&#x27; if plural else &#x27;tua&#x27;\"></t> password cliccando su questo link, che rimarrà valido per 24 ore:\n"
"</p>\n"
"<div style=\"text-align: center; margin-top: 16px; text-transform: uppercase\">\n"
"    <a t-attf-href=\"{{link}}\" style=\"padding: 5px 10px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\">\n"
"        Cambia password\n"
"    </a>\n"
"</div>\n"
"<p>\n"
"    Grazie mille per la <t t-out=\"&#x27;vostra&#x27; if plural else &#x27;tua&#x27;\"></t> partecipazione alla lotta contro la povertà estrema. Non esita<t t-out=\"&#x27;t&#x27; if plural else &#x27;r&#x27;\"></t>e contattarci se <t t-out=\"&#x27;avete&#x27; if plural else &#x27;hai&#x27;\"></t> domande.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"<t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"    <p>\n"
"        <t t-out=\"object.user_id.signature\"></t>\n"
"    </p>\n"
"</t>\n"
"</body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.auto_reminder_archive_partners_template
msgid ""
"<html>\n"
"  <body><div>\n"
"                    <b>The following partners meet the criteria (see <a href=\"/web#action=521&amp;active_id=895&amp;cids=1&amp;id=600&amp;menu_id=2029&amp;model=project.task&amp;view_type=form\">T0024</a>) and are considered invalid : </b>\n"
"                    <span style=\"font-family: 'miller';\">\n"
"                    <t t-foreach=\"ctx.get(&#x27;partners_to_archive&#x27;)\" t-as=\"partner\">\n"
"                        <p><a t-attf-href=\"/web#id={{partner.id}}&amp;model=res.partner&amp;view_type=form\">Ref <t t-out=\"partner.ref\"></t> - <t t-out=\"partner.name\"></t></a></p>\n"
"                    </t>\n"
"                    </span>\n"
"                </div>\n"
"            </body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"                    <b>The following partners meet the criteria (see <a href=\"/web#action=521&amp;active_id=895&amp;cids=1&amp;id=600&amp;menu_id=2029&amp;model=project.task&amp;view_type=form\">T0024</a>) and are considered invalid : </b>\n"
"                    <span style=\"font-family: 'miller';\">\n"
"                    <t t-foreach=\"ctx.get('partners_to_archive')\" t-as=\"partner\">\n"
"                        <p><a t-attf-href=\"/web#id={{partner.id}}&amp;model=res.partner&amp;view_type=form\">Ref <t t-out=\"partner.ref\"/> - <t t-out=\"partner.name\"/></a></p>\n"
"                    </t>\n"
"                    </span>\n"
"                </div>\n"
"            </body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.old_letter
msgid ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"letter\" t-value=\"object.get_objects()\"/>\n"
"    letter: <t t-out=\"letter\"></t><br/><br/>\n"
"    <t t-set=\"cetteLettre\" t-value=\"&#x27;cette lettre&#x27; if len(letter) == 1 else &#x27;ces lettres&#x27;\"/>\n"
"    cetteLettre: <t t-out=\"cetteLettre\"></t>\n"
"    <t t-set=\"uneLettre\" t-value=\"&#x27;une lettre&#x27; if len(letter) == 1 else &#x27;des lettres&#x27;\"/>\n"
"    <t t-set=\"child\" t-value=\"letter.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"partner_name\" t-value=\"partner.firstname and (partner.firstname + &#x27; &#x27; + partner.lastname) or partner.name\"/>\n"
"    <t t-set=\"urls\" t-value=\"[]\"/>\n"
"    <t t-foreach=\"letter.filtered(&#x27;read_url&#x27;).mapped(&#x27;read_url&#x27;)\" t-as=\"l\">\n"
"        <t t-if=\"l not in urls\">\n"
"            <t t-set=\"void\" t-value=\"urls.append(l)\"/>\n"
"        </t>\n"
"    </t>\n"
"    <t t-set=\"wp_tchat_url\" t-value=\"&quot;https://mycompassion.ch/fr_CH/im_livechat/support/3&quot;\"/>\n"
"    <t t-set=\"number_years\" t-value=\"object.get_snippet(&#x27;number_years&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_children\" t-value=\"object.get_snippet(&#x27;number_children&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_fcps\" t-value=\"object.get_snippet(&#x27;number_fcps&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_countries\" t-value=\"object.get_snippet(&#x27;number_countries&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_uc\" t-value=\"object.get_snippet(&#x27;years_uc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_lc\" t-value=\"object.get_snippet(&#x27;years_lc&#x27;, strip_html=True)\"/>\n"
"</div>\n"
"\n"
"<t t-if=\"object.send_mode == &quot;sms&quot;\">\n"
"    <p>\n"
"        <t t-out=\"partner.informal_salutation\"></t>,\n"
"    </p>\n"
"    <p>\n"
"        Nous sommes heureux de t'envoyer la nouvelle lettre de <t t-out=\"child.get(&#x27;preferred_name&#x27;, translate=False)\"></t>!\n"
"    </p>\n"
"    <p>\n"
"        Clique ici pour télécharger la lettre: <a t-attf-href=\"{{urls[0]}}\">Lettre</a>\n"
"    </p>\n"
"    <p>\n"
"        Bonne lecture!\n"
"    </p>\n"
"    <p>\n"
"        Si tu as cinq minutes, pourrais-tu directement répondre à cette lettre? Clique simplement ici: <a href=\"https://mycompassion.ch/fr_CH/my/letter\">MyCompassion</a>\n"
"    </p>\n"
"    <p>\n"
"        Merci et à bientôt!\n"
"    </p>\n"
"    <p>\n"
"        L'équipe de Compassion\n"
"        <br/>Tel: +41 (0)24 434 21 24\n"
"        <br/>Des questions? Écris-nous sur WhatsApp: +41 (0)79 622 31 97\n"
"    </p>\n"
"% else:  \n"
"    <p>\n"
"        <t t-out=\"object.partner_id.salutation\"></t>,\n"
"    </p>\n"
"    <p>\n"
"        C'est avec joie que nous vous adressons <t t-out=\"uneLettre\"></t> de <t t-out=\"child.get_list(&#x27;preferred_name&#x27;, 3, child.get_number(), False)\"></t> ! Comme vous le constaterez, <t t-out=\"&quot;cette lettre n&#x27;est&quot; if len(letter) == 1 else &quot;ces lettres ne sont&quot;\"></t> pas toute récente<t t-out=\"child.get(&#x27;accord_s&#x27;)\"></t>, la faute à un problème technique survenu lors de la transmission. Toutes nos excuses pour ce désagrément.\n"
"    </p>\n"
"    <p>\n"
"        <t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"            Cliquez sur le lien pour télécharger <t t-out=\"cetteLettre\"></t>*. Nous vous souhaitons beaucoup de plaisir à la lecture des nouvelles de <t t-out=\"child.get_list(&#x27;preferred_name&#x27;, 3, child.get_number(), False)\"></t>\n"
"            </p>\n"
"            <ul>\n"
"                <t t-foreach=\"urls\" t-as=\"l\">\n"
"                    <li>\n"
"                        <a t-attf-href=\"{{l}}\">\n"
"                            <t t-out=\"l\"></t>\n"
"                        </a>\n"
"                    </li>\n"
"                </t>\n"
"                </ul>\n"
"            <p>\n"
"        </t>\n"
"        <t t-out=\"years_uc\"></t> <t t-out=\"number_years\"></t> ans d'expérience montrent que ces lettres peuvent contribuer de façon déterminante au développement de l'enfant.\n"
"    </p>\n"
"    <p>\n"
"        D'avance, merci de prendre quelques minutes pour répondre <t t-out=\"&#x27;au courrier ci-joint&#x27; if len(child) == 1 else &#x27;aux courriers ci-joints&#x27;\"></t>, avec quelques paroles d'encouragement à <t t-out=\"child.get_list(&#x27;preferred_name&#x27;, 3, child.get_number(), False)\"></t>. Vous pouvez lui écrire\n"
"        <a href=\"https://mycompassion.ch\">en ligne</a>.\n"
"    </p>\n"
"    <p>\n"
"        N'hésitez pas à prendre contact avec nous pour toute question relative aux échanges de courriers !\n"
"    </p>\n"
"    <p>\n"
"        Merci de transformer la vie <t t-out=\"&#x27;d&#x27;un enfant&#x27; if len(child) == 1 else &#x27;de plusieurs enfants et de les&#x27;\"></t> et de le libérer de l'extrême pauvreté pour une vie digne et qui ait du sens.\n"
"    </p>\n"
"    <p>\n"
"        Avec nos chaleureuses salutations.\n"
"    </p>\n"
"    <p>\n"
"        <t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"            </p>\n"
"            <p>\n"
"                <t t-out=\"object.sudo().user_id.signature\"></t>\n"
"        </t>\n"
"    </p>\n"
"    <p>\n"
"        *En cas de problème pour ouvrir une ou plusieurs lettres, vous pouvez aussi les télécharger depuis votre compte MyCompassion.\n"
"    </p>\n"
"% endif</body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"letter\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"one_letter\" t-value=\"len(letter) == 1\"/>\n"
"    <t t-set=\"child\" t-value=\"letter.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"one_child\" t-value=\"len(child) == 1\"/>\n"
"    <t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, &#x27;vostri figlioli&#x27;, False)\"/>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"partner_name\" t-value=\"partner.firstname and (partner.firstname + &#x27; &#x27; + partner.lastname) or partner.name\"/>\n"
"    <t t-set=\"urls\" t-value=\"[]\"/>\n"
"    <t t-foreach=\"letter.filtered(&#x27;read_url&#x27;).mapped(&#x27;read_url&#x27;)\" t-as=\"l\">\n"
"        <t t-if=\"l not in urls\">\n"
"            <t t-set=\"void\" t-value=\"urls.append(l)\"/>\n"
"        </t>\n"
"    </t>\n"
"    <t t-set=\"number_years\" t-value=\"object.get_snippet(&#x27;number_years&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_children\" t-value=\"object.get_snippet(&#x27;number_children&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_fcps\" t-value=\"object.get_snippet(&#x27;number_fcps&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_countries\" t-value=\"object.get_snippet(&#x27;number_countries&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_uc\" t-value=\"object.get_snippet(&#x27;years_uc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_lc\" t-value=\"object.get_snippet(&#x27;years_lc&#x27;, strip_html=True)\"/>\n"
"</div>\n"
"\n"
"<t t-if=\"object.send_mode == &quot;sms&quot;\">\n"
"    <p>\n"
"        <t t-out=\"object.partner_id.informal_salutation\"></t>,\n"
"    </p>\n"
"    <p>\n"
"        Siamo felici di inviarti la nuova lettera di <t t-out=\"firstname\"></t>!\n"
"    </p>\n"
"    <p>\n"
"        Clicca qui per scaricarla. <a t-attf-href=\"{{urls[0]}}\">link</a>\n"
"    </p>\n"
"    <p>\n"
"        Buona lettura!\n"
"    </p>\n"
"    <p>\n"
"       Se <t t-out=\"&#x27;avete&#x27; if plural else &#x27;hai&#x27;\"></t> qualche minuto di tempo, <t t-out=\"&#x27;potreste&#x27; if plural else &#x27;potresti&#x27;\"></t> rispondere direttamente a questa lettera? <t t-out=\"&#x27;Cliccate&#x27; if plural else &#x27;Clicca&#x27;\"></t> qui: <a href=\"https://mycompassion.ch/it_IT/my/letter\">MyCompassion</a>\n"
"    </p>\n"
"    <p>\n"
"        Grazie e a presto!\n"
"    </p>\n"
"    <p>\n"
"        <t t-out=\"whatsapp_signature\"></t>\n"
"    </p>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    <p>\n"
"        <t t-out=\"object.partner_id.salutation\"></t>,\n"
"    </p>\n"
"    <p>\n"
"        Siamo felici di inviar<t t-out=\"&#x27;vi&#x27; if plural else &#x27;ti&#x27;\"></t> <t t-out=\"&#x27;una lettera&#x27; if one_letter else &#x27;alcune lettere&#x27;\"></t> di <t t-out=\"firstname\"></t>! Come <t t-out=\"&#x27;noterete&#x27; if plural else &#x27;noterai&#x27;\"></t>, <t t-out=\"&#x27;questa lettera non è molto recente&#x27; if one_letter else &#x27;queste lettere non sono molto recenti&#x27;\"></t>; purtroppo, a causa di un problema tecnico, non è stato possibile consegnarl<t t-out=\"&#x27;a&#x27; if one_letter else &#x27;e&#x27;\"></t> prima. Ci dispiace per l'inconveniente.\n"
"    </p>\n"
"\n"
"    <t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"        <p>\n"
"            <t t-out=\"&#x27;Cliccate&#x27; if plural else &#x27;Clicca&#x27;\"></t> sul link per <t t-out=\"&#x27;scaricarla&#x27; if one_letter else &#x27;scaricarle&#x27;\"></t>*. <t t-out=\"&#x27;Vi&#x27; if plural else &#x27;Ti&#x27;\"></t> auguriamo di leggerl<t t-out=\"&#x27;a&#x27; if one_letter else &#x27;e&#x27;\"></t> con piacere.\n"
"        </p>\n"
"        <ul>\n"
"            <t t-foreach=\"urls\" t-as=\"l\">\n"
"                <li>\n"
"                    <a t-attf-href=\"{{l}}\"><t t-out=\"l\"></t></a>\n"
"                </li>\n"
"            </t>\n"
"        </ul>\n"
"    </t>\n"
"    <p>\n"
"        Oltre <t t-out=\"number_years\"></t> anni di esperienza dimostrano che lo scambio di lettere può contribuire in modo decisivo allo sviluppo dei bambini.\n"
"    </p>\n"
"    <p>\n"
"        <t t-out=\"&#x27;Vi&#x27; if plural else &#x27;Ti&#x27;\"></t> invitiamo a dedicare qualche minuto per rispondere a <t t-out=\"&#x27;questa lettera&#x27; if one_letter else &#x27;queste lettere&#x27;\"></t>, con parole di incoraggiamento per <t t-out=\"firstname\"></t>. <t t-out=\"&#x27;Potete&#x27; if plural else &#x27;Puoi&#x27;\"></t> scriver<t t-out=\"&#x27;gli&#x27; if partner.gender == &#x27;M&#x27; else &#x27;le&#x27;\"></t> online\n"
"        <a href=\"https://compassion.ch/it/scrivere/\">compassion.ch/it/scrivere/</a>\n"
"    </p>\n"
"    <p>\n"
"        Non <t t-out=\"&#x27;esitate&#x27; if plural else &#x27;esitare&#x27;\"></t> a contattarci per qualsiasi domanda sulla corrispondenza!\n"
"    </p>\n"
"    <p>\n"
"        Grazie per il <t t-out=\"&#x27;vostro&#x27; if plural else &#x27;tuo&#x27;\"></t> contributo nel trasformare la vita di un bambino e liberarlo dalla povertà estrema, così che possa vivere una vita dignitosa e piena di senso.\n"
"    </p>\n"
"    <p>\n"
"        Cari saluti,\n"
"    </p>\n"
"\n"
"    <t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"        <p>\n"
"            <t t-out=\"object.sudo().user_id.signature\"></t>\n"
"        </p>\n"
"        <p>\n"
"            *Se <t t-out=\"&#x27;avete&#x27; if plural else &#x27;hai&#x27;\"></t> difficoltà ad aprire <t t-out=\"&#x27;la lettera&#x27; if one_letter else &#x27;le lettere&#x27;\"></t>, <t t-out=\"&#x27;potete&#x27; if plural else &#x27;puoi&#x27;\"></t> anche scaricarl<t t-out=\"&#x27;a&#x27; if one_letter else &#x27;e&#x27;\"></t> dal <t t-out=\"&#x27;vostro&#x27; if plural else &#x27;tuo&#x27;\"></t> account MyCompassion.\n"
"        </p>\n"
"    </t>\n"
"</t>\n"
"</body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_new_labels
msgid ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"child\" t-value=\"object.get_objects().mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, &#x27;your sponsored children&#x27;, False)\"/>\n"
"    <t t-if=\"len(child) == 1\">\n"
"        <t t-set=\"anewsheet\" t-value=\"&#x27;a new sheet&#x27;\"/>\n"
"        <t t-set=\"child\" t-value=\"&#x27;child&#x27;\"/>\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-set=\"anewsheet\" t-value=\"&#x27;the new sheets&#x27;\"/>\n"
"        <t t-set=\"child\" t-value=\"&#x27;children&#x27;\"/>\n"
"    </t>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.salutation\"></t>\n"
"</p>\n"
"<p>\n"
"    Thank you for investing into the life of <t t-out=\"firstname\"></t>.\n"
"</p>\n"
"<p>\n"
"    Please find enclosed <t t-out=\"anewsheet\"></t> of labels for the letters you wish to send by post.\n"
"</p>\n"
"<p>\n"
"    Do you know that you can write your letters easily in your <a href=\"https://www.mycompassion.ch\">MyCompassion profile</a>? With it, you always have the pictures, letters and information of your <t t-out=\"child\"></t> at hand.\n"
"</p>\n"
"<p>\n"
"    Enjoy writing!\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"<t t-if=\"object.send_mode != &#x27;physical&#x27;\">\n"
"    <p>\n"
"        <t t-out=\"object.user_id.short_signature\"></t>\n"
"    </p>\n"
"</t>\n"
"</body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"male\" t-value=\"partner.gender == &#x27;M&#x27;\"/>\n"
"    <t t-set=\"child\" t-value=\"object.get_objects().mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, child.get_number(), translate=False)\"/>\n"
"    <t t-set=\"boy\" t-value=\"child.gender == &#x27;M&#x27;\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.salutation\"></t>,\n"
"</p>\n"
"<p>\n"
"    Grazie per aver investito nel migliorare la vita di <t t-out=\"firstname\"></t>.\n"
"</p>\n"
"<p>\n"
"    In allegato <t t-out=\"&#x27;troverete&#x27; if plural else &#x27;troverai&#x27;\"></t> un nuovo set di etichette per la corrispondenza con <t t-out=\"&#x27;lui&#x27; if boy else &#x27;lei&#x27;\"></t>. <t t-out=\"&#x27;Ricordate&#x27; if plural else &#x27;Ricorda&#x27;\"></t> di attaccare un'etichetta su ogni elemento della spedizione (lettera, cartolina, adesivi, disegni, ecc.) destinato a <t t-out=\"firstname\"></t>.\n"
"</p>\n"
"<p>\n"
"    <t t-out=\"&#x27;Potete&#x27; if plural else &#x27;Puoi&#x27;\"></t> anche scriver<t t-out=\"&#x27;gli&#x27; if boy else &#x27;le&#x27;\"></t> da www.mycompassion.ch.\n"
"</p>\n"
"<p>\n"
"    Siamo a disposizione per qualsiasi domanda.\n"
"</p>\n"
"<p>\n"
"    Buona scrittura!\n"
"</p>\n"
"<p>\n"
"    Cari saluti e a presto,\n"
"</p>\n"
"<t t-if=\"object.send_mode != &#x27;physical&#x27;\">\n"
"    <p>\n"
"        <t t-out=\"object.user_id.signature\"></t>\n"
"    </p>\n"
"</t>\n"
"</body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_sponsorship_confirmation_not_read
msgid ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"child\" t-value=\"object.get_objects().mapped(&#x27;child_id&#x27;)\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.salutation\"></t>\n"
"</p>\n"
"<p>\n"
"    We recently sent you an email to <t t-out=\"partner.email\"></t>, which doesn't seem to have reached you. Could you please let us know if you have a different email address. If our email went to the spam folder, could you please add compassion@compassion.ch to your address book? This way you will receive all the important information about <t t-out=\"child.get(&#x27;your sponsored child&#x27;)\"></t> in the future.\n"
"</p>\n"
"<p>\n"
"    Below is the communication we sent you:\n"
"</p>\n"
"<span>\n"
"    <t t-out=\"object.env.ref(&#x27;partner_communication_switzerland.mail_onboarding_sponsorship_confirmation&#x27;).generate_email(object.id, [&#x27;body_html&#x27;])[&#x27;body_html&#x27;].replace(partner.salutation, &#x27;&#x27;).strip().replace(&#x27;&lt;p&gt;&lt;/p&gt;&#x27;, &#x27;&#x27;)\"></t>\n"
"</span>\n"
"</body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"child\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"te\" t-value=\"&quot;voi&quot; if plural else &quot;te&quot;\"/>\n"
"    <t t-set=\"tu\" t-value=\"&quot;voi&quot; if plural else &quot;tu&quot;\"/>\n"
"    <t t-set=\"tua\" t-value=\"&quot;vostra&quot; if plural else &quot;tua&quot;\"/>\n"
"    <t t-set=\"tuo\" t-value=\"&quot;vostro&quot; if plural else &quot;tuo&quot;\"/>\n"
"    <t t-set=\"tue\" t-value=\"&quot;vostre&quot; if plural else &quot;tue&quot;\"/>\n"
"    <t t-set=\"ti\" t-value=\"&quot;vi&quot; if plural else &quot;ti&quot;\"/>\n"
"    <t t-if=\"plural\">\n"
"        <t t-set=\"benvenuto\" t-value=\"&quot;Benvenuti &quot; + partner.firstname or partner.name + &quot;!&quot;\"/>\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-set=\"benvenuto\" t-value=\"(&quot;Benvenuta &quot; if partner.gender == &quot;F&quot; else &quot;Benvenuto &quot;) + partner.firstname + &quot;!&quot;\"/>\n"
"    </t>\n"
"    <t t-if=\"len(child) == 1\">\n"
"        <t t-set=\"sul_bambino\" t-value=\"(&quot;sulla bambina&quot; if partner.gender == &quot;F&quot; else &quot;sul bambino &quot;)\"/>\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-set=\"sul_bambino\" t-value=\"&#x27;sui bambini&#x27;\"/>\n"
"    </t>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.salutation\"></t>,\n"
"</p>\n"
"<p>\n"
"    Di recente <t t-out=\"ti\"></t> abbiamo inviato un'e-mail all'indirizzo <t t-out=\"partner.email\"></t>, che sembra <t t-out=\"tu\"></t> non <t t-out=\"&#x27;abbiate&#x27; if plural else &#x27;abbia&#x27;\"></t> ricevuto. <t t-out=\"&#x27;Potreste&#x27; if plural else &#x27;Potresti&#x27;\"></t> verificare se è arrivata nella <t t-out=\"tua\"></t> cartella spam, ed eventualmente aggiungere compassion@compassion.ch alla <t t-out=\"tua\"></t> rubrica oppure inviarci un altro indirizzo?\n"
"</p>\n"
"<p>\n"
"    In questo modo, in futuro <t t-out=\"&#x27;potrete&#x27; if plural else &#x27;potrai&#x27;\"></t> ricevere tutte le informazioni importanti <t t-out=\"sul_bambino\"></t> che <t t-out=\"&#x27;sostenete&#x27; if plural else &#x27;sostieni&#x27;\"></t>.\n"
"</p>\n"
"<p>\n"
"    Ecco cosa <t t-out=\"ti\"></t> abbiamo scritto:\n"
"</p>\n"
"<span>\n"
"    <t t-out=\"object.env.ref(&#x27;partner_communication_switzerland.mail_onboarding_sponsorship_confirmation&#x27;).generate_email(object.id, [&#x27;body_html&#x27;])[&#x27;body_html&#x27;].replace(benvenuto, &#x27;&#x27;).strip().replace(&#x27;&lt;p&gt;&lt;/p&gt;&#x27;, &#x27;&#x27;)\"></t>\n"
"</span>\n"
"</body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_wrpr_reminder
msgid ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"children\" t-value=\"object.get_objects().mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"firstname\" t-value=\"children.get_list(&#x27;preferred_name&#x27;, 3, translate=False)\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29 or not partner.title.id\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.salutation\"></t>\n"
"</p>\n"
"<p>\n"
"    A few months ago, you decided to support <t t-out=\"firstname\"></t> through our “Write &amp; Pray” sponsorship.\n"
"</p>\n"
"<p>\n"
"    The special feature of a “Write &amp; Pray” sponsorship is teamwork.\n"
"</p>\n"
"<p>\n"
"    You are known to <t t-out=\"firstname\"></t> as <t t-out=\"children.get(&#x27;his&#x27;)\"></t> <t t-out=\"&#x27;sponsors&#x27; if plural else &#x27;sponsor&#x27;\"></t>. Another donor regularly provides the financial support for this type of sponsorship.\n"
"</p>\n"
"<p>\n"
"    We are counting on you to pray for <t t-out=\"children.get(&#x27;him&#x27;)\"></t> and write to <t t-out=\"children.get(&#x27;him&#x27;)\"></t> at least twice a year.\n"
"</p>\n"
"<p>\n"
"    So far, our records indicate that <t t-out=\"firstname\"></t> <t t-out=\"&#x27;has&#x27; if len(children) == 1 else &#x27;have&#x27;\"></t> not received a letter from you.\n"
"</p>\n"
"<p>\n"
"    Thank you for taking a few minutes of your time to write a letter to <t t-out=\"children.get(&#x27;him&#x27;)\"></t>, online via <a href=\"https://mycompassion.ch/my/letter\">MyCompassion</a>.\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"<p>\n"
"    <t t-out=\"object.user_id.signature\"></t>\n"
"</p></body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"   <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"child\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"young\" t-value=\"True\"/>\n"
"    <t t-if=\"partner.title.plural\">\n"
"\n"
"        <t t-set=\"le_parrain\" t-value=\"&#x27;die Paten&#x27;\"/>\n"
"        <t t-set=\"young\" t-value=\"False\"/>\n"
"    </t>\n"
"    <t t-set=\"te\" t-value=\"&#x27;te&#x27; if young else &#x27;voi&#x27;\"/>\n"
"  </div>\n"
"  <p>\n"
"   <t t-out=\"(partner.get(&#x27;salutation&#x27;).title() + &#x27; &#x27; + partner.preferred_name) if young else partner.salutation\"></t>,\n"
"   <br/>\n"
"   <br/>\n"
"   Qualche mese fa, <t t-out=\"&quot;ti sei impegnat&quot; + partner.get(&#x27;accord_o_a&#x27;) if young else &quot;vi siete impegnati&quot;\"></t> a sostenere <t t-out=\"child.get_list(&#x27;preferred_name&#x27;, translate=False)\"></t> grazie al nostro programma di sostegno «Write &amp; Pray».\n"
"   <br/>\n"
"   <br/>\n"
"   La particolarità del sostegno «Write &amp; Pray» è il lavoro di squadra. <t t-out=\"&quot;Tu sei il sostenitore&quot; if young else &quot;Voi siete i sostenitori&quot;\"></t> in contatto con <t t-out=\"child.get_list(&#x27;preferred_name&#x27;, translate=False)\"></t>.  Contiamo su di <t t-out=\"te\"></t> per pregare per <t t-out=\"child.get(&#x27;lui&#x27;)\"></t> e scrivere<t t-out=\"child.get(&#x27;gli&#x27;)\"></t> almeno due volte l'anno. Un altro donatore fornisce supporto finanziario per questo sostegno.\n"
"   <br/>\n"
"   <br/>\n"
"   Fino ad oggi <t t-out=\"child.get_list(&#x27;preferred_name&#x27;, translate=False)\"></t> non ha ricevuto nessuna letterina. Contiamo su di <t t-out=\"te\"></t>! Grazie di prendere 5 minuti per scrivere oggi, <t t-out=\"&quot;puoi&quot; if young else &quot;potete&quot;\"></t> farlo direttamente online: https://compassion.ch/it/scrivere/\n"
"   <br/>\n"
"   <br/>\n"
"   Una lettera può fare la differenza. Ronnie, ad esempio, è cresciuto in una baraccopoli in Uganda. Quando in una delle sue lettere la sua sostenitrice inglese gli ha chiesto quale lavoro avesse voluto fare da grande, Ronnie non sapeva neanche cosa significasse la parola «lavoro». Grazie alle spiegazioni dello staff del centro compassion,  all'incoraggiamento e alla fiducia mostrate dalla sua sostenitrice nelle sue lettere, grazie al suo lavoro a scuola, Ronnie ha brillantemente completato la sua istruzione. In grado di entrare nella scuola di ingegneria, si è diplomato pochi anni dopo.\n"
"   <br/>\n"
"   <br/>\n"
"   Scrivere e pregare: grazie per aver preso seriamente questa missione, così come il donatore che fornisce fedelmente supporto per <t t-out=\"child.get_list(&#x27;preferred_name&#x27;, translate=False)\"></t>.\n"
"   <br/>\n"
"   <br/>\n"
"   Ancora una volta, grazie di investire nella vita di questo bambino che vive in estrema povertà.\n"
"   <br/>\n"
"   <br/>\n"
"   Con i nostri migliori saluti.\n"
"<t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"   <br/>\n"
"   <br/>\n"
"       <t t-out=\"object.user_id.short_signature\"></t>\n"
"</t>\n"
"  </p>\n"
"</body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.tax_receipt_letter_template
msgid ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"number_years\" t-value=\"object.get_snippet(&#x27;number_years&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_children\" t-value=\"object.get_snippet(&#x27;number_children&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_fcps\" t-value=\"object.get_snippet(&#x27;number_fcps&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_countries\" t-value=\"object.get_snippet(&#x27;number_countries&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_uc\" t-value=\"object.get_snippet(&#x27;years_uc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_lc\" t-value=\"object.get_snippet(&#x27;years_lc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"tax_year\" t-value=\"2025\"/>\n"
"    <t t-set=\"major_donor\" t-value=\"18454 in partner.category_id.ids\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-if=\"not major_donor\">\n"
"        <t t-out=\"partner.salutation\"></t>,\n"
"    </t>\n"
"<t t-else=\"\">\n"
"      </p><div style=\"height: 15mm\"/>\n"
"    </t>\n"
"<p>\n"
"    In <t t-out=\"tax_year\"></t>, we accomplished a lot together:\n"
"</p>\n"
"<ul>\n"
"    <li>Another 4,066 children were supported from Switzerland</li>\n"
"    <li>1,759 mothers and their babies received vital aid</li>\n"
"    <li>100 vocational training places were funded for young people</li>\n"
"    <li>34,775 children were given a Christmas gift</li>\n"
"    <li>4,886 families received food supplies</li>\n"
"    <li>3,765 children now have access to safe, clean toilets</li>\n"
"</ul>\n"
"<p t-attf-style=\"{{'margin-bottom: 40px' if object.send_mode == 'digital' else ''}}\">\n"
"Thanks in part to your generosity and faithfulness, thank you from the bottom of our hearts!\n"
"</p>\n"
"<h4>Your <t t-out=\"tax_year\"></t> Donation Receipt</h4>\n"
"<p>\n"
"    We’re delighted to send you the tax receipt for the donations you made to Compassion in <t t-out=\"tax_year\"></t>. You can deduct 100% of your donations on your tax return in all Swiss cantons.\n"
"</p>\n"
"<h4>It All Begins with a Yes</h4>\n"
"<p>Your engagement to fight alongside Compassion against extreme poverty probably started with a “yes”, and for this you have our profound thanks. This “yes” has a long-lasting impact on the lives of children and families, as well as on our programs worldwide. We invite you to discover this impact in our <t t-out=\"tax_year\"></t> Activity Report, available in German or French.\n"
"</p>\n"
"<t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"    <div style=\"margin:40px auto; text-align: center;\">\n"
"        <a href=\"https://compassion.ch/activite-2025\" style=\"padding: 12px 18px; font-size: 16px; line-height: 18px; color: #FFFFFF; border-color:#2A5EEC; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #2A5EEC; border: 1px solid #2A5EEC; border-radius:3px\" title=\"\">\n"
"            Your Impact in <t t-out=\"tax_year\"></t>\n"
"        </a>\n"
"    </div>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    <p>\n"
"        See your impact in <t t-out=\"tax_year\"></t> in French : https://compassion.ch/activite-2025 or in German compassion.ch/de/aktivitaet-2025\n"
"    </p>\n"
"</t>\n"
"<p>\n"
"    Once again, thank you for your faithful engagement alongside Compassion in the fight against injustice and extreme poverty. Together, you and other sponsors and donors, along with more than 8,700 Child Development Centers in the Global South, work to bring hope to a growing number of children and families in need.\n"
"</p>\n"
"<t t-if=\"not major_donor\">\n"
"<p>\n"
"    We wish you a happy new year, warm regards, and until next time,\n"
"</p>\n"
"</t>\n"
"<t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"    <p><t t-out=\"object.user_id.short_signature\"></t></p>\n"
"% endif</body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"     <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"ti\" t-value=\"&#x27;vi&#x27; if plural else &#x27;ti&#x27;\"/>\n"
"    <t t-set=\"Scopri\" t-value=\"&#x27;Scoprite&#x27; if plural else &#x27;Scopri&#x27;\"/>\n"
"    <t t-set=\"tuo\" t-value=\"&#x27;vostro&#x27; if plural else &#x27;tuo&#x27;\"/>\n"
"    <t t-set=\"tua\" t-value=\"&#x27;vostra&#x27; if plural else &#x27;tua&#x27;\"/>\n"
"    <t t-set=\"inviarti\" t-value=\"&#x27;inviarvi&#x27; if plural else &#x27;inviartiti&#x27;\"/>\n"
"    <t t-set=\"te\" t-value=\"&#x27;voi&#x27; if plural else &#x27;te&#x27;\"/>\n"
"    <t t-set=\"hai\" t-value=\"&#x27;avete&#x27; if plural else &#x27;hai&#x27;\"/>\n"
"    <t t-set=\"number_years\" t-value=\"object.get_snippet(&#x27;number_years&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_children\" t-value=\"object.get_snippet(&#x27;number_children&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_fcps\" t-value=\"object.get_snippet(&#x27;number_fcps&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_countries\" t-value=\"object.get_snippet(&#x27;number_countries&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_uc\" t-value=\"object.get_snippet(&#x27;years_uc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_lc\" t-value=\"object.get_snippet(&#x27;years_lc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"major_donor\" t-value=\"18454 in partner.category_id.ids\"/>\n"
"    <t t-set=\"tax_year\" t-value=\"2025\"/>\n"
"</div>\n"
"<p>\n"
"        <t t-out=\"partner.salutation\"></t>,\n"
"</p>\n"
"<p>\n"
"    Nel corso del <t t-out=\"tax_year\"></t> abbiamo realizzato molte cose insieme:\n"
"</p>\n"
"<ul>\n"
"    <li>4066 bambini in più hanno beneficiato di un sostegno dalla Svizzera</li>\n"
"    <li>1.759 mamme e i loro bambini hanno ricevuto un sostegno vitale</li>\n"
"    <li>100 posti di formazione professionale sono stati finanziati dagli amici di Compassion Svizzera</li>\n"
"    <li>34.775 bambini hanno ricevuto un regalo a Natale</li>\n"
"    <li>4.886 famiglie hanno ricevuto scorte alimentari</li>\n"
"    <li>3.765 bambini hanno ora accesso a servizi igienici sicuri</li>\n"
"</ul>\n"
"<p t-attf-style=\"{{'margin-bottom: 40px' if object.send_mode == 'digital' else ''}}\">\n"
"<t t-out=\"ti.title()\"></t> ringraziamo di cuore per la <t t-out=\"tua\"></t> generosità e fedeltà!\n"
"</p>\n"
"<h4>La <t t-out=\"tua\"></t> ricevuta fiscale <t t-out=\"tax_year\"></t></h4>\n"
"<p>\n"
"    È con grande gioia che <t t-out=\"ti\"></t> inviamo in allegato la ricevuta fiscale delle donazioni che <t t-out=\"hai\"></t> versato a Compassion nel <t t-out=\"tax_year\"></t>. <t t-out=\"&quot;Potete&quot; if plural else &quot;Puoi&quot;\"></t> dedurre il 100% di questo importo dalla <t t-out=\"tua\"></t> dichiarazione dei redditi in tutti i cantoni svizzeri.\n"
"</p>\n"
"<h4>Tutto inizia con un sì</h4>\n"
"<p>Il <t t-out=\"tuo\"></t> contributo a favore di Compassion nella lotta contro l'estrema povertà è probabilmente iniziato con un “sì” e per questo <t t-out=\"ti\"></t> siamo profondamente grati. Quel “sì” ha un impatto duraturo sui beneficiari di Compassion e sui nostri programmi. <t t-out=\"ti.title()\"></t> invitiamo a scoprire di più nel nostro rapporto annuale.\n"
"</p>\n"
"<t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"    <div style=\"margin:40px auto; text-align: center;\">\n"
"        <a t-attf-href=\"https://compassion.ch/it/attivita-{{tax_year}}\" style=\"padding: 12px 18px; font-size: 16px; line-height: 18px; color: #FFFFFF; border-color:#2A5EEC; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #2A5EEC; border: 1px solid #2A5EEC; border-radius:3px\" title=\"\">\n"
"            Il <t t-out=\"tuo\"></t> impatto nel <t t-out=\"tax_year\"></t>\n"
"        </a>\n"
"    </div>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    <p>\n"
"        Il <t t-out=\"tuo\"></t> impatto nel <t t-out=\"tax_year\"></t> : https://compassion.ch/it/attivita-<t t-out=\"tax_year\"></t>\n"
"    </p>\n"
"</t>\n"
"<p>\n"
"    Grazie ancora per il <t t-out=\"tuo\"></t> fedele impegno al nostro fianco nella lotta contro l'ingiustizia della povertà estrema. Insieme a <t t-out=\"te\"></t> e ad altri sostenitori, donatori e agli oltre <t t-out=\"number_fcps\"></t> centri di sviluppo infantile presenti nei Paesi del Sud, acciamo tutto il possibile per offrire prospettive di speranza a un numero sempre maggiore di bambini e famiglie in difficoltà.\n"
"</p>\n"
"<p>\n"
"    <t t-out=\"ti.title()\"></t> auguriamo un felice anno nuovo. Cari saluti e a presto,\n"
"</p>\n"
"\n"
"<t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"    <p><t t-out=\"object.user_id.short_signature\"></t></p>\n"
"% endif</body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_photo_by_post
msgid ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"sponsorship\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"child\" t-value=\"sponsorship.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"one_child\" t-value=\"len(child) == 1\"/>\n"
"    <t t-set=\"less_4\" t-value=\"len(child) &lt; 4\"/>\n"
"    <t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, &#x27;your sponsored children&#x27;, translate=False)\"/>\n"
"    <t t-set=\"apos\" t-value=\"&quot;&#x27;&quot; if firstname[-1] == &#x27;s&#x27; else &quot;&#x27;s&quot;\"/>\n"
"    <t t-set=\"sms\" t-value=\"partner.global_communication_delivery_preference == &quot;sms&quot;\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.informal_salutation\"></t>\n"
"</p>\n"
"<p>\n"
"    We're so pleased to send you <t t-out=\"firstname + apos + &#x27; first photo&#x27; if one_child else (&#x27;the first photos of your sponsored children&#x27; if not less_4 else firstname + apos + &#x27; first photos&#x27;)\"></t>.\n"
"</p>\n"
"<p>\n"
"    Thank you for making room for <t t-out=\"firstname if len(child) == 1 else &#x27;the children&#x27;\"></t> in your life and investing in <t t-out=\"child.get(&#x27;his&#x27;) + &#x27; future&#x27; if len(child) == 1 else &#x27;their futures&#x27;\"></t>.\n"
"</p>\n"
"\n"
"<t t-if=\"partner.email or sms\">\n"
"   <p>\n"
"       Keep an eye on your emails, as we will send you all the necessary information about your <t t-out=\"&#x27;sponsorship&#x27; if one_child else &#x27;sponsorships&#x27;\"></t>.\n"
"   </p>\n"
"</t>\n"
"<p>\n"
"    Please do not hesitate to contact us at info@compassion.ch or +41 31 552 21 21 if you have any questions.\n"
"</p>\n"
"\n"
"<p>\n"
"    Together, we are changing the world! One child at a time.\n"
"</p>\n"
"\n"
"<t t-if=\"object.send_mode == &#x27;digital&#x27;\">\n"
"    <p>\n"
"        <t t-out=\"object.user_id.signature\"></t>\n"
"    </p>\n"
"</t>\n"
"</body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><p>\n"
"   <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"<t t-set=\"plural\" t-value=\"partner.title.plural\"/>\n"
"<t t-set=\"te\" t-value=\"&quot;voi&quot; if plural else &quot;te&quot;\"/>\n"
"<t t-set=\"tu\" t-value=\"&quot;voi&quot; if plural else &quot;tu&quot;\"/>\n"
"<t t-set=\"tua\" t-value=\"&quot;vostra&quot; if plural else &quot;tua&quot;\"/>\n"
"<t t-set=\"tuo\" t-value=\"&quot;vostro&quot; if plural else &quot;tuo&quot;\"/>\n"
"<t t-set=\"tue\" t-value=\"&quot;vostre&quot; if plural else &quot;tue&quot;\"/>\n"
"<t t-set=\"ti\" t-value=\"&quot;vi&quot; if plural else &quot;ti&quot;\"/>\n"
"<t t-set=\"sponsorship\" t-value=\"object.get_objects()\"/>\n"
"<t t-set=\"child\" t-value=\"sponsorship.mapped(&#x27;child_id&#x27;)\"/>\n"
"<t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, &#x27;vostri bambini&#x27; if plural else &#x27;tuoi bambini&#x27;, translate=False)\"/>\n"
"<t t-set=\"di\" t-value=\"&#x27;di&#x27; if len(child) &lt; 4 else &#x27;dei&#x27;\"/>\n"
"   <t t-out=\"partner.salutation\"></t>\n"
"  </p>\n"
"  <p>\n"
"   Siamo felici di <t t-out=\"&quot;inviarvi&quot; if plural else &quot;inviarti&quot;\"></t> la prima foto <t t-out=\"di\"></t> <t t-out=\"firstname\"></t>.\n"
"  </p>\n"
"  <p>\n"
"<t t-if=\"not sponsorship.mapped(&#x27;parent_id&#x27;)\">\n"
"  Grazie di cuore, di dare <t t-out=\"&quot;a &quot; + firstname if len(child) &lt; 4 else &quot;ai bambini&quot;\"></t> un posto nella <t t-out=\"tua\"></t> vita e di investire nel <t t-out=\"child.get(&#x27;suo&#x27;)\"></t> futuro.\n"
"</t>\n"
"<t t-else=\"\">\n"
"<t t-out=\"&quot;Desiderate&quot; if plural else &quot;Desideri&quot;\"></t> dare <t t-out=\"&quot;a &quot; + firstname if len(child) &lt; 4 else &quot;ai bambini&quot;\"></t> un posto nella <t t-out=\"tua\"></t> avita e a investire nel <t t-out=\"child.get(&#x27;suo&#x27;)\"></t> futuro?\n"
"</t>\n"
"  </p>\n"
"  <t t-if=\"partner.email\">\n"
"  <p>\n"
"<t t-out=\"&quot;Fate&quot; if plural else &quot;Fai&quot;\"></t> attenzione al <t t-out=\"tuo\"></t> indirizzo e-mail, perché invieremo tutte le informazioni necessarie sul sostegno a distanza li!\n"
"  </p>\n"
"  </t>\n"
"  <p>\n"
"  Se <t t-out=\"&quot;avete&quot; if plural else &quot;hai&quot;\"></t> domande, <t t-out=\"&quot;contattateci&quot; if plural else &quot;contattaci&quot;\"></t> a info@compassion.ch o al numero:\n"
"031 552 21 24\n"
"  </p>\n"
"  <p style=\"text-transform: uppercase; font-weight: bolder; color: #0054A6\">\n"
"   Insieme cambiamo il mondo, un bambino alla volta.\n"
"  </p>\n"
"  <p>\n"
"    <t t-out=\"object.user_id.short_signature\"></t>\n"
"  </p>\n"
" </body>\n"
"</html>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_zoom_reminder
msgid ""
"<html>\n"
"  <body><div>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"zoom\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"child\" t-value=\"partner.sponsorship_ids.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"one_child\" t-value=\"len(child) == 1\"/>\n"
"    <t t-set=\"firstname\" t-value=\"child.get_list(&#x27;preferred_name&#x27;, 3, child.get_number(), translate=False)\"/>\n"
"    <t t-set=\"less_4\" t-value=\"firstname != child.get_number()\"/>\n"
"</div>\n"
"<p>\n"
"    <t t-out=\"partner.informal_salutation\"></t>\n"
"</p>\n"
"<p>\n"
"    The next video conference for new sponsors is getting closer.\n"
"</p>\n"
"<p>\n"
"    You will experience what the message of a sponsorship means for a local family and you will be given more information on your sponsorship.\n"
"</p>\n"
"<p>\n"
"    Have you already signed up? Don't worry, it's really straightforward!\n"
"</p>\n"
"<p>\n"
"    Sign up here: <t t-out=\"zoom.get_date(&#x27;date_start&#x27;, &#x27;dd. MMMM&#x27;)\"></t> um <t t-out=\"zoom.get_date(&#x27;date_start&#x27;, &#x27;HH:mm&#x27;)\"></t>.\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://mycompassion.ch/de_DE/zoom/register\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Registration Video Conference\n"
"    </a>\n"
"</div>\n"
"<p>\n"
"    We look forward to welcoming/seeing you!\n"
"</p>\n"
"<p>\n"
"    Thank you for investing in the life of <t t-out=\"firstname\"></t> and <t t-out=\"child.get(&#x27;his&#x27;)\"></t> <t t-out=\"&#x27;family&#x27; if one_child else &#x27;families&#x27;\"></t>. Together we are changing the world. One child at a time.\n"
"</p>\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"<p>\n"
"    <t t-out=\"object.user_id.signature\"></t>\n"
"<br/>\n"
"</p>\n"
"</body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><p>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"children\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural\"/>\n"
"    <t t-set=\"firstname\" t-value=\"children.get_list(&#x27;preferred_name&#x27;, 3, &#x27;i vostri bambini&#x27; if plural else &#x27;i tuoi bambini&#x27;, translate=False)\"/>\n"
"    <t t-set=\"te\" t-value=\"&quot;voi&quot; if plural else &quot;te&quot;\"/>\n"
"    <t t-set=\"tu\" t-value=\"&quot;voi&quot; if plural else &quot;tu&quot;\"/>\n"
"    <t t-set=\"tua\" t-value=\"&quot;vostra&quot; if plural else &quot;tua&quot;\"/>\n"
"    <t t-set=\"tuo\" t-value=\"&quot;vostro&quot; if plural else &quot;tuo&quot;\"/>\n"
"    <t t-set=\"tue\" t-value=\"&quot;vostre&quot; if plural else &quot;tue&quot;\"/>\n"
"    <t t-set=\"ti\" t-value=\"&quot;vi&quot; if plural else &quot;ti&quot;\"/>\n"
"    <t t-set=\"vive\" t-value=\"&quot;vive&quot;\"/>\n"
"    <t t-if=\"&quot;,&quot; in firstname or firstname == &quot;i tuoi bambini&quot; or firstname == &quot;i vostri bambini&quot;\">\n"
"        <t t-set=\"vive\" t-value=\"&quot;vivono&quot;\"/>\n"
"    </t>\n"
"</p>\n"
"<p>\n"
"    <t t-out=\"partner.salutation\"></t>\n"
"</p>\n"
"<p>\n"
"    <t t-if=\"sponsorships.filtered(&quot;is_first_sponsorship&quot;)\">\n"
"\t    Questa è la prima delle cinque e-mail che abbiamo annunciato.\n"
"    </t>\n"
"</p>\n"
"<p>\n"
"    Oggi <t t-out=\"ti\"></t> presentiamo meglio: <t t-out=\"firstname\"></t> che <t t-out=\"vive\"></t> in <t t-out=\"children.get_list(&#x27;field_office_id.country_id.name&#x27;, 3, &#x27;diversi paesi&#x27;)\"></t>. (in allegato il PDF)\n"
"</p>\n"
"<p>\n"
"    <t t-if=\"False\">   \n"
"        <t t-out=\"&#x27;Sapevate&#x27; if plural else &#x27;Sapevi&#x27;\"></t> che è possibile fare visita <t t-out=\"children.get(&#x27;al bambino&#x27;)\"></t> che <t t-out=\"&#x27;sostenete&#x27; if plural else &#x27;sostieni&#x27;\"></t>?\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://compassion.ch/de/reisen/\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        INFORMAZIONI SULLE VISITE\n"
