#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_wrpr_welcome
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set firstname = sponsorships.mapped('child_id').get_list('preferred_name', 3, deine + 'n Patenkindern', False)\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
" % set my_url = \"https://stage.compassion.ch/im_livechat/support/2\"\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>So schön, ${\"ihr gehört\" if plural else \"du gehörst\"} nun zur weltweiten Compassion-Familie! Herzlich wilkommen!\n"
"</p>\n"
"<p>${\"Erfahrt\" if plural else \"Erfahre\"} hier mehr dazu: <a href=\"https://vimeo.com/710323229/b9f3f472c5\">https://vimeo.com/710323229/b9f3f472c5</a>\n"
"</p><div>\n"
"% if sum(sponsorships.mapped('total_amount')) and partner in sponsorships.mapped('partner_id'):\n"
"    <p>Damit ${\"ihr eure\" if plural else \"du deine\"} Spende für die ${sponsorships.get('Patenschaft')} einrichten ${\"könnt, findet ihr\" if plural else \"kannst, findest du\"} hier den Einzahlungsschein: <a href=\"https://stage.compassion.ch/report/pdf/report_compassion.single_bvr_sponsorship/${str(sponsorships[:1].id)}\">Einzahlungsschein</a>\n"
"        % if partner.parent_consent == 'not_submitted':\n"
"<br/>und die Einverständniserklärung, die wir von ${deine}n Eltern unterschrieben benötigen:\n"
"<a href=\"https://stage.compassion.ch/partner_compassion/static/src/img/parental_consent_de_DE.pdf\">https://stage.compassion.ch/partner_compassion/static/src/img/parental_consent_de_DE.pdf</a>\n"
"         % endif\n"
"    </p>\n"
"% endif\n"
"</div><p>In den kommenden Tagen werden wir ${dir} weitere wichtige Informationen zum Start der ${sponsorships.get('Patenschaft')} per SMS zukommen lassen. Heute sind wir bei Schritt 1/8.\n"
"</p>\n"
"<p>Liebe Grüsse\n"
"<br/>Sarah\n"
"<br/>Tel: +41 (0)31 552 21 21\n"
"<br/>Fragen? ${\"Meldet ihr\" if plural else \"Melde dich\"} per Chat bei uns: <a href=\"${my_url}\">${my_url}</a>\n"
"</p>\n"
"        "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set firstname = sponsorships.mapped('child_id').get_list('preferred_name', 3, 'n Patenkindern', False)\n"
"    % set chat_url = 'https://mycompassion.ch/fr_CH/im_livechat/support/3'\n"
"    % set survey = object.env.ref('partner_communication_switzerland.wrpr_onboarding_survey').public_url\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Che bello, ora fai parte della grande famiglia di Compassion! Benvenut${'o' if partner.gender == 'M' else 'a'}!\n"
"<p>\n"
"    Per saperne di più, clicca qui: <a href='https://vimeo.com/compassionswitzerland/writeandpray-it?share=copy'>video</a>\n"
"</p>\n"
"% if payer:\n"
"<p>\n"
"    Per effettuare la tua donazione per il sostegno, trovi il bollettino di versamento <a href='http://mycompassion.ch/my/download/sponsorship_bvr'>cliccando qui</a> e il modulo di consenso dei genitori da far firmare ai tuoi genitori <a href=\"http://compassion.ch/medias/write_pray/parental_consent_form_WP_it.pdf\">qui</a>.\n"
"</p>\n"
"% endif\n"
"<p>\n"
"    Nei prossimi giorni ti invieremo tramite SMS ulteriori informazioni importanti sull'inizio del tuo sostegno.\n"
"</p>\n"
"<p>\n"
"    Grazie e a presto!<br>\n"
"    Il team di Compassion<br>\n"
"    Tel: +41 (0)24 434 21 24<br>\n"
"    Hai domande? Chatta con noi su MyCompassion: <a href=\"${chat_url}\">${chat_url}</a>\n"
"</p>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.portal_user_welcome_email
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set user = object.get_objects()\n"
"    % set user = object.get_objects()\n"
"    % set registration = partner.registration_ids[:1]\n"
"    % set event = registration.event_id.compassion_event_id\n"
"    % set country = event.country_id\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation},\n"
"</p>\n"
"<p>\n"
"    WELCOME to the Muskathlon ${event.name} from&nbsp;${event.get_date('start_date','d')}&nbsp;until&nbsp;${event.get_date('end_date', 'date_full')} - your extreme commitment against extreme poverty!\n"
"</p>\n"
"<p>\n"
"    The Muskathlon is organized by 4M Switzerland in cooperation with the Christian charity for children, Compassion, and offers you the extraordinary opportunity to take part in the fight against child poverty and its consequences and at the same time take part in a sporting challenge on another continent.\n"
"</p>\n"
"<p>\n"
"    Together we will make the difference, and see that hope is stronger than poverty!\n"
"</p>\n"
"<p>\n"
"    With your registration a very special and great adventure has begun for you. Compassion wants to give you the best possible support and give you all the information and tips you need for your muskathlon.\n"
"</p>\n"
"<p>\n"
"    Start with your preparation and familiarise yourself with the ‘Events’ section in your MyCompassion profile.\n"
"</p>\n"
"<p>\n"
"    In the following months, we will provide you with more information material and remind you when to do what.\n"
"</p>\n"
"<p>\n"
"    Soon you will receive mail from us with the invoice for the travel costs, various flyers and your training shirt.\n"
"</p>\n"
"\n"
"% if not user:\n"
"    <p>\n"
"        Please activate your account and setup your password by clicking on this button:\n"
"    </p>\n"
"    <div style=\"font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin:0 auto; text-align: center;\">\n"
"        <a href=\"${user.signup_url + '&amp;redirect=/my/muskathlon'}\"\n"
"            style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\">\n"
"            Activate my account\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"\n"
"<p>\n"
"    Here are your access data:\n"
"</p>\n"
"<ul>\n"
"    <li>\n"
"        Username: ${user.login or ''}\n"
"    </li>\n"
"    <li>\n"
"        Access link: <a href=\"https://my.compassion.ch/my/muskathlon\">my.compassion.ch/my/muskathlon</a>\n"
"    </li>\n"
"</ul>\n"
"<p>\n"
"    If any questions arise, please do not hesitate to contact us.\n"
"</p>\n"
"<ul>\n"
"    <li>\n"
"        For questions about organization and travel:\n"
"        <br>\n"
"        Nathalie Schranz, n.schranz@4m-switzerland.ch, 079 507 92 40\n"
"    </li>\n"
"    <li>\n"
"        For questions about Compassion and sponsorships:\n"
"        <br>\n"
"        Colin Ward, cward@compassion.ch, 077 261 36 76\n"
"    </li>\n"
"</ul>\n"
"<p>\n"
"    Best Regards\n"
"</p>\n"
"<p>\n"
"    Nathalie, 4M Switzerland\n"
"    <br>\n"
"    Colin, Compassion Switzerland\n"
"</p>"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set user = object.get_objects()\n"
"    % set registration = partner.registration_ids[:1]\n"
"    % set event = registration.event_id.compassion_event_id\n"
"    % set country = event.country_id\n"
"    % set start_date = event.get_date('start_date', 'd')\n"
"    % set end_date = event.get_date('end_date', 'date_full')\n"
"\n"
"    % if start_date.startswith(\"11\") or start_date.startswith(\"8\") or start_date.startswith(\"1 \"):\n"
"        % set start_date = \"dall'\" + start_date\n"
"    % else:\n"
"        % set start_date = \"dal \" + start_date\n"
"    % endif\n"
"\n"
"    % if end_date.startswith(\"11\") or end_date.startswith(\"8\") or end_date.startswith(\"1 \"):\n"
"        % set end_date = \"all'\" + end_date\n"
"    % else:\n"
"        % set end_date = \"al \" + end_date\n"
"    % endif\n"
"\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"<p>\n"
"    Benvenut${'o' if partner.gender == 'M' else 'a'} al Muskathlon che si terrà ${start_date} - ${end_date} – il tuo impegno sportivo contro la povertà estrema!\n"
"</p>\n"
"<p>\n"
"    Il Muskathlon è organizzato da 4M Svizzera, in collaborazione con l’ONG Compassion. Quest'ultima ti offre un'opportunità unica di partecipare alla lotta contro la povertà infantile e le sue conseguenze, affrontando al contempo una sfida sportiva in un altro continente.\n"
"</p>\n"
"<p>\n"
"    Insieme, faremo la differenza e vedremo che la speranza è più forte della povertà!\n"
"</p>\n"
"<p>\n"
"    La tua iscrizione segna l'inizio di una grande avventura. Compassion vuole sostenerti al meglio e fornirti tutte le informazioni necessarie per il successo del tuo Muskathlon. Nel corso dei mesi, ti invieremo regolarmente informazioni su cosa devi fare, quando, come, ecc.\n"
"</p>\n"
"<p>\n"
"    Nei prossimi giorni riceverai una nostra comunicazione con la fattura per le spese di viaggio, vari volantini e la tua maglietta da allenamento.\n"
"</p>\n"
"\n"
"% if not user:\n"
"    <p>\n"
"        Ti invitiamo ad attivare il tuo account da partecipante, a scegliere una password e a completare il resto delle informazioni.\n"
"    </p>\n"
"    <div style=\"margin:0 auto; text-align: center;\">\n"
"        <a href=\"${partner.signup_url + '&amp;redirect=/my/events'}\"\n"
"            style=\"text-decoration:none;color:rgb(124, 123, 173);background-color:transparent;padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\">\n"
"            Attiva l'account\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"\n"
"<p>\n"
"    Ecco i tuoi dati di accesso:\n"
"</p>\n"
"<ul>\n"
"    <li>\n"
"        Nome utente: ${user.login or ''}\n"
"    </li>\n"
"    <li>\n"
"        Link di accesso: <a href=\"https://my.compassion.ch/my/muskathlon\">my.compassion.ch/my/muskathlon</a>\n"
"    </li>\n"
"</ul>\n"
"<p>\n"
"    Se hai domande, non esitare a contattarci.\n"
"</p>\n"
"<ul>\n"
"    <li>\n"
"        Per domande relative all'organizzazione e al viaggio:\n"
"        <br>\n"
"        Nathalie Schranz, n.schranz@4m-switzerland.ch, 079 507 92 40\n"
"    </li>\n"
"    <li>\n"
"        Per domande relative a Compassion e ai sostegni:\n"
"        <br>\n"
"        Colin Ward, cward@compassion.ch, 077 261 36 76\n"
"    </li>\n"
"</ul>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"<p>\n"
"    Nathalie, 4M Switzerland\n"
"    <br>\n"
"    Colin, Compassion\n"
"</p>"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_zoom_link
msgid ""
"<div>\n"
"    % set session = object.get_objects()\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you for registering for the video conference for new sponsors. We look forward to meeting you online on\n"
"    ${session.get_date('date_start', 'dd. MMMM')}, showing you what your sponsorship is doing, and answering your\n"
"    questions.\n"
"</p>\n"
"<p>\n"
"    Here is the link to attend the meeting at ${session.get_date('date_start', 'HH:mm')}: ${session.link}\n"
"</p>\n"
"<p>\n"
"    We'll be happy if you turn on the camera at the beginning of the meeting so we can see you. You can also turn\n"
"    it off afterwards if you prefer. The sound quality is best if all participants mute their microphone when they are\n"
"    not speaking.\n"
"</p>\n"
"<p>\n"
"    You can log in ten minutes before the meeting starts. If you have any technical questions, please feel free to\n"
"    contact me in advance.\n"
"</p>\n"
"<p>\n"
"    Warm regards and see you soon!\n"
"</p>\n"
"<div>\n"
"    ${object.user_id.signature | safe}\n"
"</div>\n"
msgstr ""
"<!--\n"
"La ${'vostra' if object.partner_id.title.plural or object.partner_id.title.id == 29 else 'tua'} iscrizione alla videoconferenza\n"
"-->\n"
"<div>\n"
"    % set session = object.get_objects()\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"\n"
"    % if plural:\n"
"        % set iscritto = 'iscritti'\n"
"    % elif partner.gender == 'F':\n"
"        % set iscritto = 'iscritta'\n"
"    % else\n"
"        % set iscritto = 'iscritto'\n"
"    % endif\n"
"\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Grazie per ${'esservi' if plural else 'esserti'} ${iscritto} alla videoconferenza per nuovi sostenitori.\n"
"</p>\n"
"<p>\n"
"    Saremo felici di ${'incontrarvi' if plural else 'incontrarti'} ${session.get_date('date_start', 'dd. MMMM')} per parlare dell'impatto del ${'vostro' if plural else 'tuo'} sostegno e rispondere a tutte le ${'vostre' if plural else 'tue'} domande.\n"
"</p>\n"
"<p>\n"
"    Ecco il link per partecipare alla riunione di ${session.get_date('date_start', 'dd. MMMM')} alle ore ${session.get_date('date_start', 'HH:mm')}: <a href=\"${session.link}\">${session.link}</a>\n"
"</p>\n"
"<p>\n"
"    ${'Vi' if plural else 'Ti'} proponiamo di attivare la telecamera all'inizio dell'incontro in modo che possiamo ${'vedervi' if plural else 'vederti'}. Se lo ${'desiderate' if plural else 'desideri'}, ${'potete' if plural else 'puoi'} disattivarla in seguito. Per una qualità audio ottimale, ${'vi' if plural else 'ti'} chiediamo di disattivare il microfono e di attivarlo solamente quando ${'prendete' if plural else 'prendi'} la parola.\n"
"</p>\n"
"<p>\n"
"    ${'Potrete collegarvi' if plural else 'Potrai collegarti'} a partire dalle 19:50. Non ${'esitate' if plural else 'esitare'} a contattarci se ${'avete' if plural else 'hai'} domande di carattere tecnico.\n"
"</p>\n"
"<p>\n"
"    Cari saluti e a presto!\n"
"</p>\n"
"<div>\n"
"    ${object.user_id.signature | safe}\n"
"</div>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_zoom_registration_confirmation
msgid ""
"<div>\n"
"    % set session = object.get_objects().zoom_session_id\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you for your interest in the informational and sharing video conference for new sponsors.\n"
"</p>\n"
"<p>\n"
"    The meeting will take place on ${session.get_date('date_start', 'dd. MMMM')} at ${session.get_date('date_start',\n"
"    'HH:mm')}.\n"
"</p>\n"
"<p>\n"
"    We will send you all the information regarding the connection to this meeting a few days before by email or will\n"
"    inform you in case you have chosen a later date.\n"
"</p>\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"<div>\n"
"    ${object.user_id.signature | safe}\n"
"</div>\n"
msgstr ""
"<div>\n"
"    % set session = object.get_objects().zoom_session_id\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    ${'Vi' if plural else 'Ti'} ringraziamo per il ${'vostro' if plural else 'tuo'} interesse alla videoconferenza di informazione e di condivisione per nuovi sostenitori.\n"
"</p>\n"
"<p>\n"
"    L'incontro online si terrà ${session.get_date('date_start', 'dd. MMMM')} alle ore ${session.get_date('date_start', 'HH:mm')}.\n"
"</p>\n"
"<p>\n"
"    Qualche giorno prima, ${'vi' if plural else 'ti'} invieremo via e-mail tutte le informazioni per ${'potervi' if plural else 'poterti'} collegare. Se ${'avete' if plural else 'hai'} scelto l’opzione di una data successiva, ${'vi' if plural else 'ti'} contatteremo per ${'informarvi' if plural else 'informarti'} delle prossime date disponibili.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"<div>\n"
"    ${object.user_id.signature | safe}\n"
"</div>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_birthday_reminder
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set He = child.get('He')\n"
"    % set he = child.get('he')\n"
"    % set his = child.get('his')\n"
"    % set him = child.get('him')\n"
"    % set age = child.age + 1\n"
"    % set month = child.get_date('birthdate', 'date_month')\n"
"    % set hold_gifts = child.get_hold_gifts()\n"
"    % set partner = object.partner_id\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set already_paid = sponsorships.mapped('birthday_paid')\n"
"    % set paid_date = already_paid and already_paid[0] and already_paid[0].get_date('date_partner_paid', 'date_full')\n"
"    % set send_gifts_to = sponsorships.mapped(sponsorships[0].send_gifts_to)[0]\n"
"    % set does_write = partner == sponsorships[0].correspondent_id and 23 not in partner.category_id.ids\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    It's ${firstname}'s birthday on ${month}.\n"
"</p>\n"
"<p>\n"
"    ${child.get('He')} will be ${age} years old this year.\n"
"</p>\n"
"<p>\n"
"    We invite you to write a few words of encouragement to ${him} online via <a href=\"https://www.mycompassion.ch\">MyCompassion</a>.\n"
"</p>\n"
"<p>\n"
"    Imagine the joy when ${he} receives a letter from you!*\n"
"</p>\n"
"\n"
"% if not hold_gifts and not already_paid and send_gifts_to == partner:\n"
"    <p>\n"
"        If you would also like to give ${firstname} a present, you can do so using the attached payment slip or <a href=\"https://compassion.ch/de/geschenkformular\">online</a>.*\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Thank you for making a difference in ${firstname}'s life.\n"
"</p>\n"
"<p>\n"
"    Kind regards\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.short_signature | striptags}\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    *It is possible that this message crossed with your letter or donation.\n"
"</p>\n"
msgstr ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set boy = child.gender == 'M'\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set his = child.get('his')\n"
"    % set him = child.get('him')\n"
"    % set month = child.get_date('birthdate', 'date_month')\n"
"    % set hold_gifts = child.get_hold_gifts()\n"
"    % set partner = object.partner_id\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set already_paid = sponsorships.mapped('birthday_paid')\n"
"    % set paid_date = already_paid and already_paid[0] and already_paid[0].get_date('date_partner_paid', 'date_full')\n"
"    % set send_gifts_to = sponsorships.mapped(sponsorships[0].send_gifts_to)[0]\n"
"    % set does_write = partner == sponsorships[0].correspondent_id and 23 not in partner.category_id.ids\n"
"    % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"\n"
"    % if month.startswith(\"11\") or month.startswith(\"8\"):\n"
"        % set date = \"L'\" + month\n"
"    % elif month.startswith(\"1 \"):\n"
"        % set date = \"Il 1°\" + month[1:]\n"
"    % else:\n"
"        % set date = \"Il \" + month\n"
"    % endif\n"
"</div>\n"
"\n"
"% if object.send_mode == 'sms':\n"
"    <p>\n"
"        ${partner.informal_salutation},\n"
"    </p>\n"
"    <p>\n"
"        ${date}, sarà il compleanno di ${firstname}.\n"
"    </p>\n"
"    <p>\n"
"        Immagina la gioia di ricevere gli auguri di compleanno che arrivano dall'altra parte del mondo. Sapere che qualcuno pensa a te e che non sei solo è un regalo dal valore inestimabile.\n"
"    </p>\n"
"    <p>\n"
"        Puoi scriver${'gli' if boy else 'le'} su MyCompassion.\n"
"    </p>\n"
"\n"
"    % if partner.has_majority or partner.parent_consent == \"approved\":\n"
"        <p>\n"
"            Se desideri fare una donazione per un regalo di compleanno a ${firstname}, <a href=\"https://compassion.ch/it/formulario-per-regalo?${partner.wordpress_form_data}\">puoi farlo qui</a>.\n"
"        </p>\n"
"    % endif\n"
"\n"
"    <p>\n"
"        Grazie per aver investito nel migliorare la sua vita.\n"
"    </p>\n"
"    <p>\n"
"        Buona giornata e a presto!\n"
"    </p>\n"
"    <p>${whatsapp_signature}</p>\n"
"% else:\n"
"    <p>\n"
"        ${partner.salutation},\n"
"    </p>\n"
"    <p>\n"
"        ${date}, sarà il compleanno di ${firstname}, quest'anno compirà ${child.age + 1} anni.\n"
"    </p>\n"
"\n"
"    % if does_write:\n"
"        <p>\n"
"            ${'Dedichereste' if plural else 'Dedicheresti'} qualche minuto per scriver${'gli' if boy else 'le'} un breve messaggio e far${'gli' if boy else 'le'} sapere che ${'pensate' if plural else 'pensi'} a ${'lui' if boy else 'lei'}? ${'Potete' if plural else 'Puoi'} farlo rapidamente e facilmente su MyCompassion.ch. Questa piattaforma ${ti} permette di avere sempre a portata di mano le foto, le lettere e le informazioni su ${firstname}.\n"
"        </p>\n"
"        <p>\n"
"            ${'Immaginate' if plural else 'Immagina'} la ${'loro' if plural else 'sua'} gioia nel ricevere una ${tua} lettera.\n"
"        </p>\n"
"    % endif\n"
"\n"
"    % if not hold_gifts and not already_paid and send_gifts_to == partner:\n"
"        <p>\n"
"            Se ${\"desiderate\" if plural else \"desideri\"} far${'gli' if boy else 'le'} un regalo di compleanno, ${'potete' if plural else 'puoi'} utilizzare il bollettino di versamento allegato o andare direttamente online\n"
"            <a href=\"https://compassion.ch/it/formulario-per-regalo/\">\n"
"                compassion.ch/it/formulario-per-regalo/\n"
"            </a>.\n"
"        </p>\n"
"    % endif\n"
"\n"
"    <p>\n"
"        Grazie per il contributo che ${'state' if plural else 'stai'} dando alla vita di ${firstname}!\n"
"    </p>\n"
"    <p>\n"
"        Cari saluti e a presto,\n"
"    </p>\n"
"\n"
"    % if object.send_mode == \"digital\":\n"
"        <p>\n"
"            ${object.user_id.short_signature | safe}\n"
"        </p>\n"
"    % endif\n"
"\n"
"    <p>\n"
"        *È possibile che questo messaggio sia stato inviato contemporaneamente a una lettera o una donazione per un regalo di compleanno da parte ${tua}. In questo caso, ${'potete' if plural else 'puoi'} semplicemente ignorarlo. Grazie per la comprensione.\n"
"    </p>\n"
"% endif"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_wrpr_dossier
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set partner = object.partner_id\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation},\n"
"    <br>\n"
"    <br>\n"
"    Welcome to the Compassion Family!\n"
"    <br>\n"
"    <br>\n"
"    Thank you for your commitment to ${'another ' if sponsorships.mapped('parent_id') or len(object.partner_id.sponsorship_ids) != len(sponsorships) else ''}child in poverty. You have made a great decision! You will be changing the life of ${firstname} ${child.get('his')} family.\n"
"    <br>\n"
"    <br>\n"
"    In a few days time, ${firstname} will learn that ${child.get('he')} ${child.get('has')} a sponsor. It will be a day of joy for ${child.get('him')} and ${child.get('his')} family.\n"
"    <br>\n"
"    <br>\n"
"    So that the sponsorship runs smoothly, enclosed you will find some important information and documents to help you get started:\n"
"    <br>\n"
"</p>\n"
"<ul>\n"
"    <li>\n"
"        1 photo of your sponsored child\n"
"    </li>\n"
"    <li>\n"
"        1 dossier with practical information about this sponsorship\n"
"        <br>\n"
"    </li>\n"
"    <li>\n"
"        1 letter template so that you can introduce yourself to the child\n"
"        <br>\n"
"    </li>\n"
"    <li>\n"
"        1 sheet of labels to use each time you write letters to the child (1 label each with a reference number to whatever you send-- each letter, card, drawing, booklet, etc.)\n"
"        <br>\n"
"    </li>\n"
"</ul>\n"
"<p>\n"
"    The special feature of a “Write &amp; Pray” sponsorship is teamwork. The sponsored child will come to know you as ${child.get('his')} sponsor.  We are depending on you to pray for the child and to write to ${child.get('him')} at least 2x per year while another donor provides the ${'missing ' if payer else ''}financial support for ${child.get('the child')}.\n"
"    <br>\n"
"    <br>\n"
"    We wish you and ${firstname} much joy and blessing in corresponding with one another!\n"
"    <br>\n"
"    <br>\n"
"    If you have any questions, please do not hesitate to contact us.\n"
"    <br>\n"
"    <br>\n"
"    Best regards,\n"
"</p>\n"
" "
msgstr ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', translate=False)\n"
"    % set partner = object.partner_id\n"
"    % set lui = child.get('lui')\n"
"    % set payer = partner in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set young = not plural\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set ti = \"vi\" if plural else \"ti\"    \n"
"    \n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"   % if sponsorships.mapped('parent_id') or len(object.partner_id.sponsorship_ids) != len(sponsorships):\n"
"\t${partner.salutation}\n"
"</p>\n"
"<p>\n"
"Grazie mille, ${\"avete\" if plural else \"hai\"} deciso di investire nella vita di ${\"un altro bambino\" if len(child) == 1 else \"altri bambini\"}!\n"
"\t% else:\n"
"\t${partner.get('Benvenuto')} ${partner.firstname}! Che bello, ora ${\"fate\" if plural else \"fai\"} parte della famiglia di Compassion!\n"
"% endif\n"
"</p>\n"
"<p>\n"
"   Insieme a ${te}, stiamo attualmente liberando più di ${number_children} milioni di bambini dalla povertà estrema con circa ${number_fcps} chiese partner in ${number_countries} paesi. Insieme doniamo ai bambini la possibilità di vivere con speranza e futuro.\n"
"    </p>\n"
"% if not payer:\n"
"<p>\n"
"   Tra qualche giorno ${firstname} ${child.get('will be')} informat${child.get('accord_o_a')} di avere finalmente un sostenitore. Sarà un giorno di gioia per ${lui} e ${\"la sua famiglia\" if len(child) == 1 else \"le loro famiglie\"}.\n"
"   </p>\n"
"% endif\n"
"<p>\n"
"   Per iniziare bene il sostegno di ${firstname}, alleghiamo alcune informazioni importanti: \n"
"  </p>\n"
"  <ul>\n"
"   <li>\n"
"    1 foto ${'di ' + firstname if len(child) == 1 else 'ogni bambino'}.\n"
"   </li>\n"
"   <li>\n"
"    1 dossier con informazioni pratiche\n"
"   </li>\n"
"   <li>\n"
"    1 carta per ${\"presentarvi\" if plural else \"presentarti\"} ${'al bambino' if len(child) == 1 else 'ai bambini'}\n"
"   </li>\n"
"   <li>\n"
"    1 foglio di etichette da utilizzare per tutta la corrispondenza (da incollare su lettere, carte, disegni, adesivi, su tutto il materiale cartaceo che ci ${\"invierete\" if plural else \"invierai\"} per corriere).\n"
"   </li>\n"
"  </ul>\n"
"  La particolarità del sostegno «Write & Pray» è il lavoro di squadra. Contiamo su di ${te} per pregare per ${firstname}, e scrivere almeno due volte l'anno.\n"
"    </p>\n"
"<p>\n"
"  % if payer:\n"
"\tUn altro donatore coprirà il saldo del sostegno finanziario per ${firstname}. Dopo l'arrivo della prima donazione per il sostegno a distanza, ${firstname}, ${child.get('will be')} informat${child.get('accord_o_a')} avere finalmente un sostenitore!  ${\"Riuscite\" if plural else \"Riesci\"} a immaginare la grande gioia di questa notizia?\n"
"\t% else:\n"
"\tUn altro donatore fornirà supporto finanziario per ${firstname}.\n"
"% endif\n"
"    </p>\n"
"<p>\n"
"  Grazie mille per aver preso una generosa decisione per ${firstname}! \n"
"    </p>\n"
"<p>\n"
"  Auguriamo a entrambi gioia e benedizione, e ${ti} ricordiamo che se ${\"avete\" if plural else \"hai\"} domande siamo qui per ${te}. Insieme cambiamo il mondo! Un bambino alla volta.\n"
" </p>\n"
"<p>\n"
"A presto!\n"
"</p>"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_birthday_1day_reminder
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"\n"
"% set sponsorships = object.get_objects()\n"
"\n"
"% set child = sponsorships.mapped('child_id')\n"
"\n"
"% set name = child.get_list('preferred_name', translate=False)\n"
"\n"
"% set one = len(child) == 1\n"
"\n"
"% set letters = object.env['correspondence'].search([('sponsorship_id', 'in', sponsorships.ids), ('scanned_date', '>=', (datetime.datetime.now() - relativedelta(months=3)).strftime('%Y-%m-%d')), ('direction', '=', 'Supporter To Beneficiary')])\n"
"\n"
"% set month = child.get_date('birthdate', 'date_month')\n"
"\n"
"% set already_paid = sponsorships.mapped('birthday_paid')\n"
"\n"
"% set paid_date = already_paid and already_paid[0] and already_paid[0].get_date('date_partner_paid', 'date_full')\n"
"\n"
"% set hold_gifts = child.get_hold_gifts()\n"
"\n"
"% set send_gifts_to = sponsorships.mapped(sponsorships[0].send_gifts_to)[0]\n"
"\n"
"% set does_write = partner == sponsorships[0].correspondent_id and 23 not in partner.category_id.ids\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Tomorrow, it’s ${child.get('your sponsored child')} ${name}'s birthday! Thanks to your sponsorship, ${name} has been able to enjoy another year at the project.\n"
"   <br>\n"
"   <br>\n"
"   % if does_write and not letters:\n"
"\tIf you haven’t sent a greeting yet, would you be willing to send ${child.get('him')} some birthday wishes? A few heartfelt and appreciative words encourage the children greatly and demonstrates that they are valuable.  You can write him online at:\n"
"   <a href=\"https://my.compassion.ch/r/fVN?email=${partner.email}&pname=${partner.name}&sponsor_ref=${partner.ref}&child_ref=${child.local_id if len(child) == 1 else ''}\">\n"
"    www.compassion.ch/ecrire\n"
"   </a>\n"
"   <br>\n"
"   <br>\n"
"   % endif \n"
" \n"
"% if not hold_gifts and not already_paid and send_gifts_to == partner:\n"
"\tDid you know you can also send a birthday present to ${name}? If you would like, you can still\n"
"   <a href=\"https://my.compassion.ch/r/njq?fund_code=Anniversaire&last_name=${partner.lastname}&first_name=${partner.firstname}&street=${partner.street}&zipcode=${partner.zip}&city=${partner.city}&email=${partner.email}&child_ref=${child.local_id if len(child) == 1 else ''}&country=${partner.country_id.name}\">\n"
"    send your sponsored child a birthday present\n"
"   </a>\n"
"   (between 20.-100 CHF.-maximum).  Together, with an employee from the project who knows ${name} well; a useful present or presents will be chosen and purchased. Just imagine the joy on their face in a few months when they realize you have sent them a birthday gift!\n"
"   <br>\n"
"   <br>\n"
"   % endif \n"
"   Thank you for investing in the life of ${name}. In partnership with you and more than one million sponsors worldwide, the lives of 2 million children living in extreme poverty are being transformed. Michelle in the Philippines, who now runs her own NGO to help victims of human trafficking, is one example of many other former sponsored children who are now changing the lives of many other children.\n"
"   <br>\n"
"   <br>\n"
"   Thanks again for your generous commitment.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"   <br>\n"
"   <br>\n"
"   Carole Rochat\n"
"   <br>\n"
"   Sponsor and Donor services\n"
"   <br>\n"
"   Compassion Switzerland\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set boy = child.gender == 'M'\n"
"    % set name = child.get_list('preferred_name', translate=False)\n"
"    % set one = len(child) == 1\n"
"    % set letters = object.env['correspondence'].search([('sponsorship_id', 'in', sponsorships.ids), ('scanned_date', '>=', (datetime.datetime.now() - relativedelta(months=3)).strftime('%Y-%m-%d')), ('direction', '=', 'Supporter To Beneficiary')])\n"
"    % set month = child.get_date('birthdate', 'date_month')\n"
"    % set already_paid = sponsorships.mapped('birthday_paid')\n"
"    % set paid_date = already_paid and already_paid[0] and already_paid[0].get_date('date_partner_paid', 'date_full')\n"
"    % set hold_gifts = child.get_hold_gifts()\n"
"    % set send_gifts_to = sponsorships.mapped(sponsorships[0].send_gifts_to)[0]\n"
"    % set does_write = partner == sponsorships[0].correspondent_id and 23 not in partner.category_id.ids\n"
"    % set partner = object.partner_id\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Domani è il compleanno di ${name}, compirà ${child.age + 1} anni!\n"
"</p>\n"
"<p>\n"
"    Grazie al ${'vostro' if plural else 'tuo'} sostegno, ${name} ha potuto partecipare alle attività del centro di accoglienza per un altro anno.\n"
"</p>\n"
"\n"
"% if does_write and not letters:\n"
"    <p>\n"
"        ${'Vi' if plural else 'Ti'} invitiamo a prendere qualche minuto per augurar${'gli' if boy else 'le'} un felice compleanno e per inviar${'gli' if boy else 'le'} parole di apprezzamento e incoraggiamento. ${'Potete' if plural else 'Puoi'} scriver${'gli' if boy else 'le'} direttamente online su\n"
"        <a href=\"https://my.compassion.ch/r/Sdg?email=${partner.email}&pname=${partner.name}&sponsor_ref=${partner.ref}&child_ref=${child.local_id if len(child) == 1 else ''}\">\n"
"            mycompassion.ch\n"
"        </a>.\n"
"    </p>\n"
"% endif\n"
"\n"
"% if not hold_gifts and not already_paid and send_gifts_to == partner:\n"
"    <p>\n"
"        Se ${'desiderate' if plural else 'desideri'} far${'gli' if boy else 'le'} un regalo di compleanno, ${'potete' if plural else 'puoi'} farlo utilizzando il bollettino di versamento allegato o direttamente online:\n"
"        <a href=\"https://compassion.ch/it/offrire/\">\n"
"            compassion.ch/it/offrire\n"
"        </a>\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Grazie per aver investito nel migliorare la vita di ${name} e per contribuire a cambiarla in modo duraturo.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    * Questa comunicazione potrebbe essere stata inviata contemporaneamente a una lettera, a un biglietto di auguri o a una donazione per un regalo di compleanno da parte ${'vostra' if plural else 'tua'}. In questo caso, ${'potete' if plural else 'puoi'} semplicemente ignorarla. Grazie!\n"
"</p>"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_invalid_email
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"   \n"
"% set sponsorships = partner.sponsorship_ids\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   % if sponsorships:\n"
"\tThank you for investing in the life of ${sponsorships.get_list('preferred_name', translate=False)} with a sponsorship.\n"
"\t% else:\n"
"\tThank you for your concern for children living in extreme poverty.\n"
"% endif\n"
"   <br>\n"
"   <br>\n"
"   We have sent you an e-mail to the following address: ${partner.email or ''} . Unfortunately, it seems to not have reached you. Have you changed your email address or did the email end up in your spam?\n"
"   <br>\n"
"   <br>\n"
"   May we ask you to contact us to give us your new email address or that you add \"info@compassion\" to your contact list, in case the email reached you? You can reach us by phone at 031 552 21 21 or write us to info@compassion.ch.\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment. Together we are able to tranform the lives of currently 2 million children in 25 countries in a sustainable way.\n"
"   <br>\n"
"   <br>\n"
"   Sincerely,\n"
"   <br>\n"
"   <br>\n"
"   PS: Do you already have the Compassion app? With it you always have your sponsored child's pictures, letters and all information at hand. And the letter writing is made even easier. Download here: www.compassion.ch/app\n"
"   <br>\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorships = partner.sponsorship_ids.filtered('is_active')\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation},\n"
"</p>\n"
"<p>\n"
"    % if sponsorships:\n"
"        Grazie per aver investito nel migliorare la vita di bambini che vivono in condizioni di estrema povertà.\n"
"    % else:\n"
"        Grazie per il ${'vostro' if plural else 'tuo'} impegno a favore dei bambini che vivono in condizioni di estrema povertà.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    ${'Vi' if plural else 'Ti'} abbiamo inviato un'e-mail all'indirizzo ${partner.invalid_mail or partner.email}. ${'Avete' if plural else 'Hai'} cambiato indirizzo e-mail o è finita nella posta indesiderata (spam)?\n"
"</p>\n"
"<p>\n"
"    ${'Vi' if plural else 'Ti'} preghiamo di fornirci un indirizzo e-mail valido o aggiungere l'indirizzo info@compassion.ch ai ${'vostri' if plural else 'tuoi'} contatti.\n"
"</p>\n"
"<p>\n"
"    Ancora una volta, grazie di cuore per il ${'vostro' if plural else 'tuo'} impegno con Compassion. Insieme, stiamo contribuendo a cambiare in modo duraturo la vita di ${number_children} milioni di bambini bisognosi.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_address_change
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"                    \n"
"% set address = partner.short_address\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the lives of children in extreme poverty.\n"
"   <br>\n"
"   <br>\n"
"   We have sent you mail to the following address:\n"
"   <br>\n"
"   <br>\n"
"   ${address |safe}\n"
"   <br>\n"
"   <br>\n"
"   Unfortunately, the letter did not reach you. Have you moved? If so, we would be pleased if you could tell us your new address.\n"
"   <br>\n"
"   <br>\n"
"   Your support of children in extreme poverty is valuable.\n"
"   <br>\n"
"   <br>\n"
"   At Compassion, we believe that you are giving them the chance to live a dignified and meaningful life. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can positively transform the lives of currrently more than 2 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Sincerely,\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"   ${object.user_id.preferred_name} ${object.user_id.lastname}\n"
"   <br>\n"
"   ${object.user_id.employee_ids.department_id.name}\n"
"   <br>\n"
"   ${object.user_id.company_id.address_name}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set address = partner.short_address\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Purtroppo, la posta che ${'vi' if plural else 'ti'} abbiamo inviato al seguente indirizzo è tornata indietro:\n"
"</p>\n"
"<p>\n"
"    ${address |safe}\n"
"</p>\n"
"<p>\n"
"    ${'Vi siete' if plural else 'Ti sei'} trasferit${'i' if plural else ('o' if partner.gender == 'M' else 'a')}?\n"
"</p>\n"
"<p>\n"
"    In tal caso ${'vi' if plural else 'ti'} preghiamo di comunicarci il ${'vostro' if plural else 'tuo'} nuovo indirizzo.\n"
"</p>\n"
"<p>\n"
"    Grazie per aver investito nel migliorare la vita dei bambini che vivono in povertà. Insieme, stiamo contribuendo a cambiare in modo duraturo la vita di oltre ${number_children} milioni di bambini in ${number_countries} Paesi del Sud.\n"
"</p>\n"
"<p>\n"
"    Cari saluti e a presto,\n"
"</p>\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
"% endif\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.sms_confirmation_email_2
msgid ""
"<div>\n"
"   % set sponsorship = object.get_objects()\n"
"                    \n"
"% set child = sponsorship.child_id\n"
"% set transaction_done = sponsorship.state == 'active'\n"
"  </div>\n"
"  <p>\n"
"   Hello,\n"
"   <br>\n"
"   <br>\n"
"   Thank you for your commitment towards ${child.preferred_name}.\n"
"% if not transaction_done:\n"
"Now that all information is completed, we will activate your sponsorship. ${child.preferred_name} will be informed as soon as you pay your first donation.\n"
"% endif\n"
"   <br>\n"
"   <br>\n"
"   You will receive more documentation by post in the coming days. In the mean time, feel free to reach us if you have any question.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"    Carole Rochat\n"
"    <br>\n"
"    Sponsor and Donor services\n"
"    <br>\n"
"    Compassion Switzerland\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.sms_reminder_email
msgid ""
"<div>\n"
"   % set sponsorship = object.get_objects()\n"
"                    \n"
"% set partner = sponsorship.partner_id\n"
"                    \n"
"% set child = sponsorship.child_id\n"
"                    \n"
"% set url = \"%s/child/%s/sponsor/confirmation?face_reveal=1\" % (partner.get_base_url(), child.id)\n"
"  </div>\n"
"  <p>\n"
"   Hello,\n"
"  </p>\n"
"  <p>\n"
"   3 days ago, you chose to invest in the life of ${child.preferred_name}.\n"
"   <br>\n"
"   <br>\n"
"   There are 2 steps left before ${child.get('he')} will be informed that you sponsor ${child.get('him')}.                    Please consider finishing your request&nbsp;and you will begin to release&nbsp;${child.preferred_name} from poverty, for a purposeful life.\n"
"   <br>\n"
"   <br>\n"
"   1.\n"
"   <a href=\"${url}\" style=\"color:#0055A6;text-decoration: underline;\">\n"
"    Click here\n"
"   </a>\n"
"   to complete your information and your payment option.\n"
"   <br>\n"
"   2. Your sponsorship will be activated when we receive your first payment.\n"
"   <br>\n"
"   <br>\n"
"   In the unlikely case you don't want to sponsor this child anymore, please contact us quickly by e-mail or by phone at 031 552 21 25. We will then try to find another sponsor for ${child.preferred_name}.\n"
"  </p>\n"
"  <p>\n"
"   A sponsorship changes a child's life forever. Michelle has grown in extrem poverty in the Philippines. She has been sponsored and created her own NGO to rescue human trafic victims.\n"
"   <br>\n"
"   <br>\n"
"   Best regards\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"    Carole Rochat\n"
"    <br>\n"
"    Sponsor and Donor services\n"
"    <br>\n"
"    Compassion Switzerland\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set sponsorship = object.get_objects()\n"
"    % set partner = sponsorship.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set child = sponsorship.child_id\n"
"    % set url = \"%s/child/%s/sponsor/confirmation?face_reveal=1\" % (partner.get_base_url(), child.id)\n"
"</div>\n"
"<p>\n"
"        ${partner.informal_salutation},\n"
"</p>\n"
"<p>\n"
"    Grazie per aver deciso di investire nel migliorare la vita di ${child.preferred_name}.\n"
"</p>\n"
"<p>\n"
"    ${'Potete' if plural else 'Puoi'} inviarci i ${'vostri' if plural else 'tuoi'} dati completi <a href=\"${url}\" style=\"color: #0055A6; text-decoration: underline;\">(${'cliccate' if plural else 'clicca'} qui)</a>.\n"
"</p>\n"
"<p>\n"
"    Se ${'avete' if plural else 'hai'} ancora domande, contatta${'te' if plural}ci all'indirizzo <a href=\"mailto:info@compassion.ch\">info@compassion.ch</a> o al numero 042 434 21 24.\n"
"</p>\n"
"<p>\n"
"    ${'Vi' if plural else 'Ti'} invieremo un'e-mail non appena avremo ricevuto i ${'vostri' if plural else 'tuoi'} dati.\n"
"</p>\n"
"<p>\n"
"    Insieme, contribuiamo a cambiare il mondo, un bambino alla volta!\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"<p>\n"
"    ${whatsapp_signature}\n"
"</p>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_welcome_activation
msgid ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"                    \n"
"% set partner = object.partner_id\n"
"                    \n"
"% set intro = 'a child' if len(partner.sponsorship_ids) == 1 else 'a new child'\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for recently deciding to become a sponsor of Compassion. Thank you for your commitment to a child in extreme poverty. That’s how we change the world - one child after another.\n"
"   <br>\n"
"   <br>\n"
"   We hope you have received the information package and have had time to read through the materials so that you are well-informed about your sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   On our website, www.compassion.ch, you will find many testimonies that show the effectiveness of sponsorship.\n"
"   <a href=\"https://compassion.ch/en/jennifer/\">\n"
"    For example, Jennifer\n"
"   </a>\n"
"   and further information about the program can be found under the heading, “Frequently Asked Questions (FAQ)”.  If you have any questions, please do not hesitate to contact us directly.\n"
"   <br>\n"
"   <br>\n"
"   We wish you much joy with your sponsorship of ${firstname}.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"% if object.send_mode != 'physical':\n"
"   <br>\n"
"   <br>\n"
"   ${object.user_id.preferred_name}${object.user_id.lastname}\n"
"   <br>\n"
"   ${object.user_id.employee_ids.department_id.name}\n"
"   <br>\n"
"   ${object.user_id.company_id.address_name}\n"
"   <br>\n"
"   <br>\n"
"PS: Do you already have the Compassion App? With it you always have your godchild's pictures, letters and all information with you. And the letter writing is made even easier. Download here: www.compassion.ch/app\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"    \n"
"% set child = sponsorships.mapped('child_id')\n"
"    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    \n"
"% set partner = object.partner_id\n"
"    \n"
"% set plural = object.partner_id.title.plural or object.partner_id.title.id == 29\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation}\n"
"   <br>\n"
"   <br>\n"
"   Grazie di aver preso recentemente, la decisione di sostenere un bambino. Ci auguriamo che ${'abbiate' if plural else 'abbia'} ricevuto il dossier di ${firstname} inviato${'vi' if plural else 'le'} e che ${'abbiate' if plural else 'abbia'} avuto il tempo di leggerlo. In questo modo il sostegno potrà iniziare nelle migliori condizioni possibili.\n"
"   <br>\n"
"   <br>\n"
"   <a href=\"https://compassion.ch/it/notizie/\">\n"
"    Sul nostro sito internet\n"
"   </a>\n"
"   sono disponibili numerose testimonianze di ex bimbi Compassion iscritti al programma \"sostegno a distanza\".\n"
"   <br>\n"
"   <br>\n"
"   <a href=\"https://compassion.ch/it/domande-frequenti/\">\n"
"    Nella sezione (FAQ)\n"
"   </a>\n"
"   si possono trovare invece, risposte a domande che spesso riceviamo dai sostenitori. Per qualsiasi dubbio, richiesta o assistenza, restiamo sempre a disposizione!\n"
"   <br>\n"
"   <br>\n"
"   Scrivere a ${firstname} parole incoraggianti e personali è essenziale per il sostegno. Ricordiamo che è possibile farlo\n"
"   <a href=\"https://compassion.ch/it/scrivere/\">\n"
"    dal sito web\n"
"   </a>\n"
"   o comodamente dopo avere scaricato\n"
"   <a href=\"https://compassion.ch/it/lapp-di-compassion-svizzera/\" title=\"\">\n"
"    l'APP gratuita di Compassion Svizzera\n"
"   </a>\n"
"   <br>\n"
"   <br>\n"
"   ${'Vi' if plural else 'Le'} auguriamo tanta gioia nel ${'vostro' if plural else 'suo'} rapporto con ${firstname}.\n"
"   <br>\n"
"   <br>\n"
"   Grazie a ${'voi' if plural else 'lei'}, il mondo cambierà un pò di più, un bambino alla volta. Grazie!\n"
"   <br>\n"
"   <br>\n"
"   I nostri più sinceri e calorosi saluti.\n"
"% if object.send_mode != 'physical':\n"
"   <br>\n"
"   <br>\n"
"     ${object.user_id.short_signature | safe}\n"
"% endif\n"
"   <br>\n"
"   <br>P.S. Ha già l'App di Compassion? Caricare le foto, le lettere e tutte le informazioni del suo bambino sul suo cellulare. Scrivere non è mai stato così facile! Per scaricare la App: https://compassion.ch/it/app\n"
"  </p>\n"
" "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_anniversary_1
msgid ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Congratulations!\n"
"   <br>\n"
"   <br>\n"
"   Now it‘s already been a year since you have gotten to know ${firstname} and supported ${child.get('him')} as a sponsor.\n"
"   <br>\n"
"   <br>\n"
"   Thank you for your commitment to  ${firstname}. With your help, ${child.get('his')} life has changed.\n"
"   <br>\n"
"   <br>\n"
"   Together with you as a sponsor, Compassion and 8,600 local churches; we are releasing 2.3 million children from extreme poverty.\n"
"   <br>\n"
"   <br>\n"
"   Thank you!\n"
"  </p>\n"
" % if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')     \n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"</p>\n"
"<p>\n"
"    Congratulazioni !\n"
"</p>\n"
"<p>\n"
"    È passato un anno da quando ${\"avete\" if plural else \"hai\"} conosciuto ${firstname} e ${child.get(\"lo\")} ${\"sostenete\" if plural else \"sostieni\"}.\n"
"</p>\n"
"<p>\n"
"    Grazie al ${tuo} aiuto, la sua vita sta cambiando.\n"
"</p>\n"
"<p>\n"
"    Insieme a ${te} e a circa ${number_fcps} chiese partner locali, stiamo al momento liberando più di ${number_children} milioni di bambini dalla povertà estrema.\n"
"</p>\n"
"<p>\n"
"    Questo è un motivo meraviglioso per festeggiare! Grazie di cuore per la fiducia e per dare speranza alla vita di ${firstname}!\n"
"</p>\n"
"<p>\n"
"    A presto!\n"
"</p>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_anniversary_10
msgid ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   Can you believe it‘s been 10 years since you have been sponsoring ${firstname}? Congratulations for your wonderful commitment!\n"
"   <br>\n"
"   <br>\n"
"   Through your dedication, the life of ${firstname} has already changed tremendously. After more than 70 years of experience with child sponsorships, we know that long-term commitment brings lasting sustainable benefits. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   We thank you greatly for believing with us that poverty does not have to be predestined. And that the life of a child, their family and the local community will change if we invest in a child‘s life.\n"
"   <br>\n"
"   <br>\n"
"   With Warmest Regards,\n"
"  </p>\n"
" % if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"</p>\n"
"<p>\n"
"    Semplicemente Fantastico!\n"
"</p>\n"
"<p>\n"
"    Ci ${\"credete\" if plural else \"credi\"} che ${\"state\" if plural else \"stai\"} sostenendo ${firstname} da 10 anni ormai!\n"
"</p>\n"
"<p>\n"
"    Con ${years_lc} ${number_years} anni di esperienza nel programma di sostegno a distanza, sappiamo che un impegno a lungo termine fa una differenza incredibile nella vita di un bambino.\n"
"</p>\n"
"<p>\n"
"    Il ${tuo} impegno, la ${tua} costanza nella vita di ${firstname} dona speranza e nuove prospettive per un futuro liber${child.get(\"accord_o_a\")} dalla povertà. E non solo per se stess${child.get(\"accord_o_a\")}, ma per tutta la famiglia e la sua comunità.\n"
"</p>\n"
"<p>\n"
"    Grazie, per questa enorme differenza che ${\"state\" if plural else \"stai\"} facendo nella vita di ${firstname}!\n"
"</p>\n"
"<p>\n"
"    Tutto questo è prezioso,\n"
"</p>\n"
"<p>\n"
"    Cordialmente\n"
"</p>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_anniversary_15
msgid ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   This year, we would like to celebrate a special event with you: 15 years ago, you decided to change a life forever. You decided to sponsor ${firstname}. much has been accomplished since then.\n"
"   <br>\n"
"   <br>\n"
"   Your loyalty, your generous support and your contact in their lives will continue to change the life of ${firstname} drastically and in a sustainable way.\n"
"   <br>\n"
"   <br>\n"
"   We would like to thank you from our hearts for your commitment. Together with you and many sponsors, we are in the process of releasing 2,3 million children from extreme poverty.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"   <br>\n"
"  </p>\n"
" % if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"% set partner = object.partner_id\n"
"% set plural = partner.title.plural or partner.title.id == 29\n"
"% set te = \"voi\" if plural else \"te\"\n"
"% set tu = \"voi\" if plural else \"tu\"\n"
"% set tua = \"vostra\" if plural else \"tua\"\n"
"% set tuo = \"vostro\" if plural else \"tuo\"\n"
"% set tue = \"vostre\" if plural else \"tue\"\n"
"% set ti = \"vi\" if plural else \"ti\"\n"
"\n"
"% set sponsorships = object.get_objects()\n"
"% set child = sponsorships.mapped('child_id')                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"  </div>\n"
"  <p>\n"
"   ${object.partner_id.salutation},\n"
" </p>\n"
"<p>\n"
"  Quindici anni fa, ${\"avete\" if plural else \"hai\"} deciso di cambiare una vita per sempre - la vita di ${firstname}.\n"
"  </p>\n"
"<p>\n"
"   ${\"Pensate\" if plural else \"Pensa\"} per un momento a tutto quello che è successo da allora. Non è motivo per una grande celebrazione?\n"
"</p>\n"
"<p>\n"
"  Grazie al ${tuo} sostegno, ${\"state\" if plural else \"stai\"} permettendo a ${firstname} di assumersi le proprie responsabilità, di sviluppare doni, capacità e talenti. Questa è la base per una vita indipendente, piena di speranza e futuro.\n"
"  </p>\n"
"<p>\n"
"Grazie per questo investimento duraturo nella vita di ${firstname}! Insieme stiamo cambiando il mondo! Un bambino alla volta. Grati di farlo al ${tuo} fianco.\n"
"  </p>\n"
"<p>\n"
"Benedizioni!\n"
"</p>\n"
" "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_anniversary_3
msgid ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   We want to celebrate your anniversary together with you!\n"
"   <br>\n"
"   <br>\n"
"   It‘s been 3 years since you decided to support ${firstname} with a sponsorship to free ${child.get('him')} from extreme poverty.\n"
"   <br>\n"
"   <br>\n"
"   Through your support, you not only provide ${firstname} with solid assistance, but you‘re also expanding the horizon for ${child.get('him')}. Thank you for investing in the contact with your sponsored child!\n"
"   <br>\n"
"   <br>\n"
"   Together with you as sponsors, Compassion and 8,600 local churches; we are liberating 2.3 million children from extreme poverty.\n"
"   <br>\n"
"   <br>\n"
"   Thank you so very much!\n"
"   <br>\n"
"  </p>\n"
" % if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"</p>\n"
"<p>\n"
"    Meravigliosa giornata di gioia! \n"
"</p>\n"
"<p>\n"
"    Sono passati 3 anni da quando ${\"avete\" if plural else \"hai\"} iniziato a sostenere ${firstname} per liberar${child.get(\"lo\")} dalla povertà estrema. È fantastico.  \n"
"</p>\n"
"<p>\n"
"    Il sostegno a distanza è molto di più di un supporto finanziario. Con la ${tua} generosità ${firstname} sa che dall’altra parte del mondo qualcuno ${child.get(\"lo\")} ha nel cuore. E si preoccupa per ${child.get(\"lui\")}.\n"
"</p>\n"
"<p>\n"
"    Questo è un dono dal valore inestimabile. Grazie per investire nella sua vita con il programma del sostegno a distanza.\n"
"</p>\n"
"<p>\n"
"    Grazie per la ${tua} fiducia in tutti questi anni. Insieme a ${te} e a circa ${number_fcps} chiese partner locali, stiamo liberando al momento, più di ${number_children} milioni di bambini dalla povertà estrema.\n"
"</p>\n"
"<p>\n"
"    Con i nostri migliori auguri.\n"
"</p>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_sub_dossier_new
msgid ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set previous = sponsorships.mapped('parent_id.child_id')\n"
"                    \n"
"% set previous_name = previous.get_list('preferred_name', 3, '', translate=False)\n"
"                    \n"
"% set name = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   We recently informed you that ${previous.get('your sponsored child')}, ${previous_name} ${previous.get('is')} no longer participating in the sponsorship program. We suggested that you sponsor another child who really needs help.\n"
"   <br>\n"
"   <br>\n"
"   Enclosed you will find information about ${name} in ${child.get_list('project_id.country_id.name')}. Would you again be prepared to invest in a life to release ${child.get('him')} from extreme poverty?\n"
"   <br>\n"
"   <br>\n"
"   Jennifer, for example lost her mother when she was only 14 years old. Today she is a lawyer. “In my sponsors letters, I was always encouraged to persevere and to improve.“\n"
"   <br>\n"
"   <br>\n"
"   Sponsorship changes the life of a child. Your commitment makes a huge difference for a child, for the family and the entire environment.\n"
"   <br>\n"
"   <br>\n"
"   If you do not want to support this child, please let us know as soon as possible so that we can find another sponsor for ${child.get('him')}.\n"
"   <br>\n"
"   <br>\n"
"   Thank you for everything you have already done for a child in poverty.\n"
"   <br>\n"
"   <br>\n"
"   Thank you for responding to this request.\n"
"   <br>\n"
"   <br>\n"
"   Sincerely,\n"
"  </p>\n"
" "
msgstr ""
"<!--\n"
"% set plural = object.partner_id.title.plural or object.partner_id.title.id == 29\n"
"Il ${'vostro' if plural else 'tuo'} nuovo sostegno\n"
"-->\n"
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set sponsorships = object.get_objects()                  \n"
"    % set child = sponsorships.mapped('child_id')                    \n"
"    % set previous = sponsorships.mapped('parent_id.child_id')\n"
"    % set previous_name = previous.get_list('preferred_name', 3, '', translate=False)\n"
"    % set name = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set presentarti = \"presentarvi\" if plural else \"presentarti\"\n"
"    % set Immagina = \"Immaginate\" if plural else \"Immagina\"\n"
"    % set vuoi = \"volete\" if plural else \"vuoi\"\n"
"    % set devi = \"dovete\" if plural else \"devi\"\n"
"    % set desideri = \"desiderate\" if plural else \"desideri\"\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"\n"
"    % if plural:\n"
"        % set hai = 'avete'\n"
"        % set voglia = 'vogliate'\n"
"        % set impegnarti = 'impegnarvi'\n"
"        % set scopri = 'scoprite'\n"
"        % set puoi = 'potete'\n"
"        % set saresti = 'sareste'\n"
"        % set o = 'i'\n"
"        % set un_sostenitore = 'sostenitori'\n"
"        % set il_sostenitore = 'i sostenitori'\n"
"    % else:\n"
"        % set hai = 'hai'\n"
"        % set voglia = 'voglia'\n"
"        % set impegnarti = 'impegnarti'\n"
"        % set scopri = 'scopri'\n"
"        % set puoi = 'puoi'\n"
"        % set saresti = 'saresti'\n"
"\n"
"        % if partner.gender == 'M':\n"
"            % set un_sostenitore = 'un sostenitore'\n"
"            % set il_sostenitore = 'il sostenitore'\n"
"            % set o = 'o'\n"
"        % else:\n"
"            % set un_sostenitore = 'una sostenitrice'\n"
"            % set il_sostenitore = 'la sostenitrice'\n"
"            % set o = 'a'\n"
"        % endif\n"
"    % endif\n"
"\n"
"    % if len(child) == 1:\n"
"        % if child.gender == 'M':\n"
"            % set questo = 'questo'\n"
"            % set bambino = 'bambino'\n"
"        % else:\n"
"            % set questo = 'questa'\n"
"            % set bambino = 'bambina'\n"
"        % endif\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"</p>\n"
"<p>\n"
"    Una delle cose più belle del nostro lavoro è poter mettere in contatto un bambino che vive in estrema povertà con un sostenitore.\n"
"</p>\n"
"<p>\n"
"    <b>Siamo felici di ${presentarti} ${name}, \n"
"    % if len(child) == 1:\n"
"        ${child.age} ${\"anno,\" if child.age < 2 else \"anni,\"} \n"
"    % endif\n"
"\n"
"    % if child.get_list('project_id.country_id.from_preposition') == \"dall'\":\n"
"        ${child.get_list('project_id.country_id.from_preposition')}${child.get_list('project_id.country_id.name')},\n"
"    % else:\n"
"        ${child.get_list('project_id.country_id.from_preposition')} ${child.get_list('project_id.country_id.name')},\n"
"    % endif\n"
"    </b>\n"
"    in attesa di ${un_sostenitore} come ${te}.\n"
"</p>\n"
"<p>\n"
"    Ogni bambino è unico e merita un futuro pieno di speranza e opportunità. Le informazioni in allegato ${ti} permetteranno di conoscere un po' meglio ${name}. ${scopri.title()} quali sono le sue sfide e i suoi sogni e come ${puoi} contribuire a migliorare la sua vita.\n"
"</p>\n"
"<p>\n"
"    La maggior parte dei sostenitori sceglie di continuare con un nuovo sostegno. Ecco perché abbiamo reso la procedura il più semplice possibile. <b>${saresti.title()} dispost${o} a diventare ${il_sostenitore} di ${name}?</b>\n"
"</p>\n"
"<p>\n"
"    % if lsv_dd:\n"
"        Se non ${hai} ancora annullato il ${tuo} addebito diretto, non ${devi} fare nulla. Ci occuperemo noi di tutto affinché il nuovo sostegno possa iniziare. La ${tua} donazione continuerà ad essere addebitata normalmente.\n"
"    % else:\n"
"        Se non ${hai} ancora disdetto il ${tuo} ordine permanente, non ${devi} fare nulla. Ci occuperemo noi di tutto affinché il nuovo sostegno possa iniziare.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    <b>\n"
"        Se non avremo ${tue} notizie, penseremo che ${tu} ${voglia} sostenere ${name}, per continuare a ${impegnarti} nella lotta contro la povertà estrema. Se invece ${'decidete' if plural else 'decidi'} di non ${'sostenerla' if child.gender == 'F' else 'sostenerlo'} o se ${desideri} scegliere un altro bambino, ${ti} preghiamo di contattarci via e-mail o per telefono entro le prossime due settimane.\n"
"    </b>\n"
"</p>\n"
"<p>\n"
"    Non vediamo l'ora di condividere la buona notizia con ${name}. Grazie per aver investito nel migliorare la vita di bambini che vivono in condizioni di estrema povertà.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>${object.user_id.signature | safe}</p>\n"
"% endif\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_new_donors_onboarding_postcard_and_magazine
msgid ""
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    % set partner = object.partner_id\n"
"                    % set is_plural = partner.title.plural or partner.title.id == 29\n"
"                    % set dir = 'euch' if is_plural else 'dir'\n"
"                    % set du = 'ihr' if is_plural else 'du'\n"
"                    % set dich = 'euch' if is_plural else 'dich'\n"
"                    % set hast = 'habt' if is_plural else 'hast'\n"
"                    % set kennst = 'kennt' if is_plural else 'kennst'\n"
"                    % set Melde = 'Meldet' if is_plural else 'Melde'\n"
"                    ${partner.salutation}\n"
"                </p>\n"
"                <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    Danke!\n"
"                </p>\n"
"                <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    Wir freuen uns, ${dir} das aktuelle Compassion-Magazin zu senden. Einmal pro Jahr berichten wir in diesem Format über den Impact, den wir gemeinsam erreicht haben, was unsere Herausforderungen und Ziele sind und was Menschen im globalen Süden und in der Schweiz bewegt. Viel Freude beim Schmökern und Entdecken!\n"
"                </p>\n"
"                <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    Wenn ${du} Compassion noch nicht ${kennst}, ${hast} ${du} vielleicht noch viele Fragen. ${Melde} ${dich} gerne jederzeit bei uns.\n"
"                </p>\n"
"                <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    Herzliche Grüsse\n"
"                </p>\n"
"                <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    Debora Alder-Gasser und das Team von Compassion\n"
"                </p>\n"
"            "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29 or not partner.title\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Grazie!\n"
"</p>\n"
"<p>\n"
"    Siamo felici di inviar${\"v\" if plural else \"t\"}i l’ultimo numero della rivista\n"
"\n"
"    % if partner.country_id.name != 'Suisse' and partner.country_id.name != False and partner.country_id.name != 'Liechtenstein':\n"
"        <a href=\"https://compassion.ch/it/download/?e-filter-e27dc5c-download-cat=notizie\">Magazine Compassion</a>.\n"
"    % else:\n"
"        Magazine Compassion.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Scoprir${\"ete\" if plural else \"ai\"} una panoramica dell'impatto che abbiamo ottenuto insieme, delle sfide di Compassion e di ciò che motiva le persone nel Sud del mondo e in Svizzera. Buona lettura!\n"
"</p>\n"
"<p>\n"
"    Non conosc${\"ete\" if plural else \"i\"} ancora bene Compassion? Potrest${\"e\" if plural else \"i\"} avere domande sul nostro impegno e sul nostro lavoro. Non esita${\"t\" if plural else \"r\"}e a contattarci.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.m2m_stop_template
#: model:mail.template,body_html:partner_communication_switzerland.m2m_welcome_template
msgid ""
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida "
"Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\"><br></p>"
msgstr ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set one_child = len(sponsorships) == 1\n"
"\n"
"    % if one_child:\n"
"        % set contracts = object.get_objects()\n"
"        % set start_date = contracts.get_date('start_date', 'd MMMM YYYY')\n"
"        % set period = contracts.group_id.advance_billing_months\n"
"        % set partner = object.partner_id\n"
"        % set plural = partner.title.plural or partner.title.id == 29\n"
"        % set hai = \"avete\" if plural else \"hai\"\n"
"        % set te = \"voi\" if plural else \"te\"\n"
"        % set ti = \"vi\" if plural else \"ti\"\n"
"        % set Ti = \"Vi\" if plural else \"Ti\"\n"
"        % set tu = \"voi\" if plural else \"tu\"\n"
"        % set tua = \"vostra\" if plural else \"tua\"\n"
"        % set tuo = \"vostro\" if plural else \"tuo\"\n"
"        % set tuoi = \"vostri\" if plural else \"tuoi\"\n"
"        % set tue = \"vostre\" if plural else \"tue\"\n"
"        % set trovi = \"trovate\" if plural else \"trovi\"\n"
"        % set potrai = 'potrete' if plural else 'potrai'\n"
"        % set Potrai = 'Potrete' if plural else 'Potrai'\n"
"        % set four_children = len(sponsorships) > 3\n"
"        % set is_new = sponsorships.filtered(\"is_first_sponsorship\")\n"
"        % set others = partner.sponsorship_ids - sponsorships\n"
"        % set wp = \"SWP\" in sponsorships.mapped(\"type\")\n"
"        % set payer = object.partner_id in sponsorships.mapped('partner_id')\n"
"        % set children = sponsorships.mapped('child_id')\n"
"        % set firstname = children.get_list('preferred_name', 3, 'ai bambini', translate=False)\n"
"        % set less_3 = firstname != 'i bambini'\n"
"        % set payment_modes = contracts.with_context(lang=\"en_US\").mapped(\"payment_mode_id.name\")\n"
"\n"
"        % set other_children = (partner.sponsorship_ids - sponsorships).mapped('child_id')\n"
"        % set other_names = other_children.get_list('preferred_name', 3, other_children.get('your sponsored child'))\n"
"\n"
"        % if plural:\n"
"            % if partner.gender == 'F' or partner.title.id == 29:\n"
"                % set Benvenuto = 'Benvenute'\n"
"            % else:\n"
"                % set Benvenuto = 'Benvenuti'\n"
"            % endif\n"
"        % else:\n"
"            % set Benvenuto = \"Benvenuta\" if partner.gender == \"F\" else \"Benvenuto\"\n"
"        % endif\n"
"\n"
"        % if one_child:\n"
"            % if children.gender == 'F':\n"
"                % set al_bambino = 'alla bambina'\n"
"            % else:\n"
"                % set al_bambino = 'al bambino'\n"
"            % endif\n"
"        % else:\n"
"            % set al_bambino = 'ai bambini'\n"
"        % endif\n"
"\n"
"        % set number_years = object.env[\"partner.communication.job\"].get_snippet('number_years') | striptags | safe\n"
"        % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"        % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"        % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | safe\n"
"        % set years_uc = object.env[\"partner.communication.job\"].get_snippet('years_uc') | striptags | safe\n"
"        % set years_lc = object.env[\"partner.communication.job\"].get_snippet('years_lc') | striptags | safe\n"
"        % set children_in_poverty = object.env[\"partner.communication.job\"].get_snippet('children_in_poverty') | striptags | safe\n"
"        % set early_deaths = object.env[\"partner.communication.job\"].get_snippet('early_deaths') | striptags | safe\n"
"        % set number_mothers = object.env[\"partner.communication.job\"].get_snippet('number_mothers') | striptags | safe\n"
"        % set number_unacceptable_conditions = object.env[\"partner.communication.job\"].get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"        % set children_in_poverty = object.env[\"partner.communication.job\"].get_snippet('children_in_poverty') | striptags | safe\n"
"        % set daily_income_dollar = object.env[\"partner.communication.job\"].get_snippet('daily_income_dollar') | striptags | safe\n"
"        % set daily_income_chf = object.env[\"partner.communication.job\"].get_snippet('daily_income_chf') | striptags | safe\n"
"\n"
"        % if start_date.startswith(\"11\") or start_date.startswith(\"8\") or start_date.startswith(\"1 \"):\n"
"            % set start_date = \"dall'\" + start_date\n"
"        % else:\n"
"            % set start_date = \"dal \" + start_date\n"
"        % endif\n"
"    </div>\n"
"    <p>\n"
"        ${partner.salutation},\n"
"    </p>\n"
"    <p>\n"
"        ${Ti} ringraziamo per aver sostenuto il programma di sviluppo infantile di Compassion sin ${start_date}. ${hai.title()} fornito supporto a una chiesa locale che si è impegnata ad aiutare i bambini bisognosi del proprio quartiere e villaggio aprendo un centro partner di Compassion.\n"
"    </p>\n"
"    <p>\n"
"        <b>\n"
"            Abbiamo preso nota della ${tua} decisione di interrompere questa donazione ricorrente.\n"
"        </b>\n"
"        Se ${hai} impostato un ordine permanente, ${ti} preghiamo di interromperlo.\n"
"    </p>\n"
"    <p>\n"
"        <b>\n"
"            Il ${tuo} sostegno finanziario ha contribuito a cambiare delle vite in modo duraturo.\n"
"        </b>\n"
"        Ogni anno, decine di migliaia di nuovi bambini iscritti al nostro programma scoprono che l'estrema povertà non è una fatalità. Il loro sguardo su se stessi e sul futuro cambia.\n"
"    </p>\n"
"    <p>\n"
"        Spesso, questo rappresenta l'inizio di una trasformazione radicale e duratura per loro e per le loro famiglie. A nome di tutti questi bambini, ${ti} ringraziamo di cuore per il ${tuo} impegno al nostro fianco.\n"
"    </p>\n"
"    <p>\n"
"        Qui ${'troverete' if plural else 'troverai'} altri modi per ${'impegnarvi' if plural else 'impegnarti'} nella lotta contro la povertà estrema:\n"
"        <a href=\"https://compassion.ch/it/donare/\">\n"
"            compassion.ch/it/donare\n"
"        </a>\n"
"    </p>\n"
"    <p>\n"
"        Cari saluti.\n"
"    </p>\n"
"    % if object.send_mode == \"digital\":\n"
"        <p>\n"
"            ${object.user_id.signature | safe}\n"
"        </p>\n"
"    % endif\n"
"% endif\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_new_donors_onboarding_2nd_blog_post
msgid ""
"<p>\n"
"                    % set partner = object.partner_id\n"
"                    % set is_plural = partner.title.plural or partner.title.id == 29\n"
"                    % set dir = 'euch' if is_plural else 'dir'\n"
"                    % set du = 'ihr' if is_plural else 'du'\n"
"                    % set du_upper = 'Ihr' if is_plural else 'Du'\n"
"                    % set dich = 'euch' if is_plural else 'dich'\n"
"                    % set deine = 'eure' if is_plural else 'deine'\n"
"                    % set findest = 'findet' if is_plural else 'findest'\n"
"                    % set fragst = 'fragt' if is_plural else 'fragst'\n"
"                    % set base_url = object.env['ir.config_parameter'].sudo().get_param('web.external.url')\n"
"                    ${partner.salutation}\n"
"                </p>\n"
"                <p>\n"
"                    ${du_upper} ${fragst} ${dich} vielleicht: \"Kinderpatenschaften kommen mir ein bisschen altmodisch vor. Sind sie wirklich noch relevant?\"\n"
"                </p>\n"
"                <p>\n"
"                    Es wird ${dich} wahrscheinlich nicht überraschen, dass wir hier bei Compassion sagen, dass Kinderpatenschaften relevanter sind als je zuvor. Mit fast 70 Jahren Erfahrung glauben wir immer noch, dass eine Kinderpatenschaft eine lohnenswerte Investition ist, die effektiv, nachhaltig und engagiert ist - sogar in Krisenzeiten wie einer globalen Pandemie. Aber warum? Lass es uns gemeinsam auspacken.\n"
"                </p>\n"
"                <p>\n"
"                    <!-- TODO add link      -->\n"
"                    <a href=\"#\">Weiterlesen</a>\n"
"                </p>\n"
"                <p>\n"
"                    Hier ${findest} ${du} Kinder, für die wir gerade dringend einen Paten oder eine Patin suchen.\n"
"                </p>\n"
"                <p>\n"
"                    <a href=\"https://compassion.ch/de/finden-sie-ein-patenkind/?utm_event=sponsorshipheaderbutton\">Ja, ich möchte ein Kind mit einer Patenschaft unterstützen</a>\n"
"                </p>\n"
"                <p>\n"
"                    Nochmals vielen Dank, denn gemeinsam verändern wir das Leben von Kindern - eins nach dem anderen.\n"
"                </p>\n"
"                <p>\n"
"                    Herzliche Grüsse\n"
"                </p>\n"
"                <p>\n"
"                    Debora Alder-Gasser und das Team von Compassion\n"
"                </p>\n"
"                <p>\n"
"                    Du erhältst diese E-Mail, weil du gemeinsam mit Compassion Schweiz gegen extreme Armut kämpfst und die Arbeit mit einer Spende unterstützt hast. Du kannst dich jederzeit vom <a href=\"${base_url}/onboarding/new_donors/unsubscribe/${partner.onboarding_new_donor_hash}\">Nachrichtenversand abmelden</a>.\n"
"                </p>\n"
"            "
msgstr ""
"<p>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29 or not partner.title\n"
"% set base_url = object.env['ir.config_parameter'].sudo().get_param('web.external.url')\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = object.get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Forse ${\"vi starete\" if plural else \"ti starai\"} chiedendo se il sostegno a distanza di un bambino è ancora rilevante in questi tempi. Probabilmente non ${\"sarete sorpresi\" if plural else \"ti sorprenderà\"} di sapere che qui a Compassion, diciamo che il programma di sostegnoa distanza dei bambini è una forma di assistenza allo sviluppo più importante che mai. \n"
"</p>\n"
"<p>\n"
"    Con ${years_lc} ${number_years} anni di esperienza, crediamo ancora che questo programma <b>è un investimento utile, efficace e duraturo</b>, anche in tempi di crisi come una pandemia globale. Ma perché? Diamo un'occhiata più da vicino.\n"
"</p>\n"
"<p>\n"
"    <div style=\"margin:30px auto; text-align: center;  text-transform: uppercase;\">\n"
"        <a href=\"https://compassion.ch/it/il-sostegno-a-distanza-e-ancora-rilevante-oggi/\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            Leggi di più\n"
"        </a>\n"
"    </div>\n"
"</p>\n"
"<p>\n"
"    Qui ${\"troverete\" if plural else \"troverai\"} i bambini per i quali stiamo cercando urgentemente un sostenitore.\n"
"</p>\n"
"<p>\n"
"    <a href=\"https://compassion.ch/it/sostegno-individuale/sostieni-un-bambino/\">Sì, ${\"vorremmo\" if plural else \"vorrei\"} sostenere un bambino con il sostegno a distanza</a>\n"
"</p>\n"
"<p>\n"
"    Grazie ancora, perché insieme stiamo cambiando la vita dei bambini - uno alla volta.\n"
"</p>\n"
"<p>\n"
"    Un buon tempo e a presto!\n"
"</p>\n"
"${object.user_id.signature | safe}\n"
"<br>\n"
"<br>\n"
"<p>\n"
"Se vuoi annullare l'iscrizione alla nostra newsletter <a href=\"${base_url}/onboarding/new_donors/unsubscribe/${partner.onboarding_new_donor_hash}\">clicca qui.</a>\n"
"</p>\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_new_donors_onboarding_1st_blog_post
msgid ""
"<p>\n"
"                    % set partner = object.partner_id\n"
"                    % set is_plural = partner.title.plural or partner.title.id == 29\n"
"                    % set dir = 'euch' if is_plural else 'dir'\n"
"                    % set du = 'ihr' if is_plural else 'du'\n"
"                    % set du_upper = 'Ihr' if is_plural else 'Du'\n"
"                    % set dich = 'euch' if is_plural else 'dich'\n"
"                    % set deine = 'eure' if is_plural else 'deine'\n"
"                    % set hast = 'habt' if is_plural else 'hast'\n"
"                    % set fragst = 'fragt' if is_plural else 'fragst'\n"
"                    % set base_url = object.env['ir.config_parameter'].sudo().get_param('web.external.url')\n"
"                    ${partner.salutation}\n"
"                </p>\n"
"                <p>\n"
"                    Wir freuen uns, ${dich} kennenzulernen und ${dir} mehr davon zu erzählen, wie wir Kinder und Familien unterstützen, extreme Armut zu überwinden. ${du_upper} ${fragst} ${dich} vielleicht, was Kinderpatenschaften bringen, vielleicht sogar, ob sie sinnvoll sind oder ob nur christliche Kinder unterstützt werden? Gerne nehmen wir ${dich} mit und beantworten ${deine} Fragen.\n"
"                </p>\n"
"                <p>\n"
"                    <!-- TODO add link -->\n"
"                    <a href=\"#\">Weiterlesen</a>\n"
"                </p>\n"
"                <p>\n"
"                    Nochmals vielen Dank: mit ${dir} zusammen befreien wir zurzeit mit rund 8'000 Partnerkirchen in 25 Ländern 2,2 Millionen Kinder aus extremer Armut. Gemeinsam ermöglichen wir den Kindern ein Leben mit Hoffnung und Zukunft.\n"
"                </p>\n"
"                <p>\n"
"                    Herzliche Grüsse\n"
"                </p>\n"
"                <p>\n"
"                    Debora Alder-Gasser und das Team von Compassion\n"
"                </p>\n"
"                <p>\n"
"                    Du erhältst diese E-Mail, weil du gemeinsam mit Compassion Schweiz gegen extreme Armut kämpfst und die Arbeit mit einer Spende unterstützt hast. Du kannst dich jederzeit vom <a href=\"${base_url}/onboarding/new_donors/unsubscribe/${partner.onboarding_new_donor_hash}\">Nachrichtenversand abmelden</a>.\n"
"                </p>\n"
"            "
msgstr ""
"<p>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"% set base_url = object.env['ir.config_parameter'].sudo().get_param('web.external.url')\n"
"    ${partner.salutation}\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = object.get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"</p>\n"
"<p>\n"
"    Non vediamo l'ora di ${\"incontrarvi e dirvi\" if plural else \"incontrarti e dirti\"} di più su come sosteniamo i bambini e le famiglie per superare la povertà estrema. ${\"Vi starete\" if plural else \"Ti starai\"} chiedendo in cosa consiste il sostegno a distanza, se ha senso o se vengono sostenuti solo bambini cristiani? Saremo felici di ${\"portarvi\" if plural else \"portarti\"} con noi e di rispondere a tutte le domande.\n"
"</p>\n"
"<p>\n"
"    <div style=\"margin:30px auto; text-align: center;  text-transform: uppercase;\">\n"
"        <a href=\"https://compassion.ch/it/nuovo-a-compassion/\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            Leggi di più\n"
"        </a>\n"
"    </div>\n"
"</p>\n"
"<p>\n"
"    Grazie ancora: insieme stiamo attualmente sollevando ${number_children} milioni di bambini dalla povertà estrema con circa ${number_fcps} chiese partner locali  in ${number_countries} paesi. E sempre insieme permettiamo ai bambini di vivere con speranza e futuro. \n"
"\n"
"</p>\n"
"<p>\n"
"    I nostri migliori auguri!\n"
"</p>\n"
"    ${object.user_id.signature | safe}\n"
"<br>\n"
"<br>\n"
"<p>\n"
"Se vuoi annullare l'iscrizione alla nostra newsletter <a href=\"${base_url}/onboarding/new_donors/unsubscribe/${partner.onboarding_new_donor_hash}\">clicca qui.</a>\n"
"</p>"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_certificate
msgid ""
"<p>\n"
"                    % set partner = object.partner_id\n"
"                    % set sponsorships = object.get_objects()\n"
"                    % set name = sponsorships.mapped(\"child_id\").get_list(\"preferred_name\")\n"
"                    ${partner.salutation}\n"
"                </p>\n"
"                <p>\n"
"                    We recently informed you by email about the end of the sponsorship of ${name}.\n"
"                </p>\n"
"                <p>\n"
"                    From the bottom of our hearts, we would like to thank you for your valuable contribution!\n"
"                </p>\n"
"                <p>\n"
"                    Best regards\n"
"                </p>\n"
"            "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set Ti = 'Vi' if plural else 'Ti'\n"
"    % set tuo = 'vostro' if plural else 'tuo'\n"
"    % set name = sponsorships.mapped(\"child_id\").get_list(\"preferred_name\")\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    ${Ti} abbiamo recentemente informato via e-mail che il sostegno di ${name} è giunto al termine.\n"
"</p>\n"
"<p>\n"
"    ${Ti} ringraziamo di cuore per il ${tuo} prezioso impegno al nostro fianco!\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step2
msgid ""
"<p>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorship = object.get_objects()\n"
"    % set child = sponsorship.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, 'your sponsored children', translate=False)\n"
"    % set country = child.mapped('field_office_id')\n"
"    % set alumni_name = country.get_list('alumni_representative')\n"
"    % set apos = \"'\" if alumni_name[-1] == 's' else \"'s\"\n"
"    % set alumni_link = country.get_list('alumni_video_link', 1, 'https://vimeo.com/showcase/geschichten-ehemaliger-patenkinder-von-compassion')\n"
"    % set multi_link = alumni_link == 'https://vimeo.com/showcase/geschichten-ehemaliger-patenkinder-von-compassion'\n"
"    ${partner.salutation}, your sponsorship is making a difference!\n"
"</p>\n"
"<p>\n"
"    % if not multi_link:\n"
"        Today, we would like to introduce you to ${alumni_name}, a former sponsored child of Compassion. ${'She' if child[0].field_office_id.alumni_gender == 'F' else 'He'} lives on the same continent as ${firstname}.\n"
"    % else:\n"
"        Today, we would like to introduce you to ${alumni_name}, former sponsored children of Compassion. They on the same continent as ${firstname}.\n"
"    % endif\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"${alumni_link}\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">Discover\n"
"    % if multi_link:\n"
"        their stories\n"
"    % else:\n"
"        ${alumni_name + apos} story\n"
"    % endif\n"
"    </a>\n"
"</div>\n"
"<h3 style=\"color: #0054A6; text-transform: uppercase;\">\n"
"    <b>You enable ${firstname if len(child) < 4 else 'your sponsored children'}:</b>\n"
"</h3>\n"
"<ul>\n"
"    <li>Access to school (school fees, uniform, material, tutoring)</li>\n"
"    <li>Higher education (vocational training or university studies)</li>\n"
"    <li>Medical care</li>\n"
"    <li>Hygiene training and regular balanced meals</li>\n"
"    <li>Love and care from a local church, bible teaching*</li>\n"
"    <li>Encouragement to explore their personality as they learn and play</li>\n"
"    <li>Letter contact with you</li>\n"
"</ul>\n"
"<p style=\"font-size: smaller\">\n"
"    *In agreement with the child's parents\n"
"</p>\n"
"<p>The child will be supported until the end of school, including vocational training, but at most until the age of 22.</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://compassion.ch/de/compassion-weltweit\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Get to know more about the country where ${firstname} ${'lives' if len(child) == 1 else 'live'}\n"
"    </a>\n"
"</div>\n"
"<p>Thanks to you, not only a child, but a whole family can find new hope for the future.</p>\n"
"<p>Warm regards,</p>\n"
"<p>${object.user_id.short_signature | safe}</p>"
msgstr ""
"<p>\n"
"   % set partner = object.partner_id\n"
"% set plural = partner.title.plural\n"
" % set te = \"voi\" if plural else \"te\"\n"
"% set tu = \"voi\" if plural else \"tu\"\n"
"% set tua = \"vostra\" if plural else \"tua\"\n"
"% set tuo = \"vostro\" if plural else \"tuo\"\n"
"% set tue = \"vostre\" if plural else \"tue\"\n"
"% set ti = \"vi\" if plural else \"ti\"\n"
"\n"
"% set sponsorship = object.get_objects()\n"
"% set child = sponsorship.mapped('child_id')\n"
"% set firstname = child.get_list('preferred_name', 3, 'i vostri bambini' if plural else 'i tuoi bambini', translate=False)\n"
"\n"
"% set country = child.mapped('field_office_id')\n"
"% set alumni_name = country.get_list('alumni_representative')\n"
"% set alumni_link = country.get_list('alumni_video_link', 1, 'https://vimeo.com/showcase/8314999')\n"
"% set multi_link = alumni_link == 'https://vimeo.com/showcase/8314999'\n"
"   ${partner.salutation} il ${tuo} sostegno funziona!\n"
"  </p>\n"
"  <p>\n"
"   % if not multi_link:\n"
"            % if firstname == \"i tuoi bambini\":\n"
"         \tOggi vorremmo ${\"presentarvi\" if plural else \"presentarti\"} ${alumni_name}, ex bambini Compassion. Vivono nello stesso continente dei bambini che sostieni.\n"
"            % else:\n"
"              \tOggi vorremmo ${\"presentarvi\" if plural else \"presentarti\"} ${alumni_name}, ex bambini Compassion. Vivono nello stesso continente di ${firstname}, ${child.get('il bimbo')} che ${\"sostenete\" if plural else \"sostieni\"}.\n"
"           % endif\n"
"\t% else:\n"
"           % if firstname == \"i tuoi bambini\":\n"
"         \tOggi vorremmo ${\"presentarvi\" if plural else \"presentarti\"} ${alumni_name}, ex bambini Compassion. Vivono nello stesso continente dei bambini che sostieni.\n"
"            % else:\n"
"              \tOggi vorremmo ${\"presentarvi\" if plural else \"presentarti\"} ${alumni_name}, ex bambini Compassion. Vivono nello stesso continente di ${firstname}, ${child.get('il bimbo')} che ${\"sostenete\" if plural else \"sostieni\"}.\n"
"           % endif\n"
"% endif\n"
"  </p>\n"
"  <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"   <a href=\"${alumni_link}\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"    Qui la ${child.mapped('field_office_id').get('sua')} storia.\n"
"   </a>\n"
"  </div>\n"
"  <h3 style=\"color: #0054A6; text-transform: uppercase;\">\n"
"   <b>\n"
"    Il ${tuo} sostegno permette a ${firstname} di ricevere:\n"
"   </b>\n"
"  </h3>\n"
"  <ul>\n"
"   <li>\n"
"    Accesso alla scuola (tasse scolastiche, uniforme, materiale, tutoraggio)\n"
"   </li>\n"
"   <li>\n"
"    Istruzione (formazione professionale o studi universitari)\n"
"   </li>\n"
"   <li>\n"
"    Assistenza medica\n"
"   </li>\n"
"   <li>\n"
"    Formazione all'igiene,pasti regolari ed equilibrati\n"
"   </li>\n"
"   <li>\n"
"    Amore e cura in una comunità cristiana locale, insegnamento biblico*.\n"
"   </li>\n"
"   <li>\n"
"    Attività per sviluppare i propri talenti\n"
"   </li>\n"
"   <li>\n"
"    Corrispondenza con il sostenitore\n"
"   </li>\n"
"  </ul>\n"
"  <p style=\"font-size: smaller\">\n"
"   *con il consenso dei genitori\n"
"  </p>\n"
"  <p>\n"
"   Ogni bambino è accompagnato fino alla fine della scuola, compresa la formazione professionale, ma non oltre i 22 anni.\n"
"  </p>\n"
"% if False:\n"
"  <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"   <a href=\"https://compassion.ch/de/compassion-weltweit\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"    ${'Scoprite' if plural else 'Scopri'} di più sul paese in cui ${\"vive\" if len(child) == 1 else \"vivono\"} ${firstname}.\n"
"   </a>\n"
"  </div>\n"
"% endif\n"
"  <p>\n"
"   Grazie a ${te}, non solo un bambino, ma un'intera famiglia troverà una nuova speranza per il futuro.\n"
"  </p>\n"
"  <p>\n"
"   A presto!\n"
"  </p>\n"
"  <p>\n"
"   ${object.user_id.short_signature | safe}\n"
"  </p>\n"
" "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_sponsorship_confirmation
msgid ""
"<p>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorships = object.get_objects()\n"
"\n"
"    % if len(sponsorships) > 1:\n"
"        % set has = 'have'\n"
"    % else:\n"
"        % set has = 'has'\n"
"    % endif\n"
"    % set others = partner.sponsorship_ids - sponsorships\n"
"    % set wp = \"SWP\" in sponsorships.mapped(\"type\")\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), translate=False)\n"
"    % set less_3 = firstname != children.get_number()\n"
"    % set apos = \"'\" if firstname[-1] == 's' else \"'s\"\n"
"    % set payment_attachment = sponsorships.get_payment_type_attachment_string()\n"
"    % set is_new = sponsorships.filtered(\"is_first_sponsorship\")\n"
"    % set number_years = object.env[\"partner.communication.job\"].get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.env[\"partner.communication.job\"].get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.env[\"partner.communication.job\"].get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.env[\"partner.communication.job\"].get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.env[\"partner.communication.job\"].get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.env[\"partner.communication.job\"].get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = object.env[\"partner.communication.job\"].get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"<p>\n"
"</p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    % if is_new:\n"
"        It's so nice to have you as part of the Compassion family!\n"
"    % else:\n"
"        Thank you so much for deciding to sponsor ${'more children' if plural else 'another child'}.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    With your help alongside around ${number_fcps} partner churches we are currently releasing over ${number_children} million children from poverty in ${number_countries} countries. Together we enable children to have a life with hope and a future.\n"
"</p>\n"
"<p>\n"
"    % if payer:\n"
"        After receiving your first donation, ${'the children' if plural else firstname} will be informed that ${children.get('he')} now ${has} a sponsor.\n"
"        <b>\n"
"            ${payment_attachment}\n"
"        </b>\n"
"        %  if len(partner.sponsorship_ids) == len(sponsorships):\n"
"            Please <a href=\"https://compassion.ch/de/zahlungsart-deiner-patenschaft\">click here</a> if you have any questions about your donation.\n"
"        % endif\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    In a series of short emails over the coming month, we will explain everything you need to know about ${firstname if less_3 else 'the children'} and the sponsorship.\n"
"</p\n"
"<p>\n"
"    % if is_new:\n"
"        Register and discover MyCompassion to write to your sponsored ${'children' if plural else 'child'}, download photos and letters, find out more and adapt information linked to your ${'sponsorships' if plural else 'sponsorship'} and much more.\n"
"    % else:\n"
"        Just like for your other sponsorships, you will find all of ${firstname + apos if less_3 else 'your sponsored children'} information and photos on MyCompassion and you can write to ${children.get('him')}.\n"
"    % endif\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://mycompassion.ch/de_DE/my/home\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        MyCompassion\n"
"    </a>\n"
"</div>\n"
"% if is_new:\n"
"    <p>\n"
"        Thank you so much for making the decision to invest in the life of ${firstname if less_3 else 'many children'}.\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"\n"
msgstr ""
"<p>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set sponsorships = object.get_objects()\n"
"    % set is_new = sponsorships.filtered(\"is_first_sponsorship\")\n"
"    % set others = partner.sponsorship_ids - sponsorships\n"
"    % set wp = \"SWP\" in sponsorships.mapped(\"type\")\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, 'i bambini', translate=False)\n"
"    % set less_3 = firstname != 'i bambini'\n"
"    % set payment_type_attachement = sponsorships.get_payment_type_attachment_string()\n"
"\n"
"    % if plural:\n"
"        % if partner.title.id == 29:\n"
"            Benvenuta Famiglia ${partner.lastname}!\n"
"        % else:\n"
"            Benvenuti ${partner.firstname or partner.name}!\n"
"        % endif\n"
"    % else:\n"
"        ${\"Benvenuta\" if partner.gender == \"F\" else \"Benvenuto\"} ${partner.firstname}!\n"
"    % endif\n"
"\n"
"    % set number_years = object.env[\"partner.communication.job\"].get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.env[\"partner.communication.job\"].get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.env[\"partner.communication.job\"].get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.env[\"partner.communication.job\"].get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.env[\"partner.communication.job\"].get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.env[\"partner.communication.job\"].get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = object.env[\"partner.communication.job\"].get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"</p>\n"
"<p>\n"
"    % if is_new:\n"
"        Siamo felici che ora ${\"fate\" if plural else \"fai\"} parte della famiglia di Compassion!\n"
"    % else:\n"
"        Grazie mille per aver scelto di investire nella vita di ${\"un altro bambino\" if len(children) == 1 else \"altri bambini\"}.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Insieme a ${te}, alle ${number_fcps} chiese locali in ${number_countries} paesi, stiamo liberando ${number_children} milioni di bambini dalla povertà estrema. Per una vita piena di speranza, dignità e futuro. \n"
"</p>\n"
"<p>\n"
"    % if payer and not wp:\n"
"        Dopo la prima donazione ricevuta ${firstname} ${children.get('will be')} informat${children.get('accord_o_a')} di avere finalmente un sostenitore. In allegato la polizza di versamento.\n"
"\n"
"        Se ${\"avete\" if plural else \"hai\"} domande sui metodi di pagamento\n"
"\n"
"        % if object.send_mode == \"digital\":\n"
"            <a href=\"https://compassion.ch/it/metodi-di-pagamento-per-il-sostegno-a-distanza/\">\n"
"                qui ${\"trovate\" if plural else \"trovi\"} più info.\n"
"            </a>\n"
"        % else:\n"
"            ${\"trovate\" if plural else \"trovi\"} più info qui: www.compassion.ch/it/metodi-di-pagamento-per-il-sostegno-a-distanza\n"
"        % endif\n"
"\n"
"    % elif wp:\n"
"        % if sponsorships.filtered(\"total_amount\"):\n"
"            La cosa speciale del sostegno \"Write & Pray\" è il lavoro di squadra. ${tu.title()} ${\"siete\" if plural else \"sei\"} il sostenitore che scrive una lettera a ${firstname} almeno due volte l'anno e ${\"pregate\" if plural else \"prega\"} per ${children.get('lui')}. Un altro donatore fornirà il saldo del sostegno a distanza per ${firstname}.  Dopo che riceveremo la ${tua}  prima donazione per ${firstname}, ${children.get('lui')} ${children.get('will be')} informat${children.get('accord_o_a')} di avere finalmente un sostenitore.  In allegato la polizza di versamento.\n"
"\n"
"            %  if len(partner.sponsorship_ids) == len(sponsorships):\n"
"                Se ${\"avete\" if plural else \"hai\"} domande sulla donazione\n"
"\n"
"            % if object.send_mode == \"digital\":\n"
"                <a href=\"https://compassion.ch/it/metodi-di-pagamento-per-il-sostegno-a-distanza/\">\n"
"                    qui ${\"trovate\" if plural else \"trovi\"} più info.\n"
"                </a>\n"
"            % else:\n"
"                ${\"trovate\" if plural else \"trovi\"} più info qui: www.compassion.ch/it/metodi-di-pagamento-per-il-sostegno-a-distanza\n"
"                % endif\n"
"            % endif\n"
"        % else:\n"
"            Tra qualche giorno, ${firstname} ${children.get('will be')} informat${children.get('accord_o_a')} di avere finalmente un sostenitore. Questo sarà un giorno di gioia per ${children.get('lui')} e la sua famiglia! Ciò che rende il sostegno \"Write & Pray\" così speciale è il lavoro di squadra. ${tu.title()} ${\"siete\" if plural else \"sei\"} il sostenitore che scrive una lettera a ${firstname} almeno due volte l'anno e ${\"pregate\" if plural else \"prega\"} per ${children.get('lui')}. Un altro donatore fornisce il sostegno finanziario.\n"
"        % endif\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    ${\"Riceverete\" if plural else \"Riceverai\"} nel corso del mese, una serie di brevi e-mail che spiegheranno tutto quello che c'è da sapere su ${children.get_list('preferred_name', translate=False)} e sul sostegno. \n"
"</p>\n"
"<p>\n"
"    % if is_new:\n"
"        ${\"Registratevi e scoprite\" if plural else \"Registrati e scopri\"} ${\"MyCompassion\" if object.send_mode==\"digital\" else \"www.mycompassion.ch\"} per scrivere ${children.get('al bambino')}, scaricare lettere e foto, visualizzare e personalizzare le informazioni sul ${tuo} sostegno e altro ancora.\n"
"    % else:\n"
"        ${\"Potrete\" if plural else \"Potrai\"} trovare tutte le informazioni e le foto di ${firstname} in ${\"MyCompassion\" if object.send_mode==\"digital\" else \"www.mycompassion.ch\"}, da cui ${\"potrete\" if plural else \"potrai\"} anche scrivere le ${tue} lettere.\n"
"    % endif\n"
"</p>\n"
"% if object.send_mode == 'digital':\n"
"    <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"        <a href=\"https://mycompassion.ch/it_IT/my/home\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            MyCompassion\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"\n"
"% if is_new:\n"
"    <p>\n"
"        Grazie di cuore per aver deciso di investire nella vita di ${children.get_list('preferred_name', translate=False)}!\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    A presto,\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
"% endif\n"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step1
msgid ""
"<p>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set one_child = len(children) == 1\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set deine_patenkinder = 'your sponsored children'\n"
"    % set firstname = children.get_list('preferred_name', 3, deine_patenkinder, translate=False)\n"
"    % set less_4 = firstname != deine_patenkinder\n"
"    % set wp = \"SWP\" in sponsorships.mapped(\"type\")\n"
"</p>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"% if sponsorships.filtered(\"is_first_sponsorship\"):\n"
"    <p>\n"
"        This is the first of five emails that you will receive from us.\n"
"    </p>\n"
"    <p>\n"
"        Today we will help you get to know ${children.get_child_preposition_country('from_preposition', child_limit=3, country_limit=3, child_substitution=deine_patenkinder, country_substitution=deine_patenkinder)} better (PDF attached).\n"
"    </p>\n"
"    <p>\n"
"        Did you know that you can visit your sponsored ${'children' if not one_child else 'child'}?\n"
"    </p>\n"
"    <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"        <a href=\"https://compassion.ch/de/reisen/\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            More information on visits\n"
"        </a>\n"
"    </div>\n"
"% else:\n"
"    <p>\n"
"        Thank you for deciding to invest in the life of ${'more children' if not one_child else 'another child'}!\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.signature | safe}\n"
"</p>\n"
msgstr ""
"<p>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set plural = partner.title.plural\n"
"    % set firstname = children.get_list('preferred_name', 3, 'i vostri bambini' if plural else 'i tuoi bambini', translate=False)\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"    % set vive = \"vive\"\n"
"\n"
"    % if \",\" in firstname or firstname == \"i tuoi bambini\" or firstname == \"i vostri bambini\":\n"
"        % set vive = \"vivono\"\n"
"    % endif \n"
"</p>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    % if sponsorships.filtered(\"is_first_sponsorship\"):\n"
"\t    Questa è la prima delle cinque e-mail che abbiamo annunciato.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Oggi ${ti} presentiamo meglio: ${firstname} che ${vive} in ${children.get_list('field_office_id.country_id.name', 3, 'diversi paesi')}. (in allegato il PDF)\n"
"</p>\n"
"<p>\n"
"    % if False:   \n"
"        ${'Sapevate' if plural else 'Sapevi'} che è possibile fare visita ${children.get('al bambino')} che ${'sostenete' if plural else 'sostieni'}?\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://compassion.ch/de/reisen/\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        INFORMAZIONI SULLE VISITE\n"
"    </a>\n"
"</div>\n"
"    % endif\n"
"    % if not sponsorships.filtered(\"is_first_sponsorship\"):\n"
"        <p>\n"
"            Grazie di cuore per aver deciso di investire nella vita di un altro bambino! Cambiamo il mondo, un bambino alla volta.\n"
"        </p>\n"
"    % endif\n"
"    <p>\n"
"        Cordiali Saluti\n"
"    </p>\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
" "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_no_sub
msgid ""
"<p>\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   We understand and acknowledge  you have decided not to take over a new sponsorship at this time.\n"
"   <br>\n"
"   <br>\n"
"   Thank you for your past investment in the life of a child living in poverty.  More than 70 years of experience assures us that this commitment produces sustainable results. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   If you have set up an automatic payment order for your sponsorship, please cancel it.\n"
"   <br>\n"
"   <br>\n"
"   Did you know that you can also help children in poverty by giving them access to drinking water (water filters, toilet installations, hygiene awareness)? With a one-time gift or regular donations of CHF 10, 20 or 30 per month - you can make a big difference.\n"
"   <br>\n"
"   <br>\n"
"   If you are interested, please call us at 031 552 21 25 or you can also donate online on www.compassion.ch/spenden\n"
"   <br>\n"
"   <br>\n"
"   Thank you again for your generosity so far.\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"   <br>\n"
"   <br>\n"
"     ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"    % set Ti = \"Vi\" if plural else \"Ti\"\n"
"    % set puoi = \"potete\" if plural else \"puoi\"\n"
"    % set Sapevi = \"Sapete\" if plural else \"Sapevi\"\n"
"    % set potessi = \"poteste\" if plural else \"potessi\"\n"
"    % set name = object.get_objects().mapped('child_id').get_list('preferred_name', translate=False)\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    Con la presente confermiamo la ${tua} decisione di non sostenere ${name}, di cui ${ti} abbiamo recentemente fornito le informazioni.\n"
"</p>\n"
"<p>\n"
"    Grazie per il ${tuo} impegno verso i bambini in estrema povertà. Siamo sicuri che il ${tuo} sostegno finora ha fatto una significativa differenza.\n"
"</p>\n"
"<p>\n"
"    Il sostegno a distanza dei bambini è solo una parte del programma di Compassion.\n"
"    <br><br>\n"
"    ${Sapevi} che è possibile fornire supporto alle donne incinte e alle madri di neonati in difficoltà? Il programma \"Mamme e Neonati\" permette, con una donazione una tantum o regolare di fare una grande differenza: assistenza medica durante la gravidanza, parto in una struttura medica, consulenza per diventare genitori, assistenza psicologica, sociale e spirituale, sostegno materiale e formazione per la generazione di reddito.\n"
"    <br><br>\n"
"    Con CHF15.-  ${puoi} sostenere una donna e il suo bambino per una settimana intera. \n"
"    <br><br>\n"
"    ${Ti} saremmo grati se ${potessi} contattarci o fare una donazione per <a href=\"https://compassion.ch/it/aiuto-per-mamme-e-neonati/\">Il programma mamme e neonati</a>.\n"
"</p>\n"
"<p>\n"
"    Cordiali saluti\n"
"</p>\n"
"<p>\n"
"% if object.send_mode == \"digital\":\n"
"    ${object.user_id.signature | safe}\n"
"% endif\n"
"</p>"

