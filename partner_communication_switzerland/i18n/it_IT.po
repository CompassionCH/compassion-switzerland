#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_photo_by_post
msgid ""
"<!--\n"
"The first photo${'' if len(object.get_objects()) == 1 else 's'} of your sponsored child${'' if len(object.get_objects()) == 1 else 'ren'}\n"
"-->\n"
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorship = object.get_objects()\n"
"    % set child = sponsorship.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set less_4 = len(child) < 4\n"
"    % set firstname = child.get_list('preferred_name', 3, 'your sponsored children', translate=False)\n"
"    % set apos = \"'\" if firstname[-1] == 's' else \"'s\"\n"
"    % set sms = partner.global_communication_delivery_preference == \"sms\"\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"<p>\n"
"    We're so pleased to send you ${firstname + apos + ' first photo' if one_child else ('the first photos of your sponsored children' if not less_4 else firstname + apos + ' first photos')}.\n"
"</p>\n"
"<p>\n"
"    Thank you for making room for ${firstname if len(child) == 1 else 'the children'} in your life and investing in ${child.get('his') + ' future' if len(child) == 1 else 'their futures'}.\n"
"</p>\n"
"\n"
"% if partner.email or sms:\n"
"   <p>\n"
"       Keep an eye on your emails, as we will send you all the necessary information about your ${'sponsorship' if one_child else 'sponsorships'}.\n"
"   </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Please do not hesitate to contact us at info@compassion.ch or +41 31 552 21 21 if you have any questions.\n"
"</p>\n"
"\n"
"<p>\n"
"    Together, we are changing the world! One child at a time.\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<p>\n"
"   % set partner = object.partner_id\n"
"% set plural = partner.title.plural\n"
"% set te = \"voi\" if plural else \"te\"\n"
"% set tu = \"voi\" if plural else \"tu\"\n"
"% set tua = \"vostra\" if plural else \"tua\"\n"
"% set tuo = \"vostro\" if plural else \"tuo\"\n"
"% set tue = \"vostre\" if plural else \"tue\"\n"
"% set ti = \"vi\" if plural else \"ti\"\n"
"\n"
"% set sponsorship = object.get_objects()\n"
"% set child = sponsorship.mapped('child_id')\n"
"% set firstname = child.get_list('preferred_name', 3, 'vostri bambini' if plural else 'tuoi bambini', translate=False)\n"
"% set di = 'di' if len(child) < 4 else 'dei' \n"
"   ${partner.salutation}\n"
"  </p>\n"
"  <p>\n"
"   Siamo felici di ${\"inviarvi\" if plural else \"inviarti\"} la prima foto ${di} ${firstname}.\n"
"  </p>\n"
"  <p>\n"
"% if not sponsorship.mapped('parent_id'):\n"
"  Grazie di cuore, di dare ${\"a \" + firstname if len(child) < 4 else \"ai bambini\"} un posto nella ${tua} vita e di investire nel ${child.get('suo')} futuro.\n"
"% else:\n"
"${\"Desiderate\" if plural else \"Desideri\"} dare ${\"a \" + firstname if len(child) < 4 else \"ai bambini\"} un posto nella ${tua} avita e a investire nel ${child.get('suo')} futuro?\n"
"% endif\n"
"  </p>\n"
"  % if partner.email:\n"
"  <p>\n"
"${\"Fate\" if plural else \"Fai\"} attenzione al ${tuo} indirizzo e-mail, perché invieremo tutte le informazioni necessarie sul sostegno a distanza li!\n"
"  </p>\n"
"  % endif\n"
"  <p>\n"
"  Se ${\"avete\" if plural else \"hai\"} domande, ${\"contattateci\" if plural else \"contattaci\"} a info@compassion.ch o al numero:\n"
"031 552 21 24\n"
"  </p>\n"
"  <p style=\"text-transform: uppercase; font-weight: bolder; color: #0054A6\">\n"
"   Insieme cambiamo il mondo, un bambino alla volta.\n"
"  </p>\n"
"  <p>\n"
"    ${object.user_id.short_signature | safe}\n"
"  </p>\n"
" "

