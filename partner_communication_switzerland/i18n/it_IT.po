"    <t t-set=\"sponsorships\" t-value=\"object.get_objects()\"/>\n"
"    <t t-set=\"child\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;)\"/>\n"
"    <t t-set=\"firstname\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;).get_list(&#x27;preferred_name&#x27;, 3, &#x27;n Patenkindern&#x27;, False)\"/>\n"
"    <t t-set=\"chat_url\" t-value=\"&#x27;https://mycompassion.ch/it/im_livechat/support/3&#x27;\"/>\n"
"<t t-set=\"base_url\" t-value=\"object.env[&#x27;ir.config_parameter&#x27;].get_param(&#x27;web.external.url&#x27;) + &quot;/it&quot;\"/>\n"
"    <t t-set=\"survey\" t-value=\"base_url + object.env.ref(&#x27;partner_communication_switzerland.wrpr_onboarding_survey&#x27;).get_start_url()\"/>\n"
