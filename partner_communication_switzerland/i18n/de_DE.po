"    <t t-set=\"period\" t-value=\"contracts.group_id.advance_billing_months\"/>\n"
"    <t t-set=\"payment_modes\" t-value=\"contracts.with_context(lang=&quot;en_US&quot;).mapped(&quot;payment_mode_id.name&quot;)\"/>\n"
"    <t t-set=\"others\" t-value=\"partner.sponsorship_ids - sponsorships\"/>\n"
"    <t t-set=\"is_new\" t-value=\"sponsorships.filtered(&quot;is_first_sponsorship&quot;)\"/>\n"
"    <t t-set=\"wp\" t-value=\"&quot;SWP&quot; in sponsorships.mapped(&quot;type&quot;)\"/>\n"
