#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_photo_by_post
msgid ""
"<!--\n"
"The first photo${'' if len(object.get_objects()) == 1 else 's'} of your sponsored child${'' if len(object.get_objects()) "
"== 1 else 'ren'}\n"
"-->\n"
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorship = object.get_objects()\n"
"    % set child = sponsorship.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set less_4 = len(child) < 4\n"
"    % set firstname = child.get_list('preferred_name', 3, 'your sponsored children', translate=False)\n"
"    % set apos = \"'\" if firstname[-1] == 's' else \"'s\"\n"
"    % set sms = partner.global_communication_delivery_preference == \"sms\"\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"<p>\n"
"    We're so pleased to send you ${firstname + apos + ' first photo' if one_child else ('the first photos of your "
"sponsored children' if not less_4 else firstname + apos + ' first photos')}.\n"
"</p>\n"
"<p>\n"
"    Thank you for making room for ${firstname if len(child) == 1 else 'the children'} in your life and investing in $"
"{child.get('his') + ' future' if len(child) == 1 else 'their futures'}.\n"
"</p>\n"
"\n"
"% if partner.email or sms:\n"
"   <p>\n"
"       Keep an eye on your emails, as we will send you all the necessary information about your ${'sponsorship' if "
"one_child else 'sponsorships'}.\n"
"   </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Please do not hesitate to contact us at info@compassion.ch or +41 31 552 21 21 if you have any questions.\n"
"</p>\n"
"\n"
"<p>\n"
"    Together, we are changing the world! One child at a time.\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""

