#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_new_donors_onboarding_postcard_and_magazine
msgid ""
"<p>\n"
"                    % set partner = object.partner_id\n"
"                    % set is_plural = partner.title.plural or partner.title.id == 29\n"
"                    % set dir = 'euch' if is_plural else 'dir'\n"
"                    % set du = 'ihr' if is_plural else 'du'\n"
"                    % set dich = 'euch' if is_plural else 'dich'\n"
"                    % set hast = 'habt' if is_plural else 'hast'\n"
"                    % set kennst = 'kennt' if is_plural else 'kennst'\n"
"                    % set Melde = 'Meldet' if is_plural else 'Melde'\n"
"                    ${partner.salutation}\n"
"                </p>\n"
"                <p>\n"
"                    Danke!\n"
"                </p>\n"
"                <p>\n"
"                    Wir freuen uns, ${dir} das aktuelle Compassion-Magazin zu senden. Einmal pro Jahr berichten wir in "
"diesem Format über den Impact, den wir gemeinsam erreicht haben, was unsere Herausforderungen und Ziele sind und was "
"Menschen im globalen Süden und in der Schweiz bewegt. Viel Freude beim Schmökern und Entdecken!\n"
"                </p>\n"
"                <p>\n"
"                    Wenn ${du} Compassion noch nicht ${kennst}, ${hast} ${du} vielleicht noch viele Fragen. ${Melde} $"
"{dich} gerne jederzeit bei uns.\n"
"                </p>\n"
"                <p>\n"
"                    Herzliche Grüsse\n"
"                </p>\n"
"                <p>\n"
"                    Debora Alder-Gasser und das Team von Compassion\n"
"                </p>\n"
"            "
msgstr ""
"<p>\n"
"                    % set partner = object.partner_id\n"
"                    ${partner.salutation}\n"
"                </p>\n"
"                <p>\n"
"                    Merci!\n"
"                </p>\n"
"                <p>\n"
"                    C’est avec joie que nous vous adressons le magazine Compassion actuel. Vous y découvrirez un aperçu "
"de l'impact que nous atteignons ensemble, des défis de Compassion et de ce qui fait bouger les gens dans le Sud et en "
"Suisse. Bonne lecture!\n"
"                </p>\n"
"                <p>\n"
"                    Vous ne connaissez pas encore bien Compassion? Vous avez peut-être des questions sur notre "
"engagement, notre action. N'hésitez pas à prendre contact avec nous.\n"
"                </p>\n"
"                <p>\n"
"                    Chaleureuses salutations.\n"
"                </p>"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_new_donors_onboarding_2nd_blog_post
msgid ""
"<p>\n"
"                    % set partner = object.partner_id\n"
"                    % set is_plural = partner.title.plural or partner.title.id == 29\n"
"                    % set dir = 'euch' if is_plural else 'dir'\n"
"                    % set du = 'ihr' if is_plural else 'du'\n"
"                    % set du_upper = 'Ihr' if is_plural else 'Du'\n"
"                    % set dich = 'euch' if is_plural else 'dich'\n"
"                    % set deine = 'eure' if is_plural else 'deine'\n"
"                    % set findest = 'findet' if is_plural else 'findest'\n"
"                    % set fragst = 'fragt' if is_plural else 'fragst'\n"
"                    % set base_url = object.env['ir.config_parameter'].sudo().get_param('web.external.url')\n"
"                    ${partner.salutation}\n"
"                </p>\n"
"                <p>\n"
"                    ${du_upper} ${fragst} ${dich} vielleicht: \"Kinderpatenschaften kommen mir ein bisschen altmodisch "
"vor. Sind sie wirklich noch relevant?\"\n"
"                </p>\n"
"                <p>\n"
"                    Es wird ${dich} wahrscheinlich nicht überraschen, dass wir hier bei Compassion sagen, dass "
"Kinderpatenschaften relevanter sind als je zuvor. Mit fast 70 Jahren Erfahrung glauben wir immer noch, dass eine "
"Kinderpatenschaft eine lohnenswerte Investition ist, die effektiv, nachhaltig und engagiert ist - sogar in Krisenzeiten "
"wie einer globalen Pandemie. Aber warum? Lass es uns gemeinsam auspacken.\n"
"                </p>\n"
"                <p>\n"
"                    <!-- TODO add link      -->\n"
"                    <a href=\"#\">Weiterlesen</a>\n"
"                </p>\n"
"                <p>\n"
"                    Hier ${findest} ${du} Kinder, für die wir gerade dringend einen Paten oder eine Patin suchen.\n"
"                </p>\n"
"                <p>\n"
"                    <a href=\"https://compassion.ch/de/finden-sie-ein-patenkind/?utm_event=sponsorshipheaderbutton\">Ja, "
"ich möchte ein Kind mit einer Patenschaft unterstützen</a>\n"
"                </p>\n"
"                <p>\n"
"                    Nochmals vielen Dank, denn gemeinsam verändern wir das Leben von Kindern - eins nach dem anderen.\n"
"                </p>\n"
"                <p>\n"
"                    Herzliche Grüsse\n"
"                </p>\n"
"                <p>\n"
"                    Debora Alder-Gasser und das Team von Compassion\n"
"                </p>\n"
"                <p>\n"
"                    Du erhältst diese E-Mail, weil du gemeinsam mit Compassion Schweiz gegen extreme Armut kämpfst und "
"die Arbeit mit einer Spende unterstützt hast. Du kannst dich jederzeit vom <a href=\"${base_url}/onboarding/new_donors/"
"unsubscribe/${partner.onboarding_new_donor_hash}\">Nachrichtenversand abmelden</a>.\n"
"                </p>\n"
"            "
msgstr ""
"<p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"                    % set partner = object.partner_id\n"
"                    % set base_url = object.env['ir.config_parameter'].sudo().get_param('web.external.url')\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = object.get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"                    ${partner.salutation}\n"
"                </p>\n"
"                <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, "
"Arial, sans-serif;\">\n"
"                    Vous vous demandez peut-être si le parrainage d'enfants est encore vraiment pertinent à notre "
"époque.\n"
"                </p>\n"
"                <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, "
"Arial, sans-serif;\">\n"
"                   Vous ne serez probablement pas surpris d'apprendre qu'ici, à Compassion, nous affirmons que le "
"parrainage d'enfants est une forme d’aide au développement plus pertinente que jamais. \n"
"                </p>\n"
"<p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"Avec ${years_lc} ${number_years} ans d'expérience, nous observons que le parrainage d'enfants est un investissement "
"utile, efficace et durable et ce, même en temps de crise comme une pandémie mondiale. Mais pourquoi? Découvrons-le de "
"plus près.\n"
"</p>\n"
"                <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;margin:30px auto; text-align: center;  text-transform: uppercase;\">\n"
"   <a href=\"https://compassion.ch/le-parrainage-denfants-est-il-encore-pertinent-aujourdhui/?$"
"{partner.wordpress_form_data}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, "
"173);padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: "
"none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: "
"pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-"
"radius:3px\" title=\"\">\n"
"   Lire la suite\n"
"   </a>\n"
"  </div>\n"
"                <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, "
"Arial, sans-serif;\">\n"
"                   Vous trouverez ici les enfants pour lesquels nous recherchons urgemment un parrain ou une marraine.\n"
"                </p>\n"
"                <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, "
"Arial, sans-serif;\">\n"
"                    <a href=\"https://compassion.ch/parrainages/parrainer-un-enfant/?${partner.wordpress_form_data}\" "
"style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">Oui, je souhaite soutenir un "
"enfant par un parrainage.</a>\n"
"                </p>\n"
"                <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, "
"Arial, sans-serif;\">\n"
"                    Encore une fois merci. En effet, ensemble, nous changeons la vie des enfants - un après l’autre.\n"
"                </p>\n"
"                <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, "
"Arial, sans-serif;\">\n"
"                    Chaleureuses salutations et à bientôt!\n"
"                </p>\n"
"                <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, "
"Arial, sans-serif;\">\n"
"                    Christian Willi et l'équipe de Compassion\n"
"                </p>\n"
"                <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, "
"Arial, sans-serif;\">\n"
"                     Vous recevez cet e-mail parce que vous luttez contre l'extrême pauvreté aux côtés de Compassion et "
"que vous avez soutenu ce travail par un don. Vous pouvez <a href=\"${base_url}/onboarding/new_donors/unsubscribe/$"
"{partner.onboarding_new_donor_hash}\" data-original-title=\"\" title=\"\" aria-describedby=\"tooltip652677\" "
"style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">vous désinscrire</a> à tout moment "
"de notre newsletter.\n"
"                </p>\n"
"            "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_new_donors_onboarding_1st_blog_post
msgid ""
"<p>\n"
"                    % set partner = object.partner_id\n"
"                    % set is_plural = partner.title.plural or partner.title.id == 29\n"
"                    % set dir = 'euch' if is_plural else 'dir'\n"
"                    % set du = 'ihr' if is_plural else 'du'\n"
"                    % set du_upper = 'Ihr' if is_plural else 'Du'\n"
"                    % set dich = 'euch' if is_plural else 'dich'\n"
"                    % set deine = 'eure' if is_plural else 'deine'\n"
"                    % set hast = 'habt' if is_plural else 'hast'\n"
"                    % set fragst = 'fragt' if is_plural else 'fragst'\n"
"                    % set base_url = object.env['ir.config_parameter'].sudo().get_param('web.external.url')\n"
"                    ${partner.salutation}\n"
"                </p>\n"
"                <p>\n"
"                    Wir freuen uns, ${dich} kennenzulernen und ${dir} mehr davon zu erzählen, wie wir Kinder und "
"Familien unterstützen, extreme Armut zu überwinden. ${du_upper} ${fragst} ${dich} vielleicht, was Kinderpatenschaften "
"bringen, vielleicht sogar, ob sie sinnvoll sind oder ob nur christliche Kinder unterstützt werden? Gerne nehmen wir $"
"{dich} mit und beantworten ${deine} Fragen.\n"
"                </p>\n"
"                <p>\n"
"                    <!-- TODO add link -->\n"
"                    <a href=\"#\">Weiterlesen</a>\n"
"                </p>\n"
"                <p>\n"
"                    Nochmals vielen Dank: mit ${dir} zusammen befreien wir zurzeit mit rund 8'000 Partnerkirchen in 25 "
"Ländern 2,2 Millionen Kinder aus extremer Armut. Gemeinsam ermöglichen wir den Kindern ein Leben mit Hoffnung und "
"Zukunft.\n"
"                </p>\n"
"                <p>\n"
"                    Herzliche Grüsse\n"
"                </p>\n"
"                <p>\n"
"                    Debora Alder-Gasser und das Team von Compassion\n"
"                </p>\n"
"                <p>\n"
"                    Du erhältst diese E-Mail, weil du gemeinsam mit Compassion Schweiz gegen extreme Armut kämpfst und "
"die Arbeit mit einer Spende unterstützt hast. Du kannst dich jederzeit vom <a href=\"${base_url}/onboarding/new_donors/"
"unsubscribe/${partner.onboarding_new_donor_hash}\">Nachrichtenversand abmelden</a>.\n"
"                </p>\n"
"            "
msgstr ""
"<p>\n"
"                    % set partner = object.partner_id\n"
"                    % set base_url = object.env['ir.config_parameter'].sudo().get_param('web.external.url')\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = object.get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"                    ${partner.salutation}\n"
"                </p>\n"
"                <p>\n"
"                    Nous nous réjouissons de faire votre connaissance et de vous en dire plus sur la manière dont nous "
"aidons les enfants et les familles à surmonter l'extrême pauvreté. \n"
"                </p>\n"
"<p>\n"
"Vous vous demandez peut-être ce qu'est le parrainage d'enfants, peut-être même s'il fait sens ou encore si seuls les "
"enfants chrétiens sont soutenus? C’est un plaisir pour nous d’accompagner votre découverte de Compassion et de répondre "
"à vos questions.\n"
"</p>\n"
"                    <div style=\"margin:30px auto; text-align: center;  text-transform: uppercase;\">\n"
"   <a href=\"https://compassion.ch/nouveau-nouvelle-a-compassion/?${partner.wordpress_form_data}\" style=\"padding: 12px "
"18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-"
"block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: "
"nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"   Lire la suite\n"
"   </a>\n"
"  </div>\n"
"                <p>\n"
"                    Encore une fois, merci: avec vous, nous sommes actuellement en train de soutenir ${number_children} "
"millions d'enfants, afin de les libérer de l'extrême pauvreté. Cet engagement, nous le menons en partenariat avec $"
"{number_fcps} Eglises partenaires dans ${number_countries} pays. \n"
"                </p>\n"
"                <p>\n"
"                    Ensemble, nous pouvons donner à ces enfants une vie digne, pleine d'espoir pour un avenir "
"meilleur. \n"
"                </p>\n"
"<p>\n"
"Chaleureuses salutations et à bientôt.\n"
"</p>\n"
"${object.user_id.signature | safe}\n"
"<br>\n"
"<br>\n"
"                <p>\n"
"                    Vous recevez cet e-mail parce que vous luttez contre l'extrême pauvreté aux côtés de Compassion et "
"que vous avez soutenu ce travail par un don. Vous pouvez <a href=\"${base_url}/onboarding/new_donors/unsubscribe/$"
"{partner.onboarding_new_donor_hash}\">vous désinscrire</a> à tout moment de notre newsletter.\n"
"                </p>\n"
"            "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_certificate
msgid ""
"<p>\n"
"                    % set partner = object.partner_id\n"
"                    % set sponsorships = object.get_objects()\n"
"                    % set name = sponsorships.mapped(\"child_id\").get_list(\"preferred_name\")\n"
"                    ${partner.salutation}\n"
"                </p>\n"
"                <p>\n"
"                    We recently informed you by email about the end of the sponsorship of ${name}.\n"
"                </p>\n"
"                <p>\n"
"                    From the bottom of our hearts, we would like to thank you for your valuable contribution!\n"
"                </p>\n"
"                <p>\n"
"                    Best regards\n"
"                </p>\n"
"            "
msgstr ""
"<p>\n"
"                    % set partner = object.partner_id\n"
"                    % set sponsorships = object.get_objects()\n"
"                    % set name = sponsorships.mapped(\"child_id\").get_list(\"preferred_name\")\n"
"                    ${partner.salutation},\n"
"                </p>\n"
"                <p>\n"
"                    Nous vous avons récemment informé par e-mail que votre parrainage pour ${name} est arrivé à son "
"terme.\n"
"                </p>\n"
"                <p>\n"
"                    Merci du fond du cœur de votre précieux engagement à nos côtés!\n"
"                </p>\n"
"                <p>\n"
"                    Avec nos chaleureuses salutations.\n"
"                </p>"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step2
msgid ""
"<p>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorship = object.get_objects()\n"
"    % set child = sponsorship.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, 'your sponsored children', translate=False)\n"
"    % set country = child.mapped('field_office_id')\n"
"    % set alumni_name = country.get_list('alumni_representative')\n"
"    % set apos = \"'\" if alumni_name[-1] == 's' else \"'s\"\n"
"    % set alumni_link = country.get_list('alumni_video_link', 1, 'https://vimeo.com/showcase/geschichten-ehemaliger-"
"patenkinder-von-compassion')\n"
"    % set multi_link = alumni_link == 'https://vimeo.com/showcase/geschichten-ehemaliger-patenkinder-von-compassion'\n"
"    ${partner.salutation}, your sponsorship is making a difference!\n"
"</p>\n"
"<p>\n"
"    % if not multi_link:\n"
"        Today, we would like to introduce you to ${alumni_name}, a former sponsored child of Compassion. ${'She' if "
"child[0].field_office_id.alumni_gender == 'F' else 'He'} lives on the same continent as ${firstname}.\n"
"    % else:\n"
"        Today, we would like to introduce you to ${alumni_name}, former sponsored children of Compassion. They on the "
"same continent as ${firstname}.\n"
"    % endif\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"${alumni_link}\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-"
"color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; "
"vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: "
"1px solid #0054A6; border-radius:3px\" title=\"\">Discover\n"
"    % if multi_link:\n"
"        their stories\n"
"    % else:\n"
"        ${alumni_name + apos} story\n"
"    % endif\n"
"    </a>\n"
"</div>\n"
"<h3 style=\"color: #0054A6; text-transform: uppercase;\">\n"
"    <b>You enable ${firstname if len(child) < 4 else 'your sponsored children'}:</b>\n"
"</h3>\n"
"<ul>\n"
"    <li>Access to school (school fees, uniform, material, tutoring)</li>\n"
"    <li>Higher education (vocational training or university studies)</li>\n"
"    <li>Medical care</li>\n"
"    <li>Hygiene training and regular balanced meals</li>\n"
"    <li>Love and care from a local church, bible teaching*</li>\n"
"    <li>Encouragement to explore their personality as they learn and play</li>\n"
"    <li>Letter contact with you</li>\n"
"</ul>\n"
"<p style=\"font-size: smaller\">\n"
"    *In agreement with the child's parents\n"
"</p>\n"
"<p>The child will be supported until the end of school, including vocational training, but at most until the age of 22.</"
"p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://compassion.ch/de/compassion-weltweit\" style=\"padding: 12px 18px; font-size: 14px; line-height: "
"18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-"
"weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; "
"background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Get to know more about the country where ${firstname} ${'lives' if len(child) == 1 else 'live'}\n"
"    </a>\n"
"</div>\n"
"<p>Thanks to you, not only a child, but a whole family can find new hope for the future.</p>\n"
"<p>Warm regards,</p>\n"
"<p>${object.user_id.short_signature | safe}</p>"
msgstr ""
"<p>\n"
"   % set partner = object.partner_id\n"
"% set sponsorship = object.get_objects()\n"
"% set child = sponsorship.mapped('child_id')\n"
"% set country = child.mapped('field_office_id')\n"
"% set alumni_name = country.get_list('alumni_representative')\n"
"% set alumni_link = country.get_list('alumni_video_link', 1, 'https://vimeo.com/showcase/histoires-danciens-filleuls-de-"
"compassion')\n"
"% set multi_link = alumni_link == 'https://vimeo.com/showcase/histoires-danciens-filleuls-de-compassion'\n"
"       % set wp = \"SWP\" in sponsorship.mapped(\"type\")\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set informal = wp and not plural\n"
"    % set tu = \"tu\" if informal else \"vous\"\n"
"    % set te = \"te\" if informal else \"vous\"\n"
"    % set toi = \"toi\" if informal else \"vous\"\n"
"    % set ton = \"ton\" if informal else \"votre\"\n"
"    % set tes = \"tes\" if informal else \"vos\"\n"
"% set firstname = child.get_list('preferred_name', 3, child.get('ton filleul') if informal else child.get('your "
"sponsored child'), translate=False)\n"
"  </p>\n"
"  <p>\n"
"   ${partner.informal_salutation if informal else partner.salutation},\n"
"  </p>\n"
"  <p>\n"
"   L'impact de ${ton} parrainage est réel!\n"
"  </p>\n"
"  <p>\n"
"   % if not multi_link:\n"
"\tAujourd'hui, nous souhaitons ${te} présenter ${alumni_name}, ${\"une ancienne enfant parrainée\" if "
"child[0].field_office_id.alumni_gender == 'F'  else \"un ancien enfant parrainé\"} de Compassion. ${'Elle' if "
"child[0].field_office_id.alumni_gender == 'F' else 'Il'} vit sur le même continent que ${firstname}.\n"
"\t% else:\n"
"\tAujourd'hui, nous souhaitons ${te} présenter ${alumni_name}, des anciens enfants parrainés de Compassion. Ils vivent "
"sur les mêmes continents que ${firstname}.\n"
"% endif\n"
"  </p>\n"
"  <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"   <a href=\"${alumni_link}\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-"
"color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; "
"vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: "
"1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"    ${\"Découvre\" if informal else \"Découvrez\"} l'histoire de ${alumni_name}\n"
"   </a>\n"
"  </div>\n"
"  <h3 style=\"color: #0054A6; text-transform: uppercase;\">\n"
"   <b>\n"
"    Voici ce que permet ${ton} parrainage\n"
"   </b>\n"
"   :\n"
"  </h3>\n"
"  <ul>\n"
"   <li>\n"
"    Accès à l’école (écolage, uniforme et fournitures)\n"
"   </li>\n"
"   <li>\n"
"    Suivi médical\n"
"   </li>\n"
"   <li>\n"
"    Formations (hygiène, artisanat, cuisine)\n"
"   </li>\n"
"   <li>\n"
"    Développement spirituel\n"
"   </li>\n"
"   <li>\n"
"    Activités pour développer ses talents\n"
"   </li>\n"
"   <li>\n"
"    Une correspondance avec la marraine, le parrain\n"
"   </li>\n"
"  </ul>\n"
"  <p>\n"
"   L'enfant est accompagné personnellement jusqu’à la fin d’une formation professionnelle mais jusqu’à l’âge de 22 ans "
"tout au plus.\n"
"  </p>\n"
"  <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"   <a href=\"https://compassion.ch/compassion-dans-le-monde/\" style=\"padding: 12px 18px; font-size: 14px; line-height: "
"18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-"
"weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; "
"background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"    En savoir plus sur le${'' if len(country) == 1 else 's'} pays où ${'vit' if len(child) == 1 else 'vivent'} $"
"{firstname}\n"
"   </a>\n"
"  </div>\n"
"  <p>\n"
"   Merci pour ${ton} engagement. Grâce à ${toi}, un enfant ainsi que ses proches trouvent de l’espoir pour leur avenir.\n"
"  </p>\n"
"  <p>\n"
"   Chaleureusement,\n"
"  </p>\n"
"  <p>\n"
"   ${object.user_id.short_signature | safe}\n"
"  </p>\n"
" "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_sponsorship_confirmation
msgid ""
"<p>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorships = object.get_objects()\n"
"\n"
"    % if len(sponsorships) > 1:\n"
"        % set has = 'have'\n"
"    % else:\n"
"        % set has = 'has'\n"
"    % endif\n"
"    % set others = partner.sponsorship_ids - sponsorships\n"
"    % set wp = \"SWP\" in sponsorships.mapped(\"type\")\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) !"
"= len(sponsorships)\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), translate=False)\n"
"    % set less_3 = firstname != children.get_number()\n"
"    % set apos = \"'\" if firstname[-1] == 's' else \"'s\"\n"
"    % set payment_attachment = sponsorships.get_payment_type_attachment_string()\n"
"    % set is_new = sponsorships.filtered(\"is_first_sponsorship\")\n"
"    % set number_years = object.env[\"partner.communication.job\"].get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | "
"safe\n"
"    % set years_uc = object.env[\"partner.communication.job\"].get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.env[\"partner.communication.job\"].get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.env[\"partner.communication.job\"].get_snippet('children_in_poverty') | striptags "
"| safe\n"
"    % set early_deaths = object.env[\"partner.communication.job\"].get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.env[\"partner.communication.job\"].get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = "
"object.env[\"partner.communication.job\"].get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"<p>\n"
"</p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    % if is_new:\n"
"        It's so nice to have you as part of the Compassion family!\n"
"    % else:\n"
"        Thank you so much for deciding to sponsor ${'more children' if plural else 'another child'}.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    With your help alongside around ${number_fcps} partner churches we are currently releasing over ${number_children} "
"million children from poverty in ${number_countries} countries. Together we enable children to have a life with hope and "
"a future.\n"
"</p>\n"
"<p>\n"
"    % if payer:\n"
"        After receiving your first donation, ${'the children' if plural else firstname} will be informed that $"
"{children.get('he')} now ${has} a sponsor.\n"
"        <b>\n"
"            ${payment_attachment}\n"
"        </b>\n"
"        %  if len(partner.sponsorship_ids) == len(sponsorships):\n"
"            Please <a href=\"https://compassion.ch/de/zahlungsart-deiner-patenschaft\">click here</a> if you have any "
"questions about your donation.\n"
"        % endif\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    In a series of short emails over the coming month, we will explain everything you need to know about ${firstname if "
"less_3 else 'the children'} and the sponsorship.\n"
"</p\n"
"<p>\n"
"    % if is_new:\n"
"        Register and discover MyCompassion to write to your sponsored ${'children' if plural else 'child'}, download "
"photos and letters, find out more and adapt information linked to your ${'sponsorships' if plural else 'sponsorship'} "
"and much more.\n"
"    % else:\n"
"        Just like for your other sponsorships, you will find all of ${firstname + apos if less_3 else 'your sponsored "
"children'} information and photos on MyCompassion and you can write to ${children.get('him')}.\n"
"    % endif\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://mycompassion.ch/de_DE/my/home\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; "
"color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: "
"400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; "
"background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        MyCompassion\n"
"    </a>\n"
"</div>\n"
"% if is_new:\n"
"    <p>\n"
"        Thank you so much for making the decision to invest in the life of ${firstname if less_3 else 'many children'}.\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step1
msgid ""
"<p>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set one_child = len(children) == 1\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set deine_patenkinder = 'your sponsored children'\n"
"    % set firstname = children.get_list('preferred_name', 3, deine_patenkinder, translate=False)\n"
"    % set less_4 = firstname != deine_patenkinder\n"
"    % set wp = \"SWP\" in sponsorships.mapped(\"type\")\n"
"</p>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"% if sponsorships.filtered(\"is_first_sponsorship\"):\n"
"    <p>\n"
"        This is the first of five emails that you will receive from us.\n"
"    </p>\n"
"    <p>\n"
"        Today we will help you get to know ${children.get_child_preposition_country('from_preposition', child_limit=3, "
"country_limit=3, child_substitution=deine_patenkinder, country_substitution=deine_patenkinder)} better (PDF attached).\n"
"    </p>\n"
"    <p>\n"
"        Did you know that you can visit your sponsored ${'children' if not one_child else 'child'}?\n"
"    </p>\n"
"    <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"        <a href=\"https://compassion.ch/de/reisen/\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; "
"color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: "
"400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; "
"background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            More information on visits\n"
"        </a>\n"
"    </div>\n"
"% else:\n"
"    <p>\n"
"        Thank you for deciding to invest in the life of ${'more children' if not one_child else 'another child'}!\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.signature | safe}\n"
"</p>\n"
msgstr ""

#. module: partner_communication_switzerland
