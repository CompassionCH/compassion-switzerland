#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_anniversary_3
msgid ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   We want to celebrate your anniversary together with you!\n"
"   <br>\n"
"   <br>\n"
"   It‘s been 3 years since you decided to support ${firstname} with a sponsorship to free ${child.get('him')} from "
"extreme poverty.\n"
"   <br>\n"
"   <br>\n"
"   Through your support, you not only provide ${firstname} with solid assistance, but you‘re also expanding the horizon "
"for ${child.get('him')}. Thank you for investing in the contact with your sponsored child!\n"
"   <br>\n"
"   <br>\n"
"   Together with you as sponsors, Compassion and 8,600 local churches; we are liberating 2.3 million children from "
"extreme poverty.\n"
"   <br>\n"
"   <br>\n"
"   Thank you so very much!\n"
"   <br>\n"
"  </p>\n"
" % if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_sub_dossier_new
msgid ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set previous = sponsorships.mapped('parent_id.child_id')\n"
"                    \n"
"% set previous_name = previous.get_list('preferred_name', 3, '', translate=False)\n"
"                    \n"
"% set name = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   We recently informed you that ${previous.get('your sponsored child')}, ${previous_name} ${previous.get('is')} no "
"longer participating in the sponsorship program. We suggested that you sponsor another child who really needs help.\n"
"   <br>\n"
"   <br>\n"
"   Enclosed you will find information about ${name} in ${child.get_list('project_id.country_id.name')}. Would you again "
"be prepared to invest in a life to release ${child.get('him')} from extreme poverty?\n"
"   <br>\n"
"   <br>\n"
"   Jennifer, for example lost her mother when she was only 14 years old. Today she is a lawyer. “In my sponsors letters, "
"I was always encouraged to persevere and to improve.“\n"
"   <br>\n"
"   <br>\n"
"   Sponsorship changes the life of a child. Your commitment makes a huge difference for a child, for the family and the "
"entire environment.\n"
"   <br>\n"
"   <br>\n"
"   If you do not want to support this child, please let us know as soon as possible so that we can find another sponsor "
"for ${child.get('him')}.\n"
"   <br>\n"
"   <br>\n"
"   Thank you for everything you have already done for a child in poverty.\n"
"   <br>\n"
"   <br>\n"
"   Thank you for responding to this request.\n"
"   <br>\n"
"   <br>\n"
"   Sincerely,\n"
"  </p>\n"
" "
msgstr ""

#. module: partner_communication_switzerland
