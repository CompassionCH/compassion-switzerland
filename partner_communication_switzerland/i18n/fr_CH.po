"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    % set sponsorship = object.get_objects()\n"
"                    % set child = sponsorship.child_id\n"
"% set image_url = child.image_url.replace('media.ci.org/', 'media.ci.org/g_face,c_thumb,w_150,h_150,r_max/') if "
"child.image_url else None\n"
"% set confirmation_url = \"/child/\" + str(child.id) + \"/sponsor/confirmation?face_reveal=1\"\n"
"                </div>\n"
"% if image_url:\n"
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;text-"
"align:center;>\n"
"<img src=\">\n"
"</div>\n"
"% endif\n"
"                <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, "
"Verdana, Arial, sans-serif;\">\n"
"                  Hello!\n"
"                  </p>\n"
"                  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, "
"Verdana, Arial, sans-serif;\">\n"
"                   It's so wonderful that you wish to invest in the life of ${child.preferred_name}. ou will change $"
"{child.get(\"his\")} life in a sustainable way.\n"
"                    <br><br>\n"
"                    <a href=\"${confirmation_url}\" style=\"background-color:transparent;color:#0055A6;text-decoration: "
"underline;\">Click here</a> to complete your details.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"                    Best regards,\n"
"<br><br>\n"
" ${object.user_id.preferred_name} ${object.user_id.lastname}\n"
"   <br>\n"
"   ${object.user_id.employee_ids.department_id.name}\n"
"   <br>\n"
"   ${object.user_id.company_id.address_name}\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_wrpr_child_info
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set firstname = sponsorships.mapped('child_id').get_list('preferred_name', 3, deine + 'n Patenkindern', False)\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set deine_patenkinder = 'deine Patenkinder' if not plural else 'eure Patenkinder'\n"
"    % set chat_url = \"https://mycompassion.ch/im_livechat/support/2\"\n"
"        % if partner.user_ids.login_date:\n"
"        % set my_url = \"https://mycompassion.ch/my/children\"\n"
"        % set chat_url = my_url\n"
"    % else:\n"
"        % if partner.email and not partner.signup_url:\n"
"            % if not partner.env[\"res.users\"].search_count([(\"login\", \"=\", partner.email)]):\n"
"                % set void = "
"partner.env[\"res.partner.create.portal.wizard\"].with_context(active_ids=partner.ids).create({\"create_communication\": "
"False}).button_create_portal_user()\n"
"            % endif\n"
"            % set void = partner.action_signup_prepare()\n"
"            % set void = partner.env.clear()\n"
"        % endif\n"
"        % set my_url = partner.signup_url or \"https://mycompassion.ch/web/signup\"\n"
"    % endif\n"
"</div>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"2/8:\n"
"<br>${partner.salutation}\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">Heute stellen wir ${dir} ${child.get_child_preposition_country(child_limit=3, country_limit=3, "
"child_substitution=deine_patenkinder, country_substitution=deine_patenkinder)} besser vor.\n"
"</p><p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, "
"sans-serif;\">\n"
"    % if not sponsorships.filtered(\"is_first_sponsorship\") and partner.user_ids:\n"
"Wie bisher ${\"werdet ihr\" if plural else \"wirst du\"} alle Informationen zu ${deine}r ${child.get('Patenschaft')} in "
"MyCompassion finden: <a href=\"${my_url}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, "
"173);\">${my_url}</a>\n"
"    % else:\n"
"${\"Registriert euch\" if plural else \"Registriere dich\"} dazu auf MyCompassion: <a href=\"${my_url}\" style=\"text-"
"decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">${my_url}</a>\n"
"    % endif\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">${\"Stellt euch\" if plural else \"Stell dir\"} einmal ${child.get('seine')} Herausforderungen und Träume vor "
"und wie ${du} ${child.get('ihn')} darin ermutigen und unterstützen ${\"könnt\" if plural else \"kannst\"}.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">Danke, dass ${du} einen Unterschied im Leben von ${firstname} ${\"macht\" if plural else \"machst\"}.</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"Liebe Grüsse<br>\n"
"Sarah<br>\n"
"Tel: +41 (0)31 552 21 21<br>\n"
"Fragen? <a href=\"${chat_url}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">$"
"{chat_url}</a>\n"
"</p>\n"
"        "
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_yearly_payment_slips
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set fully_managed = sponsorships.filtered('fully_managed')\n"
"    % set ns = namespace(correspondents = object.env['recurring.contract'])\n"
"   % set is_payer = partner in sponsorships.mapped(\"partner_id\")\n"
"\n"
"    % for s in sponsorships:\n"
"        % set gp = s.mapped(s.send_gifts_to)\n"
"\n"
"        % if gp == partner:\n"
"            % set ns.correspondents = ns.correspondents + s\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % set payers = partner.mapped('contracts_paid').intersect(sponsorships)\n"
"    % set payment_modes = sponsorships.mapped('payment_mode_id')\n"
"    % set bvr = payment_modes.intersect(object.env.ref('sponsorship_switzerland.payment_mode_bvr'))\n"
"    % set op = payment_modes.intersect(object.env.ref('sponsorship_switzerland.payment_mode_permanent_order'))\n"
"    % set months_paid = max(sponsorships.mapped('months_paid'))\n"
"    % set children = fully_managed.union(ns.correspondents).mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, 'many children', False)\n"
" % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | "
"safe\n"
"\n"
"    % if payers and (bvr or op):\n"
"        % set children = fully_managed.union(ns.correspondents, payers).mapped('child_id')\n"
"    % endif\n"
"</div>\n"
"    % if object.send_mode == \"digital\":\n"
"        <img src=\"https://compassion.ch/medias/banners/CC-EC0534-MyLastDay-01-2506.jpg\" alt=\"merci pour votre "
"soutien\" style=\"border-style:none;vertical-align:middle;display:block;margin: auto; margin-bottom: 60px; width: 100%; "
"max-width: 600px; height: auto;\" width=\"600\" height=\"0\">\n"
"    % endif\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\"><b style=\"font-weight:bolder;\">We wish you and your loved ones a happy new year full of hope! </b></p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"    <b style=\"font-weight:bolder;\">Thank you for choosing to invest in ${firstname}’s life.</b> Your commitment and "
"support will have a lasting impact on ${children.get('his')} life and ${children.get('his')} loved ones, just as it did "
"for Jennifer and so many other children in need.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"    Jennifer still remembers the very first time she walked into the Compassion child development center. “I was seven. "
"I felt scared and shy. They served us a warm meal – rice, chicken, and lentils – and I can still remember its smell. "
"From that moment on, I felt at home.”\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"    But what changed her life wasn’t just hot meals and school supplies. It was  a caring community, the presence of the "
"Church, and faith slowly taking root in her heart. Every day, the staff gently spoke truth over her life: “You are "
"loved. You are precious. God has a purpose for you.”\n"
"% if object.send_mode == \"digital\":\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"% endif\n"
"    Today, Jennifer is studying family social work and has returned as a teacher to the very Compassion center that once "
"welcomed her.\n"
"</p>\n"
"\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\"></p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"  <b style=\"font-weight:bolder;\">Attached you will find:</b>\n"
"</p>\n"
"<ul style=\"margin:0px 0 1rem 0;\">\n"
"    % if bvr and is_payer:\n"
"        <li>\n"
"            payment slips for your sponsorship for the year ${str(datetime.date.today().year+1)}\n"
"        </li>\n"
"    % endif\n"
"    <li>\n"
"        three additional slips per sponsored child, should you wish to bless them with a birthday gift, support $"
"{firstname}’s family, or contribute to the child development center during the year $"
"{str(datetime.date.today().year+1)}\n"
"    </li>\n"
"</ul>\n"
"   % if bvr and is_payer:\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"    You also have the option to set up a standing order for your sponsorship contributions if you wish.\n"
"</p>\n"
"% endif\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"    Please note that any “gift” donations are entirely optional - there is absolutely no obligation. Your sponsorship "
"alone is already a beautiful and generous gift! If you happen to misplace your payment slips or would like additional "
"ones, please don’t hesitate to contact us at 031 552 21 25 or at info@compassion.ch.\n"
"% if object.send_mode == \"digital\":\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"% endif\n"
"    We remain at your disposal for any further questions regarding your sponsorship.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"    <b style=\"font-weight:bolder;\">Thank you for being part of the Compassion family.</b> Your generosity, together "
"with other sponsors and the work of more than ${number_fcps} child development centers in ${number_countries} countries, "
"is bringing hope and encouragement to ${number_children} million children today.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"   Wishing you a peaceful Advent season.\n"
"</p>\n"
"\n"
"% if object.send_mode == \"digital\":\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, "
"sans-serif;\">\n"
"        ${object.user_id.sudo().signature | safe}\n"
"    </p>\n"
"% endif"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_anniversary_5
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, "
"sans-serif;\">\n"
"Congratulations! It’s been 5 years since you’ve been supporting ${firstname}! On behalf of the entire team at Compassion "
"Switzerland, we would like to thank you for your commitment to a child in extreme poverty.\n"
"   <br>\n"
"   <br>\n"
"   Your sponsorship has a great impact on the development of this child. It enables ${child.get('him')} to live a life "
"without extreme poverty but with dignity and real hope. ${firstname} is one of 2,3 million children currently supported "
"by Compassion’s sponsorship program. Thank you for working together with us.\n"
"   <br>\n"
"   <br>\n"
"   Yours sincerely.\n"
"   <br>\n"
"  </p>\n"
" % if object.send_mode == 'digital':\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, "
"sans-serif;\">\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.compassion_reset_password_email
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"% set partner = object.get_objects()\n"
"% set link = str(partner.signup_url).replace('erp.compassion', 'mycompassion')\n"
"  </div>\n"
"<p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"    Dear ${partner.preferred_name},\n"
"<br>\n"
"<br>\n"
"    You have requested a new password for your Compassion Account. You may change your password by following this link "
"which will remain valid during 24 hours:\n"
"   </p>\n"
"   <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: "
"rgb(119, 119, 119); text-align: center; margin-top: 16px;\">\n"
"    <a href=\"${link}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);padding: 5px "
"10px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#875A7B; text-decoration: none; display: inline-"
"block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: "
"nowrap; background-image: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius:3px\">\n"
"     Change password\n"
"    </a>\n"
"   </div>\n"
"<br>\n"
"<br>\n"
"   <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-"
"serif;\">\n"
"    If you do not expect this, you can safely ignore this email.\n"
"<br>\n"
"<br>\n"
"     Thank you for your committed effort in the fight against extreme poverty. Please feel free to contact us if you "
"have any questions.\n"
"     <br>\n"
"<br>\n"
"    Best Regards,\n"
"   <br>\n"
"<br>\n"
"    Compassion Switzerland\n"
"   </p>\n"
" "
msgstr ""
"<div>\n"
"% set partner = object.get_objects()\n"
"% set link = str(partner.signup_url).replace('erp.compassion', 'mycompassion')\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Une demande de réinitialisation de votre mot de passe nous est parvenue.\n"
"   <br>\n"
"   <br>\n"
"   Vous pouvez changer votre mot de passe en suivant ce lien qui restera valide pendant 24 heures :\n"
"   <br>\n"
"   <br>\n"
"  </p>\n"
"  <div style=\"text-align: center; margin-top: 16px; text-transform: uppercase\">\n"
"   <a href=\"${link}\" style=\"padding: 5px 10px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-"
"color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; "
"vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: "
"1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"    Changer mon mot de passe\n"
"   </a>\n"
"  </div>\n"
"  <br>\n"
"  <br>\n"
"  Merci beaucoup pour votre participation à la lutte contre l'extrême pauvreté. N'hésitez pas à nous contacter si vous "
"avez des questions.\n"
"  <br>\n"
"  <br>\n"
"  Meilleures salutations,\n"
"  <br>\n"
"  <br>\n"
"  L'équipe de Compassion Suisse\n"
" "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.portal_user_welcome_email
msgid ""
"<div style=\"font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif\">\n"
"    % set partner = object.partner_id\n"
"    % set user = object.get_objects()\n"
"    % set user = object.get_objects()\n"
"    % set registration = partner.registration_ids[:1]\n"
"    % set event = registration.event_id.compassion_event_id\n"
"    % set country = event.country_id\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation},\n"
"</p>\n"
"<p>\n"
"    WELCOME to the Muskathlon ${event.name} from&nbsp;${event.get_date('start_date', 'd')} until $"
"{event.get_date('end_date', 'date_full')} - your extreme commitment against extreme poverty!\n"
"</p>\n"
"<p>\n"
"    The Muskathlon is organized by 4M Switzerland and 4M Germany in cooperation with the Christian charity for children, "
"Compassion, and offers you the extraordinary opportunity to take part in the fight against child poverty and its "
"consequences and at the same time take part in a sporting challenge on another continent.\n"
"</p>\n"
"<p>\n"
"    You will make the difference and experience that hope is stronger than poverty!\n"
"</p>\n"
"<p>\n"
"    With your registration a very special and great adventure has begun for you. We want to give you the best possible "
"support and give you all the information and tips you need for your Muskathlon. Start with the preparation and read the "
"\"Information Letter\" which is deposited on your profile. In the following months, we will provide you with more "
"information material and remind you when to do what.\n"
"</p>\n"
"<p>\n"
"    Soon you will receive mail from us with the invoice for the travel costs, various flyers and your training shirt.\n"
"</p>\n"
"<p>\n"
"    Please activate your account and setup your password by clicking on this button:\n"
"</p>\n"
"<div style=\"font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin:0 auto; text-"
"align: center;\">\n"
"    <a href=\"${user.signup_url.replace('erp.compassion', 'muskathlon-kilimanjaro') + '&redirect=/my/muskathlon'}\"\n"
"       style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);padding: 12px 18px; font-size: "
"12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-"
"bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; "
"background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\">\n"
"        Activate my account\n"
"    </a>\n"
"</div>\n"
"<>\n"
"    Here are your access data:\n"
"</p>\n"
"<ul style=\"margin:0px 0 1rem 0;\">\n"
"    <li>\n"
"        Username: ${user.login or ''}\n"
"    </li>\n"
"    <li>\n"
"        Access link: <a href=\"https://mycompassion.ch/my/muskathlon\">mycompassion.ch/my/muskathlon</a>\n"
"    </li>\n"
"</ul>\n"
"<p>\n"
"    If any questions arise, please do not hesitate to contact us.\n"
"</p>\n"
"<p>\n"
"    For questions about organization and travel: Nathalie Schranz, n.schranz@4m-switzerland.ch, 079 507 92 40\n"
"</p>\n"
"<p>\n"
"    For questions about Compassion and sponsorships: Colin Ward, cward@compassion.ch, 077 261 36 76\n"
"</p>\n"
"<p>\n"
"    Regards\n"
"</p>\n"
"<p>\n"
"    Nathalie, 4M Switzerland\n"
"    <br>\n"
"    Colin, Compassion\n"
"</p>"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.auto_reminder_archive_partners_template
msgid ""
"<div>\n"
"                    <b>The following partners meet the criteria (see <a href=\"/"
"web#action=521&amp;active_id=895&amp;cids=1&amp;id=600&amp;menu_id=2029&amp;model=project.task&amp;view_type=form\">T0024</"
"a>) and are considered invalid : </b>\n"
"                    <span style=\"font-family: 'miller';\">\n"
"                    % for partner in ctx.get('partners_to_archive'):\n"
"                        <p><a href=\"/web#id=${partner.id}&amp;model=res.partner&amp;view_type=form\">Ref ${partner.ref} "
"- ${partner.name}</a></p>\n"
"                    % endfor\n"
"                    </span>\n"
"                </div>\n"
"            "
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.old_letter
msgid ""
"<div>\n"
"    % set letter = object.get_objects()\n"
"    letter: ${letter}<br><br>\n"
"    % set cetteLettre = 'cette lettre' if len(letter) == 1 else 'ces lettres'\n"
"    cetteLettre: ${cetteLettre}\n"
"    % set uneLettre = 'une lettre' if len(letter) == 1 else 'des lettres'\n"
"    % set child = letter.mapped('child_id')\n"
"    % set partner = object.partner_id\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set urls = []\n"
"\n"
"    % for l in letter.filtered('read_url').mapped('read_url'):\n"
"        % if l not in urls:\n"
"            % set void = urls.append(l)\n"
"        % endif \n"
"    % endfor\n"
"\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/fr_CH/im_livechat/support/3\"\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"\n"
"% if object.send_mode == \"sms\":\n"
"    <p>\n"
"        ${partner.informal_salutation},\n"
"    </p>\n"
"    <p>\n"
"        Nous sommes heureux de t'envoyer la nouvelle lettre de ${child.get('preferred_name', translate=False)}!\n"
"    </p>\n"
"    <p>\n"
"        Clique ici pour télécharger la lettre: <a href=\"${urls[0]}\">Lettre</a>\n"
"    </p>\n"
"    <p>\n"
"        Bonne lecture!\n"
"    </p>\n"
"    <p>\n"
"        Si tu as cinq minutes, pourrais-tu directement répondre à cette lettre? Clique simplement ici: <a href=\"https://"
"mycompassion.ch/fr_CH/my/letter\">MyCompassion</a>\n"
"    </p>\n"
"    <p>\n"
"        Merci et à bientôt!\n"
"    </p>\n"
"    <p>\n"
"        L'équipe de Compassion\n"
"        <br/>Tel: +41 (0)24 434 21 24\n"
"        <br/>Des questions? Écris-nous sur WhatsApp: +41 (0)79 622 31 97\n"
"    </p>\n"
"% else:  \n"
"    <p>\n"
"        ${object.partner_id.salutation},\n"
"    </p>\n"
"    <p>\n"
"        C'est avec joie que nous vous adressons ${uneLettre} de ${child.get_list('preferred_name', 3, "
"child.get_number(), False)} ! Comme vous le constaterez, ${\"cette lettre n'est\" if len(letter) == 1 else \"ces lettres "
"ne sont\"} pas toute récente${child.get('accord_s')}, la faute à un problème technique survenu lors de la transmission. "
"Toutes nos excuses pour ce désagrément.\n"
"    </p>\n"
"    <p>\n"
"        % if object.send_mode == 'digital':\n"
"            Cliquez sur le lien pour télécharger ${cetteLettre}*. Nous vous souhaitons beaucoup de plaisir à la lecture "
"des nouvelles de ${child.get_list('preferred_name', 3, child.get_number(), False)}\n"
"            </p>\n"
"            <ul>\n"
"                % for l in urls:\n"
"                    <li>\n"
"                        <a href=\"${l}\">\n"
"                            ${l}\n"
"                        </a>\n"
"                    </li>\n"
"                % endfor\n"
"                </ul>\n"
"            <p>\n"
"        % endif\n"
"    \n"
"        ${years_uc} ${number_years} ans d'expérience montrent que ces lettres peuvent contribuer de façon déterminante "
"au développement de l'enfant.\n"
"    </p>\n"
"    <p>\n"
"        D'avance, merci de prendre quelques minutes pour répondre ${'au courrier ci-joint' if len(child) == 1 else 'aux "
"courriers ci-joints'}, avec quelques paroles d'encouragement à ${child.get_list('preferred_name', 3, child.get_number(), "
"False)}. Vous pouvez lui écrire\n"
"        <a href=\"https://mycompassion.ch\">en ligne</a>.\n"
"    </p>\n"
"    <p>\n"
"        N'hésitez pas à prendre contact avec nous pour toute question relative aux échanges de courriers !\n"
"    </p>\n"
"    <p>\n"
"        Merci de transformer la vie ${'d'un enfant' if len(child) == 1 else 'de plusieurs enfants et de les'} et de le "
"libérer de l'extrême pauvreté pour une vie digne et qui ait du sens.\n"
"    </p>\n"
"    <p>\n"
"        Avec nos chaleureuses salutations.\n"
"    </p>\n"
"    <p>\n"
"        % if object.send_mode == 'digital':\n"
"            </p>\n"
"            <p>\n"
"                ${object.sudo().user_id.signature | safe}\n"
"        % endif\n"
"    </p>\n"
"    <p>\n"
"        *En cas de problème pour ouvrir une ou plusieurs lettres, vous pouvez aussi les télécharger depuis votre compte "
"MyCompassion.\n"
"    </p>\n"
"% endif"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_new_labels
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set child = object.get_objects().mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, 'your sponsored children', False)\n"
"    % if len(child) == 1:\n"
"        % set anewsheet = 'a new sheet'\n"
"        % set child = 'child'\n"
"    % else:\n"
"        % set anewsheet = 'the new sheets'\n"
"        % set child = 'children'\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you for investing into the life of ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Please find enclosed ${anewsheet} of labels for the letters you wish to send by post.\n"
"</p>\n"
"<p>\n"
"    Do you know that you can write your letters easily in your <a href='https://www.mycompassion.ch'>MyCompassion "
"profile</a>? With it, you always have the pictures, letters and information of your ${child} at hand.\n"
"</p>\n"
"<p>\n"
"    Enjoy writing!\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_sponsorship_confirmation_not_read
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set child = object.get_objects().mapped('child_id')\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    We recently sent you an email to ${partner.email}, which doesn't seem to have reached you. Could you please let us "
"know if you have a different email address. If our email went to the spam folder, could you please add "
"compassion@compassion.ch to your address book? This way you will receive all the important information about $"
"{child.get('your sponsored child')} in the future.\n"
"</p>\n"
"<p>\n"
"    Below is the communication we sent you:\n"
"</p>\n"
"<span>\n"
"    $"
"{object.env.ref('partner_communication_switzerland.mail_onboarding_sponsorship_confirmation').generate_email(object.id, "
"['body_html'])['body_html'].replace(partner.salutation, '').strip().replace('&lt;p&gt;&lt;/p&gt;', '') | safe}\n"
"</span>\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_wrpr_reminder
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set children = object.get_objects().mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29 or not partner.title.id\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    A few months ago, you decided to support ${firstname} through our “Write & Pray” sponsorship.\n"
"</p>\n"
"<p>\n"
"    The special feature of a “Write & Pray” sponsorship is teamwork.\n"
"</p>\n"
"<p>\n"
"    You are known to ${firstname} as ${children.get('his')} ${'sponsors' if plural else 'sponsor'}. Another donor "
"regularly provides the financial support for this type of sponsorship.\n"
"</p>\n"
"<p>\n"
"    We are counting on you to pray for ${children.get('him')} and write to ${children.get('him')} at least twice a "
"year.\n"
"</p>\n"
"<p>\n"
"    So far, our records indicate that ${firstname} ${'has' if len(children) == 1 else 'have'} not received a letter from "
"you.\n"
"</p>\n"
"<p>\n"
"    Thank you for taking a few minutes of your time to write a letter to ${children.get('him')}, online via <a "
"href=\"https://mycompassion.ch/my/letter\">MyCompassion</a>.\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.signature | safe}\n"
"</p>"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.wrpr_transformation_fail
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set children = object.get_objects().mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', translate=False)\n"
"    % set reminder = object.search([(\"config_id\", \"=\", object.config_id.id), (\"partner_id\", \"=\", partner.id), "
"(\"state\", \"=\", \"done\")])\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>Unfortunately, we have not received any feedback from you and will have to cancel the sponsorship for ${firstname}.\n"
"</p>\n"
"<p>We will now look for another sponsor for ${firstname}.\n"
"</p>\n"
"<p>\n"
"</p>\n"
"<p>Have you changed your mind? Then let us know as soon as possible and increase your sponsorship contribution to CHF "
"42:\n"
"<a href=\"https://mycompassion.ch/my/donations\">link</a>\n"
"</p>\n"
"<p>The joy of ${firstname} will be enormous!</p>\n"
"        "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set children = object.get_objects().mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', translate=False)\n"
"    % set reminder = object.search([(\"config_id\", \"=\", object.config_id.id), (\"partner_id\", \"=\", partner.id), "
"(\"state\", \"=\", \"done\")])\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/fr_FR/im_livechat/support/3\"\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation},\n"
"</p>\n"
"<p>Malheureusement nous n'avons pas reçu de réponse et nous devrons bientôt annuler le parrainage de ${firstname}.\n"
"</p>\n"
"<p>Nous allons chercher un autre parrain pour ${firstname}.\n"
"</p>\n"
"<p>\n"
"</p>\n"
"<p>As-tu changé d'avis? Fais-le nous savoir et augmente ta contribution à CHF 42.-:\n"
"<a href=\"https://mycompassion.ch/my/donations\">link</a>\n"
"</p>\n"
"<p>La joie de ${firstname} sera énorme!</p>\n"
"<p>Bonne journée et à bientôt!</p>\n"
"<p>L'équipe de Compassion\n"
"<br/>Tel: +41 (0)24 434 21 24\n"
"<br/>Des questions? Tchate avec nous sur MyCompassion: <a href=\"${wp_tchat_url}\">${wp_tchat_url}</a>\n"
"</p>\n"
"        "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.tax_receipt_letter_template
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set tax_year = 2024\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Last year:\n"
"</p>\n"
"<ul>\n"
"    <li>more children living in extreme poverty were sponsored from Switzerland</li>\n"
"    <li>more mothers and babies received vital support</li>\n"
"    <li>more young people were able to start vocational training</li>\n"
"    <li>more children received a present at Christmas*</li>\n"
"    <li>many families received food supplies</li>\n"
"    <li>and many children now have access to safe toilets</li>\n"
"</ul>\n"
"<p>\n"
"    thanks in no small part to your generosity and loyalty!\n"
"</p>\n"
"<p>\n"
"    Thank you from the bottom of our hearts!\n"
"</p>\n"
"<h4>Tax Receipt ${tax_year}</h4>\n"
"<p>\n"
"    We are grateful to send you the enclosed tax certificate for the donations you have made to Compassion in\n"
"    ${tax_year}. You can deduct 100% of this amount from your tax return in any Swiss canton.\n"
"</p>\n"
"<h4>Your real impact</h4>\n"
"<p>\n"
"    Discover the impact of the friends of Compassion Switzerland in ${tax_year} in the fight against extreme poverty.\n"
"    .. which is partly yours too!\n"
"</p>\n"
"<p>\n"
"    (Available in French or German)\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <div style=\"display: flex; margin:40px;text-align: center;\">\n"
"        <div style=\"flex: 1;\">\n"
"            <a href=\"https://compassion.ch/activite2024\" style=\"padding: 12px 18px; font-size: 16px; line-height: "
"18px;\n"
"            color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-"
"weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; "
"background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">votre impact en ${tax_year}</a>\n"
"        </div>\n"
"        &nbsp;&nbsp;&nbsp;\n"
"        <div style=\"flex: 1;\">\n"
"            <a href=\"https://compassion.ch/de/aktivitat2024\" style=\"padding: 12px 18px; font-size: 16px; line-"
"height:\n"
"             18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: "
"0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-"
"image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"                Deine Wirkung in ${tax_year}\n"
"            </a>\n"
"        </div>\n"
"    </div>\n"
"% else:\n"
"    <p>\n"
"        en français: impact.compassion.ch\n"
"        <br>\n"
"        auf Deutsch: impact.compassion.ch/de\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Thank you, once again, for your faithful commitment to fighting the injustice of extreme poverty. Together, you\n"
"    and other sponsors, donors and more than ${number_fcps} child development centres in ${number_countries} countries\n"
"    of the Global South are working to bring hope to an ever increasing number of children and families in need.\n"
"</p>\n"
"<p>\n"
"    Have a happy New Year, all the best and warm regards.\n"
"</p>\n"
"% if object.send_mode == 'digital':\n"
"    <p>${object.user_id.short_signature | safe}</p>\n"
"% endif\n"
"\n"
"<p style=\"font-size:10px\">\n"
"    * (The cost per gift has been revised downwards, from the CHF 15.- announced in our communications to CHF 12.60. "
"100% of your donation was invested in the gifts)\n"
"</p>\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step5
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorship = partner.sponsorship_ids\n"
"    % set child = sponsorship.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set one_child = len(child) == 1\n"
"    % set less_4 = firstname != child.get_number()\n"
"    % set translator = False\n"
"    % set event = False\n"
"    % set base_url = object.env['ir.config_parameter'].get_param('web.external.url')\n"
"\n"
"    % for engagement in partner.advocate_details_id.engagement_ids:\n"
"        % if engagement.id == 2:\n"
"            % set translator = True\n"
"        % endif\n"
"\n"
"        % if engagement.id in (1,3,9):\n"
"            % set event = True\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % set number_years = object.env[\"partner.communication.job\"].get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | "
"safe\n"
"    % set years_uc = object.env[\"partner.communication.job\"].get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.env[\"partner.communication.job\"].get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.env[\"partner.communication.job\"].get_snippet('children_in_poverty') | striptags "
"| safe\n"
"    % set early_deaths = object.env[\"partner.communication.job\"].get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.env[\"partner.communication.job\"].get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = "
"object.env[\"partner.communication.job\"].get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"<p>\n"
"    % if sponsorship.mapped('invoice_line_ids').filtered('last_payment') or 0 in sponsorship.mapped('total_amount'):\n"
"        Congratulations, your ${'sponsorship has' if one_child else 'sponsorships have'} started well! The good news has "
"reached ${firstname if less_4 else 'your sponsored children'} and ${child.get('his')} ${'family' if one_child else "
"'families'}.\n"
"    % endif\n"
"    This is the final email you will receive from us concerning the start of your sponsorship.\n"
"</p>\n"
"<p>\n"
"    Your feedback regarding the start of your sponsorship${'s' if not one_child} is important to us. It should only take "
"60 seconds.\n"
"</p>\n"
"<div style=\"margin:30px auto;text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"${base_url + object.env.ref('partner_communication_switzerland.onboarding_survey').get_start_url()}\"\n"
"       style=\"padding:12px 18px;font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-"
"decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: "
"middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid "
"#0054A6; border-radius:3px\">\n"
"        Take part in the questionnaire\n"
"    </a>\n"
"</div>\n"
"\n"
"% if not translator or not event:\n"
"    <p>\n"
"        Did you know that Compassion is a network of many actively engaged people? This network is made up of you and "
"other sponsors, Compassion staff in different countries and over ${number_fcps} local church partners in $"
"{number_countries} countries.\n"
"    </p>\n"
"    % if not translator:\n"
"        <p>\n"
"            In Switzerland, around 100 volunteers translate numerous letters from sponsors and sponsored children. Would "
"you be interested in helping us?\n"
"        </p>\n"
"    % endif\n"
"    <p>\n"
"        Many volunteers help in the fight against extreme poverty by participating at Compassion events or church "
"services or through prayer. Do you want to get involved?\n"
"    </p>\n"
"    <div style=\"margin:30px auto;text-align: center; text-transform: uppercase;\">\n"
"        <a href=\"https://compassion.ch/de/sich-mehr-engagieren/\"\n"
"           style=\"padding:12px 18px;font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-"
"decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: "
"middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid "
"#0054A6; border-radius:3px\">\n"
"            Volunteer\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"\n"
"<p>\n"
"    We would also like to present you our interactive fundraising platform TOGETHER. Here you can start your own "
"project!\n"
"</p>\n"
"<div style=\"margin:30px auto;text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://together.compassion.ch/homepage\"\n"
"       style=\"padding:12px 18px;font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-"
"decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: "
"middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid "
"#0054A6; border-radius:3px\">\n"
"        TOGETHER\n"
"    </a>\n"
"</div>\n"
"<p>\n"
"    Our heartfelt thanks for investing in the ${'life of ' + firstname if one_child else ('lives of ' + firstname if "
"less_4 else 'lives of many children')}! We wish you much joy throughout the journey.\n"
"</p>\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.signature | safe}\n"
"</p>"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step4
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorship = partner.sponsorship_ids\n"
"    % set child = sponsorship.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set less_4 = firstname != child.get_number()\n"
"    % set christmas_time = (datetime.date.today().month)\n"
"    % set restricted = namespace(field=False)\n"
"\n"
"    % for field in child.mapped('field_office_id'):\n"
"        % if field.id in (1,19):\n"
"            % set restricted.field = field.country_id.name\n"
"        % endif\n"
"    % endfor\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"<p>\n"
"    Your letters and prayers make a difference in the ${'life of your sponsored child' if one_child else 'lives of your "
"sponsored children'}!\n"
"</p>\n"
"<p>\n"
"    In a letter from her sponsors, Michelle from the Philippines read for the first time in her life the words \"You are "
"beautiful, you are precious, we love you\". Today, over 25 years later, the impact of letter exchanges with her sponsors "
"is still evident: Michelle has started an aid organisation to help victims of prostitution and human trafficking.\n"
"</p>\n"
"<p>\n"
"    Why not write a letter and send a photo to ${firstname if less_4 else 'your sponsored children'} for $"
"{child.get('him')} to get to know you better. You can write via <a href=\"https://mycompassion.ch/en_US/my/"
"letter\">MyCompassion</a>.\n"
"    % if christmas_time > 8:\n"
"        Why not send your sponsored child${'ren' if not one_child} a Christmas card now?\n"
"    % endif\n"
"</p>\n"
"<p>Do you need inspiration?</p>\n"
"<div style=\"margin:20px auto; text-align: center;\">\n"
"    <a href=\"https://compassion.ch/de/was-soll-ich-meinem-patenkind-schreiben/\" style=\"padding: 12px 18px; font-size: "
"12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-"
"bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; "
"background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        5 ideas for letter writing\n"
"    </a>\n"
"</div>\n"
"% if restricted.field:\n"
"    <p>Extra information on writing letters to your sponsored ${'child' if len(child) == 1 else 'children'}.</p>\n"
"    <div style=\"margin:20px auto; text-align: center;\">\n"
"        <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_EN.pdf\" style=\"padding: 12px 18px; "
"font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; "
"margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; "
"background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            Information about letter writing: ${restricted.field}\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"<p>\n"
"    Another important letter writing information: To ensure the protection of the children, but also for your own "
"safety, the communication between you and your sponsored child${'ren' if not one_child} must run solely through us.\n"
"</p>\n"
"<p>Please never mention:<br></p>\n"
"<ul>\n"
"    <li>Your postal address</li>\n"
"    <li>Your email address</li>\n"
"    <li>Your phone number</li>\n"
"    <li>Compassion Switzerland's address</li>\n"
"    <li>Your Facebook or other social media contact details</li>\n"
"    <li>Making promises (e.g. a gift or visit)</li>\n"
"</ul>\n"
"<p>\n"
"    It's so wonderful that you're investing in the ${'life of ' + firstname if one_child else 'lives of your sponsored "
"children'}!\n"
"</p>\n"
"<p>Warm regards,</p>\n"
"<p>${object.user_id.signature | safe}</p>\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_zoom_reminder
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set zoom = object.get_objects()\n"
"    % set child = partner.sponsorship_ids.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set less_4 = firstname != child.get_number()\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"<p>\n"
"    The next video conference for new sponsors is getting closer.\n"
"</p>\n"
"<p>\n"
"    You will experience what the message of a sponsorship means for a local family and you will be given more "
"information on your sponsorship.\n"
"</p>\n"
"<p>\n"
"    Have you already signed up? Don't worry, it's really straightforward!\n"
"</p>\n"
"<p>\n"
"    Sign up here: ${zoom.get_date('date_start', 'dd. MMMM')} um ${zoom.get_date('date_start', 'HH:mm')}.\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://mycompassion.ch/de_DE/zoom/register\" style=\"padding: 12px 18px; font-size: 14px; line-height: "
"18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-"
"weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; "
"background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Registration Video Conference\n"
"    </a>\n"
"</div>\n"
"<p>\n"
"    We look forward to welcoming/seeing you!\n"
"</p>\n"
"<p>\n"
"    Thank you for investing in the life of ${firstname} and ${child.get('his')} ${'family' if one_child else "
"'families'}. Together we are changing the world. One child at a time.\n"
"</p>\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.signature | safe}\n"
"<br>\n"
"</p>\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_step3
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorship = partner.sponsorship_ids\n"
"    % set child = sponsorship.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation},\n"
"</p>\n"
"<p>\n"
"    This is the third of five emails that you will receive from us.\n"
"</p>\n"
"<p>\n"
"    What does poverty mean in the life of your sponsored child${'ren' if not one_child}?\n"
"</p>\n"
"<p>\n"
"    The causes and effects of poverty can differ depending on the context.\n"
"</p>\n"
"<p>\n"
"    Compassion is active in areas where life is extremely difficult. Be it in Central America, where families live with "
"the danger of gang violence on a daily basis; Africa, where diseases, alcohol, drugs dominate every day life; or Asia, "
"where children are threatened with prostitution or child labour.\n"
"</p>\n"
"<p>\n"
"    Every child deserves to be able to go to school, be protected and experience a childhood filled with hope for the "
"future.\n"
"</p>\n"
"<p>\n"
"    This is an important part of Compassion's work. <b>A sponsorship protects a child from child labour and other forms "
"of slavery, particularly from gang violence and forced marriage.</b>\n"
"</p>\n"
"<p>\n"
"    Together we can protect children!\n"
"</p>\n"
"<div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"    <a href=\"https://compassion.ch/de/kinderschutz\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; "
"color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: "
"400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; "
"background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        More information on child protection\n"
"    </a>\n"
"</div>\n"
"<p>\n"
"    Warm regards,\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.signature | safe}\n"
"</p>\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_wrpr_volunteering
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set firstname = sponsorships.mapped('child_id').get_list('preferred_name', 3, deine + 'n Patenkindern', False)\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set deine_patenkinder = 'deine Patenkinder' if not plural else 'eure Patenkinder'\n"
"    % set my_url = \"https://stage.compassion.ch/my/home\" if partner.user_ids.login_date else partner.signup_url\n"
"    % set chat_url = my_url if partner.user_ids.login_date else \"https://stage.compassion.ch/im_livechat/support/2\"\n"
"</div>\n"
"<p>7/8:\n"
"<br/>${partner.salutation}\n"
"</p>\n"
"<p>Wir gratulieren ${dir} zum erfolgreichen Beginn ${deine}r ${child.get('Patenschaft')}! ${\"Möchtet ihr euch\" if "
"plural else \"Möchtest du dich\"} noch mehr engagieren, z.B. bei Events, mit Übersetzungen oder im Gebet? Oder sogar $"
"{dein} eigenes Projekt starten und ${deine} Familie und Freunde mobilisieren? Hier ${\"findet ihr\" if plural else "
"\"findest du\"} mehr Informationen dazu: <a href=\"https://compassion.ch/de/sich-mehr-engagieren\">https://compassion.ch/"
"de/sich-mehr-engagieren</a>\n"
"</p>\n"
"<p>Wir freuen uns sehr, mit ${dir} zusammen unterwegs zu sein.\n"
"</p>\n"
"<p>Liebe Grüsse<br/>\n"
"Sarah<br/>\n"
"Tel: +41 (0)31 552 21 21<br/>\n"
"Fragen? <a href=\"${chat_url}\">${chat_url}</a>\n"
"</p>\n"
"        "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set firstname = sponsorships.mapped('child_id').get_list('preferred_name', 3, deine + 'n Patenkindern', False)\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set deine_patenkinder = 'deine Patenkinder' if not plural else 'eure Patenkinder'\n"
"% set my_url = \"https://mycompassion.ch/fr_CH/my/home\" if partner.user_ids.login_date else partner.signup_url\n"
"% set chat_url = \"https://mycompassion.ch/fr_CH/im_livechat/support/3\"\n"
"</div>\n"
"<p>\n"
"Salut ${partner.firstname or partner.name},\n"
"</p>\n"
"<p>Félicitations, ${\"ton parrainage\" if len(child) == 1 else \"tes parrainages\"} Write&Pray ${\"a\" if len(child) == "
"1 else \"ont\"} bien commencé.</p>\n"
"<p>Aimerais-tu t'impliquer davantage, par exemple lors d’événements, en traduisant des lettres aux/des filleuls ou par "
"la prière? Tu peux même lancer ton propre projet et mobiliser ta famille et tes amis pour les enfants démunis. Tu "
"trouveras plus d'informations ici: <a href=\"https://compassion.ch/participer/\">https://compassion.ch/participer/</a>\n"
"</p>\n"
"<p>Nous sommes très heureux de faire une différence dans le monde avec toi.\n"
"</p>\n"
"<p>Bonne journée et à bientôt!\n"
"<br/>L'équipe de Compassion\n"
"<br/>Tel: +41 (0)24 434 21 24\n"
"<br/>Des questions? <a href=\"${chat_url}\">${chat_url}</a>\n"
"</p>"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_wrpr_poverty
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set firstname = sponsorships.mapped('child_id').get_list('preferred_name', 3, deine + 'n Patenkindern', False)\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set deine_patenkinder = 'deine Patenkinder' if not plural else 'eure Patenkinder'\n"
"    % set country = child.mapped('field_office_id')\n"
"    % set alumni_name = country.get_list('alumni_representative')\n"
"    % set alumni_link = country.get_list('alumni_video_link', 1, 'https://vimeo.com/showcase/geschichten-ehemaliger-"
"patenkinder-von-compassion')\n"
"    % set multi_link = alumni_link == 'https://vimeo.com/showcase/geschichten-ehemaliger-patenkinder-von-compassion'\n"
"    % set my_url = \"https://stage.compassion.ch/my/home\" if partner.user_ids.login_date else partner.signup_url\n"
