"    <t t-set=\"deine\" t-value=\"&#x27;eure&#x27; if plural else &#x27;deine&#x27;\"/>\n"
"    <t t-set=\"firstname\" t-value=\"sponsorships.mapped(&#x27;child_id&#x27;).get_list(&#x27;preferred_name&#x27;, 3, deine + &#x27;n Patenkindern&#x27;, False)\"/>\n"
