#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_anniversary_10
msgid ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   Can you believe it‘s been 10 years since you have been sponsoring ${firstname}? Congratulations for your wonderful "
"commitment!\n"
"   <br>\n"
"   <br>\n"
"   Through your dedication, the life of ${firstname} has already changed tremendously. After more than 70 years of "
"experience with child sponsorships, we know that long-term commitment brings lasting sustainable benefits. $"
"{object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   We thank you greatly for believing with us that poverty does not have to be predestined. And that the life of a "
"child, their family and the local community will change if we invest in a child‘s life.\n"
"   <br>\n"
"   <br>\n"
"   With Warmest Regards,\n"
"  </p>\n"
" % if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_anniversary_15
msgid ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   This year, we would like to celebrate a special event with you: 15 years ago, you decided to change a life forever. "
"You decided to sponsor ${firstname}. much has been accomplished since then.\n"
"   <br>\n"
"   <br>\n"
"   Your loyalty, your generous support and your contact in their lives will continue to change the life of ${firstname} "
"drastically and in a sustainable way.\n"
"   <br>\n"
"   <br>\n"
"   We would like to thank you from our hearts for your commitment. Together with you and many sponsors, we are in the "
"process of releasing 2,3 million children from extreme poverty.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"   <br>\n"
