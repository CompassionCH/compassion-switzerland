#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_wrpr_welcome
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set firstname = sponsorships.mapped('child_id').get_list('preferred_name', 3, deine + 'n Patenkindern', False)\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
" % set my_url = \"https://stage.compassion.ch/im_livechat/support/2\"\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>So schön, ${\"ihr gehört\" if plural else \"du gehörst\"} nun zur weltweiten Compassion-Familie! Herzlich wilkommen!\n"
"</p>\n"
"<p>${\"Erfahrt\" if plural else \"Erfahre\"} hier mehr dazu: <a href=\"https://vimeo.com/710323229/b9f3f472c5\">https://"
"vimeo.com/710323229/b9f3f472c5</a>\n"
"</p><div>\n"
"% if sum(sponsorships.mapped('total_amount')) and partner in sponsorships.mapped('partner_id'):\n"
"    <p>Damit ${\"ihr eure\" if plural else \"du deine\"} Spende für die ${sponsorships.get('Patenschaft')} einrichten $"
"{\"könnt, findet ihr\" if plural else \"kannst, findest du\"} hier den Einzahlungsschein: <a href=\"https://"
"stage.compassion.ch/report/pdf/report_compassion.single_bvr_sponsorship/${str(sponsorships[:1].id)}\">Einzahlungsschein</"
"a>\n"
"        % if partner.parent_consent == 'not_submitted':\n"
"<br/>und die Einverständniserklärung, die wir von ${deine}n Eltern unterschrieben benötigen:\n"
"<a href=\"https://stage.compassion.ch/partner_compassion/static/src/img/parental_consent_de_DE.pdf\">https://"
"stage.compassion.ch/partner_compassion/static/src/img/parental_consent_de_DE.pdf</a>\n"
"         % endif\n"
"    </p>\n"
"% endif\n"
"</div><p>In den kommenden Tagen werden wir ${dir} weitere wichtige Informationen zum Start der $"
"{sponsorships.get('Patenschaft')} per SMS zukommen lassen. Heute sind wir bei Schritt 1/8.\n"
"</p>\n"
"<p>Liebe Grüsse\n"
"<br/>Sarah\n"
"<br/>Tel: +41 (0)31 552 21 21\n"
"<br/>Fragen? ${\"Meldet ihr\" if plural else \"Melde dich\"} per Chat bei uns: <a href=\"${my_url}\">${my_url}</a>\n"
"</p>\n"
"        "
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_zoom_link
msgid ""
"<div>\n"
"    % set session = object.get_objects()\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you for registering for the video conference for new sponsors. We look forward to meeting you online on\n"
"    ${session.get_date('date_start', 'dd. MMMM')}, showing you what your sponsorship is doing, and answering your\n"
"    questions.\n"
"</p>\n"
"<p>\n"
"    Here is the link to attend the meeting at ${session.get_date('date_start', 'HH:mm')}: ${session.link}\n"
"</p>\n"
"<p>\n"
"    We'll be happy if you turn on the camera at the beginning of the meeting so we can see you. You can also turn\n"
"    it off afterwards if you prefer. The sound quality is best if all participants mute their microphone when they are\n"
"    not speaking.\n"
"</p>\n"
"<p>\n"
"    You can log in ten minutes before the meeting starts. If you have any technical questions, please feel free to\n"
"    contact me in advance.\n"
"</p>\n"
"<p>\n"
"    Warm regards and see you soon!\n"
"</p>\n"
"<div>\n"
"    ${object.user_id.signature | safe}\n"
"</div>\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.mail_onboarding_zoom_registration_confirmation
msgid ""
"<div>\n"
"    % set session = object.get_objects().zoom_session_id\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you for your interest in the informational and sharing video conference for new sponsors.\n"
"</p>\n"
"<p>\n"
"    The meeting will take place on ${session.get_date('date_start', 'dd. MMMM')} at ${session.get_date('date_start',\n"
"    'HH:mm')}.\n"
"</p>\n"
"<p>\n"
"    We will send you all the information regarding the connection to this meeting a few days before by email or will\n"
"    inform you in case you have chosen a later date.\n"
"</p>\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"<div>\n"
"    ${object.user_id.signature | safe}\n"
"</div>\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_birthday_reminder
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set He = child.get('He')\n"
"    % set he = child.get('he')\n"
"    % set his = child.get('his')\n"
"    % set him = child.get('him')\n"
"    % set age = child.age + 1\n"
"    % set month = child.get_date('birthdate', 'date_month')\n"
"    % set hold_gifts = child.get_hold_gifts()\n"
"    % set partner = object.partner_id\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set already_paid = sponsorships.mapped('birthday_paid')\n"
"    % set paid_date = already_paid and already_paid[0] and already_paid[0].get_date('date_partner_paid', 'date_full')\n"
"    % set send_gifts_to = sponsorships.mapped(sponsorships[0].send_gifts_to)[0]\n"
"    % set does_write = partner == sponsorships[0].correspondent_id and 23 not in partner.category_id.ids\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    It's ${firstname}'s birthday on ${month}.\n"
"</p>\n"
"<p>\n"
"    ${child.get('He')} will be ${age} years old this year.\n"
"</p>\n"
"<p>\n"
"    We invite you to write a few words of encouragement to ${him} online via <a href=\"https://"
"www.mycompassion.ch\">MyCompassion</a>.\n"
"</p>\n"
"<p>\n"
"    Imagine the joy when ${he} receives a letter from you!*\n"
"</p>\n"
"\n"
"% if not hold_gifts and not already_paid and send_gifts_to == partner:\n"
"    <p>\n"
"        If you would also like to give ${firstname} a present, you can do so using the attached payment slip or <a "
"href=\"https://compassion.ch/de/geschenkformular\">online</a>.*\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Thank you for making a difference in ${firstname}'s life.\n"
"</p>\n"
"<p>\n"
"    Kind regards\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.short_signature | striptags}\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    *It is possible that this message crossed with your letter or donation.\n"
"</p>\n"
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_wrpr_dossier
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set partner = object.partner_id\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) !"
"= len(sponsorships)\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation},\n"
"    <br>\n"
"    <br>\n"
"    Welcome to the Compassion Family!\n"
"    <br>\n"
"    <br>\n"
"    Thank you for your commitment to ${'another ' if sponsorships.mapped('parent_id') or "
"len(object.partner_id.sponsorship_ids) != len(sponsorships) else ''}child in poverty. You have made a great decision! "
"You will be changing the life of ${firstname} ${child.get('his')} family.\n"
"    <br>\n"
"    <br>\n"
"    In a few days time, ${firstname} will learn that ${child.get('he')} ${child.get('has')} a sponsor. It will be a day "
"of joy for ${child.get('him')} and ${child.get('his')} family.\n"
"    <br>\n"
"    <br>\n"
"    So that the sponsorship runs smoothly, enclosed you will find some important information and documents to help you "
"get started:\n"
"    <br>\n"
"</p>\n"
"<ul>\n"
"    <li>\n"
"        1 photo of your sponsored child\n"
"    </li>\n"
"    <li>\n"
"        1 dossier with practical information about this sponsorship\n"
"        <br>\n"
"    </li>\n"
"    <li>\n"
"        1 letter template so that you can introduce yourself to the child\n"
"        <br>\n"
"    </li>\n"
"    <li>\n"
"        1 sheet of labels to use each time you write letters to the child (1 label each with a reference number to "
"whatever you send-- each letter, card, drawing, booklet, etc.)\n"
"        <br>\n"
"    </li>\n"
"</ul>\n"
"<p>\n"
"    The special feature of a “Write &amp; Pray” sponsorship is teamwork. The sponsored child will come to know you as $"
"{child.get('his')} sponsor.  We are depending on you to pray for the child and to write to ${child.get('him')} at least "
"2x per year while another donor provides the ${'missing ' if payer else ''}financial support for ${child.get('the "
"child')}.\n"
"    <br>\n"
"    <br>\n"
"    We wish you and ${firstname} much joy and blessing in corresponding with one another!\n"
"    <br>\n"
"    <br>\n"
"    If you have any questions, please do not hesitate to contact us.\n"
"    <br>\n"
"    <br>\n"
"    Best regards,\n"
"</p>\n"
" "
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.csp_mail_template
msgid ""
"<div>\n"
"   % set contracts = object.get_objects()\n"
"                    \n"
"% set partner = object.partner_id\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you to support a child survival program from Compassion.\n"
"   <br>\n"
"   <br>\n"
"   From pregnancy through infanthood, Child Survival offers help that moms and babies desperately need to survive and "
"thrive. More than 64,598 moms and babies have been helped to date! Through our Child Survival Centers, we ensure mothers "
"and babies receive any of the following:\n"
"   <br>\n"
"  </p>\n"
"  <ul>\n"
"   <li>\n"
"    Basic Nutrition in the form of clean water, healthy food and vitamins.\n"
"   </li>\n"
"   <li>\n"
"    Pre-natal and post-natal medical exams to monitor mom and baby’s health.\n"
"   </li>\n"
"   <li>\n"
"    Critical medical resources such as child birth assistance.\n"
"   </li>\n"
"   <li>\n"
"    Monthly growth monitoring to protect the children from malnutrition.\n"
"   </li>\n"
"   <li>\n"
"    Immunizations and other medical care for newborns and babies.\n"
"   </li>\n"
"   <li>\n"
"    Mentoring from a survival specialist that gives one-on-one coaching and support.\n"
"   </li>\n"
"   <li>\n"
"    Opportunities for infants to learn cognitive skills.\n"
"   </li>\n"
"   <li>\n"
"    Workshops that teach mothers parenting and survival skills.\n"
"   </li>\n"
"   <li>\n"
"    Home visits to check in on mother and baby.\n"
"   </li>\n"
"   <li>\n"
"    Emotional support from a community of moms facing the same fears.\n"
"   </li>\n"
"  </ul>\n"
"  Each Child Survival Center is staffed with warm, caring, knowledgeable individuals that serve mothers and babies "
"extremely well. Your donations give children under 1 year old a head start toward a healthy life!\n"
"  <br>\n"
"  <br>\n"
"  There is no correspondence with the mothers, nevertheless you will receive a newsletter with information about the "
"program and testimonies from mothers.\n"
"  <br>\n"
"  <br>\n"
"  Please do not hesitate to contact us if you have any questions.\n"
"  <br>\n"
"  <br>\n"
"  Sincerely\n"
" "
msgstr ""
"<p>\n"
"  </p>\n"
"  <div>\n"
"                    \n"
"% set partner = object.partner_id\n"
"   % set contracts = partner.other_contract_ids\n"
"% set christmas_fund_2022 = 265 in partner.category_id.ids\n"
"  </div>\n"
" <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Merci de tout cœur pour votre décision de soutenir notre programme d'entraide pour mamans et tout-petits (CSP). Ces "
"centres accueillent spécialement des mères et leurs enfants ainsi que des femmes enceintes vivants dans l’extrême "
"pauvreté. De nombreuses enquêtes démontrent que la première année est déterminante dans la vie d’un enfant.\n"
"   <br>\n"
"   <br>\n"
"   Dans ces centres, les bébés et les mères bénéficient de:\n"
"  </p>\n"
"  <ul>\n"
"   <li>\n"
"    nourriture et vitamines\n"
"   </li>\n"
"   <li>\n"
"    contrôles médicaux pédiatriques\n"
"   </li>\n"
"   <li>\n"
"    contrôles mensuels, pour prévenir la malnutrition\n"
"   </li>\n"
"   <li>\n"
"    vaccinations et soins médicaux pour les nouveau-nés (jusqu’à l’âge d’un an)\n"
"   </li>\n"
"   <li>\n"
"    accompagnement spirituel et coaching pour les mères et les femmes enceintes\n"
"   </li>\n"
"   <li>\n"
"    soutien au développement cognitif des bébés\n"
"   </li>\n"
"   <li>\n"
"    ateliers éducatifs pour les mères\n"
"   </li>\n"
"   <li>\n"
"    encouragements par d’autres mères\n"
"   </li>\n"
"   <li>\n"
"    visites à la maison des mamans\n"
"   </li>\n"
"  </ul>\n"
"  Nous vous remercions pour votre générosité. Grâce à vous, tout est mis en œuvre pour que le début de la vie de ces "
"bébés se passe bien. Une source d’espoir et de réconfort pour de nombreuses mères dans le besoin.\n"
"  <br>\n"
"  <br>\n"
"  Une à deux fois par an, vous recevrez des nouvelles et des témoignages des programmes pour mamans et tout-petits "
"soutenus par les donateurs de Compassion Suisse.\n"
"  <br>\n"
"  <br>\n"
"  Au Nicaragua, Cynthia n'avait que quatorze ans lorsqu'elle a appris qu'elle était enceinte. Si aujourd'hui ses parents "
"sont d'heureux grands-parents, il n'en n'a pas été ainsi lorsqu'ils ont appris la nouvelle. C'est à Compassion que "
"l'adolescente a été accueillie, soutenue et encouragée.\n"
"  <br>\n"
"  <br>\n"
"  Encore une fois, merci de votre engagement pour libérer chaque jour plus d'enfants de l'extrême pauvreté.\n"
"  <br>\n"
"  <br>\n"
"  Chaleureusement.\n"
"  <br>\n"
"% set sponsorships = partner.sponsorship_ids.filtered('is_active')\n"
"  <p>\n"
"   <br>\n"
"  </p>\n"
" "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_birthday_1day_reminder
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"\n"
"% set sponsorships = object.get_objects()\n"
"\n"
"% set child = sponsorships.mapped('child_id')\n"
"\n"
"% set name = child.get_list('preferred_name', translate=False)\n"
"\n"
"% set one = len(child) == 1\n"
"\n"
"% set letters = object.env['correspondence'].search([('sponsorship_id', 'in', sponsorships.ids), ('scanned_date', '>=', "
"(datetime.datetime.now() - relativedelta(months=3)).strftime('%Y-%m-%d')), ('direction', '=', 'Supporter To "
"Beneficiary')])\n"
"\n"
"% set month = child.get_date('birthdate', 'date_month')\n"
"\n"
"% set already_paid = sponsorships.mapped('birthday_paid')\n"
"\n"
"% set paid_date = already_paid and already_paid[0] and already_paid[0].get_date('date_partner_paid', 'date_full')\n"
"\n"
"% set hold_gifts = child.get_hold_gifts()\n"
"\n"
"% set send_gifts_to = sponsorships.mapped(sponsorships[0].send_gifts_to)[0]\n"
"\n"
"% set does_write = partner == sponsorships[0].correspondent_id and 23 not in partner.category_id.ids\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Tomorrow, it’s ${child.get('your sponsored child')} ${name}'s birthday! Thanks to your sponsorship, ${name} has been "
"able to enjoy another year at the project.\n"
"   <br>\n"
"   <br>\n"
"   % if does_write and not letters:\n"
"\tIf you haven’t sent a greeting yet, would you be willing to send ${child.get('him')} some birthday wishes? A few "
"heartfelt and appreciative words encourage the children greatly and demonstrates that they are valuable.  You can write "
"him online at:\n"
"   <a href=\"https://my.compassion.ch/r/fVN?email=${partner.email}&pname=${partner.name}&sponsor_ref=${partner.ref}"
"&child_ref=${child.local_id if len(child) == 1 else ''}\">\n"
"    www.compassion.ch/ecrire\n"
"   </a>\n"
"   <br>\n"
"   <br>\n"
"   % endif \n"
" \n"
"% if not hold_gifts and not already_paid and send_gifts_to == partner:\n"
"\tDid you know you can also send a birthday present to ${name}? If you would like, you can still\n"
"   <a href=\"https://my.compassion.ch/r/njq?fund_code=Anniversaire&last_name=${partner.lastname}&first_name=$"
"{partner.firstname}&street=${partner.street}&zipcode=${partner.zip}&city=${partner.city}&email=${partner.email}"
"&child_ref=${child.local_id if len(child) == 1 else ''}&country=${partner.country_id.name}\">\n"
"    send your sponsored child a birthday present\n"
"   </a>\n"
"   (between 20.-100 CHF.-maximum).  Together, with an employee from the project who knows ${name} well; a useful present "
"or presents will be chosen and purchased. Just imagine the joy on their face in a few months when they realize you have "
"sent them a birthday gift!\n"
"   <br>\n"
"   <br>\n"
"   % endif \n"
"   Thank you for investing in the life of ${name}. In partnership with you and more than one million sponsors worldwide, "
"the lives of 2 million children living in extreme poverty are being transformed. Michelle in the Philippines, who now "
"runs her own NGO to help victims of human trafficking, is one example of many other former sponsored children who are "
"now changing the lives of many other children.\n"
"   <br>\n"
"   <br>\n"
"   Thanks again for your generous commitment.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"   <br>\n"
"   <br>\n"
"   Carole Rochat\n"
"   <br>\n"
"   Sponsor and Donor services\n"
"   <br>\n"
"   Compassion Switzerland\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"   % set partner = object.partner_id\n"
"\n"
"% set sponsorships = object.get_objects()\n"
"\n"
"% set child = sponsorships.mapped('child_id')\n"
"\n"
"% set name = child.get_list('preferred_name', translate=False)\n"
"\n"
"% set one = len(child) == 1\n"
"\n"
"% set letters = object.env['correspondence'].search([('sponsorship_id', 'in', sponsorships.ids), ('scanned_date', '>=', "
"(datetime.datetime.now() - relativedelta(months=3)).strftime('%Y-%m-%d')), ('direction', '=', 'Supporter To "
"Beneficiary')])\n"
"\n"
"% set month = child.get_date('birthdate', 'date_month')\n"
"\n"
"% set already_paid = sponsorships.mapped('birthday_paid')\n"
"\n"
"% set paid_date = already_paid and already_paid[0] and already_paid[0].get_date('date_partner_paid', 'date_full')\n"
"\n"
"% set hold_gifts = child.get_hold_gifts()\n"
"\n"
"% set send_gifts_to = sponsorships.mapped(sponsorships[0].send_gifts_to)[0]\n"
"\n"
"% set does_write = partner == sponsorships[0].correspondent_id and 23 not in partner.category_id.ids\n"
"    </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"  </p>\n"
"  <p>\n"
"   Demain, ${child.get('your sponsored child')} ${name} ${child.get('has')} ${child.get('son')} anniversaire\n"
"% if one:\n"
"\tet aura ${child.age +1} ans\n"
"% endif \n"
" ! Grâce à votre parrainage, ${child.get('he')} ${child.get('has')} pu participer durant une année de plus aux activités "
"du centre de développement de l'enfant.\n"
"   </p>\n"
"  <p>\n"
"   % if does_write and not letters:\n"
"\tPrenez donc quelques minutes pour lui souhaiter un joyeux anniversaire et lui adresser quelques mots d'appréciation et "
"d'encouragement. Vous pouvez lui écrire directement en ligne sur\n"
"   <a href=\"https://mycompassion.ch/fr_CH/my/letter\">\n"
"    MyCompassion.ch\n"
"   </a>\n"
"   ou depuis notre\n"
"   <a href=\"https://compassion.ch/app\">\n"
"    application mobile.\n"
"   </a>\n"
"   Les deux plate-formes vous permettent d'avoir toujours à portée de main les photos, les lettres et les informations "
"de ${child.get('your sponsored child')}.\n"
"  </p>\n"
"  <p>\n"
"   % endif \n"
"\n"
"% if not hold_gifts and not already_paid and send_gifts_to == partner:\n"
"\tUne autre façon de marquer cet anniversaire, c'est de lui financer un cadeau d'anniversaire à l'aide du bulletin de "
"versement ci-joint ou directement en ligne:\n"
"<a href=\"https://compassion.ch/offrir?${partner.with_context(mailchimp_child=child).wordpress_form_data}\">\n"
"    www.compassion.ch/offrir.\n"
"   </a>\n"
"   </p>\n"
"  <p>\n"
"   % endif \n"
"       Merci d'investir dans la vie de ${name} et de changer ainsi sa vie durablement.\n"
" </p>\n"
"  <p>\n"
"   Chaleureusement,\n"
"   </p>\n"
" ${object.user_id.short_signature | safe}\n"
"<br>\n"
"  <p>\n"
"   * Cette communication s'est probablement croisée avec une lettre/carte de voeux ou encore un don pour un cadeau "
"d'anniversaire de votre part. Dans ce cas, ignorez tout simplement ce courrier. Merci!\n"
"  </p>\n"
" "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_invalid_email
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"   \n"
"% set sponsorships = partner.sponsorship_ids\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   % if sponsorships:\n"
"\tThank you for investing in the life of ${sponsorships.get_list('preferred_name', translate=False)} with a "
"sponsorship.\n"
"\t% else:\n"
"\tThank you for your concern for children living in extreme poverty.\n"
"% endif\n"
"   <br>\n"
"   <br>\n"
"   We have sent you an e-mail to the following address: ${partner.email or ''} . Unfortunately, it seems to not have "
"reached you. Have you changed your email address or did the email end up in your spam?\n"
"   <br>\n"
"   <br>\n"
"   May we ask you to contact us to give us your new email address or that you add \"info@compassion\" to your contact "
"list, in case the email reached you? You can reach us by phone at 031 552 21 21 or write us to info@compassion.ch.\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment. Together we are able to tranform the lives of currently 2 million children "
"in 25 countries in a sustainable way.\n"
"   <br>\n"
"   <br>\n"
"   Sincerely,\n"
"   <br>\n"
"   <br>\n"
"   PS: Do you already have the Compassion app? With it you always have your sponsored child's pictures, letters and all "
"information at hand. And the letter writing is made even easier. Download here: www.compassion.ch/app\n"
"   <br>\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"    <br>\n"
"    <br>\n"
"    % if partner.has_sponsorships:\n"
"        Merci d’investir dans la vie d'enfants vivant dans l'extrême pauvreté.\n"
"    % else:\n"
"        Merci pour votre engagement pour les enfants vivant dans l'extrême pauvreté.\n"
"    % endif\n"
"    <br>\n"
"    <br>\n"
"    Nous vous avons adressé une communication par mail à l'adresse ${partner.invalid_mail or partner.email}. Avez-vous "
"changé d'adresse mail ou serait-il arrivé dans vos courriels indésirables (spam)?\n"
"    <br>\n"
"    <br>\n"
"    Pourriez-vous nous communiquer une adresse e-mail valide ou ajouter dans vos contacts l'adresse "
"«info@compassion.ch».\n"
"    <br>\n"
"    <br>\n"
"    Encore une fois, merci de tout cœur de votre engagement avec Compassion. Ensemble la vie de ${number_children} "
"millions d'enfants démunis est transformée de façon durable.\n"
"    <br>\n"
"    <br>\n"
"    Avec nos salutations les meilleures,\n"
"</p>"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_address_change
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"                    \n"
"% set address = partner.short_address\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the lives of children in extreme poverty.\n"
"   <br>\n"
"   <br>\n"
"   We have sent you mail to the following address:\n"
"   <br>\n"
"   <br>\n"
"   ${address |safe}\n"
"   <br>\n"
"   <br>\n"
"   Unfortunately, the letter did not reach you. Have you moved? If so, we would be pleased if you could tell us your new "
"address.\n"
"   <br>\n"
"   <br>\n"
"   Your support of children in extreme poverty is valuable.\n"
"   <br>\n"
"   <br>\n"
"   At Compassion, we believe that you are giving them the chance to live a dignified and meaningful life. $"
"{object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can positively transform the lives of currrently more "
"than 2 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Sincerely,\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"   ${object.user_id.preferred_name} ${object.user_id.lastname}\n"
"   <br>\n"
"   ${object.user_id.employee_ids.department_id.name}\n"
"   <br>\n"
"   ${object.user_id.company_id.address_name}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id   \n"
"    % set address = partner.short_address\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Malheureusement, le courrier que nous vous avons envoyé à l'adresse suivante est revenu en retour: \n"
"</p>\n"
"<p>\n"
"    ${address |safe}\n"
"</p>\n"
"<p>\n"
"    Avez-vous déménagé ?\n"
"</p>\n"
"<p>\n"
"    D'avance merci de nous communiquer votre nouvelle adresse. \n"
"</p>\n"
"<p>\n"
"    Merci d'investir dans la vie des enfants vivant dans la pauvreté. Ensemble, nous sommes en train de changer "
"durablement  la vie de plus de ${number_children} millions d'enfants dans ${number_countries} pays.\n"
"</p>\n"
"<p>\n"
"    Avec nos chaleureuses salutations et à bientôt.\n"
"</p>\n"
"% if object.send_mode == 'digital':\n"
"    ${object.user_id.signature | safe}\n"
"% endif"

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.sms_confirmation_email_2
msgid ""
"<div>\n"
"   % set sponsorship = object.get_objects()\n"
"                    \n"
"% set child = sponsorship.child_id\n"
"% set transaction_done = sponsorship.state == 'active'\n"
"  </div>\n"
"  <p>\n"
"   Hello,\n"
"   <br>\n"
"   <br>\n"
"   Thank you for your commitment towards ${child.preferred_name}.\n"
"% if not transaction_done:\n"
"Now that all information is completed, we will activate your sponsorship. ${child.preferred_name} will be informed as "
"soon as you pay your first donation.\n"
"% endif\n"
"   <br>\n"
"   <br>\n"
"   You will receive more documentation by post in the coming days. In the mean time, feel free to reach us if you have "
"any question.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"    Carole Rochat\n"
"    <br>\n"
"    Sponsor and Donor services\n"
"    <br>\n"
"    Compassion Switzerland\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.sms_reminder_email
msgid ""
"<div>\n"
"   % set sponsorship = object.get_objects()\n"
"                    \n"
"% set partner = sponsorship.partner_id\n"
"                    \n"
"% set child = sponsorship.child_id\n"
"                    \n"
"% set url = \"%s/child/%s/sponsor/confirmation?face_reveal=1\" % (partner.get_base_url(), child.id)\n"
"  </div>\n"
"  <p>\n"
"   Hello,\n"
"  </p>\n"
"  <p>\n"
"   3 days ago, you chose to invest in the life of ${child.preferred_name}.\n"
"   <br>\n"
"   <br>\n"
"   There are 2 steps left before ${child.get('he')} will be informed that you sponsor $"
"{child.get('him')}.                    Please consider finishing your request&nbsp;and you will begin to release&nbsp;$"
"{child.preferred_name} from poverty, for a purposeful life.\n"
"   <br>\n"
"   <br>\n"
"   1.\n"
"   <a href=\"${url}\" style=\"color:#0055A6;text-decoration: underline;\">\n"
"    Click here\n"
"   </a>\n"
"   to complete your information and your payment option.\n"
"   <br>\n"
"   2. Your sponsorship will be activated when we receive your first payment.\n"
"   <br>\n"
"   <br>\n"
"   In the unlikely case you don't want to sponsor this child anymore, please contact us quickly by e-mail or by phone at "
"031 552 21 25. We will then try to find another sponsor for ${child.preferred_name}.\n"
"  </p>\n"
"  <p>\n"
"   A sponsorship changes a child's life forever. Michelle has grown in extrem poverty in the Philippines. She has been "
"sponsored and created her own NGO to rescue human trafic victims.\n"
"   <br>\n"
"   <br>\n"
"   Best regards\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"    Carole Rochat\n"
"    <br>\n"
"    Sponsor and Donor services\n"
"    <br>\n"
"    Compassion Switzerland\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_welcome_activation
msgid ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"                    \n"
"% set partner = object.partner_id\n"
"                    \n"
"% set intro = 'a child' if len(partner.sponsorship_ids) == 1 else 'a new child'\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for recently deciding to become a sponsor of Compassion. Thank you for your commitment to a child in "
"extreme poverty. That’s how we change the world - one child after another.\n"
"   <br>\n"
"   <br>\n"
"   We hope you have received the information package and have had time to read through the materials so that you are "
"well-informed about your sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   On our website, www.compassion.ch, you will find many testimonies that show the effectiveness of sponsorship.\n"
"   <a href=\"https://compassion.ch/en/jennifer/\">\n"
"    For example, Jennifer\n"
"   </a>\n"
"   and further information about the program can be found under the heading, “Frequently Asked Questions (FAQ)”.  If you "
"have any questions, please do not hesitate to contact us directly.\n"
"   <br>\n"
"   <br>\n"
"   We wish you much joy with your sponsorship of ${firstname}.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"% if object.send_mode != 'physical':\n"
"   <br>\n"
"   <br>\n"
"   ${object.user_id.preferred_name}${object.user_id.lastname}\n"
"   <br>\n"
"   ${object.user_id.employee_ids.department_id.name}\n"
"   <br>\n"
"   ${object.user_id.company_id.address_name}\n"
"   <br>\n"
"   <br>\n"
"PS: Do you already have the Compassion App? With it you always have your godchild's pictures, letters and all "
"information with you. And the letter writing is made even easier. Download here: www.compassion.ch/app\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"                    % set sponsorships = object.get_objects()\n"
"                    % set child = sponsorships.mapped('child_id')\n"
"                    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"                    % set partner = object.partner_id\n"
"                </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Merci d'avoir pris la décision de parrainer un enfant récemment. Nous espérons que vous avez bien reçu le dossier de "
"parrainage de ${firstname} que Compassion Suisse vous a envoyé et que vous avez eu le temps d'en prendre connaissance. "
"Ainsi votre parrainage débutera dans les meilleures conditions possibles.\n"
"   <br>\n"
"   <br>\n"
"   Sur\n"
"   <a href=\"https://compassion.ch/news\">\n"
"    compassion.ch/news\n"
"   </a>\n"
"   vous trouverez plusieurs témoignages d'anciens enfants parrainés et sur\n"
"   <a href=\"https://compassion.ch/questions-frequentes\">\n"
"    compassion.ch/questions-frequentes\n"
"   </a>\n"
"   des réponses aux questions qui sont souvent posées sur le programme de parrainage (FAQ). Si vous avez des questions, "
"prenez donc contact avec nous!\n"
"   <br>\n"
"   <br>\n"
"   Désormais vous pouvez ${child.get('lui_leur')} écrire et ${child.get('lui_leur')} apporter un encouragement "
"personnel, élément essentiel de votre parrainage.\n"
"   <br>\n"
"   <br>\n"
"   Nous vous souhaitons beaucoup de joie dans votre engagement au profit de ${firstname}. Grâce à vous, le monde va "
"changer un peu plus, un enfant à la fois. Merci!\n"
"   <br>\n"
"   <br>\n"
"   Chaleureuses salutations.\n"
"% if object.send_mode != 'physical':\n"
"   <br>\n"
"   <br>\n"
"     ${object.user_id.short_signature | safe}\n"
"% endif \n"
"   <br>\n"
"   <br>PS : Avez-vous déjà l’app Compassion? Embarquez les photos, les lettres et toutes les informations de votre "
"filleul sur votre smartphone. Et écrivez-lui encore plus facilement. A télécharger ici : www.compassion.ch/app\n"
"  </p>\n"
" "

#. module: partner_communication_switzerland
#: model:mail.template,body_html:partner_communication_switzerland.email_sponsorship_anniversary_1
msgid ""
"<div>\n"
"   % set sponsorships = object.get_objects()\n"
"                    \n"
"% set child = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Congratulations!\n"
"   <br>\n"
"   <br>\n"
"   Now it‘s already been a year since you have gotten to know ${firstname} and supported ${child.get('him')} as a "
"sponsor.\n"
"   <br>\n"
"   <br>\n"
"   Thank you for your commitment to  ${firstname}. With your help, ${child.get('his')} life has changed.\n"
"   <br>\n"
"   <br>\n"
"   Together with you as a sponsor, Compassion and 8,600 local churches; we are releasing 2.3 million children from "
"extreme poverty.\n"
"   <br>\n"
"   <br>\n"
"   Thank you!\n"
"  </p>\n"
" % if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
