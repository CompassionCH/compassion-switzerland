<odoo>
        <record id="field_office_alumni_view" model="ir.ui.view">
            <field name="name">field.office.alumni.view</field>
            <field name="model">compassion.field.office</field>
            <field
      name="inherit_id"
      ref="child_compassion.view_compassion_field_office_form"
    />
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[1]/group">
                    <group string="Alumni representative">
                        <field name="alumni_representative" />
                        <field name="alumni_gender" />
                        <field name="alumni_video_link" />
                    </group>
                </xpath>
                <field name="country_director" position="after">
                    <field name="director_gender" />
                </field>
                <xpath expr="//notebook">
                    <page string="TPL">
                        <group>
                            <group>
                                <field name="tpl_nb_fcps_with_intervention" />
                                <field name="tpl_nb_years_partnership" />
                                <field name="tpl_nb_participants" />
                            </group>
                            <group>
                                <field name="tpl_prayer" />
                                <field name="tpl_praise" />
                                <field name="tpl_looking_forward" />
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
</odoo>
