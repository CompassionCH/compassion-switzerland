<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Configuration View -->
    <record
    id="view_notification_settings_invalid_mail_form"
    model="ir.ui.view"
  >
        <field name="name">staff.notification.settings.invalid.mail.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="30" />
        <field
      name="inherit_id"
      ref="message_center_compassion.compassion_settings"
    />
        <field name="arch" type="xml">
            <xpath
        expr="//block[@name='notification_configuration']"
      >
                <setting>
                    <field name="invalid_mail_notify_ids" />
                    <field name="new_donors_user_id" />
                </setting>
                <setting string="Sponsor Video Conferences">
                    <field name="zoom_attendee_fr_id" />
                    <field name="zoom_attendee_de_id" />
                    <field name="zoom_attendee_it_id" />
                    <field name="zoom_attendee_en_id" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
