<?xml version="1.0" encoding="utf-8" ?>
<!-- T3622 Reconcile rules decoding the QR reference, after the invoice
     matching rule (exact QR reference and amount) -->
<odoo noupdate="1">
    <record id="reconcile_model_qr_funds" model="account.reconcile.model">
        <field name="name">QR reference: funds and campaigns</field>
        <field name="company_id" ref="base.main_company" />
        <field name="sequence">11</field>
        <field name="rule_type">writeoff_suggestion</field>
        <field name="auto_reconcile" eval="True" />
        <field name="match_nature">amount_received</field>
        <field name="match_partner" eval="True" />
        <field
            name="qr_type_ids"
            eval="[Command.set([ref('account_reconcile_compassion_ce.qr_type_6'), ref('account_reconcile_compassion_ce.qr_type_7')])]"
        />
    </record>
    <record id="reconcile_model_qr_gifts" model="account.reconcile.model">
        <field name="name">QR reference: gifts</field>
        <field name="company_id" ref="base.main_company" />
        <field name="sequence">12</field>
        <field name="rule_type">writeoff_suggestion</field>
        <field name="auto_reconcile" eval="False" />
        <field name="match_nature">amount_received</field>
        <field name="match_partner" eval="True" />
        <field
            name="qr_type_ids"
            eval="[Command.set([ref('account_reconcile_compassion_ce.qr_type_1'), ref('account_reconcile_compassion_ce.qr_type_2'), ref('account_reconcile_compassion_ce.qr_type_3'), ref('account_reconcile_compassion_ce.qr_type_4'), ref('account_reconcile_compassion_ce.qr_type_5')])]"
        />
    </record>
</odoo>
