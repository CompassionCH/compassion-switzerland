<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.automation.simulate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='performance']" position="before">
                <block title="Testing" name="automation_simulate_setting_container">
                    <setting
                        id="automation_simulate_setting"
                        help="Add a 'Simulate process' action on the models having automation rules or scheduled actions. Enable it only on test databases!"
                    >
                        <field name="automation_simulate_enabled" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
