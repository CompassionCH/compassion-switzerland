<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Tree View -->
    <record id="view_quality_test_tree" model="ir.ui.view">
        <field name="name">quality.test.tree</field>
        <field name="model">quality.test</field>
        <field name="arch" type="xml">
            <tree
        decoration-danger="last_run_result == 'fail'"
        decoration-success="last_run_result == 'pass'"
        decoration-muted="not last_run_date"
      >
                <field name="name" />
                <field name="department_id" />
                <field name="responsible_id" widget="many2one_avatar_user" />
                <field name="last_run_date" />
                <field name="last_run_result" />
                <field name="run_count" string="# Runs" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_quality_test_form" model="ir.ui.view">
        <field name="name">quality.test.form</field>
        <field name="model">quality.test</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
            name="action_create_run"
            string="Record New Test Run"
            type="object"
            class="btn-primary"
          />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
              name="action_view_runs"
              type="object"
              class="oe_stat_button"
              icon="fa-list"
            >
                            <field
                name="run_count"
                widget="statinfo"
                string="Test Runs"
              />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Quality Test Name" />
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="responsible_id" widget="many2one_avatar_user" />
                            <field name="department_id" />
                        </group>
                        <group string="Last Run">
                            <field name="last_run_date" />
                            <field
                name="last_run_result"
                decoration-danger="last_run_result == 'fail'"
                decoration-success="last_run_result == 'pass'"
                widget="badge"
              />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field
                name="description"
                widget="html"
                placeholder="Describe the steps to execute this quality test..."
              />
                        </page>
                        <page string="Related Modules" name="modules">
                            <field
                name="module_ids"
                widget="many2many_tags"
                options="{'no_create': True}"
              />
                        </page>
                        <page string="Notification Rules" name="rules">
                            <group string="Time-Based Rule">
                                <field name="rule_delay" />
                                <field
                  name="delay_days"
                  attrs="{'invisible': [('rule_delay', '=', False)], 'required': [('rule_delay', '=', True)]}"
                />
                            </group>
                            <group string="Module Update Rule">
                                <field name="rule_module_update" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_quality_test_search" model="ir.ui.view">
        <field name="name">quality.test.search</field>
        <field name="model">quality.test</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="responsible_id" />
                <field name="department_id" />
                <filter
          string="Failing"
          name="failing"
          domain="[('last_run_result', '=', 'fail')]"
        />
                <filter
          string="Passing"
          name="passing"
          domain="[('last_run_result', '=', 'pass')]"
        />
                <filter
          string="Never Tested"
          name="never_tested"
          domain="[('last_run_date', '=', False)]"
        />
                <group expand="1" string="Group By">
                    <filter
            name="groupby_department"
            string="Department"
            context="{'group_by': 'department_id'}"
          />
                    <filter
            name="groupby_responsible"
            string="Responsible"
            context="{'group_by': 'responsible_id'}"
          />
                    <filter
            name="groupby_result"
            string="Last Result"
            context="{'group_by': 'last_run_result'}"
          />
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_quality_test" model="ir.actions.act_window">
        <field name="name">Quality Tests</field>
        <field name="res_model">quality.test</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_quality_test_tree" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first quality test
            </p>
            <p>
                Define quality tests to track critical processes and ensure
                they are regularly verified.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem
    id="menu_quality_test_root"
    name="Quality Tests"
    sequence="90"
    groups="base.group_user"
  />
    <menuitem
    id="menu_quality_test_list"
    name="Quality Tests"
    parent="menu_quality_test_root"
    action="action_quality_test"
    sequence="10"
  />

</odoo>
