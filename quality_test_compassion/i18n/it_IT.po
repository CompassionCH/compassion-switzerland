#. module: quality_test_compassion
#: model:mail.template,body_html:quality_test_compassion.email_template_quality_test_run_fail
msgid ""
"<html>\n"
"  <body><div style=\"font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #333;\">\n"
"    <p>Hello <t t-out=\" object.test_id.user_id.name \"></t>,</p>\n"
"    <p>\n"
"        A test run for <strong><t t-out=\" object.test_id.name \"></t></strong> recorded on\n"
"        <strong><t t-out=\" object.date \"></t></strong> has <span style=\"color: #d9534f;\"><strong>failed</strong></span>.\n"
"    </p>\n"
"    <t t-if=\"object.comment\">\n"
"        <p><strong>Notes:</strong></p>\n"
"        <div style=\"margin-left: 1em;\"><t t-out=\" object.comment \"></t></div>\n"
"    </t>\n"
"    <p>\n"
"        Please investigate and record a passing run once the issue is resolved.\n"
"    </p>\n"
"    <p>Best regards,<br/>Compassion Switzerland – Quality Team</p>\n"
"</div>\n"
"            </body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div style=\"font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #333;\">\n"
"    <p>Hello <t t-out=\" object.test_id.user_id.name \"/>,</p>\n"
"    <p>\n"
"        A test run for <strong><t t-out=\" object.test_id.name \"/></strong> recorded on\n"
"        <strong><t t-out=\" object.date \"/></strong> has <span style=\"color: #d9534f;\"><strong>failed</strong></span>.\n"
"    </p>\n"
"    <t t-if=\"object.comment\">\n"
"        <p><strong>Notes:</strong></p>\n"
"        <div style=\"margin-left: 1em;\"><t t-out=\" object.comment \"/></div>\n"
"    </t>\n"
"    <p>\n"
"        Please investigate and record a passing run once the issue is resolved.\n"
"    </p>\n"
"    <p>Best regards,<br/>Compassion Switzerland – Quality Team</p>\n"
"</div>\n"
"            </body>\n"
"</html>\n"

#. module: quality_test_compassion
#: model:mail.template,body_html:quality_test_compassion.email_template_quality_test_notification
msgid ""
"<html>\n"
"  <body><div style=\"font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #333;\">\n"
"    <p>Hello <t t-out=\" object.user_id.name \"></t>,</p>\n"
"    <p>\n"
"        The quality test <strong><t t-out=\" object.name \"></t></strong> requires a new test run\n"
"        for the following reason(s):\n"
"    </p>\n"
"    <ul>\n"
"        <t t-foreach=\"ctx.get(&#x27;notification_reasons&#x27;, [])\" t-as=\"reason\">\n"
"            <li><t t-out=\" reason \"></t></li>\n"
"        </t>\n"
"    </ul>\n"
"    <t t-if=\"object.description\">\n"
"        <p><strong>Test Description:</strong></p>\n"
"        <div style=\"margin-left: 1em;\"><t t-out=\" object.description \"></t></div>\n"
"    </t>\n"
"    <p>\n"
"        Please log in to Odoo and record a new test run as soon as possible.\n"
"    </p>\n"
"    <p>Best regards,<br/>Compassion Switzerland – Quality Team</p>\n"
"</div>\n"
"            </body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div style=\"font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #333;\">\n"
"    <p>Hello <t t-out=\" object.user_id.name \"/>,</p>\n"
"    <p>\n"
"        The quality test <strong><t t-out=\" object.name \"/></strong> requires a new test run\n"
"        for the following reason(s):\n"
"    </p>\n"
"    <ul>\n"
"        <t t-foreach=\"ctx.get('notification_reasons', [])\" t-as=\"reason\">\n"
"            <li><t t-out=\" reason \"/></li>\n"
"        </t>\n"
"    </ul>\n"
"    <t t-if=\"object.description\">\n"
"        <p><strong>Test Description:</strong></p>\n"
"        <div style=\"margin-left: 1em;\"><t t-out=\" object.description \"/></div>\n"
"    </t>\n"
"    <p>\n"
"        Please log in to Odoo and record a new test run as soon as possible.\n"
"    </p>\n"
"    <p>Best regards,<br/>Compassion Switzerland – Quality Team</p>\n"
"</div>\n"
"            </body>\n"
"</html>\n"

