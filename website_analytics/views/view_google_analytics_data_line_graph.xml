<?xml version='1.0' encoding='UTF-8' ?>
<odoo><record id="view_google_analytics_data_line_graph" model="ir.ui.view">
        <field name="name">google.analytics.data.line.graph</field>
        <field name="model">google.analytics.data.line</field>
        <field name="arch" type="xml">
            <graph string="Page Views by URL" type="bar">
                <field name="url" type="row" />
                <field name="page_views_total" type="measure" />
            </graph>
        </field>
    </record>

    </odoo>
