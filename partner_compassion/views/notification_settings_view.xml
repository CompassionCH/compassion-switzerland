<odoo>
    <!-- Configuration View -->
    <record
    id="view_notification_settings_partner_compassion_form"
    model="ir.ui.view"
  >
        <field name="name">staff.notification.settings.muksathlon.form</field>
        <field name="model">res.config.settings</field>
        <field
      name="inherit_id"
      ref="message_center_compassion.compassion_settings"
    />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='notification_configuration']" position="inside">
                <setting string="Advocates" help="Define advocates for birthday notifications">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="advocate_birthday_fr_id" class="col-lg-3 o_light_label"/>
                            <field name="advocate_birthday_fr_id"/>
                        </div>
                        <div class="row">
                            <label for="advocate_birthday_de_id" class="col-lg-3 o_light_label"/>
                            <field name="advocate_birthday_de_id"/>
                        </div>
                        <div class="row">
                            <label for="advocate_birthday_it_id" class="col-lg-3 o_light_label"/>
                            <field name="advocate_birthday_it_id"/>
                        </div>
                        <div class="row">
                            <label for="advocate_birthday_en_id" class="col-lg-3 o_light_label"/>
                            <field name="advocate_birthday_en_id"/>
                        </div>
                        <div class="row">
                            <label for="advocate_birthday_translation_id" class="col-lg-3 o_light_label"/>
                            <field name="advocate_birthday_translation_id"/>
                        </div>
                    </div>
                </setting>
                <setting string="Potential advocates" help="Define potential advocates">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="potential_advocate_fr" class="col-lg-3 o_light_label"/>
                            <field name="potential_advocate_fr"/>
                        </div>
                        <div class="row">
                            <label for="potential_advocate_de" class="col-lg-3 o_light_label"/>
                            <field name="potential_advocate_de"/>
                        </div>
                        <div class="row">
                            <label for="potential_advocate_it" class="col-lg-3 o_light_label"/>
                            <field name="potential_advocate_it"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
