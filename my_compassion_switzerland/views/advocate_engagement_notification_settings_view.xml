<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_notification_engagement_advocate" model="ir.ui.view">
        <field name="name">advocate.engagement.notification.website.form</field>
        <field name="model">res.config.settings</field>
        <field
      name="inherit_id"
      ref="message_center_compassion.compassion_settings"
    />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='notification_configuration']" position="inside">
                <setting
          string="Engagement from advocates"
          help="Email addresses to notify when an advocate engagement form is submitted"
        >
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="advocate_notify_fr_email" class="col-lg-3 o_light_label"/>
                            <field name="advocate_notify_fr_email"/>
                        </div>
                        <div class="row">
                            <label for="advocate_notify_de_email" class="col-lg-3 o_light_label"/>
                            <field name="advocate_notify_de_email"/>
                        </div>
                        <div class="row">
                            <label for="advocate_notify_it_email" class="col-lg-3 o_light_label"/>
                            <field name="advocate_notify_it_email"/>
                        </div>
                        <div class="row">
                            <label for="advocate_notify_default_email" class="col-lg-3 o_light_label"/>
                            <field name="advocate_notify_default_email"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
