<odoo>
    <data noupdate="1">
        <record id="recurring_payment_charger_cron" model="ir.cron">
            <field name="name">Process Recurring Payments (Due Today)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_charge_due_recurring_invoices()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False" />
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 07:00:00')" />
        </record>
    </data>
</odoo>