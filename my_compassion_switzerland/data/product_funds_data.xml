            <field name="my_compassion_show_impact_statement" eval="True"/>
            <field name="my_compassion_show_info" eval="False"/>
            <field name="my_compassion_show_testimony" eval="False"/>
            <field name="my_compassion_donation_quantity_low">2</field>
            <field name="my_compassion_donation_quantity_medium">3</field>
            <field name="my_compassion_donation_quantity_high">8</field>
