        <record id="product_template_fund_csp_after2" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_csp"/>
            <field name="type">after</field>
            <field name="description" eval="'Nutritious food.'"/>
        </record>

        <record id="product_template_fund_csp_after3" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_csp"/>
            <field name="type">after</field>
            <field name="description" eval="'Psychosocial and spiritual support.'"/>
        </record>

        <record id="product_template_fund_csp_after4" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_csp"/>
            <field name="type">after</field>
            <field name="description" eval="'Training to generate a sustainable income '
