            <field name="my_compassion_name">Food Fund</field>
            <field name="my_compassion_color" ref="theme_compassion_2025.mid_brown"/>
            <field name="my_compassion_pictogram" ref="theme_compassion_2025.pictogram_food"/>
            <field name="my_compassion_description" eval="'Droughts, crop failures, '
            'conflict, and rising prices—for families in extreme poverty, food is '
