            <field name="donation_id" ref="product_template_fund_fda"/>
            <field name="type">before</field>
            <field name="description" eval="'Food security is a major challenge in '
            'many countries in the Global South.'"/>
        </record>

        <record id="product_template_fund_fda_before2" model="donation.impact.line">
            <field name="donation_id" ref="product_template_fund_fda"/>
            <field name="type">before</field>
            <field name="description" eval="'Many families often do not know if or '
            'what they will eat tomorrow.'"/>
        </record>

        <record id="product_template_fund_fda_after1" model="donation.impact.line">
            <field name="donation_id" ref="product_template_fund_fda"/>
            <field name="type">after</field>
            <field name="description" eval="'Distribute food supplies to families in '
            'critical situations.'"/>
        </record>

        <record id="product_template_fund_fda_after2" model="donation.impact.line">
            <field name="donation_id" ref="product_template_fund_fda"/>
            <field name="type">after</field>
            <field name="description" eval="'Provide vulnerable families with seeds, '
            'fertilizer, and livestock, and offer training in self-sufficient farming.'"/>
        </record>
    </data>

