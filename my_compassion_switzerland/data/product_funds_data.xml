<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PRODUCT REGISTRATION -->
    <!-- WASH FUND PRODUCT -->
    <data noupdate="0">
        <record id="sponsorship_switzerland.product_template_fund_wtp" model="product.template">
            <field name="name">"Water for the children" Fund</field>
            <!-- Header information -->
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <!-- General information tab -->
            <field name="type">service</field>
            <field name="categ_id" ref="sponsorship_compassion.product_category_fund"/>
            <field name="default_code">wash</field>
            <field name="list_price">8.00</field>
            <field name="description">
                Thanks to your donation. It allows us to finance water disinfection
                project to provide sponsored children, their families, their community
                and villages with drinking water, in the poorest regions of the world.
                This help would not be possible without you and we are very grateful for
                your support.
            </field>
            <!-- MyCompassion tab -->
            <field name="activate_for_my_compassion" eval="True"/>
            <field name="my_compassion_donation_type">fund</field>
            <field name="my_compassion_name">Clean Water</field>
            <field name="my_compassion_color" ref="theme_compassion_2025.mid_blue"/>
            <field name="my_compassion_pictogram" ref="theme_compassion_2025.pictogram_water_and_sanitation"/>
            <field name="my_compassion_description" eval="'Clean water and safe '
            'sanitation are crucial for a child\'s healthy development. That is why '
            'Compassion is committed to building wells, latrines, and sanitary '
            'facilities in Child Development Centers and local communities.'"/>
            <field name="my_compassion_show_impact_statement" eval="True"/>
            <field name="my_compassion_show_info" eval="False"/>
            <field name="my_compassion_show_testimony" eval="False"/>
            <field name="my_compassion_donation_quantity_low">1</field>
            <field name="my_compassion_donation_quantity_medium">3</field>
            <field name="my_compassion_donation_quantity_high">5</field>
        </record>

        <record id="product_template_fund_wtp_before1" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_wtp"/>
            <field name="type">before</field>
            <field name="description" eval="'2.2 billion people lack access to safe '
            'drinking water.'"/>
        </record>

        <record id="product_template_fund_wtp_before2" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_wtp"/>
            <field name="type">before</field>
            <field name="description" eval="'494 million people still use inadequate '
            'sanitation facilities or practice open defecation.'"/>
        </record>

        <record id="product_template_fund_wtp_before3" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_wtp"/>
            <field name="type">before</field>
            <field name="description" eval="'Just CHF 30.– is enough to provide a '
            'child with access to a safe toilet.'"/>
        </record>

        <record id="product_template_fund_wtp_after1" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_wtp"/>
            <field name="type">after</field>
            <field name="description" eval="'Build wells and water tanks that give '
            'children, their families, and entire communities vital access to clean '
            'water.'"/>
        </record>

        <record id="product_template_fund_wtp_after2" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_wtp"/>
            <field name="type">after</field>
            <field name="description" eval="'Construct safe toilet facilities so that '
            'children—especially girls—have access to protected and dignified '
            'sanitation.'"/>
        </record>

        <record id="product_template_fund_wtp_after3" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_wtp"/>
            <field name="type">after</field>
            <field name="description" eval="'Keep children in class, as they no longer '
            'have to spend hours walking to fetch water.'"/>
        </record>
    </data>

    <!-- UNSPONSORED CHILDREN FUND PRODUCT -->
    <data noupdate="0">
        <record id="sponsorship_switzerland.product_template_fund_usp" model="product.template">
            <field name="name">Unsponsored Children Fund</field>
            <!-- Header information -->
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <!-- General information tab -->
            <field name="type">service</field>
            <field name="categ_id" ref="sponsorship_compassion.product_category_fund"/>
            <field name="default_code">sansparrain</field>
            <field name="list_price">8.00</field>
            <field name="description">
                Your donation to the "Unsponsored Children Fund" unlocks the benefits
                of Compassion's program for children who have been registered but not
                yet been sponsored. Your gift to this fund also encourages parents and
                program staff as they see Compassion benefits at work for the children
                they love, even as they wait — and hope — for sponsors.

                We thank you very much for your precious support.
            </field>
            <!-- MyCompassion tab -->
            <field name="activate_for_my_compassion" eval="True"/>
            <field name="my_compassion_donation_type">fund</field>
            <field name="my_compassion_name">Children Waiting for a Sponsor</field>
            <field name="my_compassion_color" ref="theme_compassion_2025.low_yellow"/>
            <field name="my_compassion_pictogram" ref="theme_compassion_2025.pictogram_children"/>
            <field name="my_compassion_description" eval="'Compassion staff on the '
            'ground identify highly vulnerable families and offer them the chance to '
            'register a child at the local Child Development Center. There, children '
            'receive support, protection, and loving care even before a sponsor is '
            'found. This fund covers program costs for children during this waiting '
            'period, ensuring they don\'t miss out on vital activities.'"/>
            <field name="my_compassion_show_impact_statement" eval="True"/>
            <field name="my_compassion_show_info" eval="False"/>
            <field name="my_compassion_show_testimony" eval="False"/>
            <field name="my_compassion_donation_quantity_low">1</field>
            <field name="my_compassion_donation_quantity_medium">3</field>
            <field name="my_compassion_donation_quantity_high">5</field>
        </record>

        <record id="product_template_fund_usp_before1" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_usp"/>
            <field name="type">before</field>
            <field name="description" eval="'Currently, over 400 million children '
            'worldwide live in extreme poverty on less than $2.15 a day.'"/>
        </record>

        <record id="product_template_fund_usp_before2" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_usp"/>
            <field name="type">before</field>
            <field name="description" eval="'305,000 children are currently '
            'participating in the Compassion program while waiting for a sponsor.'"/>
        </record>

        <record id="product_template_fund_usp_before3" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_usp"/>
            <field name="type">before</field>
            <field name="description" eval="'The average wait time to be matched with '
            'a sponsor is around 180 days.'"/>
        </record>

        <record id="product_template_fund_usp_after1" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_usp"/>
            <field name="type">after</field>
            <field name="description" eval="'These children can fully participate in '
            'the Compassion program and center activities.'"/>
        </record>

        <record id="product_template_fund_usp_after2" model="donation.impact.line">
            <field name="donation_id" ref="sponsorship_switzerland.product_template_fund_usp"/>
            <field name="type">after</field>
            <field name="description" eval="'Children receive support, protection, and '
            'loving care while they wait for a sponsor.'"/>
        </record>
    </data>

    <!-- HEALTH FUND PRODUCT -->
