        </record>

        <record id="product_template_fund_dis_before2" model="donation.impact.line">
            <field name="donation_id" ref="product_template_fund_dis"/>
            <field name="type">before</field>
            <field name="description" eval="'Every year, millions of people worldwide '
            'face emergencies due to extreme weather events, which often destroy basic '
            'necessities like water, food, shelter, and healthcare access.'"/>
