        <record id="product_template_fund_hea_after2" model="donation.impact.line">
            <field name="donation_id" ref="product_template_fund_hea"/>
            <field name="type">after</field>
            <field name="description" eval="'Health check-ups and medical treatments.'"/>
        </record>

        <record id="product_template_fund_hea_after3" model="donation.impact.line">
            <field name="donation_id" ref="product_template_fund_hea"/>
            <field name="type">after</field>
            <field name="description" eval="'Access to critical prevention programs.'"/>
        </record>
    </data>

    <!-- FOOD FUND PRODUCT -->
    <data noupdate="0">
        <record id="product_template_fund_fda" model="product.template">
