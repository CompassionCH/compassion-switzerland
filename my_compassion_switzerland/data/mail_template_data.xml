<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record
      id="email_template_volunteer_registration"
      model="mail.template"
    >
            <field name="name">Volunteer Registration</field>
            <field name="model_id" ref="base.model_res_partner" />
            <field
        name="subject"
      >I want to get involved at Compassion Switzerland</field>
            <field
        name="email_from"
      >Compassion &lt;compassion@compassion.ch&gt;</field>
            <field name="body_html" type="html">
<div
          style="font-family:Arial, sans-serif;font-size: 14px; line-height: 1.5; color: #333;"
        >
    <p
          >A new volunteer has registered from My Compassion with the following details:</p>

    <p><strong>Title:</strong> <t t-out="ctx.get('title') or ''"/></p>
    <p><strong
            >Firstname, Lastname:</strong> <t t-out="ctx.get('firstname') or ''"/> <t t-out="ctx.get('lastname') or ''"/></p>
    <p><strong>Phone number:</strong> <t t-out="ctx.get('phone_number') or ''"/></p>
    <p><strong>Email:</strong> <t t-out="ctx.get('email') or ''"/></p>
    <p><strong>Church:</strong> <t t-out="ctx.get('church') or ''"/></p>

    <p><strong>I want to get involved as:</strong></p>
    <ul t-if="ctx.get('volunteer_roles')">
        <li t-foreach="ctx.get('volunteer_roles')" t-as="role" t-out="role or ''"/>
    </ul>
    <p t-else="">No roles selected</p>

    <p><strong>Message:</strong><br />
        <t t-out="ctx.get('comments') or ''"/>
    </p>

    <p>Best regards,<br />
    Compassion Switzerland Website</p>
</div>
            </field>
            <field name="email_to">info@compassion.ch</field>
            <field name="auto_delete" eval="True" />
        </record>
    </data>
</odoo>
