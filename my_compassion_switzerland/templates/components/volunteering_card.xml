<?xml version="1.0" encoding="utf-8" ?>
<!--
Page: My Compassion 2 Volunteering Card Component

    Description:
    This component is used to display a volunteering opportunity

    Used in route:
    - /my2/volunteering/

    Injected data:
    - engagement_type (object): The engagement type object containing the details for the volunteering opportunity.
    - internal_link_label (string): The label for the internal link button.
    - button_color (string): The color for the button when there is an internal link.
    - volunteer (boolean): Indicates if the user is a volunteer of the specific engagement type.
-->
<odoo>
    <template
    id="volunteering_card_component"
    name="My Compassion 2 Volunteering Card Component"
  >
        <!-- Image, title and description -->
        <div
      class="d-flex flex-column align-items-center justify-content-center text-center"
    >
            <img
        t-att-alt="engagement_type.my_compassion_alt_text"
        t-att-src="'/web/image/%s/%s/my_compassion_image' % (engagement_type._name, engagement_type.id)"
        class="volunteering_image w-100 pb-3"
      />
            <t t-call="theme_compassion_2025.TitleComponent">
                <t
          t-set="title_content"
          t-value="engagement_type.my_compassion_label"
        />
                <t t-set="title_size" t-value="'md'" />
                <t t-set="color" t-value="'core-blue'" />
                <t t-set="show_underline" t-value="true" />
                <t t-set="underline_color" t-value="'low-yellow'" />
                <t
          t-set="description"
          t-value="(engagement_type.my_compassion_thank_you_text or 'Thank you for being a volunteer!') if volunteer else engagement_type.my_compassion_description"
        />
            </t>
        </div>
        <!-- Action buttons -->
        <div>
            <t t-if="volunteer" />
            <t t-elif="engagement_type.my_compassion_external_link">
                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                    <t t-set="variant" t-value="'default'" />
                    <t t-set="variation" t-value="'filled'" />
                    <t t-set="label">Learn More</t>
                    <t t-set="color" t-value="'core-blue'" />
                    <t t-set="text_color" t-value="'pure-white'" />
                    <t
            t-set="href"
            t-value="engagement_type.my_compassion_external_link"
          />
                    <t t-set="target" t-value="'_blank'" />
                    <t t-set="rel" t-value="'noopener noreferrer'" />
                </t>
            </t>
            <t t-elif="engagement_type.my_compassion_internal_link">
                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                    <t t-set="variant" t-value="'default'" />
                    <t t-set="variation" t-value="'filled'" />
                    <t t-set="label" t-value="internal_link_label" />
                    <t t-set="color" t-value="button_color" />
                    <t t-set="text_color" t-value="'pure-white'" />
                    <t
            t-set="href"
            t-value="engagement_type.my_compassion_internal_link"
          />
                </t>
            </t>
            <t t-else="">
                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                    <t t-set="variant" t-value="'default'" />
                    <t t-set="variation" t-value="'filled'" />
                    <t t-set="label">Apply as a Volunteer</t>
                    <t t-set="color" t-value="'mid-green'" />
                    <t t-set="text_color" t-value="'pure-white'" />
                    <t t-set="href" t-value="'#volunteer_form_top'" />
                </t>
            </t>
        </div>
    </template>
</odoo>
