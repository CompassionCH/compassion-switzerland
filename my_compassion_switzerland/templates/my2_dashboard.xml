<odoo>
    <template id="dashboard_volunteering_vignette">
        <t t-call="my_compassion.DashboardGridItem">
            <t t-call="theme_compassion_2025.VignetteComponent">
                <t
          t-set="image"
          t-value="'/theme_compassion_2025/static/src/img/snippets/library_image_13.jpg'"
        />
                <t t-set="title">Volunteers</t>
                <t t-set="subtitle">Commit to serving the most vulnerable</t>
                <t t-set="icon" t-value="'pictogram-local-empowerment-partnership'" />
                <t t-set="color" t-value="'low-green'" />
                <t t-set="bg_color" t-value="'high-green'" />
                <t t-set="href" t-value="'/my2/volunteering'" />
            </t>
            <t t-if="partner.is_translator">
                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                    <t t-set="variant" t-value="'default'" />
                    <t t-set="variation" t-value="'filled'" />
                    <t t-set="label">Translate a letter</t>
                    <t t-set="color" t-value="'mid-green'" />
                    <t t-set="text_color" t-value="'pure-white'" />
                    <t
            t-set="href"
            t-value="'https://translate.compassion.ch'"
          />
                </t>
            </t>
        </t>
    </template>
</odoo>
