#. module: my_compassion_switzerland
#: model:mail.template,body_html:my_compassion_switzerland.email_template_volunteer_registration
msgid ""
"<div style=\"font-family:Arial, sans-serif;font-size: 14px; line-height: 1.5; color: #333;\">\n"
"    <p>A new volunteer has registered from My Compassion with the following details:</p>\n"
"\n"
"    <p><strong>Title:</strong> <t t-out=\"ctx.get('title') or ''\"/></p>\n"
"    <p><strong>Firstname, Lastname:</strong> <t t-out=\"ctx.get('firstname') or ''\"/> <t t-out=\"ctx.get('lastname') or ''\"/></p>\n"
"    <p><strong>Phone number:</strong> <t t-out=\"ctx.get('phone_number') or ''\"/></p>\n"
"    <p><strong>Email:</strong> <t t-out=\"ctx.get('email') or ''\"/></p>\n"
"    <p><strong>Church:</strong> <t t-out=\"ctx.get('church') or ''\"/></p>\n"
"\n"
"    <p><strong>I want to get involved as:</strong></p>\n"
"    <ul t-if=\"ctx.get('volunteer_roles')\">\n"
"        <li t-foreach=\"ctx.get('volunteer_roles')\" t-as=\"role\" t-out=\"role or ''\">\n"
"    </li></ul>\n"
"    <p t-else=\"\">No roles selected</p>\n"
"\n"
"    <p><strong>Message:</strong><br/>\n"
"        <t t-out=\"ctx.get('comments') or ''\"/>\n"
"    </p>\n"
"\n"
"    <p>Best regards,<br/>\n"
"    Compassion Switzerland Website</p>\n"
"</div>\n"
"            "
msgstr ""
"<html>\n"
"  <body>\n"
"    <div style=\"font-family:Arial, sans-serif;font-size: 14px; line-height: 1.5; color: #333;\">\n"
"    <p>Un nuovo volontario si è registrato su My Compassion con i seguenti dettagli:</p>\n"
"\n"
"    <p><strong>Title:</strong> <t t-out=\"ctx.get(&#x27;title&#x27;) or &#x27;&#x27;\"></t></p>\n"
"    <p><strong>Nome, Cognome:</strong> <t t-out=\"ctx.get(&#x27;firstname&#x27;) or &#x27;&#x27;\"></t> <t t-out=\"ctx.get(&#x27;lastname&#x27;) or &#x27;&#x27;\"></t></p>\n"
"    <p><strong>Numero di telefono:</strong> <t t-out=\"ctx.get(&#x27;phone_number&#x27;) or &#x27;&#x27;\"></t></p>\n"
"    <p><strong>E-mail:</strong> <t t-out=\"ctx.get(&#x27;email&#x27;) or &#x27;&#x27;\"></t></p>\n"
"    <p><strong>Chiesa:</strong> <t t-out=\"ctx.get(&#x27;church&#x27;) or &#x27;&#x27;\"></t></p>\n"
"\n"
"    <p><strong>Desidero partecipare come:</strong></p>\n"
"    <t t-if=\"ctx.get(&#x27;volunteer_roles&#x27;)\">\n"
"        <ul>\n"
"        <t t-foreach=\"ctx.get(&#x27;volunteer_roles&#x27;)\" t-as=\"role\">\n"
"            <li><t t-out=\"role or &#x27;&#x27;\"></t></li>\n"
"        </t>\n"
"        </ul>\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <p>Nessun ruolo selezionato</p>\n"
"    </t>\n"
"    <p><strong>Messaggio:</strong><br/>\n"
"        <t t-out=\"ctx.get(&#x27;comments&#x27;) or &#x27;&#x27;\"></t>\n"
"    </p>\n"
"\n"
"    <p>Cari saluti,<br/>\n"
"    Sito web Compassion Svizzera</p>\n"
"</div>\n"
"  </body>\n"
"</html>\n"

