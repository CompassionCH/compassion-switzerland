#. module: my_compassion_switzerland
#: model:mail.template,body_html:my_compassion_switzerland.email_template_volunteer_registration
msgid ""
"<div style=\"font-family:Arial, sans-serif;font-size: 14px; line-height: 1.5; color: #333;\">\n"
"    <p>A new volunteer has registered from My Compassion with the following details:</p>\n"
"\n"
"    <p><strong>Title:</strong> ${ctx.get('title') or ''}</p>\n"
"    <p><strong>Firstname, Lastname:</strong> ${ctx.get('firstname') or ''} ${ctx.get('lastname') or ''}</p>\n"
"    <p><strong>Phone number:</strong> ${ctx.get('phone_number') or ''}</p>\n"
"    <p><strong>Email:</strong> ${ctx.get('email') or ''}</p>\n"
"    <p><strong>Church:</strong> ${ctx.get('church') or ''}</p>\n"
"\n"
"    <p><strong>I want to get involved as:</strong></p>\n"
"    % if ctx.get('volunteer_roles'):\n"
"        <ul>\n"
"        % for role in ctx.get('volunteer_roles'):\n"
"            <li>${role or ''}</li>\n"
"        % endfor\n"
"        </ul>\n"
"    % else:\n"
"        <p>No roles selected</p>\n"
"    % endif\n"
"\n"
"    <p><strong>Message:</strong><br/>\n"
"        ${ctx.get('comments') or ''}\n"
"    </p>\n"
"\n"
"    <p>Best regards,<br/>\n"
"    Compassion Switzerland Website</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"font-family:Arial, sans-serif;font-size: 14px; line-height: 1.5; color: #333;\">\n"
"    <p>A new volunteer has registered from My Compassion with the following details:</p>\n"
"\n"
"    <p><strong>Title:</strong> ${ctx.get('title') or ''}</p>\n"
"    <p><strong>Firstname, Lastname:</strong> ${ctx.get('firstname') or ''} ${ctx.get('lastname') or ''}</p>\n"
"    <p><strong>Phone number:</strong> ${ctx.get('phone_number') or ''}</p>\n"
"    <p><strong>Email:</strong> ${ctx.get('email') or ''}</p>\n"
"    <p><strong>Church:</strong> ${ctx.get('church') or ''}</p>\n"
"\n"
"    <p><strong>I want to get involved as:</strong></p>\n"
"    % if ctx.get('volunteer_roles'):\n"
"        <ul>\n"
"        % for role in ctx.get('volunteer_roles'):\n"
"            <li>${role or ''}</li>\n"
"        % endfor\n"
"        </ul>\n"
"    % else:\n"
"        <p>No roles selected</p>\n"
"    % endif\n"
"\n"
"    <p><strong>Message:</strong><br/>\n"
"        ${ctx.get('comments') or ''}\n"
"    </p>\n"
"\n"
"    <p>Best regards,<br/>\n"
"    Compassion Switzerland Website</p>\n"
"</div>"

