<odoo>
    <record id="paperformat_mini_childpack" model="report.paperformat">
        <field name="name">Childpack mini</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">210</field>
        <field name="page_width">210</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">35</field>
        <field name="dpi">96</field>
    </record>

    <record id="report_childpack_mini" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_mini_childpack" />
        <field name="model">compassion.child</field>
        <field name="name">Mini Childpack</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">child_switzerland.childpack_mini</field>
    </record>

    <template id="childpack_mini">
        <t t-set="mini" t-value="1" />
        <t t-set="disable_header" t-value="1" />
        <t t-set="disable_footer" t-value="1" />
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <style>
                        .local_id {
                            position: absolute;
                            top: 200mm;
                            left: 8mm;
                            width: 25mm;
                            font-size: 8pt;
                        }
                        h6 {
                            text-transform: uppercase;
                        }
                        .photo {
                            position: absolute;
                            left: 118mm;
                            top: 49mm;
                            width: 88mm;
                            height: 125mm;
                        }
                        .photo img {
                            max-width: 100%;
                            max-height: 100%;
                            margin: auto;
                        }
                        .summary {
                            position: absolute;
                            left: 118mm;
                            top: 177mm;
                            text-transform: uppercase;
                            font-size: 15pt;
                            line-height: 1.4;
                            color: #0054a6;
                        }
                        .summary .name {
                            font-weight: bold;
                        }
                        /* Drawn in CSS so that the punctuation is neither exposed as
                           a translatable term nor spaced out by the HTML whitespace
                           collapsing */
                        .summary .name:after {
                            content: ",";
                        }
                        .summary .parenthesis:before {
                            content: "(";
                        }
                        .summary .parenthesis:after {
                            content: ")";
                        }
                        .summary .ref {
                            color: black;
                            font-size: 8pt;
                        }
                    </style>
                    <div class="local_id">
                        <span t-field="o.local_id" />
                    </div>
                    <div class="photo">
                        <img
              t-if="o.fullshot"
              t-attf-src="data:image/jpg;base64,{{ o.fullshot }}"
            />
                    </div>
                    <div class="summary">
                        <span t-field="o.preferred_name" class="name" />
                        <t t-if="o.gender == 'M'">
                            <span>boy</span>
                        </t>
                        <t t-if="o.gender == 'F'">
                            <span>girl</span>
                        </t>
                        <br />
                        <span t-field="o.birthdate" class="birthdate" />
                        <span class="parenthesis">
                            <span t-field="o.age" class="age" />
                            <span>years</span>
                        </span>
                        <br />
                        <span t-field="o.project_id.country_id.name" />
                        <br />
                        <span t-field="o.local_id" class="ref" />
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template
    id="childpack_swiss"
    inherit_id="child_compassion.childpack_document"
  >
        <!-- oca-hooks:disable=xml-dangerous-qweb-replace-low-priority -->
        <xpath expr="//div[@class='background']/img" position="replace">
            <t t-if="lang != 'en_US'">
            <img
          t-attf-src="/child_compassion/static/img/#{ type }/1904_dossier_#{ lang }.jpg"
        />
            </t>
            <t t-else="">
                <t t-if="'full' not in type">
                    <img
            src="/child_switzerland/static/img/1904_dossier_en_US.jpg"
          />
                </t>
            </t>
        </xpath>
    </template>
</odoo>
