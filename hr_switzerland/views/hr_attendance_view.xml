<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Every employee can see and edit his own attendances (trust-based) -->
    <record id="hr_attendance_my_action" model="ir.actions.act_window">
        <field name="name">My Attendances</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="search_view_id" ref="hr_attendance.hr_attendance_view_filter" />
    </record>
</odoo>
