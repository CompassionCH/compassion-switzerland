<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="hr_attendance.attendance_menu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_att_menu_container')]" position="inside">
            <button class="btn btn-link p-0 text-start" t-on-click="openMyAttendances">
                <i class="fa fa-list me-1" />My Attendances
            </button>
        </xpath>
    </t>
</templates>
