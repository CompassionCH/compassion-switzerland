<odoo>
    <!-- Hide state field in address and use firstname field -->
    <!-- oca-hooks:disable=xml-dangerous-qweb-replace-low-priority -->
    <template id="cart_address" inherit_id="website_sale.address">
        <xpath expr="//select[@name='state_id']/.." position="attributes">
            <attribute name="t-attf-class">d-none</attribute>
        </xpath>
        <xpath expr="//div[@id='div_street2']" position="replace" />
        <xpath expr="//input[@name='required_fields']" position="attributes">
            <attribute name="t-att-value"></attribute>
        </xpath>
        <xpath expr="//input[@name='phone']" position="attributes">
            <attribute name="t-att-value">partner_sudo.phone or partner_sudo.mobile</attribute>
        </xpath>
        <xpath expr="//input[@name='name']/.." position="replace">
            <t
        t-set="checkout_title"
        t-value="partner_sudo.title"
      />
            <t t-set="title_id" t-value="checkout_title.id" />
            <div class="form-group col-lg-6" id="div_title">
                    <label class="col-form-label" for="title_select">Title</label>
                        <select
          name="title"
          id="title_select"
          class="form-control"
          t-att-value="checkout_title.name or ''"
        >
                            <option value="" disabled="" t-att-selected="not title_id">Select a title...</option>
                            <t t-foreach="contact_titles" t-as="contact_title">

                                <t t-esc="contact_title.id" />
                                                <option
              t-att-value="contact_title.id"
              t-att-selected="title_id == contact_title.id"
            >
                                                    <t t-esc="contact_title.name" />
                                                </option>
                                            </t>
                        </select>
                </div>

            <div
        class="form-group col-lg-12 div_name"
      >
                <label class="col-form-label" for="o_firstname">Firstname</label>
                <input
          type="text"
          name="firstname"
          id="o_firstname"
          class="form-control"
          t-att-value="partner_sudo.firstname if partner_sudo else ''"
        />
            </div>
            <div
        class="form-group col-lg-12 div_name"
      >
                <label class="col-form-label" for="o_lastname">Lastname</label>
                <input
          type="text"
          name="lastname"
          id="o_lastname"
          class="form-control"
          t-att-value="partner_sudo.lastname if partner_sudo else ''"
        />
            </div>
        </xpath>
    </template>

    <template
    id="cart_participant_picture"
    inherit_id="website_sale.cart_lines"
  >
        <xpath
      expr="//div[@t-field='line.product_id.image_128']"
      position="attributes"
    >
            <attribute name="t-field">line.image</attribute>
        </xpath>
    </template>

    <template id="checkout_participant_picture" inherit_id="website_sale.checkout_layout">
        <xpath
      expr="//span[@t-field='line.product_id.image_128']"
      position="attributes"
    >
            <attribute name="t-field">line.image</attribute>
        </xpath>
    </template>
</odoo>
