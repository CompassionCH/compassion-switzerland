<!-- oca-hooks:disable=xml-dangerous-qweb-replace-low-priority -->
<odoo>
    <!-- The contact page of Odoo holds demo content (company, address) and
         sends a lead: it becomes a support request, as on MyCompassion, which
         shows its own page instead. -->
    <template
    name="Compassion CH Contact Form"
    inherit_id="website.contactus"
    id="contactus"
  >
        <xpath expr="//p[hasclass('lead')]" position="replace">
            <p class="lead">
                Have a question or want to learn more about our work? Fill out the form below, and we'll get back to you as soon as possible.
            </p>
        </xpath>
        <xpath expr="//section[hasclass('s_website_form')]" position="replace">
            <section
        class="s_website_form"
        data-vcss="001"
        data-snippet="s_website_form"
        data-name="Form"
      >
                <form
          id="contactus_form"
          action="/website/form/"
          method="post"
          enctype="multipart/form-data"
          class="o_mark_required"
          data-mark="*"
          data-model_name="crm.claim"
          data-success-mode="redirect"
          data-success-page="/contactus-thank-you"
        >
                    <div class="s_website_form_rows row s_col_no_bgcolor">
                        <div
              class="mb-3 col-12 col-md-6 s_website_form_field s_website_form_custom s_website_form_required"
              data-type="char"
              data-name="Field"
              t-if="titles"
            >
                            <label
                class="s_website_form_label form-label"
                for="contactus_form_title"
              >
                                <span class="s_website_form_label_content">Title</span>
                                <span class="s_website_form_mark"> *</span>
                            </label>
                            <select
                id="contactus_form_title"
                name="title"
                class="form-select s_website_form_input"
                required="1"
              >
                                <option value="" disabled="1" selected="1">Please select</option>
                                <option
                  t-foreach="titles"
                  t-as="title"
                  t-att-value="title.shortcut"
                  t-out="title.name"
                />
                            </select>
                        </div>
                        <div class="w-100" t-if="titles" />
                        <div
              class="mb-3 col-12 col-md-6 s_website_form_field s_website_form_custom s_website_form_required"
              data-type="char"
              data-name="Field"
            >
                            <label
                class="s_website_form_label form-label"
                for="contactus_form_firstname"
              >
                                <span class="s_website_form_label_content">First Name</span>
                                <span class="s_website_form_mark"> *</span>
                            </label>
                            <input
                id="contactus_form_firstname"
                type="text"
                name="firstname"
                class="form-control s_website_form_input"
                required="1"
              />
                        </div>
                        <div
              class="mb-3 col-12 col-md-6 s_website_form_field s_website_form_custom s_website_form_required"
              data-type="char"
              data-name="Field"
            >
                            <label
                class="s_website_form_label form-label"
                for="contactus_form_lastname"
              >
                                <span class="s_website_form_label_content">Last Name</span>
                                <span class="s_website_form_mark"> *</span>
                            </label>
                            <input
                id="contactus_form_lastname"
                type="text"
                name="lastname"
                class="form-control s_website_form_input"
                required="1"
              />
                        </div>
                        <div
              class="mb-3 col-12 col-md-6 s_website_form_field"
              data-type="char"
              data-name="Field"
            >
                            <label
                class="s_website_form_label form-label"
                for="contactus_form_phone"
              >
                                <span class="s_website_form_label_content">Phone number</span>
                            </label>
                            <input
                id="contactus_form_phone"
                type="tel"
                name="partner_phone"
                class="form-control s_website_form_input"
              />
                        </div>
                        <div
              class="mb-3 col-12 col-md-6 s_website_form_field s_website_form_required"
              data-type="email"
              data-name="Field"
            >
                            <label
                class="s_website_form_label form-label"
                for="contactus_form_email"
              >
                                <span class="s_website_form_label_content">E-mail</span>
                                <span class="s_website_form_mark"> *</span>
                            </label>
                            <input
                id="contactus_form_email"
                type="email"
                name="email_from"
                class="form-control s_website_form_input"
                required="1"
              />
                        </div>
                        <div
              class="mb-3 col-12 s_website_form_field s_website_form_required"
              data-type="char"
              data-name="Field"
            >
                            <label
                class="s_website_form_label form-label"
                for="contactus_form_subject"
              >
                                <span class="s_website_form_label_content">Subject</span>
                                <span class="s_website_form_mark"> *</span>
                            </label>
                            <input
                id="contactus_form_subject"
                type="text"
                name="name"
                class="form-control s_website_form_input"
                required="1"
              />
                        </div>
                        <div
              class="mb-3 col-12 s_website_form_field s_website_form_required"
              data-type="text"
              data-name="Field"
            >
                            <label
                class="s_website_form_label form-label"
                for="contactus_form_message"
              >
                                <span class="s_website_form_label_content">Message</span>
                                <span class="s_website_form_mark"> *</span>
                            </label>
                            <textarea
                id="contactus_form_message"
                name="description"
                class="form-control s_website_form_input"
                rows="6"
                required="1"
              />
                        </div>
                        <div
              class="col-12 s_website_form_submit text-end"
              data-name="Submit Button"
            >
                            <a
                href="#"
                role="button"
                class="btn btn-primary s_website_form_send"
              >Send the message</a>
                            <span id="s_website_form_result" />
                        </div>
                    </div>
                </form>
            </section>
        </xpath>
        <xpath
      expr="//div[hasclass('col-lg-4')][hasclass('offset-lg-1')]"
      position="replace"
    >
            <t t-call="website_switzerland.contactus_company" />
        </xpath>
    </template>
    <template
    id="contactus_thanks"
    inherit_id="website.contactus_thanks_ir_ui_view"
  >
        <xpath
      expr="//div[hasclass('col-lg-4')][hasclass('offset-lg-1')]"
      position="replace"
    >
            <t t-call="website_switzerland.contactus_company" />
        </xpath>
    </template>
    <!-- Instead of the demo company of the contact pages of Odoo -->
    <template id="contactus_company">
            <!-- The office answering in the language of the visitor -->
            <t
        t-set="street"
        t-value="res_company.commercial_street or res_company.street"
      />
            <t t-set="phone" t-value="res_company.commercial_phone or res_company.phone" />
            <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0">
                <h5 t-out="res_company.commercial_name or res_company.name" />
                <ul class="list-unstyled mb-0 ps-2">
                    <li t-if="street">
                        <i class="fa fa-map-marker fa-fw me-2" />
                        <span t-out="street" />,
                        <span t-out="res_company.commercial_zip or res_company.zip" />
                        <span t-out="res_company.commercial_city or res_company.city" />
                    </li>
                    <li t-if="phone">
                        <i class="fa fa-phone fa-fw me-2" />
                        <a
              t-attf-href="tel:#{phone}"
              class="o_force_ltr"
              t-out="phone"
            />
                    </li>
                    <li t-if="res_company.email">
                        <i class="fa fa-envelope fa-fw me-2" />
                        <a
              t-attf-href="mailto:#{res_company.email}"
              t-out="res_company.email"
            />
                    </li>
                </ul>
            </div>
    </template>
    <!-- Was shown on the Compassion Suisse website only (v14) -->
    <record id="contactus" model="ir.ui.view">
        <field name="active" eval="True" />
    </record>
</odoo>
