#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid "The entry %s is hashed (inalterable) and therefore cannot be split."
msgstr ""
"La pièce %s est hachée (inaltérable) et ne peut donc pas être scindée."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid "The entry %s is in a locked period and cannot be split."
msgstr ""
"La pièce %s se trouve dans une période verrouillée et ne peut pas être "
"scindée."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid "The entry %s would not be balanced after the split."
msgstr "La pièce %s ne serait pas équilibrée après la scission."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid "The entry has been modified in the meantime, please start again."
msgstr "La pièce a été modifiée entre-temps, veuillez recommencer."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid "The item '%s' cannot absorb the amount to move."
msgstr "L'écriture '%s' ne peut pas absorber le montant à déplacer."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid "The item '%s' cannot be used as a total item."
msgstr "L'écriture '%s' ne peut pas être utilisée comme ligne de total."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid ""
"The item '%s' is linked to a payment or a bank statement and must be kept in"
" the current entry."
msgstr ""
"L'écriture '%s' est liée à un paiement ou à un relevé bancaire et doit "
"rester dans la pièce actuelle."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid ""
"The items to move are not balanced (difference of %s). Flag at least one "
"item (receivable, payable, ...) as 'Total' to share the difference between "
"both entries, or select balanced items."
msgstr ""
"Les écritures à déplacer ne sont pas équilibrées (différence de %s). Marquez"
" au moins une écriture (débiteur, créancier, ...) comme « Total » pour "
"répartir la différence entre les deux pièces, ou sélectionnez des écritures "
"équilibrées."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid "The reconciled tax item '%s' cannot be split. Unreconcile it first."
msgstr ""
"La ligne de taxe lettrée '%s' ne peut pas être scindée. Délettrez-la "
"d'abord."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid ""
"The reconciliation of '%s' generated exchange difference or cash basis "
"entries, which cannot be split automatically. Unreconcile it first."
msgstr ""
"Le lettrage de '%s' a généré des pièces de différence de change ou de taxes "
"sur base de caisse, qui ne peuvent pas être scindées automatiquement. "
"Délettrez-la d'abord."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/models/ebics_file.py:0
msgid ""
"The statement for Account Number %(nr)s is imported in a background job."
msgstr ""
"Le relevé du compte %(nr)s est importé dans une tâche en arrière-plan."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid ""
"The total items (%(total)s) cannot absorb the amount to move (%(needed)s): "
"the total must have the same sign and be larger than the amount of the moved"
" items."
msgstr ""
"Les lignes de total (%(total)s) ne peuvent pas absorber le montant à "
"déplacer (%(needed)s) : le total doit avoir le même signe et être supérieur "
"au montant des écritures déplacées."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid "This entry has been created by splitting %s."
msgstr "Cette pièce a été créée en scindant %s."

#. module: account_switzerland
#. odoo-python
#: code:addons/account_switzerland/wizards/account_move_split_wizard.py:0
msgid "This entry has been split. The moved journal items are now in %s."
msgstr ""
"Cette pièce a été scindée. Les écritures déplacées se trouvent maintenant "
"dans %s."

#. module: account_switzerland
#: model:ir.model.fields.selection,name:account_switzerland.selection__account_move_split_wizard_line__action__total
msgid "Total (adapt and split)"
msgstr "Total (adapter et répartir)"

