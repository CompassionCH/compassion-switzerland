#. module: account_switzerland
#: model_terms:ir.ui.view,arch_db:account_switzerland.account_move_split_wizard_form
msgid "<b>Keep</b>: stays in the current entry."
msgstr "<b>Conserver</b> : reste dans la pièce actuelle."

#. module: account_switzerland
#: model_terms:ir.ui.view,arch_db:account_switzerland.account_move_split_wizard_form
msgid "<b>Move</b>: goes to the new entry (a copy of the current one)."
msgstr ""
"<b>Déplacer</b> : va dans la nouvelle pièce (une copie de l'actuelle)."

#. module: account_switzerland
#: model_terms:ir.ui.view,arch_db:account_switzerland.account_move_split_wizard_form
msgid ""
"<b>Split (taxes)</b>: the tax item is shared between both entries in "
"proportion to the base items that are moved."
msgstr ""
"<b>Scinder (taxes)</b> : la ligne de taxe est répartie entre les deux pièces"
" proportionnellement aux lignes de base déplacées."

#. module: account_switzerland
#: model_terms:ir.ui.view,arch_db:account_switzerland.account_move_split_wizard_form
msgid ""
"<b>Total</b>: the total item (e.g. receivable or payable) is shared between "
"both entries so that each one is balanced. Reconciliations are shared as "
"well."
msgstr ""
"<b>Total</b> : la ligne de total (p. ex. débiteur ou créancier) est répartie"
" entre les deux pièces afin que chacune soit équilibrée. Les lettrages sont "
"également répartis."

