<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_split_wizard" model="ir.ui.view">
        <field name="name">account.move.form.split.wizard</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_open_split_wizard"
                    string="Split Entry"
                    type="object"
                    groups="account.group_account_user"
                    invisible="not id"
                />
            </xpath>
        </field>
    </record>
</odoo>
