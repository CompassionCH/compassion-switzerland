<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sign_oca_request_paper_view_form" model="ir.ui.view">
        <field name="model">sign.oca.request.paper</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    The scan replaces the document of the request and every
                    signer below is marked as signed. No e-mail is sent to ask
                    for a signature.
                </p>
                <group>
                    <field name="request_id" />
                    <field name="signer_ids" widget="many2many_tags" />
                    <field name="data" filename="filename" />
                    <field name="filename" invisible="1" />
                    <field name="signed_on" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="sign_oca_request_paper_action" model="ir.actions.act_window">
        <field name="name">Signed on paper</field>
        <field name="res_model">sign.oca.request.paper</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
