<odoo>
    <data noupdate="1">
        <!-- Report for printing a letter on Compassion Paper -->
        <record id="report_anniversary_card" model="ir.actions.report">
            <field name="name">Anniversary Card</field>
            <field name="model">partner.communication.job</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">report_compassion.anniversary_card</field>
            <field name="paperformat_id" ref="paperformat_anniversary_card" />
        </record>

        <template id="anniversary_card">
         <t t-set="custom_css">
                .container {
                    font-family: "NeighbourSans";
                    margin-top: -5mm;
                    margin-left: 6mm;
                    font-size: 10pt;
                }

                .body {
                    font-family: "NeighbourSans";
                    width: 100mm;
                    float: left;
                    box-sizing: border-box;
                }
                #date {
                    width: 100%;
                }
                #title {
                    font-family: "NeighbourSans";
                    margin-top: 10mm;
                    width: 100%;
                }
                #body-content {
                    width: 100%;
                    margin-top: 8mm;
                }
                #signature {
                    display: block;
                    float: right;
                    position: relative;
                    top: -10mm;
                }

                .expedition {
                    width: 84mm;
                    float: right;
                    box-sizing: border-box;
                    position: relative;
                }
                #pp {
                    position: absolute;
                    top: 38mm;
                    width: 70mm;
                    font-family: verdana;
                    margin-bottom: 5mm;
                    font-weight: bold;
                }
                #pp-box {
                    display: inline-block;
                    padding: 1mm;
                    border: 1pt solid black;
                    white-space: nowrap;
                    width: 45mm;
                }
                #pp-box div:first-child {
                    font-size: 10pt;
                    white-space: nowrap;
                }
                #pp-box div:last-child {
                    font-size: 8pt;
                    white-space: nowrap;
                }
                #pp-post {
                    font-size: 8pt;
                    display: inline-block;
                    width: 20mm;
                }
                #pp hr {
                    margin-top: 0.5mm;
                    margin-bottom: 3mm;
                    width: 100%;
                    height: 2px;
                    background-color: black;
                    border: none;
                }
                #partner_address {
                    overflow-wrap: break-word;
                    display: block;
                    position: absolute;
                    top: 54mm;
                    width: 70mm;
                    font-family: "NeighbourSans";
                }

                #footer {
                    font-size: 8pt;
                    width: 100%;
                    position: fixed;
                    top: 135mm;
                    font-family: "NeighbourSans";
                }
                .blue {
                    color: #0054A6;
                    font-weight: bold;
                }
                .o_standard_footer{
                  display: none;
                  }
            </t>
             <t t-set="address" t-value="False" />
                          <t t-set="report_header_style">
                            display: None;
                          </t>
            <t t-call="web.html_container">
                    <t t-foreach="docs" t-as="o">
                        <t t-call="web.external_layout">

                                <t t-call="report_compassion.style" />
                                <div class="body">
                                    <div id="date">
                                        <span
                  t-raw="o.partner_id.date_communication"
                />
                                    </div>
                                    <div id="title">
                                        <b><span t-raw="o.subject" /></b>
                                    </div>
                                    <div id="body-content">
                                        <span t-raw="o.body_html" />
                                        <div id="signature">
                                            <!-- 187 is equal to Sarah Maria Internal user ID -->
                                            <t
                    t-set="sign_user"
                    t-value="o.env['res.users'].browse(187)"
                  />
                                            <img
                    t-if="sign_user.digital_signature"
                    t-att-src="'data:image/png;base64,' + sign_user.digital_signature.decode('utf-8')"
                    style="width: 200px; max-width: 200px;"
                  />
                                            <p>
                                                <span
                      style="font-weight: bold"
                    >Sarah Maria Herrendorff</span>
                                                <br />
                                                <span
                    >and the team from Compassion</span>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="expedition">
                                    <div id="pp">
                                        <div id="pp-box">
                                            <div>P.P.</div>
                                            <div>CH-1400 Yverdon-les-Bains</div>
                                        </div>
                                        <div id="pp-post">
                                            <p>Poste CH SA</p>
                                        </div>
                                        <hr />
                                    </div>
                                    <span
                t-raw="o.partner_id.short_address"
                id="partner_address"
              />
                                </div>
                                <div id="footer">
                                    <span class="blue">COMPASSION</span>
                                    <span
              >Rue Galilée 3, 1400 Yverdon-les-Bains, Switzerland</span>
                                    <br />
                                    <span class="blue">TÉL</span>
                                    <span>.: 031 552 21 25 </span>
                                    <span class="blue">MAIL</span>
                                    <span>: info@compassion.ch </span>
                                    <span class="blue">WWW</span>
                                    <span>.compassion.ch </span>
                                    <span class="blue">CCP/PC</span>
                                    <span> 17-312562-0</span>
                                </div>
                        </t>
                    </t>
            </t>
        </template>
    </data>
</odoo>
