<odoo>
    <record id="tax_receipt_report" model="ir.actions.report">
        <!-- A4 no margin -->
        <field name="name">Tax Receipt</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">report_compassion.tax_receipt</field>
        <field name="paperformat_id" ref="l10n_ch.paperformat_euro_no_margin" />
    </record>

    <template id="tax_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="partner">
                <t
          t-set="partner"
          t-value="partner.with_context({'lang':partner.lang})"
        />
                <t t-set="object" t-value="partner" />
                <t t-set="print_header" t-value="1" />
                <t t-set="print_subject" t-value="1" />
                <t t-set="body_html">
                    <t t-call="report_compassion.tax_receipt_content" />
                </t>
                <t
          t-set="director"
          t-value="partner.company_id.official_signer_id"
        />
                <t t-set="show_signature" t-value="1" />
                <t t-set="user" t-value="director.user_id" />
                <t
          t-set="signature_letter"
          t-value="user.signature_letter if director else partner.company_id._get_signature_closing_line()"
        />
                <t t-set="display_pp" t-value="1" />
                <t
          t-call="report_compassion.partner_communication_document"
          t-lang="partner.lang"
        />
            </t>
        </t>
    </template>

    <template id="tax_receipt_content">
        <div>
            <br />
            <h2>
                <t t-out="object.get_donations_intro()"/> <t t-out="year"/> add up to CHF <t t-out="object.get_receipt_text(year)"/>
            </h2>
            <p>The Christian humanitarian organisation Compassion Suisse,
                that serves as an advocate for children in poverty, is exempt from taxes.
                By a decision taken May 24, 2004 by the cantonal administration of the canton
                of Vaud, the association is recognized as a registered non profit organisation.
            </p>
            <p>May God bless you richly.</p>
            <p>Best regards</p>
        </div>
    </template>
</odoo>
