#. module: report_compassion
#: model:mail.template,body_html:report_compassion.tax_receipt_template
msgid ""
"<span><t t-set=\"year\" t-value=\"year or datetime.date.today().year\"/>\n"
"                <t t-call=\"report_compassion.tax_receipt_content\"/>\n"
"            </span>"
msgstr ""
"<html>\n"
"  <body><div>\n"
"                    <t t-set=\"year\" t-value=\"ctx[&#x27;year&#x27;]\"/>\n"
"    <t t-set=\"partner\" t-value=\"object\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"Deine\" t-value=\"&#x27;Eure&#x27; if plural else &#x27;Deine&#x27;\"/>\n"
"                </div>\n"
"                <div>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <h3 align=\"center\"><t t-out=\"Deine\"></t> Spenden im Jahr <t t-out=\"year\"></t> betragen<br/>CHF <t t-out=\"object.get_receipt_text(year)\"></t></h3>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <p>Der Verein Compassion Schweiz bietet christlich-humanitäre Hilfe für benachteiligte Kinder und ist von Steuern befreit und durch einen Entscheid vom 24. Mai 2004, der kantonalen Administration des Kantons Waadt als gemeinnütziges Werk anerkannt.\n"
"                    </p>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <p>Freundliche Grüsse</p>\n"
"                </div>\n"
"            </body>\n"
"</html>\n"

