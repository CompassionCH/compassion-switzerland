#. module: report_compassion
#: model:mail.template,body_html:report_compassion.tax_receipt_template
msgid ""
"<div>\n"
"                    % set year = ctx['year']\n"
"                </div>\n"
"                <div>\n"
"                    <h2>Your donations in ${year} add up to CHF <span style=\"font-family: 'miller';\">${object.get_receipt_text(year)}</span></h2>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <p>The Christian humanitarian organisation Compassion Suisse, that serves as an advocate for children in poverty, is exempt from taxes. By a decision taken May 24, 2004 by the cantonal administration of the canton of Vaud, the association is recognized as a registered non profit organisation.\n"
"                    </p>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <p>May God bless you richly.</p>\n"
"                    <p>Best regards</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    % set year = ctx['year']\n"
"    % set partner = object\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set Deine = 'Eure' if plural else 'Deine'\n"
"\n"
"                </div>\n"
"                <div>\n"
"                    <br>\n"
"                    <br>\n"
"                    <h3 align=center>${Deine} Spenden im Jahr ${year} betragen<br>CHF ${object.get_receipt_text(year)}</h3>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <p>Der Verein Compassion Schweiz bietet christlich-humanitäre Hilfe für benachteiligte Kinder und ist von Steuern befreit und durch einen Entscheid vom 24. Mai 2004, der kantonalen Administration des Kantons Waadt als gemeinnütziges Werk anerkannt.\n"
"                    </p>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <p>Freundliche Grüsse</p>\n"
"                </div>\n"
"            "

